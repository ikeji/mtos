// asm_pass2.tc — driver for the label-collection pass.
//
// All the orchestration logic lives in asm_pass2_lib.tc as
// `export fn run(...)`. This file is just the main(argv) wrapper —
// argv parsing + state setup + run() call. Kept separate so the new
// asm_pass1 (Phase C of the 3-binary split) can `import
// "asm_pass2_lib.tc"` and call run() without colliding on main /
// arg_eq linker symbols.

import "asm_pass2_lib.tc";
import "asm_common.tc";

fn arg_eq(s: String, pat: StringLiteral) -> i32 {
    var ns: i32 = len(s);
    var np: i32 = len(pat);
    if ns != np { return 0; }
    var i: i32 = 0;
    while i < np {
        if get(s, i) != get(pat, i) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn main() -> i32 {
    return run(0 as String, 0 as String, 0 as String, 0 as String, 0 as String);
}

fn main(argv: StringArray) -> i32 {
    // CLI shapes:
    //   asm_pass2                                       stdin → .lab on stdout
    //   asm_pass2 src.s                                 read src, .lab on stdout
    //   asm_pass2 src.s strip.s                         dead-strip → strip.s, .lab on stdout
    //   asm_pass2 --emit-idx out.idx src.s              extract pass only → .idx
    //   asm_pass2 --load-idx in.idx src.s [strip.s]     load prelude state then process src
    //   asm_pass2 --load-idx in.idx --idx-source p.s ... emit `src p.s` into the .lab so
    //                                                     pass3 can open the prelude directly
    //   asm_pass2 --lab-out path.lab ...                .lab to a file instead of stdout
    var path: String = 0 as String;
    var strip_out: String = 0 as String;
    var emit_idx: String = 0 as String;
    var load_idx: String = 0 as String;
    var idx_source: String = 0 as String;
    var lab_out: String = 0 as String;
    var prelude_text_bin:   String = 0 as String;
    var prelude_rodata_bin: String = 0 as String;
    var prelude_data_bin:   String = 0 as String;
    var prelude_reloc:      String = 0 as String;
    if argv as u32 != 0u32 {
        var argc: i32 = len(argv);
        var consumed: i32 = 1;  // skip argv[0] (program name)
        var keep_scanning: i32 = 1;
        while keep_scanning != 0 && consumed < argc {
            var a: String = get(argv, consumed);
            if arg_eq(a, "--emit-idx") != 0 && consumed + 1 < argc {
                emit_idx = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--load-idx") != 0 && consumed + 1 < argc {
                load_idx = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--idx-source") != 0 && consumed + 1 < argc {
                idx_source = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--lab-out") != 0 && consumed + 1 < argc {
                lab_out = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--prelude-text-bin") != 0 && consumed + 1 < argc {
                prelude_text_bin = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--prelude-rodata-bin") != 0 && consumed + 1 < argc {
                prelude_rodata_bin = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--prelude-data-bin") != 0 && consumed + 1 < argc {
                prelude_data_bin = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--prelude-reloc") != 0 && consumed + 1 < argc {
                prelude_reloc = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else {
                keep_scanning = 0;
            }
        }
        if consumed < argc { path = get(argv, consumed); consumed = consumed + 1; }
        if consumed < argc { strip_out = get(argv, consumed); consumed = consumed + 1; }
    }
    if idx_source as u32 != 0u32 { asm_set_src_path1(idx_source); }
    if strip_out as u32 != 0u32 {
        asm_set_src_path2(strip_out);
    } else if path as u32 != 0u32 && idx_source as u32 != 0u32 {
        asm_set_src_path2(path);
    } else if path as u32 != 0u32 {
        asm_set_src_path1(path);
    }
    if prelude_text_bin   as u32 != 0u32 { asm_set_prelude_text_bin(prelude_text_bin); }
    if prelude_rodata_bin as u32 != 0u32 { asm_set_prelude_rodata_bin(prelude_rodata_bin); }
    if prelude_data_bin   as u32 != 0u32 { asm_set_prelude_data_bin(prelude_data_bin); }
    if prelude_reloc      as u32 != 0u32 { asm_set_prelude_reloc(prelude_reloc); }
    return run(path, strip_out, emit_idx, load_idx, lab_out);
}
