// asm_pass2.tc — driver for the lab build / linker merge.
//
// All the orchestration logic lives in asm_pass2_lib.tc. This file
// is just the main(argv) wrapper. Kept separate so asm_pass1 (Phase
// C of the 3-binary split) can `import "asm_pass2_lib.tc"` and call
// run() / run_link() without colliding on main / arg_eq linker
// symbols.
//
// Two CLI shapes:
//
//   1. Linker mode (LINK_MODE — the standard host + OS pipeline):
//
//      asm_pass2 --link \
//          [--prelude-idx prelude.idx
//           --prelude-text-bin pT.bin --prelude-rodata-bin pR.bin
//           --prelude-data-bin pD.bin --prelude-reloc pL.reloc] \
//          --user-idx user.idx \
//          --user-text-bin uT.bin --user-rodata-bin uR.bin \
//          --user-data-bin uD.bin --user-reloc uL.reloc \
//          [--add idx text.bin rodata.bin data.bin reloc] ... \
//          --lab-out full.lab
//
//      Single-input links (run_asm_tc, on-device kernel link) omit
//      --prelude-* and pass the whole self-contained .s through
//      asm_pass1 as the user side.
//
//   2. Walked-source (legacy fallback for OS-side big-input links
//      that exceed the 288 KB asm_pass1 task arena):
//
//      asm_pass2 --lab-out full.lab src.s
//
//      Walks `src.s` once, builds the label table + writes the .lab
//      with a `src <src.s>` line so asm_pass3 can reopen the source
//      per emit section. No idx / bin / reloc artefacts — pass 1
//      semantics in a single binary. Used by pico2_self_step2 and
//      pico2_link_kernel{,_step2,_nodisk}.sh where the kernel-image
//      .s (~3.8 MB) is too big for asm_pass1's pre-encode arena.

import "asm_pass2_lib.tc";
import "asm_common.tc";

fn arg_eq(s: String, pat: StringLiteral) -> i32 {
    var ns: i32 = len(s);
    var np: i32 = len(pat);
    if ns != np { return 0; }
    var i: i32 = 0;
    while i < np {
        if get(s, i) != get(pat, i) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn err(s: StringLiteral) -> void {
    sys_write(2, s as u32 as U8Array, len(s));
    return;
}

fn main() -> i32 {
    err("asm_pass2: requires args — see source for CLI shape\n");
    return 1;
}

fn main(argv: StringArray) -> i32 {
    var lab_out: String = 0 as String;
    var src_path: String = 0 as String;
    var prelude_text_bin:   String = 0 as String;
    var prelude_rodata_bin: String = 0 as String;
    var prelude_data_bin:   String = 0 as String;
    var prelude_reloc:      String = 0 as String;
    var prelude_idx:        String = 0 as String;
    var user_idx:           String = 0 as String;
    var user_text_bin:      String = 0 as String;
    var user_rodata_bin:    String = 0 as String;
    var user_data_bin:      String = 0 as String;
    var user_reloc:         String = 0 as String;
    var link_mode: i32 = 0;
    if argv as u32 != 0u32 {
        var argc: i32 = len(argv);
        var consumed: i32 = 1;  // skip argv[0] (program name)
        while consumed < argc {
            var a: String = get(argv, consumed);
            if arg_eq(a, "--link") != 0 {
                link_mode = 1;
                consumed = consumed + 1;
            } else if arg_eq(a, "--prelude-idx") != 0 && consumed + 1 < argc {
                prelude_idx = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--user-idx") != 0 && consumed + 1 < argc {
                user_idx = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--lab-out") != 0 && consumed + 1 < argc {
                lab_out = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--prelude-text-bin") != 0 && consumed + 1 < argc {
                prelude_text_bin = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--prelude-rodata-bin") != 0 && consumed + 1 < argc {
                prelude_rodata_bin = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--prelude-data-bin") != 0 && consumed + 1 < argc {
                prelude_data_bin = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--prelude-reloc") != 0 && consumed + 1 < argc {
                prelude_reloc = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--user-text-bin") != 0 && consumed + 1 < argc {
                user_text_bin = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--user-rodata-bin") != 0 && consumed + 1 < argc {
                user_rodata_bin = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--user-data-bin") != 0 && consumed + 1 < argc {
                user_data_bin = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--user-reloc") != 0 && consumed + 1 < argc {
                user_reloc = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--add") != 0 && consumed + 5 < argc {
                // --add <idx> <text.bin> <rodata.bin> <data.bin> <reloc>
                // Each --add registers one extra link input beyond
                // prelude (input 0) + user (input 1). asm_pass2_lib's
                // run_link_finish loads each idx in order, captures
                // its content_start values, and shifts its reloc
                // text offsets by the running text-size accumulator.
                asm_add_extra_input(get(argv, consumed + 1),
                                    get(argv, consumed + 2),
                                    get(argv, consumed + 3),
                                    get(argv, consumed + 4),
                                    get(argv, consumed + 5));
                consumed = consumed + 6;
            } else {
                // Treat the first non-flag argument as the walked-
                // source positional path (legacy `asm_pass2 src.s`
                // form, OS-side kernel-image link).
                if src_path as u32 == 0u32 {
                    src_path = a;
                    consumed = consumed + 1;
                } else {
                    err("asm_pass2: unknown argument — see source for CLI shape\n");
                    return 1;
                }
            }
        }
    }
    if link_mode != 0 {
        return run_link(prelude_idx, user_idx,
                        prelude_text_bin, prelude_rodata_bin,
                        prelude_data_bin, prelude_reloc,
                        user_text_bin, user_rodata_bin,
                        user_data_bin, user_reloc,
                        lab_out);
    }
    if src_path as u32 != 0u32 {
        // Walked-source: run() opens src_path, walks it, builds the
        // label table + writes the .lab. The .lab carries a
        // `src <src_path>` line so asm_pass3 can reopen the source
        // per emit section.
        asm_set_src_path1(src_path);
        return run(src_path, 0 as String, lab_out);
    }
    err("asm_pass2: --link or src.s argument required\n");
    return 1;
}
