// asm_pass2.tc — driver for the linker merge.
//
// All the orchestration logic lives in asm_pass2_lib.tc. This file
// is just the main(argv) wrapper. Kept separate so asm_pass1 (Phase
// C of the 3-binary split) can `import "asm_pass2_lib.tc"` and call
// run_link() without colliding on main / arg_eq linker symbols.
//
// CLI shape (idx v2):
//
//   asm_pass2 --add <idx> [--add <idx>] ... --lab-out <lab>
//
// Each `--add <idx>` registers one input. Inputs load in order:
//   - input[0] sets the raw/load_base authority for the final binary
//   - input[1] (if present) gets text_shift = sec_pos at start of load
//   - input[N>=2] same as input[1] but with the accumulated shift
//
// The .idx file (v2) carries its bin/reloc paths in its header, so
// no separate flags are needed for those — asm_pass1 baked them in
// when it generated the idx.
//
// Single-input links (run_asm_tc, on-device kernel link) just pass
// one `--add` and asm_pass2 treats that input as the whole program
// with sec_pos starting at 0.

import "asm_pass2_lib.tc";
import "asm_common.tc";
import "asm_dead_strip.tc";

fn arg_eq(s: String, pat: StringLiteral) -> i32 {
    var ns: i32 = len(s);
    var np: i32 = len(pat);
    if ns != np { return 0; }
    var i: i32 = 0;
    while i < np {
        if get(s, i) != get(pat, i) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn err(s: StringLiteral) -> void {
    sys_write(2, s as u32 as U8Array, len(s));
    return;
}

fn main() -> i32 {
    err("asm_pass2: requires args — see source for CLI shape\n");
    return 1;
}

var MAX_INPUTS: i32 = 32;

fn main(argv: StringArray) -> i32 {
    var lab_out: String = 0 as String;
    var inputs: StringArray = StringArray((MAX_INPUTS) as u32);
    var n_inputs: i32 = 0;
    var strip: i32 = 0;
    if argv as u32 != 0u32 {
        var argc: i32 = len(argv);
        var consumed: i32 = 1;  // skip argv[0] (program name)
        while consumed < argc {
            var a: String = get(argv, consumed);
            if arg_eq(a, "--add") != 0 && consumed + 1 < argc {
                if n_inputs >= MAX_INPUTS {
                    err("asm_pass2: too many --add inputs\n");
                    return 1;
                }
                set(inputs, n_inputs, get(argv, consumed + 1));
                n_inputs = n_inputs + 1;
                consumed = consumed + 2;
            } else if arg_eq(a, "--lab-out") != 0 && consumed + 1 < argc {
                lab_out = get(argv, consumed + 1);
                consumed = consumed + 2;
            } else if arg_eq(a, "--strip") != 0 {
                // Phase C dead-strip: compact dead byte ranges out of
                // the linked output. asm_pass3 must honor the `skip`
                // lines emitted in the .lab for this to produce a
                // correct binary. Default off until C.3 lands.
                strip = 1;
                consumed = consumed + 1;
            } else {
                err("asm_pass2: unknown argument — see source for CLI shape\n");
                return 1;
            }
        }
    }
    if n_inputs == 0 {
        err("asm_pass2: at least one --add <idx> required\n");
        return 1;
    }
    asm_dead_strip_set_strip(strip);
    return run_link(inputs, n_inputs, lab_out);
}
