// const globals: string consts alias their literal (push_str), int /
// bool consts inline their value (push_int), assignment is a compile
// error, and `var X: StringLiteral = "..."` at global scope is a
// compile error (#36 — a string pointer can't live in a .data word
// because PIC raw-bin tasks have no load-time relocation).
// Covers: str const via get/len, two consts sharing one literal (slit
// dedup), int / u32 / bool consts, a local shadowing a const name,
// and a mutable var global living in the same file.

const GREET: StringLiteral = "hi, global str!";
const SAME: StringLiteral = "hi, global str!";
const TAIL: StringLiteral = "tail";
const N: i32 = 42;
const MASK: u32 = 0x10u32;
const FLAG: bool = true;
var g_counter: i32 = 0;

fn put_sl(s: StringLiteral) -> void {
    var n: i32 = len(s);
    var buf: U8Array = U8Array(64u32);
    var i: i32 = 0;
    while i < n {
        set(buf, i, get(s, i));
        i = i + 1;
    }
    set(buf, n, 10u8);
    sys_write(1, buf, n + 1);
    delete(buf);
    return;
}

fn put2(v: i32) -> void {
    var buf: U8Array = U8Array(4u32);
    set(buf, 0, (48 + v / 10) as u8);
    set(buf, 1, (48 + v % 10) as u8);
    set(buf, 2, 10u8);
    sys_write(1, buf, 3);
    delete(buf);
    return;
}

fn shadowed() -> void {
    var N: i32 = 7;
    N = 8;
    put2(N);
    return;
}

fn main() -> i32 {
    put_sl(GREET);
    put_sl(SAME);
    put_sl(TAIL);
    g_counter = N + (MASK as i32);
    if FLAG { put2(g_counter); }
    put2(len(GREET) + 10);
    shadowed();
    return 0;
}
