.bc
; globals
.global G_ADD i32 10

.fn put_sl StringLiteral void
.param s StringLiteral
.local n i32
.local buf U8Array
.local i i32
; var n: i32 = len(s);
  load s
  call len StringLiteral
  store n
; var buf: U8Array = U8Array(64u32);
  push_int 64
  call U8Array u32
  store buf
; var i: i32 = 0;
  push_int 0
  store i
; while i < n {
__L0:
  load i
  load n
  lt
  jump_ifnot __L1
; set(buf, i, get(s, i));
  load buf
  load i
  load s
  load i
  call get StringLiteral i32
  call set U8Array i32 u8
  pop
; i = i + 1;
  load i
  push_int 1
  add
  store i
  jump __L0
__L1:
; set(buf, n, 10u8);
  load buf
  load n
  push_int 10
  call set U8Array i32 u8
  pop
; sys_write(1, buf, n + 1);
  push_int 1
  load buf
  load n
  push_int 1
  add
  call sys_write i32 U8Array i32
  pop
; delete(buf);
  load buf
  call delete U8Array
  pop
; return;
  return_void
  return_void
.endfn

.fn put2 i32 void
.param v i32
.local buf U8Array
; var buf: U8Array = U8Array(4u32);
  push_int 4
  call U8Array u32
  store buf
; set(buf, 0, (48 + v / 10) as u8);
  load buf
  push_int 0
  push_int 48
  load v
  push_int 10
  div
  add
  cast u8
  call set U8Array i32 u8
  pop
; set(buf, 1, (48 + v % 10) as u8);
  load buf
  push_int 1
  push_int 48
  load v
  push_int 10
  mod
  add
  cast u8
  call set U8Array i32 u8
  pop
; set(buf, 2, 10u8);
  load buf
  push_int 2
  push_int 10
  call set U8Array i32 u8
  pop
; sys_write(1, buf, 3);
  push_int 1
  load buf
  push_int 3
  call sys_write i32 U8Array i32
  pop
; delete(buf);
  load buf
  call delete U8Array
  pop
; return;
  return_void
  return_void
.endfn

.fn main i32
; put_sl(GREET);
  push_str 0
  call put_sl StringLiteral
  pop
; put_sl(SAME);
  push_str 0
  call put_sl StringLiteral
  pop
; put_sl(TAIL);
  push_str 1
  call put_sl StringLiteral
  pop
; put2(len(GREET) + G_ADD);
  push_str 0
  call len StringLiteral
  load G_ADD
  add
  call put2 i32
  pop
; return 0;
  push_int 0
  return
  return_void
.endfn

; string table
.string 0 "hi, global str!"
.string 1 "tail"

.endbc
