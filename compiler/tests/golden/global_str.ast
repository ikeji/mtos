(program
  (var_decl GREET
    (type StringLiteral)
    (str "hi, global str!")
  )
  (var_decl SAME
    (type StringLiteral)
    (str "hi, global str!")
  )
  (var_decl TAIL
    (type StringLiteral)
    (str "tail")
  )
  (var_decl G_ADD
    (type i32)
    (int 10)
  )
  (fn put_sl
    (params
      (param s
        (type StringLiteral)
      )
    )
    (ret
      (type void)
    )
    (block
      (comment "var n: i32 = len(s);")
      (var_decl n
        (type i32)
        (call len
          (var s)
        )
      )
      (comment "var buf: U8Array = U8Array(64u32);")
      (var_decl buf
        (type U8Array)
        (call U8Array
          (int:u32 64)
        )
      )
      (comment "var i: i32 = 0;")
      (var_decl i
        (type i32)
        (int 0)
      )
      (comment "while i < n {")
      (while
        (binop <
          (var i)
          (var n)
        )
        (block
          (comment "set(buf, i, get(s, i));")
          (call_stmt set
            (var buf)
            (var i)
            (call get
              (var s)
              (var i)
            )
          )
          (comment "i = i + 1;")
          (assign i
            (binop +
              (var i)
              (int 1)
            )
          )
        )
      )
      (comment "set(buf, n, 10u8);")
      (call_stmt set
        (var buf)
        (var n)
        (int:u8 10)
      )
      (comment "sys_write(1, buf, n + 1);")
      (call_stmt sys_write
        (int 1)
        (var buf)
        (binop +
          (var n)
          (int 1)
        )
      )
      (comment "delete(buf);")
      (call_stmt delete
        (var buf)
      )
      (comment "return;")
      (return)
    )
  )
  (fn put2
    (params
      (param v
        (type i32)
      )
    )
    (ret
      (type void)
    )
    (block
      (comment "var buf: U8Array = U8Array(4u32);")
      (var_decl buf
        (type U8Array)
        (call U8Array
          (int:u32 4)
        )
      )
      (comment "set(buf, 0, (48 + v / 10) as u8);")
      (call_stmt set
        (var buf)
        (int 0)
        (cast
          (binop +
            (int 48)
            (binop /
              (var v)
              (int 10)
            )
          )
          (type u8)
        )
      )
      (comment "set(buf, 1, (48 + v % 10) as u8);")
      (call_stmt set
        (var buf)
        (int 1)
        (cast
          (binop +
            (int 48)
            (binop %
              (var v)
              (int 10)
            )
          )
          (type u8)
        )
      )
      (comment "set(buf, 2, 10u8);")
      (call_stmt set
        (var buf)
        (int 2)
        (int:u8 10)
      )
      (comment "sys_write(1, buf, 3);")
      (call_stmt sys_write
        (int 1)
        (var buf)
        (int 3)
      )
      (comment "delete(buf);")
      (call_stmt delete
        (var buf)
      )
      (comment "return;")
      (return)
    )
  )
  (fn main
    (params)
    (ret
      (type i32)
    )
    (block
      (comment "put_sl(GREET);")
      (call_stmt put_sl
        (var GREET)
      )
      (comment "put_sl(SAME);")
      (call_stmt put_sl
        (var SAME)
      )
      (comment "put_sl(TAIL);")
      (call_stmt put_sl
        (var TAIL)
      )
      (comment "put2(len(GREET) + G_ADD);")
      (call_stmt put2
        (binop +
          (call len
            (var GREET)
          )
          (var G_ADD)
        )
      )
      (comment "return 0;")
      (return
        (int 0)
      )
    )
  )
)
