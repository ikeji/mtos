// asm_common.tc — shared encoder/parser core for the asm split
// (Phase 2 #56). asm-pass1 (label collector) and asm-pass2 (encoder)
// import this module and call the export fns listed below; the
// instruction encoders, operand parsers, mnemonic dispatch table,
// label/section state, and per-line tokenizer all live here so the
// two pass binaries don't have to duplicate them.
//
// Public entry points:
//
//   asm_init_pass1()                — allocate state for pass 1 (no g_code)
//   asm_init_pass2()                — allocate state for pass 2 (+ g_code)
//   asm_set_pass(p)                 — sets g_pass (1 or 2)
//   asm_parse_meta_directive(buf,n) — handle ; raw / ; load_base
//   asm_process_line(buf, n, ln)    — main per-line driver
//   asm_compute_sec_bases()         — pass 1 fixup: derive sec_base[]
//   asm_fixup_labels()              — pass 1 fixup: addr += sec_base
//   asm_dump_lab_state()            — pass 1 → .lab on stdout
//   asm_install_label_from_lab(name, nlen, addr, section)
//   asm_install_numlab_from_lab(digit, addr)
//   asm_install_sec_base_size(idx, base, size)
//   asm_write_elf()                 — pass 2 final step
//
// See docs/lab_format.md for the .lab on-the-wire format and
// docs/task/pipeline_100kb.md §5 for split rationale.

import "string_buffer.tc";
import "source_reader.tc";
import "strlib.tc";

// ===== Constants =====
var ELF_HDR_SIZE: i32 = 84;  // 52 (ehdr) + 32 (phdr)
// PIC: labels are stored as offsets from code start (0..code_size).
// ELF output adds g_load_vaddr + ELF_HDR_SIZE for runtime addresses.
//
// MAX_LABELS: 4096 is enough for the current self-host build (measured
// ~2800-3200 labels when compiling a full compiler source). Raising
// this triggers a 16 B × N alloc in g_labels so stay conservative.
//
// NAME_POOL_INITIAL_KB: starting capacity of the byte pool that holds
// label names, in KB. Grows exponentially via ensure_name_pool_capacity
// so small inputs (hello.tc uses 35 bytes total) only pay the initial
// 4 KB and large inputs amortise the resize cost. Replaces the old
// MAX_NAME_POOL fixed cap (was 96 KB pre-allocated regardless of
// usage); for hello.tc that saved ~92 KB of asm_pass2/asm_pass3 peak.
//
// asm_pass2 --link with many inputs (self_replicate's 13-way merge)
// needs ~60 KB total — calling asm_preallocate_name_pool(64*1024)
// from run_link skips the gradual-grow churn that would otherwise
// fragment the arena and OOM the final 64 KB grow. Other callers
// keep the small initial cap.
var MAX_LABELS:           i32 = 4096;
var NAME_POOL_INITIAL_KB: i32 = 4;
// Numeric labels (0:..9:). Each digit holds at most NUM_LAB_PER_DIGIT
// definitions; the g_numlab table is `digit * NUM_LAB_PER_DIGIT + idx`.
// Measured: kernel build has ~404 "0:" labels (bc2asm emits `0f/0b`
// for every conditional branch).
//
// 2026-04-30: tried 512, asm_pass2.tc itself overflowed digit 0
// (>512 conditional branches in the assembler source). Reverted
// to 1024 — the kernel's measured 404 max underestimated; compiling
// the assembler itself is the real worst case. The bounds check in
// define_numlab below catches future regressions cleanly.
var NUM_LAB_PER_DIGIT: i32 = 4096;

// ===== Output mode (set by ; raw / ; load_base directives) =====
var g_load_vaddr: i32 = 65536;  // 0x10000 (default Linux ELF load address)
var g_raw_mode: i32 = 0;        // 1 = raw bin output (no ELF header)

// ===== Section-reordering linker =====
// Sections: 0=text, 1=rodata, 2=data, 3=bss
// asm.tc is the linker in this toolchain: it sees every `.s` input as a
// single stream with interleaved sections, and emits them physically
// grouped in the output (text -> rodata -> data -> bss). Labels are first
// recorded with their per-section intra offset (g_sec_pos at the time of
// definition), then fixed up after pass 1 by adding g_sec_base[section].
//
// gp-relative la is always active for data/bss labels. `__global_pointer$`
// is auto-defined at data_base + 0x800 (in the text address space, so
// `la gp, __global_pointer$` used by crt0 is a plain PC-relative la).
// Data/bss la offsets must fit in 12-bit signed (-2048..2047); out of range
// is a fatal error with the label name.
var g_current_section: i32 = 0;
var g_sec_pos: I32Array = 0 as I32Array;   // [text, rodata, data, bss] intra cursors
var g_sec_base: I32Array = 0 as I32Array;  // final absolute base of each section
var g_sec_size: I32Array = 0 as I32Array;  // final size of each section (16-byte aligned)
var g_gp_abs: i32 = 0;                     // absolute value of __global_pointer$

// ===== Global state =====
// Pass 2 emit modes:
//   - buffered (g_stream_mode=0): legacy path. g_code is a U8Array
//     sized to filesz, bytes written via emit8 land at g_code[g_pos]
//     and asm_write_elf dumps header + g_code at end. Used by
//     single-pass callers that can't afford multi-pass source reads.
//   - streaming (g_stream_mode=1): new path (2026-04-16). g_code is
//     NOT allocated. Instead, asm_pass3 runs pass 2 THREE times (once
//     per output section: text, rodata, data), each pass re-reading
//     the source from a filename supplied as argv[1]. During a pass,
//     emit8 writes to g_out_buf only if g_current_section equals
//     g_target_section, flushing to stdout when the buffer fills.
//     This cuts asm_pass3 peak from ~400 KB (asm_common + g_code
//     filesz) to ~200 KB (asm_common + 4 KB g_out_buf).
var g_code: U8Array = 0 as U8Array;  // buffered-mode output buffer, unused in stream mode
var g_code_size: i32 = 0;            // allocated size of g_code
var g_pos: i32 = 0;                  // current write position (PIC offset in bin)
var g_pass: i32 = 0;                 // 1 or 2
var g_code_end: i32 = 0;             // highest position written to g_code
var g_bss_pos: i32 = 0;              // BSS size (accumulated from .comm directives)

// Stream-emit state (2026-04-16, Phase 5)
var g_stream_mode:     i32 = 0;        // 1 = stream to stdout, 0 = buffer in g_code
var g_target_section:  i32 = 0;        // which section (0/1/2) the current pass is emitting
var g_out_buf:         U8Array = 0 as U8Array;  // 4 KB stdout buffer
var g_out_pos:         i32 = 0;        // bytes currently in g_out_buf
var g_out_buf_size:    i32 = 4096;
var g_section_emitted: i32 = 0;        // bytes emitted in the current target section this pass

// Incbin-defer (2026-05-09): when --incbin-skip is set on asm_pass1,
// a `.incbin SIZE "path"` directive at section offset 0 is recorded
// in the idx as `incbin <sec> <intra_off> <size> <path>` instead of
// being materialized into the per-section bin. The link step
// translates the idx record back into a `src raw <orig_path> <sec>
// <abs_start>` line in the .lab so asm_pass3 memcpys the original
// blob (e.g. /sd/dx.img) directly without a 3.5 MB intermediate.
//
// Restriction: only the first .incbin in a section is deferred, and
// only when intra_off is 0 at the directive (i.e., the .incbin is
// the leading content of the section). All other .incbin uses fall
// back to the materialized path. Covers the wrap.s pattern bin2s_
// incbin.sh emits.
var g_incbin_skip:           i32 = 0;
var g_pass1_incbin_present:  i32 = 0;
var g_pass1_incbin_sec:      i32 = 0;
var g_pass1_incbin_intra_off: i32 = 0;
var g_pass1_incbin_size:     i32 = 0;
var g_pass1_incbin_path:     String = 0 as String;
// Transient: idx_process_line writes here when an `incbin` line is
// parsed. Caller (run_link / run_link_finish) reads after each
// asm_load_idx and copies into per-input slots before the next load.
var g_load_incbin_present:    i32 = 0;
var g_load_incbin_sec:        i32 = 0;
var g_load_incbin_intra_off:  i32 = 0;
var g_load_incbin_size:       i32 = 0;
var g_load_incbin_path:       String = 0 as String;
// Where pass2 writes the encoded binary. Defaults to stdout (fd 1)
// for the legacy pipeline; asm_pass3 sets this to the --out file fd
// when invoked with file-args.
var g_out_fd:          i32 = 1;
export fn asm_set_out_fd(fd: i32) -> void { g_out_fd = fd; return; }
export fn asm_get_out_fd() -> i32 { return g_out_fd; }

// Public flush-on-demand for pass2's raw memcpy path: empties the
// section emit buffer to g_out_fd before a direct sys_write, so the
// pre-encoded prelude bytes don't get sandwiched between buffered
// asm-emit bytes.
export fn asm_flush_out_buf_export() -> void {
    if g_out_pos > 0 {
        sys_write(g_out_fd, g_out_buf, g_out_pos);
        g_out_pos = 0;
    }
    return;
}

// Bump the current target section's cursor / emitted counter by `n`
// bytes after a raw memcpy. Mirrors what emit_stream / emit8 would
// have done if we had walked the bytes through emit8 — but raw blobs
// skip per-byte dispatch and write straight to g_out_fd.
export fn asm_advance_section_pass2(n: i32) -> void {
    if g_pass != 2 { return; }
    g_section_emitted = g_section_emitted + n;
    set(g_sec_pos, g_target_section,
        get(g_sec_pos, g_target_section) + n);
    return;
}

// Per-section emit fds for --emit-bin mode. When non-zero, the
// asm-pass2 section pass for that section writes to the file
// instead of g_out_fd. Set up by run_pass2 from the
// --text-bin / --rodata-bin / --data-bin flags. Reset to 0
// when not in emit-bin mode.
var g_text_bin_fd:   i32 = 0;
var g_rodata_bin_fd: i32 = 0;
var g_data_bin_fd:   i32 = 0;
// Reloc output fd: where to write `reloc <offset> <kind> <name>`
// lines as the encoder detects PC-relative refs that change with
// user-side text size (la to rodata / __global_pointer$, call to
// main / main__StringArray).
var g_reloc_fd:      i32 = 0;
var g_reloc_count:   i32 = 0;
export fn asm_set_text_bin_fd(fd: i32)   -> void { g_text_bin_fd   = fd; return; }
export fn asm_set_rodata_bin_fd(fd: i32) -> void { g_rodata_bin_fd = fd; return; }
export fn asm_set_data_bin_fd(fd: i32)   -> void { g_data_bin_fd   = fd; return; }
export fn asm_set_reloc_fd(fd: i32)      -> void { g_reloc_fd      = fd; return; }
export fn asm_get_reloc_fd() -> i32 { return g_reloc_fd; }
export fn asm_get_text_bin_fd()   -> i32 { return g_text_bin_fd; }
export fn asm_get_rodata_bin_fd() -> i32 { return g_rodata_bin_fd; }
export fn asm_get_data_bin_fd()   -> i32 { return g_data_bin_fd; }
export fn asm_get_reloc_count() -> i32 { return g_reloc_count; }
// When non-zero, every label reference whose name isn't in the local
// g_labels table emits a reloc (kind 0/1/2 depending on the
// instruction) and the encoder writes a placeholder zero offset. The
// link step (asm_pass2 / asm_pass3 patcher) consumes the .reloc and
// fixes up the bytes. Off by default — preserves the legacy
// hardcoded-extern-list behavior for prelude pre-encode.
var g_emit_undef_relocs: i32 = 0;
export fn asm_set_emit_undef_relocs(v: i32) -> void { g_emit_undef_relocs = v; return; }
export fn asm_get_emit_undef_relocs() -> i32 { return g_emit_undef_relocs; }
// Per-section start alignment (in bytes) recorded by pass 1 from the
// first `.align N` directive seen in each section. Captured into the
// .idx so the link step can pre-align sec_pos before installing this
// idx's labels — that's where the legacy walked-source flow inserts
// padding as its single cursor crosses the directive.
// Section ids: 0=text, 1=rodata, 2=data, 3=bss. 0 means "no .align
// observed in this section yet" — link step leaves sec_pos alone.
var g_sec_start_align: I32Array = 0 as I32Array;
// Per-section content start offset captured during the most recent
// asm_load_idx call: initialized to sec_pos at load entry, then
// updated by each `align <s> <n>` line in the idx so callers can
// later read where the idx's bytes actually begin in the merged
// layout. Used by asm_pass2's --link mode to emit per-bin start
// offsets in the lab so asm_pass3 pads zeros to the right place.
var g_load_idx_content_start: I32Array = 0 as I32Array;
fn ensure_load_idx_content_start() -> void {
    if g_load_idx_content_start as u32 == 0u32 {
        g_load_idx_content_start = I32Array(4);
    }
    return;
}
export fn asm_load_idx_content_start(s: i32) -> i32 {
    if s < 0 || s >= 4 { return 0; }
    if g_load_idx_content_start as u32 == 0u32 { return 0; }
    return get(g_load_idx_content_start, s);
}
fn ensure_sec_start_align() -> void {
    if g_sec_start_align as u32 == 0u32 {
        g_sec_start_align = I32Array(4);
        var i_init: i32 = 0;
        while i_init < 4 { set(g_sec_start_align, i_init, 0); i_init = i_init + 1; }
    }
    return;
}
export fn asm_record_sec_align(sec: i32, n_bytes: i32) -> void {
    if sec < 0 || sec >= 4 { return; }
    ensure_sec_start_align();
    if get(g_sec_start_align, sec) == 0 {
        set(g_sec_start_align, sec, n_bytes);
    }
    return;
}
export fn asm_get_sec_align(sec: i32) -> i32 {
    if sec < 0 || sec >= 4 { return 0; }
    if g_sec_start_align as u32 == 0u32 { return 0; }
    return get(g_sec_start_align, sec);
}
var g_src_bytes:       i32 = 0;        // source byte count emitted by pass1 in the .lab so pass2 knows where each copy ends

// Label table. g_lab_names is a shared packed-byte pool that every
// Label's [name_off..name_off+name_len] slice points into; the Label
// struct itself holds per-entry metadata (R6). The old parallel
// arrays g_lab_offs / g_lab_lens / g_lab_addrs / g_lab_section /
// g_lab_is_bss were collapsed here; is_bss was dead anyway so we
// dropped it.
//
// 2026-04-30: bit-packed name_off + name_len + section into a single
// i32 to halve the per-entry kmalloc cost (struct went from 4 i32 +
// 4 B hdr = 20 B = 32 B bucket → 2 i32 + 4 B hdr = 12 B = 16 B
// bucket). For 3000+ labels in a self-host build this saves ~48 KB
// of asm_pass2/pass2 peak. Field widths:
//   name_off  18 bits (256 KB max — MAX_NAME_POOL is 96 KB so plenty)
//   name_len   8 bits (255 max — even mangled symbols stay under 80)
//   section    2 bits (0=text 1=rodata 2=data 3=bss)
struct Label {
    packed: i32,   // (name_off & 0x3FFFF) | ((name_len & 0xFF) << 18)
                   // | ((section & 0x3) << 26)
    addr:   i32,
}
var g_lab_names: U8Array = 0 as U8Array;      // packed name storage
var g_labels: LabelArray = 0 as LabelArray;
var g_nlabels: i32 = 0;
var g_lab_name_pos: i32 = 0;

// Label bit-pack helpers. The synthetic API only generates packed()
// and addr() getters/setters; these wrappers preserve the old
// name_off / name_len / section call shape so existing call sites
// don't need to know about the packing.
fn name_off(lb: Label) -> i32 { return packed(lb) & 0x3FFFF; }
fn name_len(lb: Label) -> i32 { return (packed(lb) >> 18) & 0xFF; }
fn section(lb: Label) -> i32 { return (packed(lb) >> 26) & 0x3; }
// Setter for section only (name_off/name_len never change after the
// label is first defined; section can flip when define_label hits a
// duplicate and rebinds it). Clears bits 26-27 by masking with the
// 26-bit max (~26-bit-set = 0x3FFFFFF) and ORs the new value in.
fn section(lb: Label, sec: i32) -> void {
    var p: i32 = packed(lb);
    packed(lb, (p & 0x3FFFFFF) | ((sec & 0x3) << 26));
    return;
}
fn make_label(noff: i32, nlen: i32, addrv: i32, sec: i32) -> Label {
    var p: i32 = (noff & 0x3FFFF)
               | ((nlen & 0xFF) << 18)
               | ((sec & 0x3) << 26);
    return Label(p, addrv);
}

// ===== Reference graph (for dead-strip) =====
//
// docs/task/asm_dead_strip.md Phase 1: while pass1 is reading source,
// each operand that names a defined symbol records a (from_idx →
// to_idx) edge in g_refs. The owner of the current line is tracked
// in g_owner_idx (updated on label define / section change). Forward
// refs (target not yet defined when ref is seen) are skipped here;
// they will need a 2nd source pass once the design lands. For now
// the graph is collected but not yet consumed.
//
// Encoding: each edge is one i32 = (from_idx << 16) | to_idx. With
// MAX_LABELS = 4096 (12 bits), 16 bits per id has plenty of margin.
// MAX_REFS = 8192 covers the runtime.s + crt0 self-host build with
// some headroom; if a future build trips it we'll bump or grow.
var MAX_REFS: i32 = 16384;
var g_refs: I32Array = 0 as I32Array;
var g_nrefs: i32 = 0;
var g_owner_idx: i32 = 0 - 1;  // -1 = no current owner (section root)

// Ref-collection gate: only the .idx emit path collects refs (so the
// per-file ref edges land in the dump). Stdin/host paths and the
// linker-mode walks bypass it entirely, dropping the O(N_labels)
// find_label cost that would otherwise turn pass 1a from 26 s to
// 56 s on pico2 just from register-name lookups failing.
var g_collecting_refs: i32 = 0;

// Deferred forward-ref queue. record_ref appends (owner, name) here
// when find_label fails (target not yet defined); resolve_deferred
// drains the queue after pass 1a once every label is in g_labels.
// Replaces the 2nd full source walk that the original Phase 3
// design used — same data, no SD round trip.
//
// Initial deferred-queue capacity; the arrays grow dynamically on
// overflow (record_def_ref doubles them via ensure_def_capacity).
// Starting small lets OS-side tasks (asm_pass1 / asm_pass2 with
// 288 KB arenas) avoid pre-allocating 4 × 64 KB arrays up-front.
var MAX_DEFERRED: i32 = 2048;
var g_def_capacity: i32 = 0;
var g_def_owner:    I32Array = 0 as I32Array;
var g_def_name_off: I32Array = 0 as I32Array;
var g_def_name_len: I32Array = 0 as I32Array;
var g_ndeferred: i32 = 0;
var g_def_pool: U8Array = 0 as U8Array;
var g_def_pool_pos: i32 = 0;
var DEF_POOL_INITIAL_KB: i32 = 4;

// Source-file paths emitted into the .lab as `src <path>` lines so
// asm-pass2 can open them directly instead of reading from stdin.
// Up to 2 entries (prelude + user_strip in the load-idx flow).
var g_src_path1: String = 0 as String;
export fn asm_set_src_path1(p: String) -> void { g_src_path1 = p; return; }

// Pre-encoded prelude paths (Step 5 of pre-encode). When set,
// asm_dump_lab_state replaces `src <g_src_path1>` (the prelude
// source line) with three `src raw` lines pointing to the
// pre-encoded section bins, and copies the contents of the
// prelude reloc file verbatim into the .lab.
var g_prelude_text_bin:   String = 0 as String;
var g_prelude_rodata_bin: String = 0 as String;
var g_prelude_data_bin:   String = 0 as String;
var g_prelude_reloc:      String = 0 as String;
export fn asm_set_prelude_text_bin(p: String)   -> void { g_prelude_text_bin   = p; return; }
export fn asm_set_prelude_rodata_bin(p: String) -> void { g_prelude_rodata_bin = p; return; }
export fn asm_set_prelude_data_bin(p: String)   -> void { g_prelude_data_bin   = p; return; }
export fn asm_set_prelude_reloc(p: String)      -> void { g_prelude_reloc      = p; return; }

// Pre-encoded user paths (Phase F of the asm split). When the linker
// has consumed user.idx + user.bin + user.reloc, asm_dump_lab_state
// emits three additional `src raw` lines (one per section, after the
// prelude raws) and copies user.reloc with each entry's offset shifted
// by g_user_text_shift so the offsets express section-absolute (post-
// concatenation) coordinates. Only the text section needs shifting in
// practice — every reloc kind asm_emit_reloc records is a text-section
// entry.
var g_user_text_bin:   String = 0 as String;
var g_user_rodata_bin: String = 0 as String;
var g_user_data_bin:   String = 0 as String;
var g_user_reloc:      String = 0 as String;
var g_user_text_shift: i32 = 0;
var g_user_text_start:   i32 = 0;
var g_user_rodata_start: i32 = 0;
var g_user_data_start:   i32 = 0;
export fn asm_set_user_text_bin(p: String)   -> void { g_user_text_bin   = p; return; }
export fn asm_set_user_rodata_bin(p: String) -> void { g_user_rodata_bin = p; return; }
export fn asm_set_user_data_bin(p: String)   -> void { g_user_data_bin   = p; return; }
export fn asm_set_user_reloc(p: String)      -> void { g_user_reloc      = p; return; }
export fn asm_set_user_text_shift(v: i32)    -> void { g_user_text_shift = v; return; }
export fn asm_set_user_text_start(v: i32)    -> void { g_user_text_start   = v; return; }
export fn asm_set_user_rodata_start(v: i32)  -> void { g_user_rodata_start = v; return; }
export fn asm_set_user_data_start(v: i32)    -> void { g_user_data_start   = v; return; }

// Additional link inputs beyond prelude (input 0) + user (input 1).
// Each entry corresponds to one extra `--add` flag in asm_pass2 --link
// invocations: an asm_pass1 output set (.idx + per-section .bin +
// .reloc) appended after `user` in the linker's input order. Section
// bytes concatenate in input order; relocs accumulate with per-input
// text-section shifts. Cap of 16 covers compile-gen2.sh's worst case
// (sh.tc-class user code + libtc + several import .s files).
var EXTRAS_CAP: i32 = 16;
var g_n_extras: i32 = 0;
var g_extra_idx:        StringArray = 0 as StringArray;
var g_extra_text_bin:   StringArray = 0 as StringArray;
var g_extra_rodata_bin: StringArray = 0 as StringArray;
var g_extra_data_bin:   StringArray = 0 as StringArray;
var g_extra_reloc:      StringArray = 0 as StringArray;
var g_extra_text_shift:   I32Array = 0 as I32Array;
var g_extra_text_start:   I32Array = 0 as I32Array;
var g_extra_rodata_start: I32Array = 0 as I32Array;
var g_extra_data_start:   I32Array = 0 as I32Array;
// Per-extra incbin record (2026-05-09). Captured from
// g_load_incbin_* after each asm_load_idx call by run_link_finish.
// emit_link_lab interleaves a `src raw <path> <sec>` line for each
// extra that has g_extra_incbin_present[i] == 1.
var g_extra_incbin_present:   I32Array    = 0 as I32Array;
var g_extra_incbin_sec:       I32Array    = 0 as I32Array;
var g_extra_incbin_intra_off: I32Array    = 0 as I32Array;
var g_extra_incbin_size:      I32Array    = 0 as I32Array;
var g_extra_incbin_path:      StringArray = 0 as StringArray;
fn ensure_extras_storage() -> void {
    if g_extra_idx as u32 == 0u32 {
        g_extra_idx        = StringArray((EXTRAS_CAP) as u32);
        g_extra_text_bin   = StringArray((EXTRAS_CAP) as u32);
        g_extra_rodata_bin = StringArray((EXTRAS_CAP) as u32);
        g_extra_data_bin   = StringArray((EXTRAS_CAP) as u32);
        g_extra_reloc      = StringArray((EXTRAS_CAP) as u32);
        g_extra_text_shift   = I32Array((EXTRAS_CAP) as u32);
        g_extra_text_start   = I32Array((EXTRAS_CAP) as u32);
        g_extra_rodata_start = I32Array((EXTRAS_CAP) as u32);
        g_extra_data_start   = I32Array((EXTRAS_CAP) as u32);
        g_extra_incbin_present   = I32Array((EXTRAS_CAP) as u32);
        g_extra_incbin_sec       = I32Array((EXTRAS_CAP) as u32);
        g_extra_incbin_intra_off = I32Array((EXTRAS_CAP) as u32);
        g_extra_incbin_size      = I32Array((EXTRAS_CAP) as u32);
        g_extra_incbin_path      = StringArray((EXTRAS_CAP) as u32);
    }
    return;
}
export fn asm_get_n_extras() -> i32 { return g_n_extras; }
export fn asm_extras_cap() -> i32 { return EXTRAS_CAP; }
// Append a new extra input. The shift / start values are filled in
// later by run_link as it walks the inputs through asm_load_idx.
export fn asm_add_extra_input(idx_path: String,
                              text_bin: String, rodata_bin: String,
                              data_bin: String, reloc: String) -> i32 {
    ensure_extras_storage();
    if g_n_extras >= EXTRAS_CAP { return 0 - 1; }
    set(g_extra_idx,        g_n_extras, idx_path);
    set(g_extra_text_bin,   g_n_extras, text_bin);
    set(g_extra_rodata_bin, g_n_extras, rodata_bin);
    set(g_extra_data_bin,   g_n_extras, data_bin);
    set(g_extra_reloc,      g_n_extras, reloc);
    set(g_extra_text_shift,   g_n_extras, 0);
    set(g_extra_text_start,   g_n_extras, 0);
    set(g_extra_rodata_start, g_n_extras, 0);
    set(g_extra_data_start,   g_n_extras, 0);
    set(g_extra_incbin_present,   g_n_extras, 0);
    set(g_extra_incbin_sec,       g_n_extras, 0);
    set(g_extra_incbin_intra_off, g_n_extras, 0);
    set(g_extra_incbin_size,      g_n_extras, 0);
    set(g_extra_incbin_path,      g_n_extras, 0 as String);
    var idx: i32 = g_n_extras;
    g_n_extras = g_n_extras + 1;
    return idx;
}
export fn asm_get_extra_idx(i: i32) -> String { return get(g_extra_idx, i); }
export fn asm_set_extra_text_shift(i: i32, v: i32) -> void {
    if i >= 0 && i < g_n_extras { set(g_extra_text_shift, i, v); }
    return;
}
export fn asm_set_extra_text_start(i: i32, v: i32) -> void {
    if i >= 0 && i < g_n_extras { set(g_extra_text_start, i, v); }
    return;
}
export fn asm_set_extra_rodata_start(i: i32, v: i32) -> void {
    if i >= 0 && i < g_n_extras { set(g_extra_rodata_start, i, v); }
    return;
}
export fn asm_set_extra_data_start(i: i32, v: i32) -> void {
    if i >= 0 && i < g_n_extras { set(g_extra_data_start, i, v); }
    return;
}
export fn asm_get_extra_text_bin(i: i32)   -> String { return get(g_extra_text_bin,   i); }
export fn asm_get_extra_rodata_bin(i: i32) -> String { return get(g_extra_rodata_bin, i); }
export fn asm_get_extra_data_bin(i: i32)   -> String { return get(g_extra_data_bin,   i); }
export fn asm_get_extra_reloc(i: i32)      -> String { return get(g_extra_reloc,      i); }
export fn asm_get_extra_text_shift(i: i32)   -> i32 { return get(g_extra_text_shift,   i); }
export fn asm_get_extra_text_start(i: i32)   -> i32 { return get(g_extra_text_start,   i); }
export fn asm_get_extra_rodata_start(i: i32) -> i32 { return get(g_extra_rodata_start, i); }
export fn asm_get_extra_data_start(i: i32)   -> i32 { return get(g_extra_data_start,   i); }

// Per-extra incbin accessors (2026-05-09 incbin-defer).
// run_link_finish copies g_load_incbin_* into these slots after
// each asm_load_idx; emit_link_lab inspects them when emitting the
// per-extra `src raw` lines.
export fn asm_set_extra_incbin(i: i32, present: i32, sec: i32, intra_off: i32, size: i32, path: String) -> void {
    if i >= 0 && i < g_n_extras {
        set(g_extra_incbin_present,   i, present);
        set(g_extra_incbin_sec,       i, sec);
        set(g_extra_incbin_intra_off, i, intra_off);
        set(g_extra_incbin_size,      i, size);
        set(g_extra_incbin_path,      i, path);
    }
    return;
}
export fn asm_get_extra_incbin_present(i: i32)   -> i32    { return get(g_extra_incbin_present,   i); }
export fn asm_get_extra_incbin_sec(i: i32)       -> i32    { return get(g_extra_incbin_sec,       i); }
export fn asm_get_extra_incbin_intra_off(i: i32) -> i32    { return get(g_extra_incbin_intra_off, i); }
export fn asm_get_extra_incbin_size(i: i32)      -> i32    { return get(g_extra_incbin_size,      i); }
export fn asm_get_extra_incbin_path(i: i32)      -> String { return get(g_extra_incbin_path,      i); }

// Reset state that varies per source pass so asm_pass2 can re-walk
// the source for a forward-ref second pass. Clears g_pos +
// section cursors + ref counter + owner; leaves g_labels and
// g_lab_names intact (define_label is idempotent on existing
// labels so re-walking doesn't grow them).
export fn asm_reset_for_ref_pass() -> void {
    g_pos              = 0;
    g_current_section  = 0;
    g_owner_idx        = 0 - 1;
    g_nrefs            = 0;
    set(g_sec_pos, 0, 0);
    set(g_sec_pos, 1, 0);
    set(g_sec_pos, 2, 0);
    set(g_sec_pos, 3, 0);
    return;
}

export fn asm_owner_idx() -> i32 { return g_owner_idx; }
export fn asm_current_section() -> i32 { return g_current_section; }
export fn asm_sec_pos(sec: i32) -> i32 { return get(g_sec_pos, sec); }
export fn asm_set_collecting_refs(v: i32) -> void {
    g_collecting_refs = v;
    if v != 0 { ensure_ref_state(); }
    return;
}

// Lazily allocate the ref + deferred-queue state. asm_init_common no
// longer pre-allocates these (~88 KB total) so pass 2 / stdin pass 1
// — neither of which collects refs — don't pay the cost. First
// asm_set_collecting_refs(1) wires it up.
fn ensure_ref_state() -> void {
    if g_refs as u32 != 0u32 { return; }
    g_refs         = I32Array((MAX_REFS) as u32);
    g_def_capacity = MAX_DEFERRED;
    g_def_owner    = I32Array((g_def_capacity) as u32);
    g_def_name_off = I32Array((g_def_capacity) as u32);
    g_def_name_len = I32Array((g_def_capacity) as u32);
    g_def_pool     = U8Array((DEF_POOL_INITIAL_KB * 1024) as u32);
    return;
}

// Grow the parallel deferred-queue arrays in place when full. record_def_ref
// calls this with the count it's about to write past — the arrays double
// (with a floor of MAX_DEFERRED) so the amortised overflow cost stays O(1).
fn grow_def_arrays() -> void {
    var new_cap: i32 = g_def_capacity * 2;
    if new_cap < MAX_DEFERRED { new_cap = MAX_DEFERRED; }
    var new_owner:    I32Array = I32Array((new_cap) as u32);
    var new_name_off: I32Array = I32Array((new_cap) as u32);
    var new_name_len: I32Array = I32Array((new_cap) as u32);
    var ci: i32 = 0;
    while ci < g_ndeferred {
        set(new_owner,    ci, get(g_def_owner,    ci));
        set(new_name_off, ci, get(g_def_name_off, ci));
        set(new_name_len, ci, get(g_def_name_len, ci));
        ci = ci + 1;
    }
    delete(g_def_owner);
    delete(g_def_name_off);
    delete(g_def_name_len);
    g_def_owner    = new_owner;
    g_def_name_off = new_name_off;
    g_def_name_len = new_name_len;
    g_def_capacity = new_cap;
    return;
}

// Grow the deferred name pool (dynamic, doubling) to fit `needed` bytes.
fn ensure_def_pool_capacity(needed: i32) -> void {
    var cap: i32 = len(g_def_pool);
    if needed <= cap { return; }
    var new_cap: i32 = cap * 2;
    if new_cap < needed { new_cap = needed; }
    var new_buf: U8Array = U8Array(new_cap as u32);
    var i: i32 = 0;
    while i < g_def_pool_pos {
        set(new_buf, i, get(g_def_pool, i));
        i = i + 1;
    }
    delete(g_def_pool);
    g_def_pool = new_buf;
    return;
}

// Return 1 if `name` is a RISC-V register ABI name (zero/ra/sp/gp/
// tp/fp, t0-t6, s0-s11, a0-a7) or x-form (x0..x31). The deferred
// forward-ref queue would otherwise fill up with reg-operand misses
// from scan_operand_refs (every instruction has 2-3 reg operands ×
// thousands of source lines).
fn is_riscv_register(name: U8Array, nlen: i32) -> i32 {
    if nlen < 2 || nlen > 4 { return 0; }
    var c0: u8 = get(name, 0);
    var c1: u8 = get(name, 1);

    // x0..x31
    if c0 == 'x' as u8 {
        if c1 < '0' as u8 || c1 > '9' as u8 { return 0; }
        if nlen == 2 { return 1; }
        if nlen == 3 {
            var c2: u8 = get(name, 2);
            if c2 < '0' as u8 || c2 > '9' as u8 { return 0; }
            return 1;
        }
        return 0;
    }

    // ra, sp, gp, tp, fp (2 chars)
    if nlen == 2 {
        if c0 == 'r' as u8 && c1 == 'a' as u8 { return 1; }
        if c0 == 's' as u8 && c1 == 'p' as u8 { return 1; }
        if c0 == 'g' as u8 && c1 == 'p' as u8 { return 1; }
        if c0 == 't' as u8 && c1 == 'p' as u8 { return 1; }
        if c0 == 'f' as u8 && c1 == 'p' as u8 { return 1; }
        // a0-a7, t0-t6, s0-s9 (single-digit)
        if c1 >= '0' as u8 && c1 <= '9' as u8 {
            if c0 == 'a' as u8 || c0 == 't' as u8 || c0 == 's' as u8 { return 1; }
        }
        return 0;
    }

    // s10, s11, t0-t6 (3 chars only valid for s10/s11)
    if nlen == 3 {
        if c0 == 's' as u8 && c1 == '1' as u8 {
            var d2: u8 = get(name, 2);
            if d2 == '0' as u8 || d2 == '1' as u8 { return 1; }
        }
        return 0;
    }

    // zero (4 chars)
    if nlen == 4 {
        if c0 == 'z' as u8 && c1 == 'e' as u8
           && get(name, 2) == 'r' as u8 && get(name, 3) == 'o' as u8 { return 1; }
    }
    return 0;
}

// Record a (from = g_owner_idx) → (to = name) edge. If the target
// is already in g_labels (backward ref) we resolve and append to
// g_refs immediately. If it's not yet defined (forward ref) we copy
// the name into g_def_pool and queue the (owner, off, len) tuple
// for resolve_deferred to pick up at end of pass 1a.
fn record_ref(name: U8Array, nlen: i32) -> void {
    if g_pass != 1 { return; }
    if g_collecting_refs == 0 { return; }
    if g_owner_idx < 0 { return; }
    var idx: i32 = find_label(name, nlen);
    if idx >= 0 {
        if g_nrefs >= MAX_REFS { return; }
        set(g_refs, g_nrefs, (g_owner_idx << 16) | (idx & 0xFFFF));
        g_nrefs = g_nrefs + 1;
        return;
    }
    // Register names dominate the operand stream (every instruction
    // has 1-3 reg operands × 11 K source lines on the self-host build
    // = ~20 K reg-name lookups). Without filtering, every miss
    // queues into g_def_*, blowing past MAX_DEFERRED in seconds.
    // Drop them here — they will never be in g_labels by the time
    // resolve_deferred runs either, so queueing was pure waste.
    if is_riscv_register(name, nlen) != 0 { return; }
    if g_ndeferred >= g_def_capacity {
        // Grow rather than abort — host self-host builds (compiler/
        // asm_pass2.tc, ~14 K cross-file refs) far exceed the
        // 2048-entry initial capacity.
        grow_def_arrays();
    }
    ensure_def_pool_capacity(g_def_pool_pos + nlen);
    var off: i32 = g_def_pool_pos;
    var i: i32 = 0;
    while i < nlen { set(g_def_pool, (off + i), get(name, i)); i = i + 1; }
    g_def_pool_pos = g_def_pool_pos + nlen;
    set(g_def_owner,    g_ndeferred, g_owner_idx);
    set(g_def_name_off, g_ndeferred, off);
    set(g_def_name_len, g_ndeferred, nlen);
    g_ndeferred = g_ndeferred + 1;
    return;
}

// Resolve every entry queued in the deferred-ref buffer and append
// the resolved edges to g_refs. Called once after pass 1a's source
// walk so every label is now in g_labels. By that time
// asm_finalize_labels() has built g_lab_hash, so each find_label
// is O(1) — the original 2-source-pass design's biggest cost was
// the linear find_label per operand, which this lifts.
export fn asm_resolve_deferred_refs() -> void {
    var d: i32 = 0;
    while d < g_ndeferred {
        var owner: i32  = get(g_def_owner, d);
        var off: i32    = get(g_def_name_off, d);
        var nlen: i32   = get(g_def_name_len, d);
        var tmp: U8Array = U8Array(nlen as u32);
        var i: i32 = 0;
        while i < nlen { set(tmp, i, get(g_def_pool, (off + i))); i = i + 1; }
        var idx: i32 = find_label(tmp, nlen);
        delete(tmp);
        if idx >= 0 {
            if g_nrefs < MAX_REFS {
                set(g_refs, g_nrefs, (owner << 16) | (idx & 0xFFFF));
                g_nrefs = g_nrefs + 1;
            }
        }
        d = d + 1;
    }
    g_ndeferred = 0;
    g_def_pool_pos = 0;
    return;
}

// Release the ref-graph + deferred-queue state. asm_pass1 calls this
// once per internal run() invocation when it doesn't need refs, so
// the ~88 KB don't add up across the three back-to-back runs.
export fn asm_release_ref_state() -> void {
    if g_refs as u32 != 0u32 {
        delete(g_refs);
        g_refs = 0 as I32Array;
    }
    if g_def_owner as u32 != 0u32 {
        delete(g_def_owner);
        g_def_owner = 0 as I32Array;
    }
    if g_def_name_off as u32 != 0u32 {
        delete(g_def_name_off);
        g_def_name_off = 0 as I32Array;
    }
    if g_def_name_len as u32 != 0u32 {
        delete(g_def_name_len);
        g_def_name_len = 0 as I32Array;
    }
    if g_def_pool as u32 != 0u32 {
        delete(g_def_pool);
        g_def_pool = 0 as U8Array;
    }
    g_nrefs = 0;
    g_ndeferred = 0;
    g_def_pool_pos = 0;
    return;
}

// Numeric labels (0:..9:). Split storage by digit because measured
// usage is wildly skewed: bc2asm.tc full.s has 373 `0:` defs and
// 0-1 across the other 9 digits; asm_pass2.tc itself reaches >512
// for digit 0 (which is why NUM_LAB_PER_DIGIT can't drop). Putting
// every digit on the same flat 1024 stride wasted 9 × 1020 entries.
// Now: digit 0 → g_numlab_zero (1024 entries), digits 1-9 →
// g_numlab_other (NUMLAB_OTHER_PER_DIGIT entries each, base
// (digit-1) × stride). Saves ~32 KB peak on asm_pass2/asm_pass3.
var NUMLAB_OTHER_PER_DIGIT: i32 = 64;  // digits 1-9 — each almost
                                       // never gets more than a
                                       // handful in real source
var g_numlab_zero:  I32Array = 0 as I32Array;
var g_numlab_other: I32Array = 0 as I32Array;
var g_numlab_count: I32Array = 0 as I32Array;  // count per digit (10 entries)

// numlab_capacity / numlab_get / numlab_set: digit-aware accessors.
// `define_numlab` and `find_numlab*` go through these so the split
// storage is invisible to callers.
fn numlab_capacity(digit: i32) -> i32 {
    if digit == 0 { return NUM_LAB_PER_DIGIT; }
    return NUMLAB_OTHER_PER_DIGIT;
}
fn numlab_get(digit: i32, idx: i32) -> i32 {
    if digit == 0 { return get(g_numlab_zero, idx); }
    return get(g_numlab_other, (digit - 1) * NUMLAB_OTHER_PER_DIGIT + idx);
}
fn numlab_set(digit: i32, idx: i32, val: i32) -> void {
    if digit == 0 { set(g_numlab_zero, idx, val); return; }
    set(g_numlab_other, (digit - 1) * NUMLAB_OTHER_PER_DIGIT + idx, val);
    return;
}

// Per-line parse state. Each call to asm_process_line copies the
// caller's line into g_line_buf, sets g_line_buf_len, then runs the
// tokenizer. The asm split eliminates the old g_lines / g_line_offs
// / g_line_lens / g_line_section caches (4 MB peak in single-process
// asm.tc) — pass1 and pass2 both stream-read the source line by line
// from their stdin instead.
var g_mnem: U8Array = 0 as U8Array;  // mnemonic buffer (64 bytes)
var g_mnem_len: i32 = 0;
var g_ops: I32Array = 0 as I32Array;  // operand offsets into line (4 entries x 2: off, len)
var g_nops: i32 = 0;
var g_line_buf: U8Array = 0 as U8Array; // current line buffer (4096 bytes)
var g_line_buf_len: i32 = 0;
// 1-origin line number of the line process_line is currently handling.
// Used by asm_err_* so error messages can say "asm:<line>: ..." and
// echo the source line. 0 means "no specific line" (e.g. a failure
// during write_elf after both passes complete).
var g_cur_line: i32 = 0;

// ===== Error reporting =====
//
// Usage pattern for each failure site:
//   var eb: StringBuffer = StringBuffer_new();
//   asm_err_begin(eb);
//   emit_string(eb, "undefined label '");
//   emit_n(eb, name, 0, nlen);
//   emit_string(eb, "'");
//   asm_err_end(eb);   // writes, destroys, exits — never returns
//
// Output format:
//   asm:<line>: <your message>
//     at: <verbatim source line>
export fn asm_err_begin(eb: StringBuffer) -> void {
    emit_string(eb, "asm:");
    if g_cur_line > 0 { emit_int(eb, g_cur_line); }
    emit_string(eb, ": ");
    return;
}
export fn asm_err_end(eb: StringBuffer) -> void {
    if g_cur_line > 0 {
        emit_string(eb, "\n  at: ");
        emit_n(eb, g_line_buf, 0, g_line_buf_len);
    }
    emit_string(eb, "\n");
    write(eb, 2);
    destroy(eb);
    sys_exit(1);
    return;
}

// ===== Emit helpers =====
//
// Stream-mode output buffer flush. Writes g_out_buf[0..g_out_pos] to
// stdout (fd 1) and resets g_out_pos to 0. Called from emit_stream
// when the buffer fills and from asm_flush_output at section end.
fn flush_out_buf() -> void {
    if g_out_pos > 0 {
        sys_write(g_out_fd, g_out_buf, g_out_pos);
        g_out_pos = 0;
    }
    return;
}

// Stream-mode byte emit: append one byte to g_out_buf. Called only
// when g_current_section == g_target_section and g_pass == 2.
fn emit_stream(v: i32) -> void {
    if g_out_pos >= g_out_buf_size { flush_out_buf(); }
    set(g_out_buf, g_out_pos, v as u8);
    g_out_pos = g_out_pos + 1;
    g_section_emitted = g_section_emitted + 1;
    return;
}

fn emit8(v: i32) -> void {
    if g_pass == 2 {
        if g_stream_mode == 1 {
            if g_current_section == g_target_section {
                emit_stream(v);
            }
        } else {
            if g_pos < g_code_size {
                set(g_code, g_pos, v as u8);
                if g_pos >= g_code_end { g_code_end = g_pos + 1; }
            }
        }
    }
    g_pos = g_pos + 1;
    return;
}

fn emit32(v: i32) -> void {
    emit8(v & 255);
    emit8((v >> 8) & 255);
    emit8((v >> 16) & 255);
    emit8((v >> 24) & 255);
    return;
}

fn align_to(n: i32) -> void {
    while g_pos % n != 0 { emit8(0); }
    return;
}

// ===== Label management =====
fn lab_name_eq(idx: i32, name: U8Array, nlen: i32) -> bool {
    var lb: Label = get(g_labels, idx);
    if name_len(lb) != nlen { return false; }
    var off: i32 = name_off(lb);
    var i: i32 = 0;
    while i < nlen {
        if get(g_lab_names, (off + i)) != get(name, i) { return false; }
        i = i + 1;
    }
    return true;
}

// Hash table over g_labels, populated on demand by asm_finalize_labels.
// g_lab_hash holds "label index + 1" (0 = empty slot). Linear probing.
//
// 2026-04-30: sized dynamically at finalize time to next-power-of-2
// ≥ 2 × g_nlabels, with a min of 64. For inputs with few labels
// (hello.tc has 3, bc2asm.tc has 944) the table now allocates 8 / 2048
// slots instead of always burning a fixed 32 KB. The 50% load factor
// keeps linear-probe runs short.
var g_lab_hash_size: i32 = 0;
var g_lab_hash_mask: i32 = 0;
var g_lab_hash:      I32Array = 0 as I32Array;
var g_lab_hash_ok:   i32 = 0;

fn lab_hash_name(buf: U8Array, off: i32, nlen: i32) -> i32 {
    var h: i32 = 0;
    var i: i32 = 0;
    while i < nlen {
        h = (h * 31) + (get(buf, off + i) as i32);
        i = i + 1;
    }
    return h & g_lab_hash_mask;
}

fn lab_hash_name(buf: U8Array, nlen: i32) -> i32 {
    var h: i32 = 0;
    var i: i32 = 0;
    while i < nlen {
        h = (h * 31) + (get(buf, i) as i32);
        i = i + 1;
    }
    return h & g_lab_hash_mask;
}

// Build g_lab_hash from the current g_labels contents. Called once
// after the .lab has been fully loaded in pass 2; pass 1's
// define_label still uses the linear search because it accumulates
// labels incrementally. This turns pass 2's per-reference find_label
// from O(n_labels) into O(1) amortised — measured 18 M comparisons
// on the self-host build.
// Idempotent variant of asm_finalize_labels: returns immediately if
// the hash is already built. Callers that may run before or after
// finalize use this — e.g., asm_pass3's `reloc` line handler wants
// O(1) find_label for the resolve, but asm_pass3's lab parser also
// calls asm_finalize_labels at end-of-parse for the encoder.
export fn asm_ensure_labels_finalized() -> void {
    if g_lab_hash_ok != 0 { return; }
    asm_finalize_labels();
    return;
}

export fn asm_finalize_labels() -> void {
    // Size to next power of 2 ≥ 2 × g_nlabels (50% load factor),
    // with a minimum of 64 to handle pathologically small inputs
    // without dividing by zero in the mask.
    var want: i32 = g_nlabels * 2;
    if want < 64 { want = 64; }
    var sz: i32 = 1;
    while sz < want { sz = sz * 2; }
    g_lab_hash_size = sz;
    g_lab_hash_mask = sz - 1;
    g_lab_hash = I32Array(sz as u32);
    var i: i32 = 0;
    while i < g_lab_hash_size {
        set(g_lab_hash, i, 0);
        i = i + 1;
    }
    i = 0;
    while i < g_nlabels {
        var lb: Label = get(g_labels, i);
        var noff: i32 = name_off(lb);
        var nlen: i32 = name_len(lb);
        var h: i32 = lab_hash_name(g_lab_names, noff, nlen);
        while get(g_lab_hash, h) != 0 {
            h = (h + 1) & g_lab_hash_mask;
        }
        set(g_lab_hash, h, i + 1);
        i = i + 1;
    }
    g_lab_hash_ok = 1;
    return;
}

fn find_label(name: U8Array, nlen: i32) -> i32 {
    if g_lab_hash_ok == 1 {
        var h: i32 = lab_hash_name(name, nlen);
        while get(g_lab_hash, h) != 0 {
            var idx: i32 = get(g_lab_hash, h) - 1;
            if lab_name_eq(idx, name, nlen) { return idx; }
            h = (h + 1) & g_lab_hash_mask;
        }
        return 0 - 1;
    }
    var i: i32 = 0;
    while i < g_nlabels {
        if lab_name_eq(i, name, nlen) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Pre-allocate the name pool to a target size. Callers that know
// they need a large pool (asm_pass2 --link merging many inputs)
// invoke this right after asm_init_pass1 to skip the gradual grow
// churn — those grows otherwise fragment the arena and the final
// big grow OOMs even when total free space would fit it.
export fn asm_preallocate_name_pool(target_bytes: i32) -> void {
    ensure_name_pool_capacity(target_bytes);
    return;
}

// Grow g_lab_names to hold at least `needed` bytes. Doubles the
// existing capacity each time, so amortised cost is O(1) per byte.
// Replaces the old fixed-cap design — there's no upper bound now;
// memory is bounded only by the task arena.
fn ensure_name_pool_capacity(needed: i32) -> void {
    var cap: i32 = len(g_lab_names);
    if needed <= cap { return; }
    var new_cap: i32 = cap * 2;
    if new_cap < needed { new_cap = needed; }
    var new_buf: U8Array = U8Array(new_cap as u32);
    var i: i32 = 0;
    while i < g_lab_name_pos {
        set(new_buf, i, get(g_lab_names, i));
        i = i + 1;
    }
    delete(g_lab_names);
    g_lab_names = new_buf;
    return;
}

fn define_label(name: U8Array, nlen: i32, addr: i32) -> void {
    var idx: i32 = find_label(name, nlen);
    if idx < 0 {
        if g_nlabels >= MAX_LABELS {
            var eb: StringBuffer = StringBuffer_new();
            asm_err_begin(eb);
            emit_string(eb, "label table full: MAX_LABELS=");
            emit_int(eb, MAX_LABELS);
            emit_string(eb, " reached (at '");
            emit_n(eb, name, 0, nlen);
            emit_string(eb, "')");
            asm_err_end(eb);
        }
        ensure_name_pool_capacity(g_lab_name_pos + nlen);
        idx = g_nlabels;
        g_nlabels = g_nlabels + 1;
        var noff: i32 = g_lab_name_pos;
        var i: i32 = 0;
        while i < nlen {
            set(g_lab_names, (g_lab_name_pos + i), get(name, i));
            i = i + 1;
        }
        g_lab_name_pos = g_lab_name_pos + nlen;
        set(g_labels, idx, make_label(noff, nlen, addr, g_current_section));
    } else {
        var lb: Label = get(g_labels, idx);
        addr(lb, addr);
        section(lb, g_current_section);
    }
    // Dead-strip Phase 1 owner update: bytes emitted between this
    // label and the next become this label's. EXCEPT for compiler-
    // emitted local labels of the form `.L_FNAME_pcN` (bc2asm prefix)
    // — those are intra-function jump targets, semantically part of
    // their containing function. Keeping the previous owner means
    // when FNAME is live, the bytes (and the local label itself)
    // ride along instead of needing their own ref edges.
    var is_local: i32 = 0;
    if nlen >= 3 {
        if get(name, 0) == '.' as u8 {
            if get(name, 1) == 'L' as u8 {
                if get(name, 2) == '_' as u8 { is_local = 1; }
            }
        }
    }
    if is_local == 0 { g_owner_idx = idx; }
    return;
}

fn label_addr(name: U8Array, nlen: i32) -> i32 {
    var idx: i32 = find_label(name, nlen);
    if idx < 0 {
        // In undef-reloc mode the encoder emitted a reloc + placeholder
        // at this site, so silently return 0 here. Without the flag,
        // an undefined ref is still a hard error.
        if g_emit_undef_relocs != 0 { return 0; }
        var eb: StringBuffer = StringBuffer_new();
        asm_err_begin(eb);
        emit_string(eb, "undefined label '");
        emit_n(eb, name, 0, nlen);
        emit_string(eb, "'");
        asm_err_end(eb);
    }
    return addr(get(g_labels, idx));
}

// ===== Numeric label support =====
fn define_numlab(digit: i32, addr: i32) -> void {
    var cnt: i32 = get(g_numlab_count, digit);
    var cap: i32 = numlab_capacity(digit);
    if cnt >= cap {
        var eb: StringBuffer = StringBuffer_new();
        asm_err_begin(eb);
        emit_string(eb, "numlab overflow: digit ");
        emit_int(eb, digit);
        emit_string(eb, " exceeded capacity (");
        emit_int(eb, cap);
        emit_string(eb, ")");
        asm_err_end(eb);
    }
    numlab_set(digit, cnt, addr);
    set(g_numlab_count, digit, cnt + 1);
    return;
}

// Nb: backward reference — last definition at or before current pc
fn numlab_miss(digit: i32, dir: u8) -> void {
    var eb: StringBuffer = StringBuffer_new();
    asm_err_begin(eb);
    emit_string(eb, "undefined numeric label '");
    emit_int(eb, digit);
    emit_char(eb, dir);
    emit_string(eb, "'");
    asm_err_end(eb);
    return;
}

fn numlab_back(digit: i32, pc: i32) -> i32 {
    var cnt: i32 = get(g_numlab_count, digit);
    var i: i32 = cnt - 1;
    while i >= 0 {
        var addr: i32 = numlab_get(digit, i);
        if addr <= pc { return addr; }
        i = i - 1;
    }
    numlab_miss(digit, 'b');
    return 0;
}

// Nf: forward reference — first definition after current pc
fn numlab_fwd(digit: i32, pc: i32) -> i32 {
    var cnt: i32 = get(g_numlab_count, digit);
    var i: i32 = 0;
    while i < cnt {
        var addr: i32 = numlab_get(digit, i);
        if addr > pc { return addr; }
        i = i + 1;
    }
    numlab_miss(digit, 'f');
    return 0;
}

// ===== Register parser =====
fn reg_eq(s: U8Array, off: i32, len: i32, name: StringLiteral) -> bool {
    var nlen: i32 = len(name);
    if len != nlen { return false; }
    var i: i32 = 0;
    while i < len {
        if get(s, (off + i)) != get(name, i) { return false; }
        i = i + 1;
    }
    return true;
}

// Parse register from a NUL-separated buffer position.
// Reads g_line_buf and operand offsets.
fn parse_reg_op(op_idx: i32) -> i32 {
    var off: i32 = get(g_ops, (op_idx * 2));
    var len: i32 = get(g_ops, (op_idx * 2 + 1));
    // Skip leading whitespace
    while len > 0 && (get(g_line_buf, off) == ' ' || get(g_line_buf, off) == 9u8) {
        off = off + 1; len = len - 1;
    }
    // Strip trailing comma, paren, space
    var stripping: i32 = 1;
    while len > 0 && stripping == 1 {
        var last: u8 = get(g_line_buf, (off + len - 1));
        if last == ',' || last == ')' || last == '(' || last == ' ' || last == 9u8 {
            len = len - 1;
        } else {
            stripping = 0;
        }
    }
    // Match register names. Direct char-level dispatch — avoids the
    // ~32 reg_eq calls (with their per-call StringLiteral length
    // probe + byte-compare loop) that the linear cascade did. Each
    // case here is a few inline byte checks so the common path is a
    // handful of cycles.
    if len < 2 || len > 4 { return 0 - 1; }
    var c0: u8 = get(g_line_buf, off);
    var c1: u8 = get(g_line_buf, (off + 1));

    // x<digit>[<digit>] — RISC-V x-form (x0..x31).
    if c0 == 'x' as u8 {
        if c1 < '0' as u8 || c1 > '9' as u8 { return 0 - 1; }
        if len == 2 { return c1 as i32 - 48; }
        if len == 3 {
            var c2: u8 = get(g_line_buf, (off + 2));
            if c2 < '0' as u8 || c2 > '9' as u8 { return 0 - 1; }
            var n: i32 = (c1 as i32 - 48) * 10 + (c2 as i32 - 48);
            if n > 31 { return 0 - 1; }
            return n;
        }
        return 0 - 1;
    }

    // Length-2 ABI names.
    if len == 2 {
        if c0 == 'r' as u8 && c1 == 'a' as u8 { return 1; }
        if c0 == 's' as u8 && c1 == 'p' as u8 { return 2; }
        if c0 == 'g' as u8 && c1 == 'p' as u8 { return 3; }
        if c0 == 't' as u8 && c1 == 'p' as u8 { return 4; }
        if c0 == 'f' as u8 && c1 == 'p' as u8 { return 8; }  // fp = s0
        // a0..a7 → 10..17
        if c0 == 'a' as u8 && c1 >= '0' as u8 && c1 <= '7' as u8 {
            return 10 + (c1 as i32 - 48);
        }
        // t0..t6 → 5,6,7,28,29,30,31
        if c0 == 't' as u8 && c1 >= '0' as u8 && c1 <= '6' as u8 {
            var d: i32 = c1 as i32 - 48;
            if d <= 2 { return 5 + d; }
            return 25 + d;  // t3=28, t4=29, t5=30, t6=31
        }
        // s0..s9 → 8, 9, 18..25
        if c0 == 's' as u8 && c1 >= '0' as u8 && c1 <= '9' as u8 {
            var ds: i32 = c1 as i32 - 48;
            if ds == 0 { return 8; }
            if ds == 1 { return 9; }
            return 16 + ds;  // s2=18 .. s9=25
        }
        return 0 - 1;
    }

    // Length-3: s10, s11.
    if len == 3 {
        if c0 == 's' as u8 && c1 == '1' as u8 {
            var c2s: u8 = get(g_line_buf, (off + 2));
            if c2s == '0' as u8 { return 26; }
            if c2s == '1' as u8 { return 27; }
        }
        return 0 - 1;
    }

    // Length-4: zero.
    if c0 == 'z' as u8 && c1 == 'e' as u8 &&
       get(g_line_buf, (off + 2)) == 'r' as u8 &&
       get(g_line_buf, (off + 3)) == 'o' as u8 {
        return 0;
    }
    return 0 - 1;
}

// ===== Parse immediate from operand =====
// Parse %hi(label) or %hi(label+offset)
fn parse_hilo(off: i32, len: i32, is_hi: i32) -> i32 {
    // Skip "%hi(" or "%lo(" prefix (4 chars)
    off = off + 4; len = len - 4;
    // Strip trailing ')'
    if len > 0 && get(g_line_buf, (off + len - 1)) == ')' { len = len - 1; }
    // Check for label+offset
    var plus_pos: i32 = 0 - 1;
    var i: i32 = 0;
    while i < len {
        if get(g_line_buf, (off + i)) == '+' { plus_pos = i; i = len; }
        else { i = i + 1; }
    }
    var label_len: i32 = len;
    var add_offset: i32 = 0;
    if plus_pos >= 0 {
        label_len = plus_pos;
        // Parse offset after '+'
        var ostart: i32 = off + plus_pos + 1;
        var olen: i32 = len - plus_pos - 1;
        var ov: i32 = 0;
        while olen > 0 {
            var c: u8 = get(g_line_buf, ostart);
            if c >= '0' && c <= '9' { ov = ov * 10 + (c as i32 - 48); }
            ostart = ostart + 1; olen = olen - 1;
        }
        add_offset = ov;
    }
    var tmp: U8Array = U8Array((label_len) as u32);
    i = 0;
    while i < label_len { set(tmp, i, get(g_line_buf, (off + i))); i = i + 1; }
    var addr: i32 = 0;
    if g_pass == 2 { addr = label_addr(tmp, label_len) + add_offset; }
    delete(tmp);
    if is_hi == 1 { return hi20(addr); }
    return lo12(addr);
}

fn parse_imm_op(op_idx: i32) -> i32 {
    var off: i32 = get(g_ops, (op_idx * 2));
    var len: i32 = get(g_ops, (op_idx * 2 + 1));
    while len > 0 && (get(g_line_buf, off) == ' ' || get(g_line_buf, off) == 9u8) {
        off = off + 1; len = len - 1;
    }
    // Check for %hi(label) or %lo(label)
    if len >= 4 && get(g_line_buf, off) == '%' {
        if get(g_line_buf, (off+1)) == 'h' && get(g_line_buf, (off+2)) == 'i' && get(g_line_buf, (off+3)) == '(' {
            return parse_hilo(off, len, 1);
        }
        if get(g_line_buf, (off+1)) == 'l' && get(g_line_buf, (off+2)) == 'o' && get(g_line_buf, (off+3)) == '(' {
            return parse_hilo(off, len, 0);
        }
    }
    var neg: i32 = 0;
    if len > 0 && get(g_line_buf, off) == '-' { neg = 1; off = off + 1; len = len - 1; }
    var v: i32 = 0;
    if len >= 2 && get(g_line_buf, off) == '0' && (get(g_line_buf, (off+1)) == 'x' || get(g_line_buf, (off+1)) == 'X') {
        off = off + 2; len = len - 2;
        while len > 0 {
            var c: u8 = get(g_line_buf, off);
            if c >= '0' && c <= '9' { v = v * 16 + (c as i32 - 48); }
            else if c >= 'a' && c <= 'f' { v = v * 16 + (c as i32 - 87); }
            else if c >= 'A' && c <= 'F' { v = v * 16 + (c as i32 - 55); }
            off = off + 1; len = len - 1;
        }
    } else {
        while len > 0 {
            var c: u8 = get(g_line_buf, off);
            if c >= '0' && c <= '9' { v = v * 10 + (c as i32 - 48); }
            off = off + 1; len = len - 1;
        }
    }
    if neg == 1 { v = 0 - v; }
    return v;
}

// Parse label name from operand, return address
fn parse_label_op(op_idx: i32) -> i32 {
    var off: i32 = get(g_ops, (op_idx * 2));
    var len: i32 = get(g_ops, (op_idx * 2 + 1));
    while len > 0 && (get(g_line_buf, off) == ' ' || get(g_line_buf, off) == 9u8) {
        off = off + 1; len = len - 1;
    }
    // Check for numeric label reference: Nb or Nf
    if len == 2 && is_digit(get(g_line_buf, off)) {
        // Pass 1: numeric labels are per-function local jumps that
        // don't affect the dead-strip ref graph; bypass the table
        // lookup (which would error on undefined-yet-forward refs).
        if g_pass == 1 { return 0; }
        var digit: i32 = get(g_line_buf, off) as i32 - 48;
        var dir: u8 = get(g_line_buf, (off + 1));
        var pc: i32 = g_pos;
        if dir == 'b' { return numlab_back(digit, pc); }
        if dir == 'f' { return numlab_fwd(digit, pc); }
    }
    // Named label
    var tmp: U8Array = U8Array((len) as u32);
    var i: i32 = 0;
    while i < len { set(tmp, i, get(g_line_buf, (off + i))); i = i + 1; }
    var addr: i32 = 0;
    if g_pass == 2 { addr = label_addr(tmp, len); }
    delete(tmp);
    return addr;
}

// Dead-strip Phase 1: walk every operand of the current line and
// record (g_owner_idx → find_label(operand)) for operands that name
// an already-defined symbol. Register names ("a0", "ra"), immediates
// ("100", "-32"), and numeric labels ("0f", "0b") naturally short-
// circuit because find_label returns -1 for them. Forward refs are
// missed for now (target not yet defined when seen) — Phase 3 adds a
// second source pass to resolve those.
fn pass1_scan_operand_refs() -> void {
    if g_pass != 1 { return; }
    if g_collecting_refs == 0 { return; }
    if g_owner_idx < 0 { return; }
    var i: i32 = 0;
    while i < g_nops {
        var off: i32 = get(g_ops, (i * 2));
        var len: i32 = get(g_ops, (i * 2 + 1));
        while len > 0 && (get(g_line_buf, off) == ' ' || get(g_line_buf, off) == 9u8) {
            off = off + 1; len = len - 1;
        }
        if len > 0 {
            var c0: u8 = get(g_line_buf, off);
            // Skip operands that obviously aren't symbol names: digits,
            // signs, and quote-delimited strings.
            if !(c0 >= '0' && c0 <= '9') && c0 != '-' && c0 != '"' {
                var tmp: U8Array = U8Array((len) as u32);
                var j: i32 = 0;
                while j < len { set(tmp, j, get(g_line_buf, (off + j))); j = j + 1; }
                record_ref(tmp, len);
                delete(tmp);
            }
        }
        i = i + 1;
    }
    return;
}

// Emit `reloc <offset> <kind> <name>\n` to g_reloc_fd. `op_idx` selects
// which operand to read the name from (the label being referenced).
// Used by asm_pass3 in --emit-bin mode to record PC-relative slots
// that need patching at link/load time when the prelude is reused
// in front of differently-sized user code.
export fn asm_emit_reloc(offset: i32, kind: i32, op_idx: i32) -> void {
    if g_reloc_fd <= 0 { return; }
    var noff: i32 = get(g_ops, (op_idx * 2));
    var nlen: i32 = get(g_ops, (op_idx * 2 + 1));
    while nlen > 0 && (get(g_line_buf, noff) == ' ' || get(g_line_buf, noff) == 9u8) {
        noff = noff + 1; nlen = nlen - 1;
    }
    // Buffer sized for "reloc <off> <kind> <name>\n". 256 covers
    // mangled names up to ~240 chars (run_link__String × 11 = 104,
    // headroom for further-overloaded fns).
    var buf: U8Array = U8Array(256);
    var p: i32 = 0;
    set(buf, p, 'r' as u8); p = p + 1;
    set(buf, p, 'e' as u8); p = p + 1;
    set(buf, p, 'l' as u8); p = p + 1;
    set(buf, p, 'o' as u8); p = p + 1;
    set(buf, p, 'c' as u8); p = p + 1;
    set(buf, p, ' ' as u8); p = p + 1;
    var v1: i32 = offset;
    if v1 == 0 { set(buf, p, '0' as u8); p = p + 1; }
    else {
        var n1: i32 = 0; var t1: i32 = v1;
        while t1 > 0 { n1 = n1 + 1; t1 = t1 / 10; }
        var i1: i32 = n1 - 1;
        while i1 >= 0 {
            set(buf, p + i1, (48 + (v1 % 10)) as u8);
            v1 = v1 / 10;
            i1 = i1 - 1;
        }
        p = p + n1;
    }
    set(buf, p, ' ' as u8); p = p + 1;
    set(buf, p, (48 + kind) as u8); p = p + 1;
    set(buf, p, ' ' as u8); p = p + 1;
    var k: i32 = 0;
    while k < nlen { set(buf, p, get(g_line_buf, noff + k)); p = p + 1; k = k + 1; }
    set(buf, p, 10u8); p = p + 1;
    sys_write(g_reloc_fd, buf, p);
    delete(buf);
    g_reloc_count = g_reloc_count + 1;
    return;
}

// Return 1 if the operand at op_idx matches one of the externally-
// resolved symbols whose call/la slot the prelude pre-encode mode
// records in the .reloc table. The hard-coded sym indices (instead
// of a StringLiteral parameter) avoid a tcheck overload-resolution
// regression that produces `?`-typed annotations on int literals
// when this file is compiled with a `pat: StringLiteral` overload
// in scope.
//   sym=0 → "main"               (4 bytes)
//   sym=1 → "main__StringArray"  (17 bytes)
//   sym=2 → "__global_pointer$"  (17 bytes)
fn asm_label_is_extern(op_idx: i32, sym: i32) -> i32 {
    var off: i32 = get(g_ops, (op_idx * 2));
    var nlen: i32 = get(g_ops, (op_idx * 2 + 1));
    while nlen > 0 && (get(g_line_buf, off) == ' ' || get(g_line_buf, off) == 9u8) {
        off = off + 1; nlen = nlen - 1;
    }
    if sym == 0 {
        if nlen != 4 { return 0; }
        if get(g_line_buf, off    ) != 'm' as u8 { return 0; }
        if get(g_line_buf, off + 1) != 'a' as u8 { return 0; }
        if get(g_line_buf, off + 2) != 'i' as u8 { return 0; }
        if get(g_line_buf, off + 3) != 'n' as u8 { return 0; }
        return 1;
    }
    if sym == 1 {
        if nlen != 17 { return 0; }
        if get(g_line_buf, off    ) != 'm' as u8 { return 0; }
        if get(g_line_buf, off + 1) != 'a' as u8 { return 0; }
        if get(g_line_buf, off + 2) != 'i' as u8 { return 0; }
        if get(g_line_buf, off + 3) != 'n' as u8 { return 0; }
        if get(g_line_buf, off + 4) != '_' as u8 { return 0; }
        if get(g_line_buf, off + 5) != '_' as u8 { return 0; }
        if get(g_line_buf, off + 6) != 'S' as u8 { return 0; }
        return 1;
    }
    if sym == 2 {
        if nlen != 17 { return 0; }
        if get(g_line_buf, off    ) != '_' as u8 { return 0; }
        if get(g_line_buf, off + 1) != '_' as u8 { return 0; }
        if get(g_line_buf, off + 2) != 'g' as u8 { return 0; }
        if get(g_line_buf, off + 3) != 'l' as u8 { return 0; }
        if get(g_line_buf, off + 16) != '$' as u8 { return 0; }
        return 1;
    }
    return 0;
}

// Return 1 if operand op_idx names a label that the link step needs
// to (re)resolve — either undefined locally, or a globally-visible
// symbol (function name / extern data label) that another input
// might override last-wins. Local-style names — bc2asm-emitted
// `.L_*` jump targets and numeric `Nb`/`Nf` refs — short-circuit to
// 0 because they are always intra-function and never participate in
// cross-file overrides. Digits / sign also short-circuit (operand is
// an immediate, not a symbol). Used by the encoder when
// g_emit_undef_relocs is on; the matching reloc handler in
// asm_pass3 patches with the merged-symbol address (same as encoded
// when there's no override → byte-identical, else repatched).
fn label_op_undefined(op_idx: i32) -> i32 {
    var off: i32 = get(g_ops, (op_idx * 2));
    var len: i32 = get(g_ops, (op_idx * 2 + 1));
    while len > 0 && (get(g_line_buf, off) == ' ' || get(g_line_buf, off) == 9u8) {
        off = off + 1; len = len - 1;
    }
    if len <= 0 { return 0; }
    var c0: u8 = get(g_line_buf, off);
    // Numeric label refs (Nb / Nf) — always intra-function, never reloc.
    if len == 2 && is_digit(c0) {
        var dir: u8 = get(g_line_buf, off + 1);
        if dir == 'b' || dir == 'f' { return 0; }
    }
    // Digits / sign — immediate operand, not a symbol.
    if (c0 >= '0' && c0 <= '9') || c0 == '-' { return 0; }
    // bc2asm-emitted local jump targets (`.L_*`) — intra-function
    // only, never overridden across inputs.
    if c0 == '.' { return 0; }
    // Anything else is a globally-visible name — promote to a reloc
    // so the link step can apply last-wins overrides.
    return 1;
}

// Return the section id of the label referenced by operand op_idx,
// or 0 (SEC_TEXT) for numeric labels and unknown labels.
fn parse_label_op_section(op_idx: i32) -> i32 {
    var off: i32 = get(g_ops, (op_idx * 2));
    var len: i32 = get(g_ops, (op_idx * 2 + 1));
    while len > 0 && (get(g_line_buf, off) == ' ' || get(g_line_buf, off) == 9u8) {
        off = off + 1; len = len - 1;
    }
    if len == 2 && is_digit(get(g_line_buf, off)) { return 0; }
    var tmp: U8Array = U8Array((len) as u32);
    var i: i32 = 0;
    while i < len { set(tmp, i, get(g_line_buf, (off + i))); i = i + 1; }
    var idx: i32 = find_label(tmp, len);
    delete(tmp);
    if idx < 0 { return 0; }
    return section(get(g_labels, idx));
}

// Parse memory operand "offset(reg)" — returns offset and sets reg via op_idx+1
fn parse_mem_off(op_idx: i32) -> i32 {
    var off: i32 = get(g_ops, (op_idx * 2));
    var len: i32 = get(g_ops, (op_idx * 2 + 1));
    // Find LAST '(' (handles %lo(label)(reg) pattern)
    var paren: i32 = 0;
    var i: i32 = len - 1;
    while i >= 0 {
        if get(g_line_buf, (off + i)) == '(' { paren = i; i = 0 - 1; }
        else { i = i - 1; }
    }
    // Parse offset (before paren)
    // Temporarily adjust ops to point to offset part
    var saved_off: i32 = get(g_ops, (op_idx * 2));
    var saved_len: i32 = get(g_ops, (op_idx * 2 + 1));
    set(g_ops, (op_idx * 2), off);
    set(g_ops, (op_idx * 2 + 1), paren);
    var imm: i32 = parse_imm_op(op_idx);
    // Parse reg (after paren, before ')')
    set(g_ops, (op_idx * 2), off + paren + 1);
    var rlen: i32 = len - paren - 1;
    if rlen > 0 && get(g_line_buf, (off + paren + 1 + rlen - 1)) == ')' { rlen = rlen - 1; }
    set(g_ops, (op_idx * 2 + 1), rlen);
    // Restore for caller to read reg via same op_idx
    // Actually, we need a way to return both. Let's use a global.
    g_mem_reg = parse_reg_op(op_idx);
    // Restore
    set(g_ops, (op_idx * 2), saved_off);
    set(g_ops, (op_idx * 2 + 1), saved_len);
    return imm;
}
var g_mem_reg: i32 = 0;

// ===== Instruction encoding =====
fn enc_r(op: i32, f3: i32, f7: i32, rd: i32, rs1: i32, rs2: i32) -> i32 {
    return (f7 << 25) | (rs2 << 20) | (rs1 << 15) | (f3 << 12) | (rd << 7) | op;
}
fn enc_i(op: i32, f3: i32, rd: i32, rs1: i32, imm: i32) -> i32 {
    return ((imm & 4095) << 20) | (rs1 << 15) | (f3 << 12) | (rd << 7) | op;
}
fn enc_s(f3: i32, rs1: i32, rs2: i32, imm: i32) -> i32 {
    return (((imm >> 5) & 127) << 25) | (rs2 << 20) | (rs1 << 15) | (f3 << 12) | ((imm & 31) << 7) | 35;
}
fn enc_b(f3: i32, rs1: i32, rs2: i32, off: i32) -> i32 {
    return (((off >> 12) & 1) << 31) | (((off >> 5) & 63) << 25) |
           (rs2 << 20) | (rs1 << 15) | (f3 << 12) |
           (((off >> 1) & 15) << 8) | (((off >> 11) & 1) << 7) | 99;
}
fn enc_u(op: i32, rd: i32, imm: i32) -> i32 {
    return (imm & (0 - 4096)) | (rd << 7) | op;
}
fn enc_j(rd: i32, off: i32) -> i32 {
    return (((off >> 20) & 1) << 31) | (((off >> 1) & 1023) << 21) |
           (((off >> 11) & 1) << 20) | (((off >> 12) & 255) << 12) |
           (rd << 7) | 111;
}

fn hi20(v: i32) -> i32 {
    if (v & 2048) != 0 { return ((v >> 12) + 1) & 1048575; }
    return (v >> 12) & 1048575;
}
fn lo12(v: i32) -> i32 {
    var lo: i32 = v & 4095;
    if (lo & 2048) != 0 { lo = lo | (0 - 4096); }
    return lo;
}

// Reloc patcher entry points: asm_pass3 looks up label addresses
// and computes RV32 imm fields for `src raw` post-memcpy patching.
// Defined here (after struct Label / g_labels / hi20 / lo12 are all
// in scope) so the type checker can resolve get(g_labels, _) without
// forward-reference quirks.
export fn asm_find_label_idx(name: U8Array, nlen: i32) -> i32 {
    return find_label(name, nlen);
}
export fn asm_label_addr_at(idx: i32) -> i32 {
    return addr(get(g_labels, idx));
}
export fn asm_label_section_at(idx: i32) -> i32 {
    return section(get(g_labels, idx));
}
export fn asm_get_sec_base(sec: i32) -> i32 {
    return get(g_sec_base, sec);
}
export fn asm_get_gp_abs() -> i32 { return g_gp_abs; }
export fn asm_get_target_section() -> i32 { return g_target_section; }
export fn asm_hi20(v: i32) -> i32 { return hi20(v); }
export fn asm_lo12(v: i32) -> i32 { return lo12(v); }

// ===== Mnemonic comparison =====
fn mnem_eq(name: StringLiteral) -> bool {
    var nlen: i32 = len(name);
    if g_mnem_len != nlen { return false; }
    var i: i32 = 0;
    while i < nlen {
        if get(g_mnem, i) != get(name, i) { return false; }
        i = i + 1;
    }
    return true;
}

// ===== Process instruction: returns byte count =====
//
// Bucketed by first character of the mnemonic so each line walks
// roughly ~5-15 mnem_eq calls instead of all ~80. The buckets are
// just stylistic — mnem_eq remains the workhorse — but the early
// dispatch on g_mnem[0] cuts the average comparison count by ~5×.
fn asm_instr() -> i32 {
    var pc: i32 = g_pos;
    if g_mnem_len == 0 { return 0; }
    var c0: u8 = get(g_mnem, 0);

    if c0 == 'a' as u8 {
        if mnem_eq("add")   { if g_pass==2 { emit32(enc_r(51,0,0,parse_reg_op(0),parse_reg_op(1),parse_reg_op(2))); } return 4; }
        if mnem_eq("addi")  { if g_pass==2 { emit32(enc_i(19,0,parse_reg_op(0),parse_reg_op(1),parse_imm_op(2))); } return 4; }
        if mnem_eq("and")   { if g_pass==2 { emit32(enc_r(51,7,0,parse_reg_op(0),parse_reg_op(1),parse_reg_op(2))); } return 4; }
        if mnem_eq("andi")  { if g_pass==2 { emit32(enc_i(19,7,parse_reg_op(0),parse_reg_op(1),parse_imm_op(2))); } return 4; }
    } else if c0 == 'b' as u8 {
        if mnem_eq("beq")  { if g_pass==2 { emit32(enc_b(0,parse_reg_op(0),parse_reg_op(1),parse_label_op(2)-pc)); } return 4; }
        if mnem_eq("bne")  { if g_pass==2 { emit32(enc_b(1,parse_reg_op(0),parse_reg_op(1),parse_label_op(2)-pc)); } return 4; }
        if mnem_eq("blt")  { if g_pass==2 { emit32(enc_b(4,parse_reg_op(0),parse_reg_op(1),parse_label_op(2)-pc)); } return 4; }
        if mnem_eq("bge")  { if g_pass==2 { emit32(enc_b(5,parse_reg_op(0),parse_reg_op(1),parse_label_op(2)-pc)); } return 4; }
        if mnem_eq("bltu") { if g_pass==2 { emit32(enc_b(6,parse_reg_op(0),parse_reg_op(1),parse_label_op(2)-pc)); } return 4; }
        if mnem_eq("bgeu") { if g_pass==2 { emit32(enc_b(7,parse_reg_op(0),parse_reg_op(1),parse_label_op(2)-pc)); } return 4; }
        if mnem_eq("ble")  { if g_pass==2 { emit32(enc_b(5,parse_reg_op(1),parse_reg_op(0),parse_label_op(2)-pc)); } return 4; }
        if mnem_eq("bgt")  { if g_pass==2 { emit32(enc_b(4,parse_reg_op(1),parse_reg_op(0),parse_label_op(2)-pc)); } return 4; }
        if mnem_eq("bleu") { if g_pass==2 { emit32(enc_b(7,parse_reg_op(1),parse_reg_op(0),parse_label_op(2)-pc)); } return 4; }
        if mnem_eq("bgtu") { if g_pass==2 { emit32(enc_b(6,parse_reg_op(1),parse_reg_op(0),parse_label_op(2)-pc)); } return 4; }
        if mnem_eq("beqz") { if g_pass==2 { emit32(enc_b(0,parse_reg_op(0),0,parse_label_op(1)-pc)); } return 4; }
        if mnem_eq("bnez") { if g_pass==2 { emit32(enc_b(1,parse_reg_op(0),0,parse_label_op(1)-pc)); } return 4; }
    } else if c0 == 'c' as u8 {
        if mnem_eq("call") || mnem_eq("tail") {
            var rd: i32 = 1;
            if mnem_eq("tail") { rd = 0; }
            if g_pass==2 {
                // Detect extern target by name regardless of which
                // section pass we're in — every section pass walks
                // the full source, so a `call main` inside a non-
                // text section pass would still hit parse_label_op
                // and explode on the undefined label.
                var is_extern_call: i32 = 0;
                if g_reloc_fd > 0 {
                    if asm_label_is_extern(0, 0) != 0 ||
                       asm_label_is_extern(0, 1) != 0 ||
                       (g_emit_undef_relocs != 0 && label_op_undefined(0) != 0) {
                        is_extern_call = 1;
                        if g_target_section == 0 {
                            asm_emit_reloc(g_section_emitted, 1, 0);
                        }
                    }
                }
                var off: i32 = 0;
                if is_extern_call == 0 {
                    off = parse_label_op(0) - pc;
                }
                emit32(enc_u(23,rd,hi20(off)<<12));
                emit32(enc_i(103,0,rd,rd,lo12(off)));
            }
            return 8;
        }
        if mnem_eq("csrrw") { if g_pass==2 { emit32(enc_i(115,1,parse_reg_op(0),parse_reg_op(2),parse_imm_op(1))); } return 4; }
        if mnem_eq("csrrs") { if g_pass==2 { emit32(enc_i(115,2,parse_reg_op(0),parse_reg_op(2),parse_imm_op(1))); } return 4; }
        if mnem_eq("csrrc") { if g_pass==2 { emit32(enc_i(115,3,parse_reg_op(0),parse_reg_op(2),parse_imm_op(1))); } return 4; }
        if mnem_eq("csrr")  { if g_pass==2 { emit32(enc_i(115,2,parse_reg_op(0),0,parse_imm_op(1))); } return 4; }
        if mnem_eq("csrw")  { if g_pass==2 { emit32(enc_i(115,1,0,parse_reg_op(1),parse_imm_op(0))); } return 4; }
    } else if c0 == 'd' as u8 {
        if mnem_eq("div")   { if g_pass==2 { emit32(enc_r(51,4,1,parse_reg_op(0),parse_reg_op(1),parse_reg_op(2))); } return 4; }
        if mnem_eq("divu")  { if g_pass==2 { emit32(enc_r(51,5,1,parse_reg_op(0),parse_reg_op(1),parse_reg_op(2))); } return 4; }
    } else if c0 == 'e' as u8 {
        if mnem_eq("ecall") { if g_pass==2 { emit32(115); } return 4; }
    } else if c0 == 'j' as u8 {
        if mnem_eq("j") {
            var off: i32 = 0;
            if g_pass==2 {
                // Pre-encode mode: `j main` from task_crt0's
                // main__StringArray stub needs a kind=0 (J-type) reloc
                // because main is user-defined and its address is
                // unknown at pre-encode time. Without this the prelude
                // bin holds a tiny placeholder offset (4 bytes) and
                // the post-link binary jumps to nowhere useful.
                var is_extern_j: i32 = 0;
                if g_reloc_fd > 0 {
                    if asm_label_is_extern(0, 0) != 0 ||
                       asm_label_is_extern(0, 1) != 0 ||
                       (g_emit_undef_relocs != 0 && label_op_undefined(0) != 0) {
                        is_extern_j = 1;
                        if g_target_section == 0 {
                            asm_emit_reloc(g_section_emitted, 0, 0);
                        }
                    }
                }
                if is_extern_j == 0 {
                    off = parse_label_op(0) - pc;
                }
                emit32(enc_j(0,off));
            }
            return 4;
        }
        if mnem_eq("jr")   { if g_pass==2 { emit32(enc_i(103,0,0,parse_reg_op(0),0)); } return 4; }
        if mnem_eq("jalr") { if g_pass==2 { emit32(enc_i(103,0,parse_reg_op(0),parse_reg_op(1),parse_imm_op(2))); } return 4; }
    } else if c0 == 'l' as u8 {
        if mnem_eq("lw")  { if g_pass==2 { var imm:i32=parse_mem_off(1); emit32(enc_i(3,2,parse_reg_op(0),g_mem_reg,imm)); } return 4; }
        if mnem_eq("lh")  { if g_pass==2 { var imm:i32=parse_mem_off(1); emit32(enc_i(3,1,parse_reg_op(0),g_mem_reg,imm)); } return 4; }
        if mnem_eq("lb")  { if g_pass==2 { var imm:i32=parse_mem_off(1); emit32(enc_i(3,0,parse_reg_op(0),g_mem_reg,imm)); } return 4; }
        if mnem_eq("lbu") { if g_pass==2 { var imm:i32=parse_mem_off(1); emit32(enc_i(3,4,parse_reg_op(0),g_mem_reg,imm)); } return 4; }
        if mnem_eq("lhu") { if g_pass==2 { var imm:i32=parse_mem_off(1); emit32(enc_i(3,5,parse_reg_op(0),g_mem_reg,imm)); } return 4; }
        if mnem_eq("lui") { if g_pass==2 { emit32(enc_u(55,parse_reg_op(0),parse_imm_op(1)<<12)); } return 4; }
        if mnem_eq("li") {
            var imm: i32 = parse_imm_op(1);
            var rd: i32 = parse_reg_op(0);
            if imm >= 0 - 2048 && imm < 2048 {
                if g_pass==2 { emit32(enc_i(19,0,rd,0,imm)); }
                return 4;
            }
            if g_pass==2 {
                emit32(enc_u(55,rd,hi20(imm)<<12));
                emit32(enc_i(19,0,rd,rd,lo12(imm)));
            }
            return 8;
        }
        if mnem_eq("la") {
            var rd: i32 = parse_reg_op(0);
            if g_pass==2 {
                var target: i32 = parse_label_op(1);
                var tsec: i32 = parse_label_op_section(1);
                if tsec == 2 || tsec == 3 {
                    // gp-relative la for data/bss target. In pre-encode mode,
                    // the gpoff baked here is computed from prelude-only
                    // sections — when the OS-side link concatenates user.s
                    // the data_base shifts and gpoff goes stale. Emit a
                    // kind=2 reloc so asm_pass3 patches the addi imm with
                    // the link-time `target - g_gp_abs`.
                    if g_reloc_fd > 0 && g_target_section == 0 {
                        asm_emit_reloc(g_section_emitted, 2, 1);
                    }
                    var gpoff: i32 = target - g_gp_abs;
                    if gpoff < (0 - 2048) || gpoff > 2047 {
                        var eb1: StringBuffer = StringBuffer_new(1);
                        asm_err_begin(eb1);
                        emit_string(eb1, "gp-relative la out of 12-bit range for label '");
                        var lop_off: i32 = get(g_ops, 2);
                        var lop_len: i32 = get(g_ops, 3);
                        emit_n(eb1, g_line_buf, lop_off, lop_len);
                        emit_string(eb1, "'");
                        asm_err_end(eb1);
                    }
                    emit32(enc_u(23, rd, 0));
                    emit32(enc_i(19, 0, rd, 3, gpoff));
                } else {
                    var emit_auto: i32 = 0;
                    if g_reloc_fd > 0 && g_target_section == 0 {
                        if g_emit_undef_relocs != 0 && label_op_undefined(1) != 0 {
                            // Cross-input ref: we don't know the
                            // target's section here. Emit a kind=3
                            // (auto-la) reloc and let asm_pass3 pick
                            // kind=1 (PC-rel) vs kind=2 (gp-rel) at
                            // link time based on the target's
                            // resolved section + g_gp_abs.
                            asm_emit_reloc(g_section_emitted, 3, 1);
                            emit_auto = 1;
                        } else if tsec == 1 ||
                                  asm_label_is_extern(1, 2) != 0 {
                            asm_emit_reloc(g_section_emitted, 1, 1);
                        }
                    }
                    if emit_auto != 0 {
                        // Placeholder — patcher rewrites both halves.
                        // addi rs1=rd matches kind=1's default; if
                        // patcher decides kind=2 it overwrites rs1
                        // with gp.
                        emit32(enc_u(23, rd, 0));
                        emit32(enc_i(19, 0, rd, rd, 0));
                    } else {
                        var off: i32 = target - pc;
                        emit32(enc_u(23,rd,hi20(off)<<12));
                        emit32(enc_i(19,0,rd,rd,lo12(off)));
                    }
                }
            }
            return 8;
        }
    } else if c0 == 'm' as u8 {
        if mnem_eq("mul")   { if g_pass==2 { emit32(enc_r(51,0,1,parse_reg_op(0),parse_reg_op(1),parse_reg_op(2))); } return 4; }
        if mnem_eq("mulhu") { if g_pass==2 { emit32(enc_r(51,3,1,parse_reg_op(0),parse_reg_op(1),parse_reg_op(2))); } return 4; }
        if mnem_eq("mret")  { if g_pass==2 { emit32(0x30200073); } return 4; }
        if mnem_eq("mv")    { if g_pass==2 { emit32(enc_i(19,0,parse_reg_op(0),parse_reg_op(1),0)); } return 4; }
    } else if c0 == 'n' as u8 {
        if mnem_eq("neg") { if g_pass==2 { emit32(enc_r(51,0,32,parse_reg_op(0),0,parse_reg_op(1))); } return 4; }
        if mnem_eq("not") { if g_pass==2 { emit32(enc_i(19,4,parse_reg_op(0),parse_reg_op(1),0-1)); } return 4; }
        if mnem_eq("nop") { if g_pass==2 { emit32(enc_i(19,0,0,0,0)); } return 4; }
    } else if c0 == 'o' as u8 {
        if mnem_eq("or")  { if g_pass==2 { emit32(enc_r(51,6,0,parse_reg_op(0),parse_reg_op(1),parse_reg_op(2))); } return 4; }
        if mnem_eq("ori") { if g_pass==2 { emit32(enc_i(19,6,parse_reg_op(0),parse_reg_op(1),parse_imm_op(2))); } return 4; }
    } else if c0 == 'r' as u8 {
        if mnem_eq("rem")  { if g_pass==2 { emit32(enc_r(51,6,1,parse_reg_op(0),parse_reg_op(1),parse_reg_op(2))); } return 4; }
        if mnem_eq("remu") { if g_pass==2 { emit32(enc_r(51,7,1,parse_reg_op(0),parse_reg_op(1),parse_reg_op(2))); } return 4; }
        if mnem_eq("ret")  { if g_pass==2 { emit32(enc_i(103,0,0,1,0)); } return 4; }
    } else if c0 == 's' as u8 {
        if mnem_eq("sub")   { if g_pass==2 { emit32(enc_r(51,0,32,parse_reg_op(0),parse_reg_op(1),parse_reg_op(2))); } return 4; }
        if mnem_eq("sll")   { if g_pass==2 { emit32(enc_r(51,1,0,parse_reg_op(0),parse_reg_op(1),parse_reg_op(2))); } return 4; }
        if mnem_eq("slli")  { if g_pass==2 { emit32(enc_i(19,1,parse_reg_op(0),parse_reg_op(1),parse_imm_op(2))); } return 4; }
        if mnem_eq("srl")   { if g_pass==2 { emit32(enc_r(51,5,0,parse_reg_op(0),parse_reg_op(1),parse_reg_op(2))); } return 4; }
        if mnem_eq("srli")  { if g_pass==2 { emit32(enc_i(19,5,parse_reg_op(0),parse_reg_op(1),parse_imm_op(2))); } return 4; }
        if mnem_eq("sra")   { if g_pass==2 { emit32(enc_r(51,5,32,parse_reg_op(0),parse_reg_op(1),parse_reg_op(2))); } return 4; }
        if mnem_eq("srai")  { if g_pass==2 { emit32(enc_i(19,5,parse_reg_op(0),parse_reg_op(1),parse_imm_op(2) | 1024)); } return 4; }
        if mnem_eq("slt")   { if g_pass==2 { emit32(enc_r(51,2,0,parse_reg_op(0),parse_reg_op(1),parse_reg_op(2))); } return 4; }
        if mnem_eq("sltu")  { if g_pass==2 { emit32(enc_r(51,3,0,parse_reg_op(0),parse_reg_op(1),parse_reg_op(2))); } return 4; }
        if mnem_eq("slti")  { if g_pass==2 { emit32(enc_i(19,2,parse_reg_op(0),parse_reg_op(1),parse_imm_op(2))); } return 4; }
        if mnem_eq("sltiu") { if g_pass==2 { emit32(enc_i(19,3,parse_reg_op(0),parse_reg_op(1),parse_imm_op(2))); } return 4; }
        if mnem_eq("sw") { if g_pass==2 { var imm:i32=parse_mem_off(1); emit32(enc_s(2,g_mem_reg,parse_reg_op(0),imm)); } return 4; }
        if mnem_eq("sh") { if g_pass==2 { var imm:i32=parse_mem_off(1); emit32(enc_s(1,g_mem_reg,parse_reg_op(0),imm)); } return 4; }
        if mnem_eq("sb") { if g_pass==2 { var imm:i32=parse_mem_off(1); emit32(enc_s(0,g_mem_reg,parse_reg_op(0),imm)); } return 4; }
        if mnem_eq("snez") { if g_pass==2 { emit32(enc_r(51,3,0,parse_reg_op(0),0,parse_reg_op(1))); } return 4; }
        if mnem_eq("seqz") { if g_pass==2 { emit32(enc_i(19,3,parse_reg_op(0),parse_reg_op(1),1)); } return 4; }
    } else if c0 == 't' as u8 {
        // tail handled in 'c' bucket alongside call (shared body)
        if mnem_eq("tail") {
            if g_pass==2 {
                var off: i32 = parse_label_op(0) - pc;
                emit32(enc_u(23,0,hi20(off)<<12));
                emit32(enc_i(103,0,0,0,lo12(off)));
            }
            return 8;
        }
    } else if c0 == 'x' as u8 {
        if mnem_eq("xor")  { if g_pass==2 { emit32(enc_r(51,4,0,parse_reg_op(0),parse_reg_op(1),parse_reg_op(2))); } return 4; }
        if mnem_eq("xori") { if g_pass==2 { emit32(enc_i(19,4,parse_reg_op(0),parse_reg_op(1),parse_imm_op(2))); } return 4; }
    }

    // Unknown instruction
    var eb: StringBuffer = StringBuffer_new();
    asm_err_begin(eb);
    emit_string(eb, "unknown instruction '");
    emit_n(eb, g_mnem, 0, g_mnem_len);
    emit_string(eb, "'");
    asm_err_end(eb);
    return 0;
}

// ===== Line parser =====
// Parse a line stored in g_line_buf[0..g_line_buf_len] into g_mnem and g_ops
fn parse_asm_line() -> void {
    g_mnem_len = 0;
    g_nops = 0;
    var pos: i32 = 0;
    var len: i32 = g_line_buf_len;
    // Skip leading whitespace
    while pos < len && (get(g_line_buf, pos) == ' ' || get(g_line_buf, pos) == 9u8) { pos = pos + 1; }
    if pos >= len { return; }
    var c: u8 = get(g_line_buf, pos);
    if c == '#' || c == ';' { return; }
    if c == '/' && pos + 1 < len && get(g_line_buf, (pos+1)) == '*' { return; }
    // Read mnemonic
    var mstart: i32 = pos;
    while pos < len && get(g_line_buf, pos) != ' ' && get(g_line_buf, pos) != 9u8 && get(g_line_buf, pos) != 10u8 {
        pos = pos + 1;
    }
    g_mnem_len = pos - mstart;
    var i: i32 = 0;
    while i < g_mnem_len { set(g_mnem, i, get(g_line_buf, (mstart + i))); i = i + 1; }
    // Skip whitespace after mnemonic
    while pos < len && (get(g_line_buf, pos) == ' ' || get(g_line_buf, pos) == 9u8) { pos = pos + 1; }
    // Read operands
    while pos < len && get(g_line_buf, pos) != '#' && get(g_line_buf, pos) != 10u8 && g_nops < 4 {
        // Skip separators
        while pos < len && (get(g_line_buf, pos) == ',' || get(g_line_buf, pos) == ' ' || get(g_line_buf, pos) == 9u8) { pos = pos + 1; }
        if pos >= len || get(g_line_buf, pos) == '#' || get(g_line_buf, pos) == 10u8 { return; }
        // Handle quoted strings
        if get(g_line_buf, pos) == '"' {
            var qstart: i32 = pos;
            pos = pos + 1;
            while pos < len && get(g_line_buf, pos) != 10u8 {
                if get(g_line_buf, pos) == '\\' && pos + 1 < len { pos = pos + 2; }
                else if get(g_line_buf, pos) == '"' { pos = pos + 1; pos = len + 1; }  // break
                else { pos = pos + 1; }
            }
            if pos > len { pos = pos - len - 1 + len; }  // undo break trick
            set(g_ops, (g_nops * 2), qstart);
            set(g_ops, (g_nops * 2 + 1), pos - qstart);
            g_nops = g_nops + 1;
            return;  // string is always last operand
        }
        // Regular operand (may include parens for memory ops)
        var ostart: i32 = pos;
        var paren: i32 = 0;
        var odone: i32 = 0;
        while pos < len && odone == 0 {
            var ch: u8 = get(g_line_buf, pos);
            if ch == '(' { paren = paren + 1; pos = pos + 1; }
            else if ch == ')' { pos = pos + 1; paren = paren - 1; if paren <= 0 { odone = 1; } }
            else if (ch == ',' || ch == ' ' || ch == 9u8) && paren == 0 { odone = 1; }
            else if ch == '#' || ch == 10u8 { odone = 1; }
            else { pos = pos + 1; }
        }
        var olen: i32 = pos - ostart;
        if olen > 0 {
            set(g_ops, (g_nops * 2), ostart);
            set(g_ops, (g_nops * 2 + 1), olen);
            g_nops = g_nops + 1;
        }
    }
    return;
}

// ===== Process one stored line =====
// Process one raw source line. The caller passes the bytes and the
// 1-origin source line number; we copy into g_line_buf, then run the
// existing strip / label / tokenize / dispatch pipeline. No g_lines
// indirection — pass1 / pass2 both stream-read source one line at a
// time and hand it here.
export fn asm_process_line(buf: U8Array, blen: i32, lineno: i32) -> void {
    g_cur_line = lineno;
    var len: i32 = blen;
    var i: i32 = 0;
    while i < len { set(g_line_buf, i, get(buf, i)); i = i + 1; }
    g_line_buf_len = len;

    // Strip leading/trailing whitespace
    var start: i32 = 0;
    while start < len && (get(g_line_buf, start) == ' ' || get(g_line_buf, start) == 9u8) { start = start + 1; }
    while len > start && (get(g_line_buf, (len-1)) == ' ' || get(g_line_buf, (len-1)) == 9u8 || get(g_line_buf, (len-1)) == 10u8 || get(g_line_buf, (len-1)) == 13u8) { len = len - 1; }
    if start > 0 {
        i = 0;
        while i < len - start { set(g_line_buf, i, get(g_line_buf, (start + i))); i = i + 1; }
        len = len - start;
    }
    g_line_buf_len = len;
    if len == 0 { return; }
    if get(g_line_buf, 0) == '#' || get(g_line_buf, 0) == ';' { return; }

    // Check for label (colon not inside quotes or a comment).
    // Stop at '#' or ';' — both start end-of-line comments in the asm
    // flavors we accept, and a colon inside the comment body must not
    // be mistaken for a label delimiter.
    var colon_pos: i32 = 0 - 1;
    var in_quote: i32 = 0;
    i = 0;
    while i < len {
        var cc: u8 = get(g_line_buf, i);
        if cc == '"' { in_quote = 1 - in_quote; }
        if in_quote == 0 && (cc == '#' || cc == ';') { i = len; }
        else if cc == ':' && in_quote == 0 { colon_pos = i; i = len; }
        else { i = i + 1; }
    }
    if colon_pos >= 0 {
        // Check if numeric label (single digit before colon)
        var is_numlab: i32 = 0;
        if colon_pos == 1 && is_digit(get(g_line_buf, 0)) {
            is_numlab = 1;
            var digit: i32 = get(g_line_buf, 0) as i32 - 48;
            if g_pass == 1 { define_numlab(digit, g_pos); }
        }
        if is_numlab == 0 {
            // Named label
            var lname: U8Array = U8Array((colon_pos) as u32);
            i = 0;
            while i < colon_pos { set(lname, i, get(g_line_buf, i)); i = i + 1; }
            if g_pass == 1 { define_label(lname, colon_pos, g_pos); }
            delete(lname);
        }
        // Process remainder after colon
        var rest_start: i32 = colon_pos + 1;
        while rest_start < len && (get(g_line_buf, rest_start) == ' ' || get(g_line_buf, rest_start) == 9u8) { rest_start = rest_start + 1; }
        if rest_start < len {
            // Shift remainder to start of buffer
            i = 0;
            while i < len - rest_start { set(g_line_buf, i, get(g_line_buf, (rest_start + i))); i = i + 1; }
            g_line_buf_len = len - rest_start;
        } else {
            return;
        }
    }

    parse_asm_line();
    if g_mnem_len == 0 { return; }

    // Directives
    if get(g_mnem, 0) == '.' {
        // Dead-strip Phase 1: every section change resets the owner
        // sentinel so the first labelless bytes after the directive
        // (rare — usually a label follows) are attributed to "no
        // owner". record_ref skips those refs.
        if mnem_eq(".text") { g_current_section = 0; g_owner_idx = 0 - 1; return; }
        if mnem_eq(".section") {
            // .section .rodata / .data / .bss / .text / other
            // Look at the first operand to pick a section id.
            g_current_section = 0;  // default: treat as text
            if g_nops > 0 {
                var sop_off: i32 = get(g_ops, 0);
                var sop_len: i32 = get(g_ops, 1);
                if sop_len >= 7 && cmp(g_line_buf, sop_off, ".rodata") {
                    g_current_section = 1;
                } else if sop_len >= 5 && cmp(g_line_buf, sop_off, ".data") {
                    g_current_section = 2;
                } else if sop_len >= 4 && cmp(g_line_buf, sop_off, ".bss") {
                    g_current_section = 3;
                }
            }
            g_owner_idx = 0 - 1;
            return;
        }
        if mnem_eq(".rodata") { g_current_section = 1; g_owner_idx = 0 - 1; return; }
        if mnem_eq(".data") { g_current_section = 2; g_owner_idx = 0 - 1; return; }
        if mnem_eq(".bss") { g_current_section = 3; g_owner_idx = 0 - 1; return; }
        if mnem_eq(".globl") || mnem_eq(".type") || mnem_eq(".size") ||
           mnem_eq(".option") || mnem_eq(".attribute") || mnem_eq(".file") ||
           mnem_eq(".ident") || mnem_eq(".p2align") { return; }
        if mnem_eq(".set") {
            // .set label, . + N  (define label at current position + offset)
            // For now, just define at current position
            if g_nops >= 1 {
                var op_off: i32 = get(g_ops, 0);
                var op_len: i32 = get(g_ops, 1);
                var lname: U8Array = U8Array((op_len) as u32);
                i = 0;
                while i < op_len { set(lname, i, get(g_line_buf, (op_off + i))); i = i + 1; }
                if g_pass == 1 { define_label(lname, op_len, g_pos); }
                delete(lname);
            }
            return;
        }
        if mnem_eq(".local") { return; }  // ignore
        if mnem_eq(".comm") {
            // .comm symbol,size,align — allocate BSS space via per-section
            // cursor g_sec_pos[SEC_BSS=3]. The label is defined in the BSS
            // section and fixed up (addr += bss_base) after pass 1.
            if g_nops >= 2 {
                var op_off: i32 = get(g_ops, 0);
                var op_len: i32 = get(g_ops, 1);
                var size: i32 = parse_imm_op(1);
                var align: i32 = 4;
                if g_nops >= 3 { align = parse_imm_op(2); }
                var bss_cursor: i32 = get(g_sec_pos, 3);
                while bss_cursor % align != 0 { bss_cursor = bss_cursor + 1; }
                var lname: U8Array = U8Array((op_len) as u32);
                i = 0;
                while i < op_len { set(lname, i, get(g_line_buf, (op_off + i))); i = i + 1; }
                if g_pass == 1 {
                    // Temporarily switch section so define_label records BSS
                    var saved_sec: i32 = g_current_section;
                    g_current_section = 3;
                    define_label(lname, op_len, bss_cursor);
                    g_current_section = saved_sec;
                }
                delete(lname);
                set(g_sec_pos, 3, bss_cursor + size);
            }
            return;
        }
        if mnem_eq(".align") {
            var n: i32 = 1;
            var shift: i32 = parse_imm_op(0);
            i = 0;
            while i < shift { n = n * 2; i = i + 1; }
            // Record the first .align in each section for the .idx —
            // see asm_record_sec_align comment. Only pass 1 has the
            // honest sec_pos / current_section state we want to
            // capture.
            if g_pass == 1 { asm_record_sec_align(g_current_section, n); }
            align_to(n);
            return;
        }
        if mnem_eq(".word") {
            if g_nops > 0 {
                // Try as label first, then as number
                var op_off: i32 = get(g_ops, 0);
                var op_len: i32 = get(g_ops, 1);
                var c0: u8 = get(g_line_buf, op_off);
                if (c0 >= '0' && c0 <= '9') || c0 == '-' {
                    emit32(parse_imm_op(0));
                } else {
                    // Label — symbol reference for dead-strip too
                    if g_pass == 1 { pass1_scan_operand_refs(); }
                    if g_pass == 2 { emit32(parse_label_op(0)); }
                    else { g_pos = g_pos + 4; }
                }
            }
            return;
        }
        if mnem_eq(".byte") {
            // Emit each comma-separated value as a single byte.
            // Parse directly from g_line_buf to avoid g_nops limit.
            var bi: i32 = 0;
            while bi < g_nops {
                emit8(parse_imm_op(bi) & 255);
                bi = bi + 1;
            }
            return;
        }
        if mnem_eq(".string") {
            if g_nops > 0 {
                var op_off: i32 = get(g_ops, 0);
                var op_len: i32 = get(g_ops, 1);
                // Skip opening quote
                var s: i32 = op_off + 1;
                var e: i32 = op_off + op_len;
                if e > s && get(g_line_buf, (e - 1)) == '"' { e = e - 1; }
                i = s;
                while i < e {
                    if get(g_line_buf, i) == '\\' && i + 1 < e {
                        i = i + 1;
                        var esc: u8 = get(g_line_buf, i);
                        if esc == 'n' { emit8(10); }
                        else if esc == 't' { emit8(9); }
                        else if esc == 'r' { emit8(13); }
                        else if esc == '0' { emit8(0); }
                        else if esc == '\\' { emit8(92); }
                        else if esc == '"' { emit8(34); }
                        else { emit8(esc as i32); }
                    } else {
                        emit8(get(g_line_buf, i) as i32);
                    }
                    i = i + 1;
                }
                emit8(0);  // NUL terminator
            }
            return;
        }
        if mnem_eq(".space") || mnem_eq(".zero") {
            var n: i32 = parse_imm_op(0);
            // Advance position; only write to g_code if within buffer.
            // bss-section .space lands past g_code_size (bss is memsz
            // only) so the write loop's bound check skips it entirely
            // — this is how the old 96 MB kernel arena .space stayed
            // out of the ELF filesz.
            if g_pass == 2 {
                if g_stream_mode == 1 {
                    // Stream mode: only emit zeros when inside the
                    // target section; skip otherwise. This is how
                    // the 96 MB kernel arena `.space` in bss stays
                    // out of filesz without 96 million emit_stream
                    // no-ops.
                    if g_current_section == g_target_section {
                        i = 0;
                        while i < n { emit_stream(0); i = i + 1; }
                    }
                    g_pos = g_pos + n;
                    return;
                }
                var end: i32 = g_pos + n;
                var write_end: i32 = end;
                if write_end > g_code_size { write_end = g_code_size; }
                i = g_pos;
                while i < write_end { set(g_code, i, 0u8); i = i + 1; }
            }
            g_pos = g_pos + n;
            return;
        }
        if mnem_eq(".incbin") {
            // .incbin SIZE "path"
            // Emits SIZE bytes from the file at "path". Used to embed
            // large binary blobs (e.g. mtfs disk image) without the
            // 7×-overhead of bin2s `.byte` text. Pass 1 advances g_pos
            // by SIZE; pass 2 opens the file and streams bytes through
            // emit8.
            var inc_size: i32 = 0;
            if g_nops >= 1 { inc_size = parse_imm_op(0); }
            var should_emit: i32 = 0;
            if g_pass == 2 {
                if g_stream_mode == 0 { should_emit = 1; }
                else { if g_current_section == g_target_section { should_emit = 1; } }
            }
            // Incbin-defer fast path: when --incbin-skip is set on
            // asm_pass1 and this is a section-leading .incbin (intra
            // offset 0), record (sec, intra_off=0, size, path) into
            // g_pass1_incbin_* and skip the file read + emit
            // entirely. Just advance g_pos so the section's intra
            // accounting (and any labels after .incbin) stays correct.
            // The link step will translate the idx record into a
            // `src raw <orig_path> <sec> <abs_start>` line so
            // asm_pass3 memcpys the original blob directly.
            //
            // Fires in BOTH pass 1 and pass 2 because asm_pass1.tc
            // dumps the idx after pass 1 (before pass 2 runs), so the
            // record must be set up during pass 1; pass 2 then must
            // skip the emit too. Use intra_now == 0 as the defer
            // gate (consistent across passes), and re-set
            // g_pass1_incbin_present = 1 idempotently.
            if g_incbin_skip == 1 && g_nops >= 2 {
                var sec_now: i32 = g_current_section;
                // Use g_sec_pos directly — equivalent in both passes
                // since asm_run_line sets g_pos from sec_pos (pass 1)
                // or sec_base + sec_pos (pass 2). sec_pos is the
                // intra-section offset and doesn't depend on
                // g_sec_base being zero-initialized. The earlier
                // formulation `g_pos - g_sec_base[sec_now]` was
                // pass-2 only correct: in pass 1 g_sec_base is
                // I32Array(4) freshly allocated, and on pico2 the
                // task arena's first allocation can return non-zero
                // residual bytes from previous task usage, so the
                // computed intra was garbage. Symptom: pass 1 fall-
                // through with no `incbin` line in the idx; pass 2
                // (with computed sec_base) skipped the bin emit
                // anyway, so device pt.ro was 4 bytes but pt.idx
                // missed the incbin record → asm_pass2 --link's lab
                // didn't get a `src raw <orig_path>` line → asm_pass3
                // never memcpy'd /sd/dx.img → kernel.bin diverged
                // from host's. Caught 2026-05-10 via mx pt.idx
                // extraction (host LINKMODE was unaffected because
                // qemu's fresh mmap pages are zero).
                var intra_now: i32 = get(g_sec_pos, sec_now);
                if intra_now == 0 {
                    // Extract the path token (same quote-stripping as
                    // the materialized path below).
                    var dpath_off: i32 = get(g_ops, 2);
                    var dpath_len: i32 = get(g_ops, 3);
                    if dpath_len > 0 && get(g_line_buf, dpath_off) == 34u8 {
                        dpath_off = dpath_off + 1;
                        dpath_len = dpath_len - 1;
                    }
                    var dqe: i32 = 0;
                    var dqfound: i32 = 0;
                    while dqe < dpath_len && dqfound == 0 {
                        if get(g_line_buf, (dpath_off + dqe)) == 34u8 {
                            dqfound = 1;
                            dpath_len = dqe;
                        } else {
                            dqe = dqe + 1;
                        }
                    }
                    // Allocate the path String — survives past the
                    // line buffer's lifetime since asm_dump_idx_state
                    // reads it later.
                    var dpbuf: U8Array = U8Array((dpath_len + 1) as u32);
                    var dpi: i32 = 0;
                    while dpi < dpath_len {
                        set(dpbuf, dpi, get(g_line_buf, (dpath_off + dpi)));
                        dpi = dpi + 1;
                    }
                    set(dpbuf, dpath_len, 0u8);
                    poke32(dpbuf as u32, dpath_len as u32);
                    // Only set the present-flag + record the path on
                    // the FIRST encounter (pass 1). Pass 2 re-enters
                    // the same handler but the record from pass 1 is
                    // already in g_pass1_incbin_*. Avoid leaking
                    // pass-2 dpbuf — only adopt it if not yet set.
                    if g_pass1_incbin_present == 0 {
                        g_pass1_incbin_present  = 1;
                        g_pass1_incbin_sec      = sec_now;
                        g_pass1_incbin_intra_off = 0;
                        g_pass1_incbin_size     = inc_size;
                        g_pass1_incbin_path     = dpbuf as u32 as String;
                    }
                    // Advance section position WITHOUT emitting any
                    // bytes to the bin fd in either pass. Subsequent
                    // emit8 calls in this section land at bin file
                    // offset 0 (since we didn't write anything yet).
                    // The .lab src-raw entry for this bin will start
                    // at section offset (intra_off + size) so those
                    // post-incbin bytes land at the right place.
                    g_pos = g_pos + inc_size;
                    return;
                }
            }
            if should_emit == 1 && g_nops >= 2 {
                var path_off: i32 = get(g_ops, 2);
                var path_len: i32 = get(g_ops, 3);
                if path_len > 0 && get(g_line_buf, path_off) == 34u8 {
                    path_off = path_off + 1;
                    path_len = path_len - 1;
                }
                var qe: i32 = 0;
                var qfound: i32 = 0;
                while qe < path_len && qfound == 0 {
                    if get(g_line_buf, (path_off + qe)) == 34u8 {
                        qfound = 1;
                        path_len = qe;
                    } else {
                        qe = qe + 1;
                    }
                }
                // Build a String header for do_openat. Layout:
                //   [4-byte count][path_len bytes payload][1 byte NUL]
                // The NUL is required by the bootstrap C runtime's
                // openat stub (it strips the count and treats the rest
                // as a C string). U8Array(N+1) gives us room for the
                // payload plus one trailing zero. Writes happen before
                // poke32 because set_check uses the count field as the
                // bound — shrinking it earlier rejects path-byte writes.
                var pbuf: U8Array = U8Array((path_len + 1) as u32);
                var pi: i32 = 0;
                while pi < path_len {
                    set(pbuf, pi, get(g_line_buf, (path_off + pi)));
                    pi = pi + 1;
                }
                set(pbuf, path_len, 0u8);
                poke32(pbuf as u32, path_len as u32);
                var path_str: String = pbuf as u32 as String;
                var fd: i32 = do_openat(0 - 100, path_str, 0);
                if fd >= 0 {
                    var iobuf: U8Array = U8Array(4096u32);
                    var emitted: i32 = 0;
                    var done_in: i32 = 0;
                    while emitted < inc_size && done_in == 0 {
                        var want: i32 = 4096;
                        if want > inc_size - emitted { want = inc_size - emitted; }
                        var got: i32 = sys_read(fd, iobuf, want);
                        if got <= 0 { done_in = 1; }
                        else {
                            var bi: i32 = 0;
                            while bi < got {
                                emit8(get(iobuf, bi) as i32);
                                bi = bi + 1;
                            }
                            emitted = emitted + got;
                        }
                    }
                    do_close(fd);
                    if emitted < inc_size {
                        while emitted < inc_size {
                            emit8(0);
                            emitted = emitted + 1;
                        }
                    }
                } else {
                    var ii: i32 = 0;
                    while ii < inc_size { emit8(0); ii = ii + 1; }
                }
                return;
            }
            g_pos = g_pos + inc_size;
            return;
        }
        // Unknown directive: ignore
        return;
    }

    // Instructions
    var sz: i32 = asm_instr();
    if g_pass == 1 {
        // Dead-strip Phase 1: record symbol references after the
        // operand parser has populated g_ops for this line.
        pass1_scan_operand_refs();
        g_pos = g_pos + sz;
    }
    return;
}

// Check whether a line starting with `; ` is a meta directive,
// and if so update global state. Returns 1 if consumed, 0 otherwise.
// Inspect a freshly-read source line for one of the meta directives
// (`; raw` / `; load_base 0xN`) and apply it. Returns 1 if the line
// was a meta directive (caller skips dispatching to process_line),
// 0 otherwise. Walks the caller-supplied buffer directly so we
// don't need a g_lines indirection.
export fn asm_parse_meta_directive(buf: U8Array, blen: i32) -> i32 {
    if blen < 4 { return 0; }
    if get(buf, 0) != ';' { return 0; }
    if get(buf, 1) != ' ' { return 0; }
    var p: i32 = 2;
    var end: i32 = blen;
    // Strip trailing newline if present
    if end > p && get(buf, (end - 1)) == 10u8 { end = end - 1; }
    // ; raw
    if (end - p) == 3 && cmp(buf, p, "raw") {
        g_raw_mode = 1;
        return 1;
    }
    // ; load_base 0xHHHHHHHH
    if (end - p) >= 11 && cmp(buf, p, "load_base ") {
        var q: i32 = p + 10;
        while q < end && get(buf, q) == ' ' { q = q + 1; }
        if q + 1 < end && get(buf, q) == '0'
           && (get(buf, (q + 1)) == 'x' || get(buf, (q + 1)) == 'X') {
            q = q + 2;
        }
        var v: i32 = 0;
        while q < end {
            var c: u8 = get(buf, q);
            if c >= '0' && c <= '9' { v = v * 16 + (c as i32 - 48); }
            else if c >= 'a' && c <= 'f' { v = v * 16 + (c as i32 - 87); }
            else if c >= 'A' && c <= 'F' { v = v * 16 + (c as i32 - 55); }
            q = q + 1;
        }
        g_load_vaddr = v;
        return 1;
    }
    return 0;
}

// ===== Init =====
//
// Allocate the per-pass state. Pass 1 doesn't need g_code (emit8 /
// emit32 only write to g_code when g_pass == 2), so asm_init_pass1
// skips that 4 MB allocation. Pass 2 needs everything.
//
// Free the big per-walk allocations before reallocating — without
// this, asm_pass1's three internal calls (run() for idx, run() for
// lab, run_pass2() for bin/reloc) leak ~80 KB per call, pushing peak
// past the 288 KB OS task arena. Only the largest arrays are freed
// here; smaller ones (sec_pos / numlab / line_buf, ~10 KB total)
// leak per re-init but are dwarfed by the freed g_lab* / g_def_*
// state.
fn asm_init_common() -> void {
    if g_lab_names  as u32 != 0u32 { delete(g_lab_names); }
    if g_labels     as u32 != 0u32 { delete(g_labels); }
    if g_lab_hash   as u32 != 0u32 { delete(g_lab_hash); g_lab_hash = 0 as I32Array; }
    if g_refs       as u32 != 0u32 { delete(g_refs); }
    if g_def_owner    as u32 != 0u32 { delete(g_def_owner); }
    if g_def_name_off as u32 != 0u32 { delete(g_def_name_off); }
    if g_def_name_len as u32 != 0u32 { delete(g_def_name_len); }
    if g_def_pool   as u32 != 0u32 { delete(g_def_pool); }

    g_lab_names    = U8Array((NAME_POOL_INITIAL_KB * 1024) as u32);
    g_labels       = LabelArray((MAX_LABELS) as u32);
    g_sec_pos      = I32Array(4);
    g_sec_base     = I32Array(4);
    g_sec_size     = I32Array(4);
    g_mnem         = U8Array(64);
    g_ops          = I32Array(8);    // 4 ops x 2 (off, len)
    g_line_buf     = U8Array(4092);
    g_numlab_zero  = I32Array((NUM_LAB_PER_DIGIT) as u32);
    g_numlab_other = I32Array((9 * NUMLAB_OTHER_PER_DIGIT) as u32);
    g_numlab_count = I32Array(10);
    // g_refs / g_def_* lazily allocated by ensure_ref_state() the
    // first time asm_set_collecting_refs(1) is called. ~88 KB.
    g_refs         = 0 as I32Array;
    g_def_owner    = 0 as I32Array;
    g_def_name_off = 0 as I32Array;
    g_def_name_len = 0 as I32Array;
    g_def_pool     = 0 as U8Array;
    g_def_capacity = 0;

    // Reset incbin-defer state per pass init. The path String stays
    // around across passes (pass1 records in pass2 walk; idx dump
    // reads it after walk2). asm_init_pass1 invocations clear it for
    // a fresh run.
    g_pass1_incbin_present  = 0;
    g_pass1_incbin_sec      = 0;
    g_pass1_incbin_intra_off = 0;
    g_pass1_incbin_size     = 0;
    g_pass1_incbin_path     = 0 as String;

    g_pos              = 0;
    g_pass             = 0;
    g_nlabels          = 0;
    g_lab_name_pos     = 0;
    g_current_section  = 0;
    g_code_end         = 0;
    g_bss_pos          = 0;
    g_cur_line         = 0;
    g_nrefs            = 0;
    g_owner_idx        = 0 - 1;
    g_ndeferred        = 0;
    g_def_pool_pos     = 0;
    // Reset the label hash table flag — g_lab_hash itself was built
    // against the previous g_labels content (now reallocated above)
    // and would point at stale indexes into the old array. Without
    // this reset, a fresh find_label call after re-init returns junk
    // ("get: null" crashes for an unrelated label search).
    g_lab_hash_ok      = 0;
    set(g_sec_pos, 0, 0);
    set(g_sec_pos, 1, 0);
    set(g_sec_pos, 2, 0);
    set(g_sec_pos, 3, 0);
    // Zero-initialize sec_base and sec_size too — the TC runtime's
    // kmalloc does not zero memory, and on pico2 the task arena is
    // reused across spawns so the freshly-allocated I32Array(4) holds
    // residual bytes from prior task usage. Pass 1 reads g_sec_base
    // (e.g. asm_run_line's pass-2 branch, label fixup, .lab dump)
    // before asm_compute_sec_bases has set them to their merged-link
    // values — without this zero-init, pass 1 sees garbage and any
    // calculation of the form `g_pos - g_sec_base[sec]` produces
    // junk. Caught 2026-05-10 when self_replicate LINKMODE+--incbin-
    // skip wrote a kernel.bin diverging from host (host's qemu fresh
    // mmap pages happen to be zero so the bug was masked).
    set(g_sec_base, 0, 0);
    set(g_sec_base, 1, 0);
    set(g_sec_base, 2, 0);
    set(g_sec_base, 3, 0);
    set(g_sec_size, 0, 0);
    set(g_sec_size, 1, 0);
    set(g_sec_size, 2, 0);
    set(g_sec_size, 3, 0);

    return;
}

export fn asm_init_pass1() -> void {
    asm_init_common();
    // Pre-define __global_pointer$ in text section; its final value is
    // patched to data_base + 0x800 after the pass 1 line loop, the
    // same way single-process asm.tc did it.
    var gp_sym: U8Array = U8Array(20);
    var gp_len: i32 = buf_set_str(gp_sym, 0, "__global_pointer$");
    define_label(gp_sym, gp_len, 0);
    delete(gp_sym);
    return;
}

export fn asm_init_pass2() -> void {
    asm_init_common();
    // g_code is allocated later via asm_pass2_allocate_code() once
    // the .lab has been parsed and section sizes are known. Only
    // used in buffered mode (g_stream_mode == 0).
    g_code = 0 as U8Array;
    g_code_size = 0;
    // Stream-mode output buffer. 4 KB is enough to amortise sys_write
    // syscall overhead; fits comfortably into any task arena.
    g_out_buf = U8Array((g_out_buf_size) as u32);
    g_out_pos = 0;
    return;
}

// Allocate g_code based on the section sizes supplied by the .lab.
// Must be called after all asm_install_sec_base_size() calls and
// before switching to pass 2. filesz = text + rodata + data; bss is
// memsz-only and never writes to g_code. Only used in buffered mode.
export fn asm_pass2_allocate_code() -> void {
    var fsz: i32 = get(g_sec_size, 0) + get(g_sec_size, 1) + get(g_sec_size, 2);
    // Guard against a degenerate .lab where all sections are empty —
    // U8Array(0) would fail, and at minimum we want a valid (empty)
    // buffer so emit8 bound checks are well-defined.
    if fsz <= 0 { fsz = 1; }
    g_code_size = fsz;
    g_code = U8Array(fsz as u32);
    return;
}

// Enable stream-emit mode (Phase 5). asm_pass3 calls this after
// parsing the .lab and before running pass 2 on the source.
// Stream mode replaces g_code with a small 4 KB buffer and a pass-
// per-section algorithm (see asm_pass3.tc main()). Drivers that
// don't go through asm_init_pass2 (asm_pass1's 2-walk fast path
// reuses the asm_init_pass1-built label state across passes) need
// the buffer to be allocated here too.
export fn asm_enable_stream_mode() -> void {
    g_stream_mode = 1;
    g_target_section = 0;
    g_section_emitted = 0;
    if g_out_buf as u32 == 0u32 {
        g_out_buf = U8Array((g_out_buf_size) as u32);
        g_out_pos = 0;
    }
    return;
}

export fn asm_set_target_section(sec: i32) -> void {
    g_target_section = sec;
    g_section_emitted = 0;
    return;
}

// Read the running per-section emit cursor. Used by raw_memcpy_section
// to anchor its chunk_off so a second `src raw` entry for the same
// section continues from where the first one stopped.
export fn asm_get_section_emitted() -> i32 { return g_section_emitted; }

// Restore the per-section emit cursor — needed by drivers that
// switch sections multiple times within a single pass-2 walk
// (asm_pass1's 2-walk fast path) so the running offset for reloc
// records persists across re-entries into the same section.
// asm_set_target_section unconditionally resets to 0, which is the
// right behaviour for the legacy 3-pass run_section_pass model
// (each pass starts from 0) but wrong for a single-walk multi-
// section driver.
export fn asm_set_section_emitted(v: i32) -> void {
    g_section_emitted = v;
    return;
}

// === Incbin-defer accessors (2026-05-09) ===
//
// asm_pass1 sets g_incbin_skip via --incbin-skip. The .incbin pass-2
// handler checks g_incbin_skip and (intra_off == 0) to decide
// whether to materialize bytes or just record path/size.
export fn asm_set_incbin_skip(v: i32) -> void {
    g_incbin_skip = v;
    return;
}
export fn asm_get_pass1_incbin_present()   -> i32    { return g_pass1_incbin_present; }
export fn asm_get_pass1_incbin_sec()       -> i32    { return g_pass1_incbin_sec; }
export fn asm_get_pass1_incbin_intra_off() -> i32    { return g_pass1_incbin_intra_off; }
export fn asm_get_pass1_incbin_size()      -> i32    { return g_pass1_incbin_size; }
export fn asm_get_pass1_incbin_path()      -> String { return g_pass1_incbin_path; }

export fn asm_get_load_incbin_present()    -> i32    { return g_load_incbin_present; }
export fn asm_get_load_incbin_sec()        -> i32    { return g_load_incbin_sec; }
export fn asm_get_load_incbin_intra_off()  -> i32    { return g_load_incbin_intra_off; }
export fn asm_get_load_incbin_size()       -> i32    { return g_load_incbin_size; }
export fn asm_get_load_incbin_path()       -> String { return g_load_incbin_path; }

// Flush the output buffer and, if we're in the middle of a target
// section, emit padding zero bytes up to the section's declared size
// (which is already 16-byte aligned in asm_compute_sec_bases). Called
// at the end of each pass in stream mode.
export fn asm_flush_section_padding() -> void {
    var want: i32 = get(g_sec_size, g_target_section);
    while g_section_emitted < want {
        emit_stream(0);
    }
    flush_out_buf();
    return;
}

// Convenience: flush whatever is in g_out_buf (used in raw mode
// between section passes when we don't want padding).
export fn asm_flush_output() -> void {
    flush_out_buf();
    return;
}

export fn asm_set_pass(p: i32) -> void {
    g_pass = p;
    return;
}

// Track the "active section" cursor for the caller. asm_pass2 / pass2
// drive process_line line by line, and each line needs g_pos set to
// the per-section intra offset (pass 1) or sec_base+intra (pass 2)
// before the line runs. This wraps that bookkeeping so the pass main
// loops stay tiny.
export fn asm_run_line(buf: U8Array, blen: i32, lineno: i32) -> void {
    if g_pass == 1 {
        var sec_before: i32 = g_current_section;
        g_pos = get(g_sec_pos, sec_before);
        asm_process_line(buf, blen, lineno);
        set(g_sec_pos, sec_before, g_pos);
    } else {
        var sec_before2: i32 = g_current_section;
        g_pos = get(g_sec_base, sec_before2) + get(g_sec_pos, sec_before2);
        asm_process_line(buf, blen, lineno);
        set(g_sec_pos, sec_before2, g_pos - get(g_sec_base, sec_before2));
    }
    return;
}

// Compute section bases / sizes from g_sec_pos (which pass 1 has been
// updating) and stash __global_pointer$ value. Called once between
// pass 1 and the .lab dump.
export fn asm_compute_sec_bases() -> void {
    var text_size: i32   = (get(g_sec_pos, 0) + 15) & (0 - 16);
    var rodata_size: i32 = (get(g_sec_pos, 1) + 15) & (0 - 16);
    var data_size: i32   = (get(g_sec_pos, 2) + 15) & (0 - 16);
    var bss_size: i32    = (get(g_sec_pos, 3) + 15) & (0 - 16);
    set(g_sec_base, 0, 0);
    set(g_sec_base, 1, text_size);
    set(g_sec_base, 2, text_size + rodata_size);
    set(g_sec_base, 3, text_size + rodata_size + data_size);
    set(g_sec_size, 0, text_size);
    set(g_sec_size, 1, rodata_size);
    set(g_sec_size, 2, data_size);
    set(g_sec_size, 3, bss_size);
    g_gp_abs = get(g_sec_base, 2) + 2048;
    return;
}

// Add g_sec_base[section] to every label's intra offset, turning them
// into absolute (PIC code-relative) addresses. Also patches the
// magic __global_pointer$ label to data_base + 0x800. Pass 1 only.
export fn asm_fixup_labels() -> void {
    var i: i32 = 0;
    while i < g_nlabels {
        var lb: Label = get(g_labels, i);
        var lsec: i32 = section(lb);
        addr(lb, addr(lb) + get(g_sec_base, lsec));
        i = i + 1;
    }
    var gp_sym: U8Array = U8Array(20);
    var gp_len: i32 = buf_set_str(gp_sym, 0, "__global_pointer$");
    var gp_idx: i32 = find_label(gp_sym, gp_len);
    if gp_idx >= 0 { addr(get(g_labels, gp_idx), g_gp_abs); }
    delete(gp_sym);
    return;
}

// Reset the per-section cursors so pass 2 (called via asm_run_line)
// starts at sec_base[i] + 0 for each section. asm_pass3 calls this
// after installing labels from .lab and before re-reading source.
export fn asm_pass2_reset_cursors() -> void {
    set(g_sec_pos, 0, 0);
    set(g_sec_pos, 1, 0);
    set(g_sec_pos, 2, 0);
    set(g_sec_pos, 3, 0);
    g_current_section = 0;
    g_pos = 0;
    g_code_end = 0;
    g_bss_pos = 0;
    return;
}

// ===== .lab dump (pass 1 → stdout) =====
//
// Emits the wrapped .lab format documented in docs/lab_format.md:
//
//     (lab
//     ; lab v1
//     sec 0 <base> <size>
//     sec 1 <base> <size>
//     sec 2 <base> <size>
//     sec 3 <base> <size>
//     lab <addr> <section> <name>
//     ...
//     num <digit> <addr>
//     ...
//     )
//
// asm_pass3 reads this from its stdin (followed immediately by the
// original source) and re-installs the state via the
// asm_install_*_from_lab fns below.

fn dump_int(sb: StringBuffer, v: i32) -> void { emit_int(sb, v); return; }

export fn asm_dump_lab_state() -> void {
    asm_dump_lab_state_to(1);
    return;
}

// fd-parameterised variant — used by asm_pass2 when `--lab-out path`
// is given so the .lab goes to a file instead of stdout. The
// existing zero-arg variant stays for the host stdin pipeline.
export fn asm_dump_lab_state_to(out_fd: i32) -> void {
    var sb: StringBuffer = StringBuffer_new(out_fd);
    emit_string(sb, "(lab"); emit_nl(sb);
    emit_string(sb, "; lab v1"); emit_nl(sb);

    // Meta directives captured during pass 1 source scan. Stream-
    // mode asm_pass3 reads these from the .lab so it doesn't need
    // to probe the source itself before emitting the ELF header.
    emit_string(sb, "raw ");
    dump_int(sb, g_raw_mode);
    emit_nl(sb);
    emit_string(sb, "load_base ");
    dump_int(sb, g_load_vaddr);
    emit_nl(sb);
    // Source byte count for the pass-per-section stream loop in
    // asm_pass3 (each pass reads exactly src_bytes bytes from stdin
    // so they stay aligned across the 3 source copies the caller
    // concatenated).
    emit_string(sb, "src_bytes ");
    dump_int(sb, g_src_bytes);
    emit_nl(sb);

    var i: i32 = 0;
    while i < 4 {
        emit_string(sb, "sec ");
        dump_int(sb, i);
        emit_char(sb, ' ');
        dump_int(sb, get(g_sec_base, i));
        emit_char(sb, ' ');
        dump_int(sb, get(g_sec_size, i));
        emit_nl(sb);
        i = i + 1;
    }

    // src lines: paths that asm-pass2 opens directly (eliminating
    // the cat-p2 concat pre-step). Order matters — pass2 walks them
    // in this order, so prelude must come before user_strip.
    //
    // Pre-encode (Step 5): when prelude bins are wired, replace the
    // first src (prelude.s) with three `src raw` lines pointing to
    // the per-section pre-encoded bins. The prelude.reloc file is
    // copied verbatim afterwards so asm_pass3 can patch the
    // post-memcpy bytes.
    if g_prelude_text_bin as u32 != 0u32 {
        emit_string(sb, "src raw ");
        emit_string(sb, g_prelude_text_bin);
        emit_string(sb, " 0");
        emit_nl(sb);
        if g_prelude_rodata_bin as u32 != 0u32 {
            emit_string(sb, "src raw ");
            emit_string(sb, g_prelude_rodata_bin);
            emit_string(sb, " 1");
            emit_nl(sb);
        }
        if g_prelude_data_bin as u32 != 0u32 {
            emit_string(sb, "src raw ");
            emit_string(sb, g_prelude_data_bin);
            emit_string(sb, " 2");
            emit_nl(sb);
        }
    } else if g_src_path1 as u32 != 0u32 {
        emit_string(sb, "src ");
        emit_string(sb, g_src_path1);
        emit_nl(sb);
    }
    // User pre-encoded bins (linker mode): emit per-section `src raw`
    // entries after the prelude raws. The 4th token on each line is
    // the start offset within the section where this bin's bytes
    // begin — captured by run_link from asm_load_idx_content_start
    // after the user idx loaded its align directives. asm_pass3 pads
    // zeros from the section's running emit cursor up to start_off
    // before the memcpy.
    if g_user_text_bin as u32 != 0u32 {
        emit_string(sb, "src raw ");
        emit_string(sb, g_user_text_bin);
        emit_string(sb, " 0 ");
        dump_int(sb, g_user_text_start);
        emit_nl(sb);
        if g_user_rodata_bin as u32 != 0u32 {
            emit_string(sb, "src raw ");
            emit_string(sb, g_user_rodata_bin);
            emit_string(sb, " 1 ");
            dump_int(sb, g_user_rodata_start);
            emit_nl(sb);
        }
        if g_user_data_bin as u32 != 0u32 {
            emit_string(sb, "src raw ");
            emit_string(sb, g_user_data_bin);
            emit_string(sb, " 2 ");
            dump_int(sb, g_user_data_start);
            emit_nl(sb);
        }
    }
    // Additional inputs beyond user (--add). Same `src raw` shape as
    // the user entry; one set per extra input, in registration order.
    //
    // Incbin-defer (2026-05-09): if this extra had its leading
    // .incbin deferred (g_extra_incbin_present[ei] == 1, sec ==
    // matching), emit a direct `src raw <orig_path> <sec> <abs>`
    // line BEFORE the section's own bin and shift the bin's
    // start by the deferred size. asm_pass3 will memcpy the
    // original blob at <abs> for `<size>` bytes, then memcpy the
    // bin at <abs + size> for whatever post-incbin bytes the
    // section had. Currently incbin-defer only fires for sec == 1
    // (rodata) — pt.s's wrap.s pattern — but the code handles any
    // section uniformly.
    var ei: i32 = 0;
    while ei < g_n_extras {
        var ic_present: i32 = asm_get_extra_incbin_present(ei);
        var ic_sec:     i32 = asm_get_extra_incbin_sec(ei);
        var ic_size:    i32 = asm_get_extra_incbin_size(ei);
        var ic_path:    String = asm_get_extra_incbin_path(ei);
        var et: String = asm_get_extra_text_bin(ei);
        if et as u32 != 0u32 {
            var t_start: i32 = asm_get_extra_text_start(ei);
            if ic_present == 1 && ic_sec == 0 {
                emit_string(sb, "src raw ");
                emit_string(sb, ic_path);
                emit_string(sb, " 0 ");
                dump_int(sb, t_start);
                emit_nl(sb);
                t_start = t_start + ic_size;
            }
            emit_string(sb, "src raw ");
            emit_string(sb, et);
            emit_string(sb, " 0 ");
            dump_int(sb, t_start);
            emit_nl(sb);
        }
        var er: String = asm_get_extra_rodata_bin(ei);
        if er as u32 != 0u32 {
            var r_start: i32 = asm_get_extra_rodata_start(ei);
            if ic_present == 1 && ic_sec == 1 {
                emit_string(sb, "src raw ");
                emit_string(sb, ic_path);
                emit_string(sb, " 1 ");
                dump_int(sb, r_start);
                emit_nl(sb);
                r_start = r_start + ic_size;
            }
            emit_string(sb, "src raw ");
            emit_string(sb, er);
            emit_string(sb, " 1 ");
            dump_int(sb, r_start);
            emit_nl(sb);
        }
        var ed: String = asm_get_extra_data_bin(ei);
        if ed as u32 != 0u32 {
            var d_start: i32 = asm_get_extra_data_start(ei);
            if ic_present == 1 && ic_sec == 2 {
                emit_string(sb, "src raw ");
                emit_string(sb, ic_path);
                emit_string(sb, " 2 ");
                dump_int(sb, d_start);
                emit_nl(sb);
                d_start = d_start + ic_size;
            }
            emit_string(sb, "src raw ");
            emit_string(sb, ed);
            emit_string(sb, " 2 ");
            dump_int(sb, d_start);
            emit_nl(sb);
        }
        ei = ei + 1;
    }

    var li: i32 = 0;
    while li < g_nlabels {
        var lb: Label = get(g_labels, li);
        emit_string(sb, "lab ");
        dump_int(sb, addr(lb));
        emit_char(sb, ' ');
        dump_int(sb, section(lb));
        emit_char(sb, ' ');
        emit_n(sb, g_lab_names, name_off(lb), name_len(lb));
        emit_nl(sb);
        li = li + 1;
    }

    var d: i32 = 0;
    while d < 10 {
        var cnt: i32 = get(g_numlab_count, d);
        var k: i32 = 0;
        while k < cnt {
            emit_string(sb, "num ");
            dump_int(sb, d);
            emit_char(sb, ' ');
            dump_int(sb, numlab_get(d, k));
            emit_nl(sb);
            k = k + 1;
        }
        d = d + 1;
    }

    // Pre-encode (Step 5): copy the prelude's reloc records into the
    // .lab so asm_pass3 patches the post-memcpy bytes after every
    // `src raw` entry. We flush the StringBuffer first so the file
    // bytes don't get sandwiched between buffered emit_string output.
    if g_prelude_reloc as u32 != 0u32 {
        write(sb, out_fd);
        destroy(sb);
        copy_file_to_fd(g_prelude_reloc, out_fd);
        sb = StringBuffer_new(out_fd);
    }
    // Phase F (linker mode): copy user.reloc with each entry's offset
    // shifted by g_user_text_shift so the .lab carries section-
    // absolute (post-concatenation) offsets. Every reloc kind we
    // emit lives in the text section, so only g_user_text_shift is
    // applied — rodata/data relocs would need their own shift.
    if g_user_reloc as u32 != 0u32 {
        write(sb, out_fd);
        destroy(sb);
        copy_reloc_shifted(g_user_reloc, out_fd, g_user_text_shift);
        sb = StringBuffer_new(out_fd);
    }
    // Each extra input's reloc with its own text-section shift.
    var ri: i32 = 0;
    while ri < g_n_extras {
        var er: String = asm_get_extra_reloc(ri);
        if er as u32 != 0u32 {
            write(sb, out_fd);
            destroy(sb);
            copy_reloc_shifted(er, out_fd, asm_get_extra_text_shift(ri));
            sb = StringBuffer_new(out_fd);
        }
        ri = ri + 1;
    }

    emit_char(sb, ')'); emit_nl(sb);
    write(sb, out_fd);
    destroy(sb);
    return;
}

// 4 KB-buffered file copy: open `src_path`, stream sys_read →
// sys_write to `dst_fd`. Used by asm_dump_lab_state_to to splice
// the prelude.reloc lines into the emitted .lab.
fn copy_file_to_fd(src_path: String, dst_fd: i32) -> void {
    var fd: i32 = do_openat(0 - 100, src_path, 0);
    if fd < 0 { return; }
    var buf: U8Array = U8Array(4096);
    var done: i32 = 0;
    while done == 0 {
        var n: i32 = sys_read(fd, buf, 4096);
        if n <= 0 { done = 1; }
        else { sys_write(dst_fd, buf, n); }
    }
    delete(buf);
    do_close(fd);
    return;
}

// Stream a reloc file line by line, rewriting each `reloc <off> <kind>
// <name>` entry's offset with `off + shift` before forwarding to
// dst_fd. Lines that don't match the reloc form pass through unchanged.
// Used by asm_dump_lab_state_to to splice user.reloc into the lab with
// offsets re-expressed in section-absolute coordinates (the prelude
// bytes occupy [0, shift) so user offsets need shift added).
fn copy_reloc_shifted(src_path: String, dst_fd: i32, shift: i32) -> void {
    var fd: i32 = do_openat(0 - 100, src_path, 0);
    if fd < 0 { return; }
    var rd: SourceReader = SourceReader_new(fd);
    var line: U8Array = U8Array(512);
    var sb: StringBuffer = StringBuffer_new(dst_fd);
    var done: i32 = 0;
    while done == 0 && at_eof(rd) == false {
        var llen: i32 = 0;
        var eol: i32 = 0;
        while eol == 0 && at_eof(rd) == false {
            var c: u8 = next(rd);
            if llen < 512 { set(line, llen, c); }
            llen = llen + 1;
            if c == 10u8 { eol = 1; }
        }
        if llen <= 0 { done = 1; }
        else if llen > 512 {
            // Truncated — emit as-is (shouldn't happen for reloc
            // lines, max ~96 bytes per asm_emit_reloc).
            emit_n(sb, line, 0, 512);
        } else if llen >= 7 && get(line, 0) == 'r' as u8
                && get(line, 1) == 'e' as u8
                && get(line, 2) == 'l' as u8
                && get(line, 3) == 'o' as u8
                && get(line, 4) == 'c' as u8
                && get(line, 5) == ' ' as u8 {
            // reloc <off> <kind> <name>\n  →  reloc <off+shift> <kind> <name>\n
            var p: i32 = 6;
            var v: i32 = 0;
            while p < llen && get(line, p) >= '0' as u8 && get(line, p) <= '9' as u8 {
                v = v * 10 + (get(line, p) as i32 - 48);
                p = p + 1;
            }
            emit_string(sb, "reloc ");
            dump_int(sb, v + shift);
            emit_n(sb, line, p, llen - p);
        } else {
            emit_n(sb, line, 0, llen);
        }
    }
    write(sb, dst_fd);
    destroy(sb);
    delete(line);
    close(rd);
    do_close(fd);
    return;
}

// ===== .idx dump (per-file pre-link metadata) =====
//
// See docs/idx_format.md. Called instead of asm_dump_lab_state when
// asm-pass1 is invoked in `--emit-idx` mode (extract pass only — no
// BFS, no fixup, no strip). The label table is dumped with intra
// addresses (= the per-section offset within this file's
// contribution); refs are dumped as (owner_name, target_name) pairs
// since label idx values aren't stable across files (merge re-numbers
// them).
//
// Numlabs are dumped with intra + section so the link step can
// rebase them when section_base is known. The current pass-1a
// `define_numlab(digit, g_pos)` already records the intra value
// (g_pos = sec_pos at the time), but doesn't record section. To
// match the post-merge numlab table semantics we also need to know
// which section the numlab lives in — for now we approximate by
// trusting numlab-back/fwd's same-section closure (numeric labels
// are always intra-function). When the pre-link prelude contains
// only one section per numlab digit, this is exact; the worst case
// is an asm where digit N is defined in both .text and .data, which
// asm-pass1's current model already collapses unsafely. So we record
// the section that was active at the time of the dump (g_current_section).
export fn asm_dump_idx_state(out_fd: i32) -> void {
    var sb: StringBuffer = StringBuffer_new(out_fd);
    emit_string(sb, "(idx"); emit_nl(sb);
    emit_string(sb, "; idx v1"); emit_nl(sb);

    // Meta directives picked up from `; raw` / `; load_base` lines in
    // the source. These are global state that the link step needs;
    // the prelude has them so its idx must carry them through.
    emit_string(sb, "raw ");
    dump_int(sb, g_raw_mode);
    emit_nl(sb);
    emit_string(sb, "load_base ");
    dump_int(sb, g_load_vaddr);
    emit_nl(sb);
    // Source byte count of this idx's input. asm-pass2's per-section
    // stream loop reads exactly src_bytes bytes per pass, so the link
    // step needs (prelude_src_bytes + user_src_bytes). Loader adds
    // this into the running total.
    emit_string(sb, "src_bytes ");
    dump_int(sb, g_src_bytes);
    emit_nl(sb);

    // Per-section start alignment, captured by asm_record_sec_align
    // from the first `.align N` directive seen in each section.
    // Emitted BEFORE secsize so the link step can pre-align sec_pos
    // (and the snap snapshot used by lab lines) before the size
    // contributions land. Only emit lines for non-zero entries to
    // keep idx noise low.
    var ai: i32 = 0;
    while ai < 4 {
        var av: i32 = asm_get_sec_align(ai);
        if av > 0 {
            emit_string(sb, "align ");
            dump_int(sb, ai);
            emit_char(sb, ' ');
            dump_int(sb, av);
            emit_nl(sb);
        }
        ai = ai + 1;
    }

    // Per-file section size contributions. Same as g_sec_pos at the
    // end of pass 1a (each section's intra cursor).
    var i: i32 = 0;
    while i < 4 {
        emit_string(sb, "secsize ");
        dump_int(sb, i);
        emit_char(sb, ' ');
        dump_int(sb, get(g_sec_pos, i));
        emit_nl(sb);
        i = i + 1;
    }

    // All labels with intra addresses + section. No live filter (BFS
    // hasn't run yet).
    var li: i32 = 0;
    while li < g_nlabels {
        var lb: Label = get(g_labels, li);
        // Skip __global_pointer$ — it's a synthetic label created
        // by asm_init_pass1 in every asm-pass1 run, so emitting it
        // into the idx would cause a duplicate definition when load
        // installs it again on top of the synthetic.
        var nlen_lb: i32 = name_len(lb);
        var noff_lb: i32 = name_off(lb);
        var is_gp: i32 = 0;
        if nlen_lb == 17 &&
           get(g_lab_names, noff_lb) == '_' as u8 &&
           get(g_lab_names, noff_lb + 1) == '_' as u8 &&
           get(g_lab_names, noff_lb + 2) == 'g' as u8 &&
           get(g_lab_names, noff_lb + 3) == 'l' as u8 &&
           get(g_lab_names, noff_lb + 4) == 'o' as u8 &&
           get(g_lab_names, noff_lb + 5) == 'b' as u8 &&
           get(g_lab_names, noff_lb + 6) == 'a' as u8 &&
           get(g_lab_names, noff_lb + 7) == 'l' as u8 &&
           get(g_lab_names, noff_lb + 8) == '_' as u8 &&
           get(g_lab_names, noff_lb + 9) == 'p' as u8 &&
           get(g_lab_names, noff_lb + 10) == 'o' as u8 &&
           get(g_lab_names, noff_lb + 11) == 'i' as u8 &&
           get(g_lab_names, noff_lb + 12) == 'n' as u8 &&
           get(g_lab_names, noff_lb + 13) == 't' as u8 &&
           get(g_lab_names, noff_lb + 14) == 'e' as u8 &&
           get(g_lab_names, noff_lb + 15) == 'r' as u8 &&
           get(g_lab_names, noff_lb + 16) == '$' as u8 {
            is_gp = 1;
        }
        if is_gp == 0 {
            emit_string(sb, "lab ");
            dump_int(sb, addr(lb));
            emit_char(sb, ' ');
            dump_int(sb, section(lb));
            emit_char(sb, ' ');
            emit_n(sb, g_lab_names, noff_lb, nlen_lb);
            emit_nl(sb);
        }
        li = li + 1;
    }

    // Numeric labels: intra + section. Section is the one that was
    // active when define_numlab was called — currently we don't track
    // that explicitly per-numlab, so we assume numlabs are .text
    // (digit 0 is by far the most common; bc2asm's `0:` after a
    // branch lands in .text). Future-proof by recording 0 (text);
    // re-derive from source order on the link side if needed.
    var d: i32 = 0;
    while d < 10 {
        var cnt: i32 = get(g_numlab_count, d);
        var k: i32 = 0;
        while k < cnt {
            emit_string(sb, "num ");
            dump_int(sb, d);
            emit_char(sb, ' ');
            dump_int(sb, numlab_get(d, k));
            emit_char(sb, ' ');
            dump_int(sb, 0);  // section: assume text (see comment)
            emit_nl(sb);
            k = k + 1;
        }
        d = d + 1;
    }

    // Ref edges as (owner_name, target_name) pairs. Look both up by
    // idx; skip if either has no entry (shouldn't happen for refs
    // recorded in g_refs, but be safe).
    var r: i32 = 0;
    while r < g_nrefs {
        var pair: i32 = get(g_refs, r);
        var from_idx: i32 = (pair >> 16) & 0xFFFF;
        var to_idx:   i32 = pair & 0xFFFF;
        if from_idx >= 0 && from_idx < g_nlabels &&
           to_idx >= 0 && to_idx < g_nlabels {
            var from_lb: Label = get(g_labels, from_idx);
            var to_lb: Label   = get(g_labels, to_idx);
            emit_string(sb, "ref ");
            emit_n(sb, g_lab_names, name_off(from_lb), name_len(from_lb));
            emit_char(sb, ' ');
            emit_n(sb, g_lab_names, name_off(to_lb), name_len(to_lb));
            emit_nl(sb);
        }
        r = r + 1;
    }

    // Incbin-defer record (2026-05-09). When the .incbin pass-2
    // handler skipped materializing bytes, dump the original
    // (sec, intra_off, size, path) so the link step can emit a
    // direct `src raw <orig_path> <sec> <abs_start>` in the .lab.
    if g_pass1_incbin_present == 1 {
        emit_string(sb, "incbin ");
        dump_int(sb, g_pass1_incbin_sec);
        emit_char(sb, ' ');
        dump_int(sb, g_pass1_incbin_intra_off);
        emit_char(sb, ' ');
        dump_int(sb, g_pass1_incbin_size);
        emit_char(sb, ' ');
        emit_string(sb, g_pass1_incbin_path);
        emit_nl(sb);
    }

    emit_char(sb, ')'); emit_nl(sb);
    write(sb, out_fd);
    destroy(sb);
    return;
}

// ===== .lab install (pass 2 reader → in-memory state) =====
export fn asm_install_label_from_lab(name: U8Array, nlen: i32, addrv: i32, sec: i32) -> void {
    // Merge duplicates last-wins: when the linker loads multiple .idx
    // files (asm_pass2 --link mode) the same label can appear in
    // both prelude and user inputs (task_crt0.s defines fallback
    // `main` / `main__StringArray` stubs that get overridden by the
    // task's own definitions). Without this merge, a stale prelude
    // entry shadows the real one and the reloc patches end up
    // pointing at the fallback. Matches define_label semantics.
    var existing: i32 = find_label(name, nlen);
    if existing >= 0 {
        var lb: Label = get(g_labels, existing);
        addr(lb, addrv);
        section(lb, sec);
        return;
    }
    if g_nlabels >= MAX_LABELS {
        var eb: StringBuffer = StringBuffer_new();
        asm_err_begin(eb);
        emit_string(eb, "lab: label table full: MAX_LABELS=");
        emit_int(eb, MAX_LABELS);
        asm_err_end(eb);
    }
    ensure_name_pool_capacity(g_lab_name_pos + nlen);
    var idx: i32 = g_nlabels;
    g_nlabels = g_nlabels + 1;
    var noff: i32 = g_lab_name_pos;
    var i: i32 = 0;
    while i < nlen {
        set(g_lab_names, (g_lab_name_pos + i), get(name, i));
        i = i + 1;
    }
    g_lab_name_pos = g_lab_name_pos + nlen;
    set(g_labels, idx, make_label(noff, nlen, addrv, sec));
    return;
}

export fn asm_install_numlab_from_lab(digit: i32, addrv: i32) -> void {
    var cnt: i32 = get(g_numlab_count, digit);
    if cnt >= numlab_capacity(digit) {
        var eb: StringBuffer = StringBuffer_new();
        asm_err_begin(eb);
        emit_string(eb, "lab: numlab overflow: digit ");
        emit_int(eb, digit);
        asm_err_end(eb);
    }
    numlab_set(digit, cnt, addrv);
    set(g_numlab_count, digit, cnt + 1);
    return;
}

export fn asm_install_sec_base_size(idx: i32, base: i32, size: i32) -> void {
    set(g_sec_base, idx, base);
    set(g_sec_size, idx, size);
    // g_gp_abs depends on data_base (sec 2) — keep it in sync the
    // moment sec 2 lands. asm_compute_sec_bases does the same thing
    // for pass 1.
    if idx == 2 { g_gp_abs = base + 2048; }
    return;
}

// Stream-mode helpers: asm_pass3 reads `raw` / `load_base` from the
// .lab and calls these so pass 2 knows the meta state before touching
// the source body. Matches asm_parse_meta_directive's effect.
export fn asm_install_raw_mode(v: i32) -> void {
    g_raw_mode = v;
    return;
}
export fn asm_get_raw_mode() -> i32 { return g_raw_mode; }

export fn asm_install_load_base(v: i32) -> void {
    g_load_vaddr = v;
    return;
}
export fn asm_get_load_base() -> i32 { return g_load_vaddr; }

// asm_pass2 counts the source bytes it consumed and stashes the
// total here so asm_dump_lab_state can emit a `src_bytes N` line.
// asm_pass3 reads that and uses it as the per-pass source length.
export fn asm_set_src_bytes(n: i32) -> void {
    g_src_bytes = n;
    return;
}

export fn asm_get_src_bytes() -> i32 {
    return g_src_bytes;
}

// ===== Write ELF (pass 2) =====
fn write_le32(buf: U8Array, off: i32, v: i32) -> void {
    set(buf, off, (v & 255) as u8);
    set(buf, (off+1), ((v >> 8) & 255) as u8);
    set(buf, (off+2), ((v >> 16) & 255) as u8);
    set(buf, (off+3), ((v >> 24) & 255) as u8);
    return;
}

// Stream-mode ELF header emission. Computes filesz/memsz/entry from
// the section sizes installed via asm_install_sec_base_size (= from
// the .lab) and writes the 84-byte header to stdout upfront, before
// any code bytes. Pass 5 (stream mode) uses this in place of
// asm_write_elf, which needs the full g_code buffer at the end.
//
// raw mode (`; raw`) skips the header entirely — subsequent section
// passes write code bytes directly.
export fn asm_write_elf_header_stream() -> void {
    if g_raw_mode == 1 { return; }

    var text_size:   i32 = get(g_sec_size, 0);
    var rodata_size: i32 = get(g_sec_size, 1);
    var data_size:   i32 = get(g_sec_size, 2);
    var bss_size:    i32 = get(g_sec_size, 3);
    var code_size:   i32 = text_size + rodata_size + data_size;
    var mem_size:    i32 = code_size + bss_size;

    var entry: i32 = 0;
    var tmp: U8Array = U8Array(6);
    set(tmp, 0, '_'); set(tmp, 1, 's'); set(tmp, 2, 't');
    set(tmp, 3, 'a'); set(tmp, 4, 'r'); set(tmp, 5, 't');
    entry = label_addr(tmp, 6) + g_load_vaddr + ELF_HDR_SIZE;
    delete(tmp);

    var load_vaddr: i32 = g_load_vaddr;
    var total_filesz: i32 = ELF_HDR_SIZE + code_size;
    var total_memsz: i32 = ELF_HDR_SIZE + mem_size;

    var out: U8Array = U8Array(ELF_HDR_SIZE as u32);
    var i: i32 = 0;
    while i < ELF_HDR_SIZE { set(out, i, 0u8); i = i + 1; }

    set(out, 0, 127u8); set(out, 1, 'E'); set(out, 2, 'L'); set(out, 3, 'F');
    set(out, 4, 1u8); set(out, 5, 1u8); set(out, 6, 1u8);
    set(out, 16, 2u8);
    set(out, 18, 243u8);
    write_le32(out, 20, 1);
    write_le32(out, 24, entry);
    write_le32(out, 28, 52);
    set(out, 40, 52u8);
    set(out, 42, 32u8);
    set(out, 44, 1u8);

    write_le32(out, 52, 1);
    write_le32(out, 56, 0);
    write_le32(out, 60, load_vaddr);
    write_le32(out, 64, load_vaddr);
    write_le32(out, 68, total_filesz);
    write_le32(out, 72, total_memsz);
    write_le32(out, 76, 7);
    write_le32(out, 80, 4096);

    sys_write(g_out_fd, out, ELF_HDR_SIZE);
    delete(out);
    return;
}

// Write the encoded program out. Uses g_code_end as the file size and
// the sum of g_sec_size[] as the memory size (they differ when there
// is bss content). Honors `; raw` (= no ELF header, just code bytes).
export fn asm_write_elf() -> void {
    g_cur_line = 0;
    var code_size: i32 = g_code_end;
    var mem_size:  i32 = get(g_sec_size, 0) + get(g_sec_size, 1) +
                         get(g_sec_size, 2) + get(g_sec_size, 3);

    if g_raw_mode == 1 {
        sys_write(g_out_fd, g_code, code_size);
        return;
    }

    var out: U8Array = U8Array(4096);
    var entry: i32 = 0;
    var tmp: U8Array = U8Array(6);
    set(tmp, 0, '_'); set(tmp, 1, 's'); set(tmp, 2, 't');
    set(tmp, 3, 'a'); set(tmp, 4, 'r'); set(tmp, 5, 't');
    entry = label_addr(tmp, 6) + g_load_vaddr + ELF_HDR_SIZE;
    delete(tmp);

    var load_vaddr: i32 = g_load_vaddr;
    var total_filesz: i32 = ELF_HDR_SIZE + code_size;
    var total_memsz: i32 = ELF_HDR_SIZE + mem_size;

    var i: i32 = 0;
    while i < ELF_HDR_SIZE { set(out, i, 0u8); i = i + 1; }

    set(out, 0, 127u8); set(out, 1, 'E'); set(out, 2, 'L'); set(out, 3, 'F');
    set(out, 4, 1u8); set(out, 5, 1u8); set(out, 6, 1u8);
    set(out, 16, 2u8);
    set(out, 18, 243u8);
    write_le32(out, 20, 1);
    write_le32(out, 24, entry);
    write_le32(out, 28, 52);
    set(out, 40, 52u8);
    set(out, 42, 32u8);
    set(out, 44, 1u8);

    write_le32(out, 52, 1);
    write_le32(out, 56, 0);
    write_le32(out, 60, load_vaddr);
    write_le32(out, 64, load_vaddr);
    write_le32(out, 68, total_filesz);
    write_le32(out, 72, total_memsz);
    write_le32(out, 76, 7);
    write_le32(out, 80, 4096);

    sys_write(g_out_fd, out, ELF_HDR_SIZE);
    sys_write(g_out_fd, g_code, code_size);
    delete(out);
    return;
}

// ===== .idx loader (per-file pre-link metadata) =====
//
// Reads a `.idx` (docs/idx_format.md) and merges its contents into
// the current asm-pass1 state. Used by `asm_pass2 --load-idx
// <prelude.idx>` to skip walking the prelude source on every OS-side
// compile (kernel build pre-links the prelude once, OS resumes from
// the .idx).
//
// Merge semantics:
// - secsize <s> <size>: this file added `size` bytes to section s.
//   We snapshot g_sec_pos[s] at the start of the load and finalise
//   each section's per-file contribution into g_sec_pos[s] = snap[s]
//   + size.
// - lab <intra> <s> <name>: install at absolute intra (within the
//   current accumulated layout) = snap[s] + intra. Section is `s`.
//   Goes through asm_install_label_from_lab so duplicates get the
//   addr/section update (last-wins; matches define_label).
// - num <digit> <intra> <s>: install via asm_install_numlab_from_lab
//   with intra value = snap[s] + intra.
// - ref <owner_name> <target_name>: look up owner in g_labels (must
//   already be loaded from this idx's lab lines, which precede
//   refs in the on-disk layout). For the target, try find_label —
//   if it hits, append edge (owner_idx, target_idx) to g_refs;
//   otherwise queue as deferred (resolved at link time once the
//   user source has been processed).
fn idx_is_ws(c: u8) -> bool { return c == ' ' || c == 9u8; }
fn idx_is_digit(c: u8) -> bool { return c >= '0' && c <= '9'; }

fn idx_skip_ws(buf: U8Array, p: i32, end: i32) -> i32 {
    while p < end && idx_is_ws(get(buf, p)) { p = p + 1; }
    return p;
}

// Parse a non-negative i32 starting at p. Returns the value via
// g_idx_int, the new cursor via g_idx_cur.
var g_idx_int: i32 = 0;
var g_idx_cur: i32 = 0;
fn idx_parse_dec(buf: U8Array, p: i32, end: i32) -> void {
    var neg: i32 = 0;
    if p < end && get(buf, p) == '-' { neg = 1; p = p + 1; }
    var v: i32 = 0;
    while p < end && idx_is_digit(get(buf, p)) {
        v = v * 10 + (get(buf, p) as i32 - 48);
        p = p + 1;
    }
    if neg == 1 { v = 0 - v; }
    g_idx_int = v;
    g_idx_cur = p;
    return;
}

// Find end-of-token (whitespace / newline / end). Returns end cursor.
fn idx_token_end(buf: U8Array, p: i32, end: i32) -> i32 {
    while p < end && !idx_is_ws(get(buf, p))
                  && get(buf, p) != 10u8 && get(buf, p) != 13u8 {
        p = p + 1;
    }
    return p;
}

// Trim trailing CR / LF / WS from a (start, end) name slice.
fn idx_trim_end(buf: U8Array, start: i32, end: i32) -> i32 {
    while end > start {
        var tc: u8 = get(buf, end - 1);
        if tc != 10u8 && tc != 13u8 && tc != ' ' && tc != 9u8 { return end; }
        end = end - 1;
    }
    return end;
}

// Process one `.idx` line. snap[] is the per-file section_pos
// snapshot taken at load start. Returns 1 if the closing `)` was
// seen.
fn idx_process_line(buf: U8Array, blen: i32, snap: I32Array) -> i32 {
    var p: i32 = idx_skip_ws(buf, 0, blen);
    if p >= blen { return 0; }
    var c: u8 = get(buf, p);
    if c == 10u8 || c == 13u8 { return 0; }
    if c == ';' { return 0; }
    if c == '(' { return 0; }
    if c == ')' { return 1; }

    if blen - p >= 4 && cmp(buf, p, "raw ") {
        idx_parse_dec(buf, p + 4, blen);
        asm_install_raw_mode(g_idx_int);
        return 0;
    }
    if blen - p >= 10 && cmp(buf, p, "load_base ") {
        idx_parse_dec(buf, p + 10, blen);
        asm_install_load_base(g_idx_int);
        return 0;
    }
    if blen - p >= 10 && cmp(buf, p, "src_bytes ") {
        idx_parse_dec(buf, p + 10, blen);
        asm_set_src_bytes(g_src_bytes + g_idx_int);
        return 0;
    }
    if blen - p >= 6 && cmp(buf, p, "align ") {
        // Pre-align the snap (and g_sec_pos) for this section to
        // n_bytes. Emitted by asm_dump_idx_state from
        // asm_record_sec_align — captures the first `.align N`
        // directive a section saw during pass1. At link time this
        // reproduces the inter-idx padding the legacy walked-source
        // flow inserted as its single cursor crossed the directive.
        idx_parse_dec(buf, p + 6, blen);
        var asec: i32 = g_idx_int;
        idx_parse_dec(buf, idx_skip_ws(buf, g_idx_cur, blen), blen);
        var an: i32 = g_idx_int;
        if asec >= 0 && asec < 4 && an > 0 {
            var cur: i32 = get(snap, asec);
            var aligned: i32 = (cur + an - 1) & (0 - an);
            set(snap, asec, aligned);
            set(g_sec_pos, asec, aligned);
            ensure_load_idx_content_start();
            set(g_load_idx_content_start, asec, aligned);
        }
        return 0;
    }
    if blen - p >= 8 && cmp(buf, p, "secsize ") {
        idx_parse_dec(buf, p + 8, blen);
        var sec_id: i32 = g_idx_int;
        idx_parse_dec(buf, idx_skip_ws(buf, g_idx_cur, blen), blen);
        var sec_sz: i32 = g_idx_int;
        if sec_id >= 0 && sec_id < 4 {
            set(g_sec_pos, sec_id, get(snap, sec_id) + sec_sz);
        }
        return 0;
    }
    if blen - p >= 4 && cmp(buf, p, "lab ") {
        idx_parse_dec(buf, p + 4, blen);
        var laddr: i32 = g_idx_int;
        idx_parse_dec(buf, idx_skip_ws(buf, g_idx_cur, blen), blen);
        var lsec: i32 = g_idx_int;
        var ns: i32 = idx_skip_ws(buf, g_idx_cur, blen);
        var ne: i32 = idx_trim_end(buf, ns, blen);
        var nlen: i32 = ne - ns;
        if nlen > 0 && lsec >= 0 && lsec < 4 {
            var name: U8Array = U8Array((nlen) as u32);
            var i: i32 = 0;
            while i < nlen { set(name, i, get(buf, (ns + i))); i = i + 1; }
            asm_install_label_from_lab(name, nlen, get(snap, lsec) + laddr, lsec);
            delete(name);
        }
        return 0;
    }
    if blen - p >= 4 && cmp(buf, p, "num ") {
        idx_parse_dec(buf, p + 4, blen);
        var dig: i32 = g_idx_int;
        idx_parse_dec(buf, idx_skip_ws(buf, g_idx_cur, blen), blen);
        var nintra: i32 = g_idx_int;
        idx_parse_dec(buf, idx_skip_ws(buf, g_idx_cur, blen), blen);
        var nsec: i32 = g_idx_int;
        if dig >= 0 && dig < 10 && nsec >= 0 && nsec < 4 {
            asm_install_numlab_from_lab(dig, get(snap, nsec) + nintra);
        }
        return 0;
    }
    if blen - p >= 7 && cmp(buf, p, "incbin ") {
        // incbin <sec> <intra_off> <size> <path>
        // Recorded by asm_pass1 when --incbin-skip deferred a
        // section-leading .incbin. Caller (run_link / run_link_finish)
        // queries g_load_incbin_* after asm_load_idx and stores per
        // input slot for emit_link_lab to interleave src raw lines.
        idx_parse_dec(buf, p + 7, blen);
        var ic_sec: i32 = g_idx_int;
        idx_parse_dec(buf, idx_skip_ws(buf, g_idx_cur, blen), blen);
        var ic_intra: i32 = g_idx_int;
        idx_parse_dec(buf, idx_skip_ws(buf, g_idx_cur, blen), blen);
        var ic_size: i32 = g_idx_int;
        var ic_ps: i32 = idx_skip_ws(buf, g_idx_cur, blen);
        var ic_pe: i32 = idx_trim_end(buf, ic_ps, blen);
        var ic_plen: i32 = ic_pe - ic_ps;
        if ic_plen > 0 && ic_sec >= 0 && ic_sec < 4 {
            // Allocate a String to outlive this line buffer.
            var ic_pbuf: U8Array = U8Array((ic_plen + 1) as u32);
            var ic_pi: i32 = 0;
            while ic_pi < ic_plen {
                set(ic_pbuf, ic_pi, get(buf, (ic_ps + ic_pi)));
                ic_pi = ic_pi + 1;
            }
            set(ic_pbuf, ic_plen, 0u8);
            poke32(ic_pbuf as u32, ic_plen as u32);
            g_load_incbin_present   = 1;
            g_load_incbin_sec       = ic_sec;
            g_load_incbin_intra_off = ic_intra;
            g_load_incbin_size      = ic_size;
            g_load_incbin_path      = ic_pbuf as u32 as String;
        }
        return 0;
    }
    if blen - p >= 4 && cmp(buf, p, "ref ") {
        var os: i32 = idx_skip_ws(buf, p + 4, blen);
        var oe: i32 = idx_token_end(buf, os, blen);
        var olen: i32 = oe - os;
        var ts: i32 = idx_skip_ws(buf, oe, blen);
        var te: i32 = idx_trim_end(buf, ts, blen);
        var tlen: i32 = te - ts;
        if olen > 0 && tlen > 0 {
            // Look up owner. Skip silently if not found (shouldn't
            // happen — labs precede refs in the dump).
            var oname: U8Array = U8Array((olen) as u32);
            var i: i32 = 0;
            while i < olen { set(oname, i, get(buf, (os + i))); i = i + 1; }
            var owner_idx: i32 = find_label(oname, olen);
            delete(oname);
            if owner_idx >= 0 {
                // record_ref uses g_owner_idx as the source; set it
                // around the call. Need ref state allocated +
                // g_collecting_refs on (set elsewhere by caller).
                var saved_owner: i32 = g_owner_idx;
                g_owner_idx = owner_idx;
                var tname: U8Array = U8Array((tlen) as u32);
                var j: i32 = 0;
                while j < tlen { set(tname, j, get(buf, (ts + j))); j = j + 1; }
                record_ref(tname, tlen);
                delete(tname);
                g_owner_idx = saved_owner;
            }
        }
        return 0;
    }
    return 0;
}

export fn asm_load_idx(path: String) -> i32 {
    // Reset incbin transient: caller queries g_load_incbin_* after
    // each asm_load_idx call to capture per-input incbin records.
    g_load_incbin_present   = 0;
    g_load_incbin_sec       = 0;
    g_load_incbin_intra_off = 0;
    g_load_incbin_size      = 0;
    g_load_incbin_path      = 0 as String;

    var fd: i32 = do_openat(0 - 100, path, 0);
    if fd < 0 { return 0 - 1; }
    // Snapshot per-section cursors so this idx's intra addrs map to
    // (snap + intra) absolute-within-current-layout values. Round each
    // up to 16-byte alignment first: when this is the second (or
    // later) idx loaded — asm_pass2's --link mode chains
    // prelude.idx + user.idx — the .s for idx N+1 starts each
    // section with `.align 4` (= 16-byte). Without the round-up,
    // user labels land at unaligned offsets that don't match what
    // the legacy walked-source flow produced. For a single-idx load
    // (legacy --load-idx + walk source), all sec_pos values are 0
    // here so the round-up is a no-op.
    // Section-start alignment is communicated per-idx via `align <s>
    // <bytes>` lines emitted by asm_pass1 (recorded while walking
    // user.s the first time it hits a `.align N` directive after a
    // section change). idx_process_line applies them to g_sec_pos
    // before the labels are installed, so the legacy walked-source
    // flow's "padding inserted as the cursor crosses .align" is
    // reproduced at link time without re-walking user.s.
    var snap: I32Array = I32Array(4);
    set(snap, 0, get(g_sec_pos, 0));
    set(snap, 1, get(g_sec_pos, 1));
    set(snap, 2, get(g_sec_pos, 2));
    set(snap, 3, get(g_sec_pos, 3));
    // Reset the per-section content-start tracker to the pre-load
    // sec_pos values. align lines in the idx will overwrite each
    // section's slot as they fire; sections without an align line
    // retain the pre-load value (the previous idx's sec end).
    ensure_load_idx_content_start();
    var i_cs: i32 = 0;
    while i_cs < 4 {
        set(g_load_idx_content_start, i_cs, get(g_sec_pos, i_cs));
        i_cs = i_cs + 1;
    }

    // Make sure g_refs / deferred queue exist before record_ref
    // runs from inside idx_process_line.
    asm_set_collecting_refs(1);

    var reader: SourceReader = SourceReader_new(fd);
    var line: U8Array = U8Array(4092);
    var done: i32 = 0;
    while done == 0 && at_eof(reader) == false {
        var llen: i32 = 0;
        var eol: i32 = 0;
        while eol == 0 && at_eof(reader) == false {
            var c: u8 = next(reader);
            if llen < 4092 { set(line, llen, c); }
            llen = llen + 1;
            if c == 10u8 { eol = 1; }
        }
        if llen > 4092 { llen = 4092; }
        if llen > 0 {
            if idx_process_line(line, llen, snap) != 0 { done = 1; }
        }
    }
    delete(line);
    delete(snap);
    close(reader);
    do_close(fd);
    return 0;
}

// Forward decls — bodies live in the per-platform crt0 (host
// bootstrap/crt0.s, OS task_crt0.s). asm_pass2 already declares them
// for its src open path, but asm_load_idx in this file (asm_common)
// also needs them.
fn do_openat(dirfd: i32, path: String, flags: i32) -> i32;
fn do_close(fd: i32) -> i32;
