// sigscan.tc — Scan AST for top-level declarations and emit extended .th
//
// Reads .ast (S-expression) from stdin, outputs the **extended .th**
// described in docs/ast_format.md "拡張 .th":
//
//   - All `fn` (export AND non-export) — header only (params + ret,
//     no body / block). Non-export ones include parser-synthesized
//     struct accessors (constructor, getter, setter, delete, XxxArray,
//     len/get/set), so struct field info is carried by those entries
//     and we don't need to encode fields directly under (struct ...).
//   - `struct` — name only, no fields (same as the legacy .th).
//   - `var_decl` — top-level globals, type only (no init expression).
//
// Compared to compiler/extract_sigs.tc this drops the :export filter
// and adds var_decl emission. tcheck consumes this via the -s argv
// flag for self forward reference resolution; legacy typecheck.tc
// continues to use extract_sigs's narrower output for imports.

import "string_buffer.tc";
import "source_reader.tc";
import "ast_node.tc";
import "strlib.tc";

// Runtime helper, linked from runtime.tc. Prints per-task kmalloc peak
// and live byte counts to stderr in the form "[kmem peak=N live=M]".
fn km_dump_peak() -> void;

// Node kind constants (subset sigscan compares against). Numbers must
// match the canonical list in ast_node.tc — TC has no `export const`,
// so this is a manual copy; classify_kind / read_node live in
// ast_node.tc, so a drifted number here fails the kind comparisons
// below loudly in the test suite.
const NK_FN:       i32 = 1;
const NK_STRUCT:   i32 = 2;
const NK_PARAMS:   i32 = 3;
const NK_RET:      i32 = 5;
const NK_TYPE:     i32 = 6;
const NK_VAR_DECL: i32 = 8;
const NK_CONST_DECL: i32 = 27;

// The S-expression reader (read_node mode 2: keep headers only,
// silent-consume everything else) and emit_kind live in ast_node.tc.

// ===== Output =====

// Generic recursive emitter for nodes whose kinds we know (params,
// param, ret, type). Used for the children of fn / var_decl.
fn write_node(nodes: AstNodeArray, strtab: U8Array, ob: StringBuffer, indent: i32, n: i32) -> void {
    emit_indent(ob, indent);
    emit_char(ob, '(');
    var k: i32 = n_kind(nodes, n);
    emit_kind(k, ob);

    var tass: i32 = n_tass(nodes, n);
    var tasl: i32 = n_tasl(nodes, n);
    if tass >= 0 && tasl > 0 {
        emit_char(ob, ':');
        emit_n(ob, strtab, tass, tasl);
    }

    if n_sl(nodes, n) > 0 {
        emit_char(ob, ' ');
        emit_n(ob, strtab, n_ss(nodes, n), n_sl(nodes, n));
    }

    var first_child: i32 = n_child(nodes, n);
    if first_child < 0 {
        emit_char(ob, ')');
    } else {
        var c: i32 = first_child;
        while c >= 0 {
            emit_nl(ob);
            write_node(nodes, strtab, ob, (indent + 1), c);
            c = n_sib(nodes, c);
        }
        emit_nl(ob);
        emit_indent(ob, indent);
        emit_char(ob, ')');
    }
    return;
}

// Emit a fn header (fn name + params + ret, skip block). Identical to
// extract_sigs.tc's write_fn_header.
fn write_fn_header(nodes: AstNodeArray, strtab: U8Array, ob: StringBuffer, indent: i32, n: i32) -> void {
    emit_indent(ob, indent);
    emit_char(ob, '(');
    emit_kind(n_kind(nodes, n), ob);

    var tass: i32 = n_tass(nodes, n);
    var tasl: i32 = n_tasl(nodes, n);
    if tass >= 0 && tasl > 0 {
        emit_char(ob, ':');
        emit_n(ob, strtab, tass, tasl);
    }

    if n_sl(nodes, n) > 0 {
        emit_char(ob, ' ');
        emit_n(ob, strtab, n_ss(nodes, n), n_sl(nodes, n));
    }

    // Output only params and ret children, skip block
    var c: i32 = n_child(nodes, n);
    var has_child: i32 = 0;
    while c >= 0 {
        var ck: i32 = n_kind(nodes, c);
        if ck == NK_PARAMS || ck == NK_RET {
            emit_nl(ob);
            write_node(nodes, strtab, ob, (indent + 1), c);
            has_child = 1;
        }
        c = n_sib(nodes, c);
    }
    if has_child == 1 {
        emit_nl(ob);
        emit_indent(ob, indent);
    }
    emit_char(ob, ')');
    return;
}

// Emit a top-level var_decl / const_decl: "(<kw> name (type ...))".
// Strips the optional init expression because tcheck only needs the
// type (+ const-ness, carried by the keyword) to put the global into
// the symbol table. Using a dedicated emitter avoids recursing into
// init expression nodes (int / call / binop / ...) for which sigscan
// has no NK_ constants.
fn write_global_var(nodes: AstNodeArray, strtab: U8Array, ob: StringBuffer, indent: i32, n: i32, kw: StringLiteral) -> void {
    emit_indent(ob, indent);
    emit_char(ob, '(');
    emit_string(ob, kw);
    if n_sl(nodes, n) > 0 {
        emit_char(ob, ' ');
        emit_n(ob, strtab, n_ss(nodes, n), n_sl(nodes, n));
    }
    var c: i32 = n_child(nodes, n);
    var emitted_type: i32 = 0;
    while c >= 0 {
        if n_kind(nodes, c) == NK_TYPE {
            emit_nl(ob);
            write_node(nodes, strtab, ob, (indent + 1), c);
            emitted_type = 1;
            c = -1;
        } else {
            c = n_sib(nodes, c);
        }
    }
    if emitted_type == 1 {
        emit_nl(ob);
        emit_indent(ob, indent);
    }
    emit_char(ob, ')');
    return;
}

// ===== Main =====
//
// Per-top-level streaming: read "(program", then loop reading 1
// top-level S-expression at a time, emit it, and reset the AST node
// pool + strtab cursor before reading the next one. read_node mode 2
// (ast_node.tc) also drops anything outside should_keep_sig() (block,
// field, expression nodes, ...) without allocating, so the peak is bounded
// to the few header nodes (params + ret + their immediate children).
//
// Measured peaks across compiler/*.tc with the skip optimization:
//   nc max  = 22 (parse.tc / bc2asm.tc)
//   sp max  = 167 (bc2asm.tc)
// The fixed buffers are sized at ~3x of those for safety; everything
// else (kmalloc bookkeeping, SourceReader, StringBuffer scratch) is
// small. See `[kmem peak=...]` printed at exit.
fn main() -> i32 {
    var nodes: AstNodeArray = AstNodeArray(64);
    var strtab: U8Array = U8Array(512);
    var atom_buf: U8Array = U8Array(256);
    var ob: StringBuffer = StringBuffer_new(1);

    rd_set_reader(SourceReader_new(0));
    ast_set_count(0);
    rd_set_sp(0);

    // Consume "(program" header
    skip_ws_in();
    if rd_at_eof() { sys_exit(1); }
    if peek_in() != '(' { sys_exit(2); }
    rd_next();
    skip_ws_in();
    var pgm_len: i32 = read_atom_in(atom_buf);
    if !streq(atom_buf, 0, pgm_len, "program") { sys_exit(3); }

    emit_string(ob, "(program");
    emit_nl(ob);

    // Loop over top-level children of (program ...)
    skip_ws_in();
    while peek_in() == '(' {
        // Reset pool + strtab cursor so each top-level decl starts
        // from a clean slate. Without this the pool fills up after
        // a handful of top levels and read_node aborts with
        // "out of bounds".
        reset_node_pool(nodes);
        rd_set_sp(0);

        var n: i32 = read_node(atom_buf, nodes, strtab, 2);
        // n == -1 is now a normal "this top-level was a skipped kind
        // (comment / import / unknown)" signal. The reader has already
        // consumed the closing ')', so just loop around.
        if n < 0 {
            skip_ws_in();
            // continue while loop
        } else {
            var k: i32 = n_kind(nodes, n);
        if k == NK_FN {
            // All fns (export and non-export). The parser-synthesized
            // struct accessor fns (fn Foo, fn f1 getter, fn f1 setter,
            // fn delete, fn FooArray, fn len/get/set) come through
            // here naturally.
            write_fn_header(nodes, strtab, ob, 1, n);
            emit_nl(ob);
        }
        if k == NK_STRUCT {
            // Struct name only (no fields). Field info is implied by
            // the synthesized accessor fns above.
            emit_indent(ob, 1);
            emit_char(ob, '(');
            emit_string(ob, "struct");
            emit_char(ob, ' ');
            emit_n(ob, strtab, n_ss(nodes, n), n_sl(nodes, n));
            emit_char(ob, ')');
            emit_nl(ob);
        }
        if k == NK_VAR_DECL {
            // Top-level global declaration.
            write_global_var(nodes, strtab, ob, 1, n, "var_decl");
            emit_nl(ob);
        }
        if k == NK_CONST_DECL {
            write_global_var(nodes, strtab, ob, 1, n, "const_decl");
            emit_nl(ob);
        }
        // Other top-level kinds (comment, import, ...) are dropped.
        }

        skip_ws_in();
    }

    // Consume the closing ')' of (program ...)
    if peek_in() == ')' { rd_next(); }

    emit_char(ob, ')');
    emit_nl(ob);
    write(ob, 1);

    close(rd_reader());
    delete(nodes); delete(strtab); delete(atom_buf); destroy(ob);

    // Print "[kmem peak=N live=M]" to stderr — same line task_crt0.s
    // emits on the kernel side. On the OS this is automatic; on host
    // (compile-gen1.sh + qemu-riscv32) we call it explicitly so the
    // diff harness can sanity-check sigscan stays inside its budget.
    km_dump_peak();
    return 0;
}
