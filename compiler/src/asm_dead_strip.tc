// asm_dead_strip.tc — link-time dead-code analysis (Phase A + B).
//
// Design: docs/task/asm_dead_strip.md.
//
// Phase A: collect the cross-program reference graph from each input's
// .idx (`ref` lines) and .rl (`reloc` lines), run BFS from a hardcoded
// root set, and stash a live[] bitmap. Print `[dead-strip live=N
// total=M edges=E]` to stderr.
//
// Phase B (this commit): asm_dump_lab_state_to reads g_ds_live and
// skips `lab` lines for dead labels. asm_pass3's reloc stream silently
// skips relocs whose target lookup fails — those targets disappeared
// because they were dead. Final ELF bytes are unchanged (Phase C will
// compact the byte ranges), but asm_pass3's label state shrinks by
// however many labels BFS marked dead.
//
// Roots are derived from what crt0_tc.s / task_crt0.s / platform_*.s
// reference unconditionally — see docs/task/asm_dead_strip.md §1.

import "asm_common.tc";
import "source_reader.tc";

fn do_openat(dirfd: i32, path: String, flags: i32) -> i32;
fn do_close(fd: i32) -> i32;

// Hand the computed live bitmap to asm_common.tc so its
// asm_dump_lab_state_to label loop can consult it. Body is in
// asm_common.tc.
fn asm_dead_strip_set_live(bitmap: U8Array, n: i32) -> void;

// ===== Small helpers =====

fn ds_streq_lit(buf: U8Array, n: i32, lit: StringLiteral) -> i32 {
    if n != len(lit) { return 0; }
    var i: i32 = 0;
    while i < n {
        if get(buf, i) != get(lit, i) as u8 { return 0; }
        i = i + 1;
    }
    return 1;
}

fn ds_is_ws(c: u8) -> i32 {
    if c == ' ' as u8 { return 1; }
    if c == 9u8 { return 1; }
    return 0;
}

fn ds_is_digit(c: u8) -> i32 {
    if c >= '0' as u8 && c <= '9' as u8 { return 1; }
    return 0;
}

fn ds_skip_ws(buf: U8Array, p: i32, end: i32) -> i32 {
    var q: i32 = p;
    while q < end && ds_is_ws(get(buf, q)) != 0 { q = q + 1; }
    return q;
}

fn ds_token_end(buf: U8Array, p: i32, end: i32) -> i32 {
    var q: i32 = p;
    while q < end {
        var c: u8 = get(buf, q);
        if ds_is_ws(c) != 0 || c == 10u8 || c == 13u8 { return q; }
        q = q + 1;
    }
    return q;
}

fn ds_parse_int(buf: U8Array, p: i32, end: i32) -> i32 {
    var q: i32 = p;
    var neg: i32 = 0;
    if q < end && get(buf, q) == '-' as u8 { neg = 1; q = q + 1; }
    var v: i32 = 0;
    while q < end && ds_is_digit(get(buf, q)) != 0 {
        v = v * 10 + (get(buf, q) as i32 - 48);
        q = q + 1;
    }
    if neg == 1 { v = 0 - v; }
    return v;
}

// ===== Root identification =====
//
// These names MUST stay live regardless of whether anything ref-edges
// them. Sourced from crt0_tc.s, kernel/tasks/task_crt0.s, and the
// kernel/platform_*.s entry points (see docs/task/asm_dead_strip.md §1).
fn ds_is_root_name(buf: U8Array, n: i32) -> i32 {
    if ds_streq_lit(buf, n, "_start") != 0 { return 1; }
    if ds_streq_lit(buf, n, "main") != 0 { return 1; }
    if ds_streq_lit(buf, n, "main__StringArray") != 0 { return 1; }
    if ds_streq_lit(buf, n, "__runtime_init__u32__i32") != 0 { return 1; }
    if ds_streq_lit(buf, n, "__global_pointer$") != 0 { return 1; }
    if ds_streq_lit(buf, n, "__data_end") != 0 { return 1; }
    if ds_streq_lit(buf, n, "__arena") != 0 { return 1; }
    if ds_streq_lit(buf, n, "_trap_frame") != 0 { return 1; }
    // Kernel-side entries that platform_*.s pulls in unconditionally.
    if ds_streq_lit(buf, n, "kern_main") != 0 { return 1; }
    if ds_streq_lit(buf, n, "_trap_entry") != 0 { return 1; }
    // Pico 2: IMAGE_DEF block at flash start. RP2350 boot ROM scans
    // for this 32-byte block; no code references it but it must stay
    // in the linked binary.
    if ds_streq_lit(buf, n, "__embedded_block") != 0 { return 1; }
    return 0;
}

// ===== Edge buffer (packed `(from << 16) | to`) =====

var g_ds_edges:    I32Array = 0 as I32Array;
var g_ds_n_edges:  i32 = 0;
var g_ds_edges_cap: i32 = 0;

fn ds_edges_init() -> void {
    // 16383 (just under 16384): I32Array(16383) = 65536 bytes = exact
    // 64 KB large_alloc slot. Bumped from 4095 to skip three doublings
    // (4095 → 8191 → 16383 → 32767). On asm_pass2 self-build with 8
    // inputs the doubling from 32 KB → 64 KB hit OOM mid-execution
    // because live state was already ~315 KB and max contig free was
    // ~49 KB. Pre-allocating 64 KB at task startup (when live is
    // ~10 KB and 390 KB is contig free) avoids the mid-execution
    // 64 KB-contig requirement. ~16 K edges covers compiler self-build
    // worst case (8 inputs × ~1500 edges average).
    g_ds_edges_cap = 16383;
    g_ds_edges     = I32Array((g_ds_edges_cap) as u32);
    g_ds_n_edges   = 0;
    return;
}

fn ds_edges_grow() -> void {
    var new_cap: i32 = g_ds_edges_cap * 2 + 1;  // 4095 → 8191 → 16383
    var new_buf: I32Array = I32Array((new_cap) as u32);
    var i: i32 = 0;
    while i < g_ds_n_edges {
        set(new_buf, i, get(g_ds_edges, i));
        i = i + 1;
    }
    delete(g_ds_edges);
    g_ds_edges = new_buf;
    g_ds_edges_cap = new_cap;
    return;
}

fn ds_add_edge(from_idx: i32, to_idx: i32) -> void {
    if from_idx < 0 { return; }
    if to_idx < 0 { return; }
    if g_ds_n_edges >= g_ds_edges_cap { ds_edges_grow(); }
    set(g_ds_edges, g_ds_n_edges, (from_idx << 16) | (to_idx & 0xFFFF));
    g_ds_n_edges = g_ds_n_edges + 1;
    return;
}

// ===== Owner lookup for relocs =====
//
// Linear scan over g_labels: find the label with the largest
// section-relative addr ≤ `sec_off` whose section matches `sec`.
// Acceptable cost for Phase A — typically called ~3000 times with
// ~2000-label tables, so ~6M comparisons total.
fn ds_find_owner(sec: i32, sec_off: i32) -> i32 {
    var n: i32 = asm_get_nlabels();
    var sec_base: i32 = asm_get_sec_base(sec);
    var best_idx: i32 = 0 - 1;
    var best_off: i32 = 0 - 1;
    var i: i32 = 0;
    while i < n {
        if asm_label_section_at(i) == sec {
            var lab_sec_off: i32 = asm_label_addr_at(i) - sec_base;
            if lab_sec_off <= sec_off && lab_sec_off > best_off {
                best_off = lab_sec_off;
                best_idx = i;
            }
        }
        i = i + 1;
    }
    return best_idx;
}

// ===== Scan one .idx for `ref <owner> <target>` lines =====

fn ds_scan_idx_refs(idx_path: String) -> void {
    if idx_path as u32 == 0u32 { return; }
    var fd: i32 = do_openat(0 - 100, idx_path, 0);
    if fd < 0 { return; }
    var reader: SourceReader = SourceReader_new(fd);
    var line: U8Array = U8Array(4092);
    while at_eof(reader) == false {
        var llen: i32 = 0;
        var eol: i32 = 0;
        while eol == 0 && at_eof(reader) == false {
            var c: u8 = next(reader);
            if llen < 4092 { set(line, llen, c); }
            llen = llen + 1;
            if c == 10u8 { eol = 1; }
        }
        if llen > 4092 { llen = 4092; }
        // Match `ref <from_name> <to_name>` at start of line.
        if llen >= 5 &&
           get(line, 0) == 'r' as u8 &&
           get(line, 1) == 'e' as u8 &&
           get(line, 2) == 'f' as u8 &&
           get(line, 3) == ' ' as u8 {
            var os: i32 = ds_skip_ws(line, 4, llen);
            var oe: i32 = ds_token_end(line, os, llen);
            var ts: i32 = ds_skip_ws(line, oe, llen);
            var te: i32 = ds_token_end(line, ts, llen);
            var olen: i32 = oe - os;
            var tlen: i32 = te - ts;
            if olen > 0 && tlen > 0 {
                var oname: U8Array = U8Array(olen as u32);
                var i: i32 = 0;
                while i < olen { set(oname, i, get(line, os + i)); i = i + 1; }
                var owner_idx: i32 = asm_find_label_idx(oname, olen);
                delete(oname);

                var tname: U8Array = U8Array(tlen as u32);
                i = 0;
                while i < tlen { set(tname, i, get(line, ts + i)); i = i + 1; }
                var target_idx: i32 = asm_find_label_idx(tname, tlen);
                delete(tname);

                ds_add_edge(owner_idx, target_idx);
            }
        }
    }
    delete(line);
    close(reader);
    do_close(fd);
    return;
}

// ===== Scan one .rl for `reloc <off> <kind> <name>` lines =====
//
// `text_shift` lets us convert the per-input intra-section offset back
// into the merged section-absolute coord that lines up with the unified
// label table.
fn ds_scan_rl_relocs(rl_path: String, text_shift: i32) -> void {
    if rl_path as u32 == 0u32 { return; }
    var fd: i32 = do_openat(0 - 100, rl_path, 0);
    if fd < 0 { return; }
    var reader: SourceReader = SourceReader_new(fd);
    var line: U8Array = U8Array(512);
    while at_eof(reader) == false {
        var llen: i32 = 0;
        var eol: i32 = 0;
        while eol == 0 && at_eof(reader) == false {
            var c: u8 = next(reader);
            if llen < 512 { set(line, llen, c); }
            llen = llen + 1;
            if c == 10u8 { eol = 1; }
        }
        if llen > 512 { llen = 512; }
        if llen >= 7 &&
           get(line, 0) == 'r' as u8 &&
           get(line, 1) == 'e' as u8 &&
           get(line, 2) == 'l' as u8 &&
           get(line, 3) == 'o' as u8 &&
           get(line, 4) == 'c' as u8 &&
           get(line, 5) == ' ' as u8 {
            // reloc <off> <kind> <name>
            // off is intra-section in the .rl (asm_pass1 emit time).
            var p: i32 = 6;
            var off_intra: i32 = ds_parse_int(line, p, llen);
            // Advance past the off token and whitespace.
            while p < llen && (ds_is_digit(get(line, p)) != 0 || get(line, p) == '-' as u8) { p = p + 1; }
            p = ds_skip_ws(line, p, llen);
            // Skip kind token (single digit).
            while p < llen && ds_is_digit(get(line, p)) != 0 { p = p + 1; }
            p = ds_skip_ws(line, p, llen);
            // Name token (trim trailing LF/CR/WS).
            var ns: i32 = p;
            var ne: i32 = llen;
            var trimming: i32 = 1;
            while trimming == 1 && ne > ns {
                var tc: u8 = get(line, ne - 1);
                if tc == 10u8 || tc == 13u8 || tc == ' ' as u8 || tc == 9u8 {
                    ne = ne - 1;
                } else {
                    trimming = 0;
                }
            }
            var nlen: i32 = ne - ns;
            if nlen > 0 {
                var tname: U8Array = U8Array(nlen as u32);
                var i: i32 = 0;
                while i < nlen { set(tname, i, get(line, ns + i)); i = i + 1; }
                var target_idx: i32 = asm_find_label_idx(tname, nlen);
                delete(tname);

                // All asm_emit_reloc call sites are in the text section,
                // so look up the owner there. text_shift converts the
                // intra-input offset to the merged-section coord that
                // matches the unified label addrs.
                var owner_idx: i32 = ds_find_owner(0, off_intra + text_shift);
                ds_add_edge(owner_idx, target_idx);
            }
        }
    }
    delete(line);
    close(reader);
    do_close(fd);
    return;
}

// ===== Print int helper (decimal, to stderr) =====

fn ds_eprint_int(v: i32) -> void {
    if v == 0 {
        sys_write(2, "0" as u32 as U8Array, 1);
        return;
    }
    var neg: i32 = 0;
    if v < 0 { neg = 1; v = 0 - v; }
    var buf: U8Array = U8Array(16);
    var n: i32 = 0;
    while v > 0 {
        set(buf, n, (48 + v % 10) as u8);
        n = n + 1;
        v = v / 10;
    }
    if neg == 1 { sys_write(2, "-" as u32 as U8Array, 1); }
    var out: U8Array = U8Array(n as u32);
    var i: i32 = 0;
    while i < n {
        set(out, i, get(buf, n - 1 - i));
        i = i + 1;
    }
    sys_write(2, out, n);
    delete(buf);
    delete(out);
    return;
}

// ===== Entry point =====
//
// Caller supplies the list of idx paths (in the same order asm_pass2
// loaded them), the parallel list of .rl paths, and the per-input
// text shifts. Builds the graph, BFSes from roots, stashes live[] in
// g_ds_live, and prints the stats line to stderr. The dump path
// (asm_dump_lab_state_to) consults g_ds_live via asm_dead_strip_is_live.
export fn asm_analyze_dead_strip(idx_paths: StringArray,
                                 rl_paths:  StringArray,
                                 text_shifts: I32Array,
                                 n_inputs: i32) -> void {
    var n_labels: i32 = asm_get_nlabels();
    if n_labels <= 0 { return; }
    if n_inputs <= 0 { return; }

    ds_edges_init();

    // Collect edges from idx ref lines.
    var i: i32 = 0;
    while i < n_inputs {
        ds_scan_idx_refs(get(idx_paths, i));
        i = i + 1;
    }

    // Collect edges from .rl reloc lines.
    i = 0;
    while i < n_inputs {
        ds_scan_rl_relocs(get(rl_paths, i), get(text_shifts, i));
        i = i + 1;
    }

    // BFS from roots. Allocate a fresh live bitmap and install it
    // via asm_dead_strip_set_live so asm_dump_lab_state_to (in
    // asm_common.tc) can consult it without importing this module.
    var live: U8Array = U8Array(n_labels as u32);
    var queue: I32Array = I32Array(n_labels as u32);
    var qhead: i32 = 0;
    var qtail: i32 = 0;

    i = 0;
    while i < n_labels {
        var nm: U8Array = asm_label_name_at(i);
        var nlen: i32 = asm_label_name_len_at(i);
        if ds_is_root_name(nm, nlen) != 0 {
            set(live, i, 1u8);
            set(queue, qtail, i);
            qtail = qtail + 1;
        }
        i = i + 1;
    }

    // Scan-all BFS — O(V × E) but the constants are small (V ~ 2000,
    // E ~ 5000, BFS depth ~ 10 → ~100 M iterations worst case, runs
    // in <1 s). Adjacency lists would speed this up but cost ~32 KB
    // more peak; not worth it.
    while qhead < qtail {
        var from: i32 = get(queue, qhead);
        qhead = qhead + 1;
        var e: i32 = 0;
        while e < g_ds_n_edges {
            var pair: i32 = get(g_ds_edges, e);
            var ef: i32 = (pair >> 16) & 0xFFFF;
            var et: i32 = pair & 0xFFFF;
            if ef == from && get(live, et) == 0u8 {
                set(live, et, 1u8);
                set(queue, qtail, et);
                qtail = qtail + 1;
            }
            e = e + 1;
        }
    }

    var live_count: i32 = 0;
    i = 0;
    while i < n_labels {
        if get(live, i) != 0u8 { live_count = live_count + 1; }
        i = i + 1;
    }

    sys_write(2, "[dead-strip live=" as u32 as U8Array, 17);
    ds_eprint_int(live_count);
    sys_write(2, " total=" as u32 as U8Array, 7);
    ds_eprint_int(n_labels);
    sys_write(2, " edges=" as u32 as U8Array, 7);
    ds_eprint_int(g_ds_n_edges);
    sys_write(2, "]\n" as u32 as U8Array, 2);

    delete(g_ds_edges);
    g_ds_edges = 0 as I32Array;
    g_ds_n_edges = 0;
    g_ds_edges_cap = 0;
    delete(queue);
    // Hand ownership of `live` to asm_common.tc. The caller (asm_pass2)
    // is the only consumer; bitmap survives until process exit.
    asm_dead_strip_set_live(live, n_labels);

    // Phase C: compact the byte layout — build per-section dead
    // ranges, adjust label addrs / sec_base / sec_size / gp_abs /
    // reloc offsets. asm_pass3 honors the `skip` lines in the .lab.
    ds_compact();
    return;
}

// ===== Phase C.1: compaction analysis (diagnostic only) =====
//
// After BFS, walk per-section labels in addr order and compute the
// total dead bytes per section. C.1 only prints diagnostics — no
// adjustment to g_sec_size / label.addr / reloc offsets yet. C.2 will
// wire those in along with the asm_pass3 skip-aware memcpy.
//
// Workspace: a packed I32Array sized to nlabels used as the
// per-section sorted label index list. Allocated once, reused per
// section. Insertion sort over typically ≤ 1500 labels in text →
// O(N²) = ~2M comparisons, well under a second.

// Sort label indices in `section` by addr into `out` (insertion sort).
// Returns the number of labels in the section.
// __global_pointer$ is recorded in section 0 (text) but its addr lives
// out in the data range (gp_abs = data_base + 2048). The per-section
// compaction walk must exclude it: sorted by addr it lands after every
// real text label, so the last real text label would take gp's addr as
// its next_addr and — if that label is dead — record a phantom dead
// range spanning all of rodata, driving the text section size negative.
// ds_compact Phase 3 rewrites gp's addr on its own dedicated path.
fn ds_is_global_pointer(idx: i32) -> i32 {
    return ds_streq_lit(asm_label_name_at(idx), asm_label_name_len_at(idx),
                        "__global_pointer$");
}

fn ds_sort_section(section: i32, out: I32Array) -> i32 {
    var n: i32 = 0;
    var total: i32 = asm_get_nlabels();
    var i: i32 = 0;
    while i < total {
        if asm_label_section_at(i) == section
            && ds_is_global_pointer(i) == 0 {
            set(out, n, i);
            n = n + 1;
        }
        i = i + 1;
    }
    // Insertion sort by asm_label_addr_at.
    var k: i32 = 1;
    while k < n {
        var cur_idx: i32 = get(out, k);
        var cur_addr: i32 = asm_label_addr_at(cur_idx);
        var j: i32 = k - 1;
        var done: i32 = 0;
        while j >= 0 && done == 0 {
            var prev_idx: i32 = get(out, j);
            var prev_addr: i32 = asm_label_addr_at(prev_idx);
            if prev_addr <= cur_addr {
                done = 1;
            } else {
                set(out, j + 1, prev_idx);
                j = j - 1;
            }
        }
        set(out, j + 1, cur_idx);
        k = k + 1;
    }
    return n;
}

// ===== Phase C.2: compaction =====
//
// Dead-range storage lives in asm_common.tc — see asm_ds_dr_add /
// asm_ds_n_dead_ranges / ds_compacted_offset there. ds_compact below
// is the producer; asm_dump_lab_state_to and copy_reloc_shifted are
// the consumers.

fn ds_align16(v: i32) -> i32 {
    return (v + 15) & (0 - 16);
}

// ds_compact — Phase C.2.
//
// Walks per-section labels in addr order, builds dead-range table,
// rewrites label addrs / sec_size / sec_base / gp_abs to compacted
// coordinates. asm_dump_lab_state_to and copy_reloc_shifted then
// emit the compacted .lab.
export fn ds_compact() -> void {
    var nl: i32 = asm_get_nlabels();
    if nl <= 0 { return; }
    var workspace: I32Array = I32Array(nl as u32);
    var per_label_gap: I32Array = I32Array(nl as u32);
    var total_dead_s: I32Array = I32Array(4);

    // Phase 1: per-section sort + dead-range collection. Gap[label]
    // is the cum dead bytes WITHIN this section before this label.
    //
    // Labels at the SAME addr are aliases (e.g. task_crt0.s defines
    // do_openat__String and do_openat__StringLiteral at the same byte
    // offset). Their bytes are owned collectively — dead iff ALL
    // aliases are dead. Process by addr-group: scan consecutive labels
    // at the same addr, OR their liveness, and only record a dead range
    // when the entire group is dead.
    var s: i32 = 0;
    while s < 4 {
        if s == 3 {
            // bss: no file bytes to compact.
            set(total_dead_s, s, 0);
            s = s + 1;
            continue;
        }
        var n_in_sec: i32 = ds_sort_section(s, workspace);
        var section_end: i32 = asm_get_sec_base(s + 1);
        var cum_dead: i32 = 0;
        var i: i32 = 0;
        while i < n_in_sec {
            var lab_addr: i32 = asm_label_addr_at(get(workspace, i));
            // Find end of this addr group + OR liveness across it.
            var j: i32 = i;
            var group_live: i32 = 0;
            while j < n_in_sec
                && asm_label_addr_at(get(workspace, j)) == lab_addr {
                if asm_dead_strip_is_live(get(workspace, j)) != 0 {
                    group_live = 1;
                }
                j = j + 1;
            }
            var next_addr: i32 = section_end;
            if j < n_in_sec {
                next_addr = asm_label_addr_at(get(workspace, j));
            }
            // Assign the same gap to every member of the group.
            var k: i32 = i;
            while k < j {
                set(per_label_gap, get(workspace, k), cum_dead);
                k = k + 1;
            }
            if group_live == 0 && next_addr > lab_addr {
                // Store dead range in INTRA-section coords (label addrs
                // are absolute after asm_fixup_labels, so subtract
                // sec_base to recover intra). asm_pass3's src raw `start`
                // offsets are also intra-section, so this lines up at
                // filter time.
                var sec_base_s: i32 = asm_get_sec_base(s);
                var dr_start: i32 = lab_addr - sec_base_s;
                var dr_end:   i32 = next_addr - sec_base_s;
                asm_ds_dr_add(s, dr_start, dr_end);
                cum_dead = cum_dead + (dr_end - dr_start);
            }
            i = j;
        }
        set(total_dead_s, s, cum_dead);
        s = s + 1;
    }

    // Phase 2: compute new sec_size / sec_base. Original sec_size is
    // already 16-aligned; subtracting the dead bytes may de-align, so
    // re-round-up. (Within-section labels don't reference the trailing
    // alignment padding, so live label addrs stay valid relative to
    // sec_base.)
    var orig_text:   i32 = asm_get_sec_size(0);
    var orig_rodata: i32 = asm_get_sec_size(1);
    var orig_data:   i32 = asm_get_sec_size(2);
    var orig_bss:    i32 = asm_get_sec_size(3);
    var new_text:    i32 = ds_align16(orig_text   - get(total_dead_s, 0));
    var new_rodata:  i32 = ds_align16(orig_rodata - get(total_dead_s, 1));
    var new_data:    i32 = ds_align16(orig_data   - get(total_dead_s, 2));
    var new_bss:     i32 = orig_bss;
    asm_set_sec_size(0, new_text);
    asm_set_sec_size(1, new_rodata);
    asm_set_sec_size(2, new_data);
    asm_set_sec_size(3, new_bss);
    asm_set_sec_base(0, 0);
    asm_set_sec_base(1, new_text);
    asm_set_sec_base(2, new_text + new_rodata);
    asm_set_sec_base(3, new_text + new_rodata + new_data);
    asm_set_gp_abs(new_text + new_rodata + 2048);

    // Phase 3: rewrite live label addrs. section_shift[s] is the
    // cumulative reduction in section sizes for sections 0..s-1
    // (NOT the raw dead-byte total — alignment rounds the new sizes
    // up to a 16-byte multiple, so the actual base shift may differ
    // from the unaligned dead count by a few bytes per section).
    var shift0: i32 = 0;
    var shift1: i32 = orig_text - new_text;
    var shift2: i32 = shift1 + (orig_rodata - new_rodata);
    var shift3: i32 = shift2 + (orig_data - new_data);
    var li: i32 = 0;
    while li < nl {
        if asm_dead_strip_is_live(li) != 0 {
            var lsec: i32 = asm_label_section_at(li);
            var shift: i32 = shift0;
            if lsec == 1 { shift = shift1; }
            if lsec == 2 { shift = shift2; }
            if lsec == 3 { shift = shift3; }
            var gap: i32 = get(per_label_gap, li);
            var new_addr: i32 = asm_label_addr_at(li) - shift - gap;
            asm_set_label_addr(li, new_addr);
        }
        li = li + 1;
    }

    // __global_pointer$ is synthetic: defined in section 0 (text) for
    // bookkeeping but its addr lives in the data range (gp_abs =
    // data_base + 2048). The generic shift-by-section-and-gap logic
    // above would treat its out-of-text addr as the "last text label"
    // and compute a bogus gap. Override with the freshly recomputed
    // g_gp_abs so kind=1 PC-rel relocs targeting __global_pointer$
    // resolve to the right post-compaction address.
    var gp_sym: U8Array = U8Array(20);
    var gp_p: i32 = 0;
    set(gp_sym, gp_p, '_' as u8); gp_p = gp_p + 1;
    set(gp_sym, gp_p, '_' as u8); gp_p = gp_p + 1;
    set(gp_sym, gp_p, 'g' as u8); gp_p = gp_p + 1;
    set(gp_sym, gp_p, 'l' as u8); gp_p = gp_p + 1;
    set(gp_sym, gp_p, 'o' as u8); gp_p = gp_p + 1;
    set(gp_sym, gp_p, 'b' as u8); gp_p = gp_p + 1;
    set(gp_sym, gp_p, 'a' as u8); gp_p = gp_p + 1;
    set(gp_sym, gp_p, 'l' as u8); gp_p = gp_p + 1;
    set(gp_sym, gp_p, '_' as u8); gp_p = gp_p + 1;
    set(gp_sym, gp_p, 'p' as u8); gp_p = gp_p + 1;
    set(gp_sym, gp_p, 'o' as u8); gp_p = gp_p + 1;
    set(gp_sym, gp_p, 'i' as u8); gp_p = gp_p + 1;
    set(gp_sym, gp_p, 'n' as u8); gp_p = gp_p + 1;
    set(gp_sym, gp_p, 't' as u8); gp_p = gp_p + 1;
    set(gp_sym, gp_p, 'e' as u8); gp_p = gp_p + 1;
    set(gp_sym, gp_p, 'r' as u8); gp_p = gp_p + 1;
    set(gp_sym, gp_p, '$' as u8); gp_p = gp_p + 1;
    var gp_idx: i32 = asm_find_label_idx(gp_sym, gp_p);
    if gp_idx >= 0 {
        asm_set_label_addr(gp_idx, new_text + new_rodata + 2048);
    }
    delete(gp_sym);

    sys_write(2, "[dead-strip compact text=" as u32 as U8Array, 25);
    ds_eprint_int(get(total_dead_s, 0));
    sys_write(2, " rodata=" as u32 as U8Array, 8);
    ds_eprint_int(get(total_dead_s, 1));
    sys_write(2, " data=" as u32 as U8Array, 6);
    ds_eprint_int(get(total_dead_s, 2));
    sys_write(2, " ranges=" as u32 as U8Array, 8);
    ds_eprint_int(asm_ds_n_dead_ranges());
    sys_write(2, "]\n" as u32 as U8Array, 2);

    delete(workspace);
    delete(per_label_gap);
    delete(total_dead_s);
    return;
}

