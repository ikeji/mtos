// asm_pass2_lib.tc — linker merge for the asm split (Phase F).
//
// `run_link` consumes pass1 outputs (.idx + per-section .bin + .reloc)
// for prelude + user + N extras, then writes a single `.lab` whose
// `src raw` entries point at the bin files for asm_pass3 to memcpy.

import "asm_common.tc";
import "asm_dead_strip.tc";
import "string_buffer.tc";
import "source_reader.tc";

// km_dump_peak — printed at exit on the OS so test_phase7.sh can
// see the per-stage memory peak. No-op stub on Gen1 (bootstrap), see
// bootstrap/runtime_syscall.c.
fn km_dump_peak() -> void;

// File-open syscalls. Forward decls; bodies live in compiler/crt0_tc.s
// (host) and kernel/tasks/task_crt0.s (OS).
fn do_openat(dirfd: i32, path: String, flags: i32) -> i32;
fn do_close(fd: i32) -> i32;

// Derive a sibling path by stripping `.idx` and appending `suffix`.
// The convention is: every `--add <foo.idx>` input has matching
// `foo.tx` / `foo.ro` / `foo.dt` / `foo.rl` siblings in the same
// directory. asm_pass1 callers are responsible for naming the outputs
// this way; bin2s_incbin.sh + compile-gen2.sh + every on-device
// fixture already do.
fn derive_sibling(idx_path: String, suffix: StringLiteral) -> String {
    var n: i32 = len(idx_path);
    var slen: i32 = len(suffix);
    // Require the idx_path to end in `.idx`. Strip those 4 chars.
    var stem: i32 = n - 4;
    if stem < 0 { return 0 as String; }
    if get(idx_path, stem)     != '.' as u8 ||
       get(idx_path, stem + 1) != 'i' as u8 ||
       get(idx_path, stem + 2) != 'd' as u8 ||
       get(idx_path, stem + 3) != 'x' as u8 {
        return 0 as String;
    }
    var out_len: i32 = stem + slen;
    // Layout: count (4 bytes) + payload (out_len bytes) + NUL.
    var buf: U8Array = U8Array((out_len + 1) as u32);
    var i: i32 = 0;
    while i < stem {
        set(buf, i, get(idx_path, i) as u8);
        i = i + 1;
    }
    var j: i32 = 0;
    while j < slen {
        set(buf, stem + j, get(suffix, j) as u8);
        j = j + 1;
    }
    set(buf, out_len, 0u8);
    poke32(buf as u32, out_len as u32);
    return buf as u32 as String;
}

// Linker mode (Phase F of the asm split). No source walk — every
// input is a pass1 output. Each idx file (v2) carries its own
// per-section .bin + .reloc paths in the header, so the CLI only
// needs to pass idx paths.
//
// Inputs are consumed in order: with N inputs (N >= 1)
//   - input[0] sets raw/load_base authority and lands at sec_pos 0
//   - input[1..N-1] load on top, each at the running sec_pos of the
//     prior input, with their reloc text offsets shifted by the
//     accumulated text size
//
// asm_pass3 then memcpies the bins in section order and patches the
// relocs — never reopening either source.
//
// Internally we keep the (prelude, user, extras) split that the lab
// dumper expects: input[0] fills prelude_*; input[1] fills user_*;
// input[2..] go through asm_add_extra_input. The single-input case
// (no prelude side) lands the lone input in user_* with text_shift 0.
export fn run_link(idx_paths: StringArray, n_inputs: i32,
                   lab_out_path: String) -> i32 {
    asm_init_pass1();
    asm_set_pass(1);

    if n_inputs < 1 { return 0 - 1; }

    var has_prelude: i32 = 0;
    if n_inputs >= 2 { has_prelude = 1; }

    var saved_raw:       i32 = 0;
    var saved_load_base: i32 = 0;
    if has_prelude == 1 {
        var prelude_idx: String = get(idx_paths, 0);
        asm_load_idx(prelude_idx);
        // Snapshot raw / load_base from the prelude (its `; raw` /
        // `; load_base` directives drive how the final binary is
        // wrapped). Later inputs' defaults (`raw 0`, `load_base
        // 65536`) would otherwise overwrite them.
        saved_raw       = asm_get_raw_mode();
        saved_load_base = asm_get_load_base();
        asm_set_prelude_text_bin(  derive_sibling(prelude_idx, ".tx"));
        asm_set_prelude_rodata_bin(derive_sibling(prelude_idx, ".ro"));
        asm_set_prelude_data_bin(  derive_sibling(prelude_idx, ".dt"));
        asm_set_prelude_reloc(     derive_sibling(prelude_idx, ".rl"));
    }

    // user slot. Either input[0] (single-input case) or input[1].
    var user_slot: i32 = 0;
    if has_prelude == 1 { user_slot = 1; }
    var user_idx: String = get(idx_paths, user_slot);
    asm_load_idx(user_idx);
    var user_text_start:   i32 = asm_load_idx_content_start(0);
    var user_rodata_start: i32 = asm_load_idx_content_start(1);
    var user_data_start:   i32 = asm_load_idx_content_start(2);
    if has_prelude == 1 {
        asm_install_raw_mode(saved_raw);
        asm_install_load_base(saved_load_base);
    }
    asm_set_user_text_bin(  derive_sibling(user_idx, ".tx"));
    asm_set_user_rodata_bin(derive_sibling(user_idx, ".ro"));
    asm_set_user_data_bin(  derive_sibling(user_idx, ".dt"));
    asm_set_user_reloc(     derive_sibling(user_idx, ".rl"));
    asm_set_user_text_shift(user_text_start);
    asm_set_user_text_start(user_text_start);
    asm_set_user_rodata_start(user_rodata_start);
    asm_set_user_data_start(user_data_start);

    // Register inputs 2..N-1 as extras. run_link_finish loads each
    // one and captures its bin/reloc paths from g_load_* after the
    // load.
    var ei_reg: i32 = user_slot + 1;
    while ei_reg < n_inputs {
        asm_add_extra_input(get(idx_paths, ei_reg));
        ei_reg = ei_reg + 1;
    }

    return run_link_finish(idx_paths, n_inputs, has_prelude, lab_out_path);
}

// Build the parallel (rl_paths, text_shifts) arrays the dead-strip
// analyzer needs, then run BFS. Caller has already finished
// asm_fixup_labels so every label.addr is in its final post-merge
// coord — which is what ds_find_owner compares against.
fn run_dead_strip_analysis(idx_paths: StringArray, n_inputs: i32,
                           has_prelude: i32) -> void {
    var rl_paths: StringArray = StringArray((n_inputs) as u32);
    var text_shifts: I32Array = I32Array((n_inputs) as u32);
    var i: i32 = 0;
    while i < n_inputs {
        set(rl_paths, i, derive_sibling(get(idx_paths, i), ".rl"));
        i = i + 1;
    }
    // Input 0 (prelude OR sole input) starts at text shift 0; user +
    // extras come in at increasing shifts captured during their loads.
    set(text_shifts, 0, 0);
    if has_prelude == 1 {
        set(text_shifts, 1, asm_get_user_text_shift());
        var ei: i32 = 0;
        while ei < asm_get_n_extras() {
            set(text_shifts, 2 + ei, asm_get_extra_text_shift(ei));
            ei = ei + 1;
        }
    } else {
        // n_inputs == 1 in single-input mode (no extras get attached).
        var ei2: i32 = 0;
        while ei2 < asm_get_n_extras() {
            set(text_shifts, 1 + ei2, asm_get_extra_text_shift(ei2));
            ei2 = ei2 + 1;
        }
    }
    asm_analyze_dead_strip(idx_paths, rl_paths, text_shifts, n_inputs);
    delete(rl_paths);
    delete(text_shifts);
    return;
}

// Process any extra inputs (registered before the run_link call via
// asm_add_extra_input from the CLI parser), then dump the lab.
// Factored out of run_link so the extras-loop runs after every
// run_link variant, regardless of how the prelude/user pair was
// wired in.
fn run_link_finish(idx_paths: StringArray, n_inputs: i32,
                   has_prelude: i32, lab_out_path: String) -> i32 {
    // Snapshot raw / load_base from whichever input set them last
    // (typically the prelude). Each extra idx might carry its own
    // `raw 0` / `load_base 65536` defaults that would otherwise
    // overwrite the prelude's `; raw` setting on the second / Nth
    // load. Restore after every extra has been ingested.
    var saved_raw_2:       i32 = asm_get_raw_mode();
    var saved_load_base_2: i32 = asm_get_load_base();
    var ei: i32 = 0;
    while ei < asm_get_n_extras() {
        // Capture the running text size BEFORE this idx loads — this
        // is the shift to apply to its reloc text offsets so they
        // land at section-absolute coordinates in the merged lab.
        asm_set_extra_text_shift(ei, asm_sec_pos(0));
        var ex_idx: String = asm_get_extra_idx(ei);
        if ex_idx as u32 != 0u32 { asm_load_idx(ex_idx); }
        // After the idx's align directives have applied,
        // asm_load_idx_content_start tells us where this input's
        // bytes actually begin in each section.
        asm_set_extra_text_start(  ei, asm_load_idx_content_start(0));
        asm_set_extra_rodata_start(ei, asm_load_idx_content_start(1));
        asm_set_extra_data_start(  ei, asm_load_idx_content_start(2));
        // Derive this extra's bin/reloc paths from its idx path by
        // suffix convention (`.idx` → `.tx`/`.ro`/`.dt`/`.rl` siblings
        // in the same directory).
        asm_set_extra_text_bin(  ei, derive_sibling(ex_idx, ".tx"));
        asm_set_extra_rodata_bin(ei, derive_sibling(ex_idx, ".ro"));
        asm_set_extra_data_bin(  ei, derive_sibling(ex_idx, ".dt"));
        asm_set_extra_reloc(     ei, derive_sibling(ex_idx, ".rl"));
        // Capture any incbin record this extra carried (set by
        // idx_process_line when an `incbin` line was parsed).
        if asm_get_load_incbin_present() == 1 {
            asm_set_extra_incbin(ei, 1,
                asm_get_load_incbin_sec(),
                asm_get_load_incbin_intra_off(),
                asm_get_load_incbin_size(),
                asm_get_load_incbin_path());
        }
        ei = ei + 1;
    }
    asm_install_raw_mode(saved_raw_2);
    asm_install_load_base(saved_load_base_2);

    // After every input has loaded, compute section bases / sizes
    // from the merged sec_pos and turn intra label addresses into
    // absolutes.
    asm_compute_sec_bases();
    asm_finalize_labels();
    asm_resolve_deferred_refs();
    asm_fixup_labels();

    // Phase B dead-strip: builds the cross-program ref graph, runs BFS
    // from roots, and stashes the live[] bitmap in g_ds_live.
    // asm_dump_lab_state_to consults it via asm_dead_strip_is_live to
    // omit `lab` lines for unreachable labels. Reloc lines flow
    // through unchanged — asm_pass3 silently skips relocs whose target
    // disappears (the dead-target case can't happen by BFS invariant
    // unless the owner is also dead, in which case the bytes are
    // unexecuted regardless).
    run_dead_strip_analysis(idx_paths, n_inputs, has_prelude);

    if lab_out_path as u32 != 0u32 {
        var lab_fd: i32 = do_openat(0 - 100, lab_out_path, 577);
        if lab_fd >= 0 {
            asm_dump_lab_state_to(lab_fd);
            do_close(lab_fd);
        }
    } else {
        asm_dump_lab_state();
    }

    km_dump_peak();
    return 0;
}

