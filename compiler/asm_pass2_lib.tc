// asm_pass2.tc — label collector half of the asm split (Phase 2 #56).
//
// Reads a `.s` source one line at a time and writes a `.lab`
// (docs/lab_format.md) so asm-pass2 can encode the binary in one
// linear scan.
//
// Source path:
//   - With argv[1] set (OS-side, msh script invoking
//     `asm_pass2 /sd/full.s`): re-readable file, the dead-strip
//     Phase 3 second source pass is enabled, refs include forward
//     edges, and the .lab dump filters by the live bitmap.
//   - Without argv (host stdin pipe via compile-gen2.sh / kernel
//     build): single source pass, dead-strip skipped (we keep all
//     labels). Host has plenty of memory and isn't size-bound.

import "asm_common.tc";
import "string_buffer.tc";
import "source_reader.tc";

// km_dump_peak — printed at exit on the OS so test_phase7.sh can
// see the per-stage memory peak. No-op stub on Gen1 (bootstrap), see
// bootstrap/runtime_syscall.c.
fn km_dump_peak() -> void;

// File-open syscalls. Forward decls; bodies live in compiler/crt0_tc.s
// (host) and kernel/tasks/task_crt0.s (OS).
fn do_openat(dirfd: i32, path: String, flags: i32) -> i32;
fn do_close(fd: i32) -> i32;

// Process the source coming from `reader` line by line. Calls
// asm_run_line which (in pass 1) collects labels, advances section
// cursors, and records reference-graph edges via record_ref.
fn process_source(reader: SourceReader) -> i32 {
    var line: U8Array = U8Array(4092);
    var lineno: i32 = 0;
    var total_bytes: i32 = 0;

    while at_eof(reader) == false {
        var llen: i32 = 0;
        var eol: i32 = 0;
        while eol == 0 && at_eof(reader) == false {
            var c: u8 = next(reader);
            if llen >= 4092 {
                var eb: StringBuffer = StringBuffer_new();
                asm_err_begin(eb);
                emit_string(eb, "line too long (max 4092 bytes)");
                asm_err_end(eb);
            }
            set(line, llen, c);
            llen = llen + 1;
            if c == 10u8 { eol = 1; }
        }
        total_bytes = total_bytes + llen;
        if llen == 0 { } else {
            lineno = lineno + 1;
            if asm_parse_meta_directive(line, llen) == 1 {
                // Discard meta directive lines.
            } else {
                asm_run_line(line, llen, lineno);
            }
        }
    }
    delete(line);
    return total_bytes;
}

// run — actual work, parameterised by the source path. src_path = 0
// means "no path, use stdin"; in that mode the full source is walked
// from fd 0 (host stdin pipe). With src_path set the file is opened
// and walked once.
//
// emit_idx_path: when non-zero the run processes the source through
// pass 1a only and writes a `.idx` (per-file metadata: secsize /
// labels intra / refs by name) instead of going through fixup / lab
// dump. Used by asm_pass1 (which calls run() internally in three
// steps to produce the .idx + .lab + per-section .bin outputs the
// linker consumes).
export fn run(src_path: String, emit_idx_path: String,
              lab_out_path: String) -> i32 {
    asm_init_pass1();
    asm_set_pass(1);

    var src_fd: i32 = 0;
    var have_path: i32 = 0;
    if src_path as u32 != 0u32 {
        var fd: i32 = do_openat(0 - 100, src_path, 0);  // AT_FDCWD, O_RDONLY
        if fd >= 0 {
            src_fd = fd;
            have_path = 1;
        }
    }

    var reader: SourceReader = SourceReader_new(src_fd);
    // Pass 1a collects refs inline (backward ones resolved
    // immediately, forward ones queued in g_def_*) so we don't need
    // a second source walk. We need the per-file ref edges only when
    // emitting .idx — drop the ~88 KB of ref+def state otherwise so
    // M7-full parse.tc compiles fit in a 320 KB asm_pass2 task arena.
    var collect_refs: i32 = 0;
    if emit_idx_path as u32 != 0u32 { collect_refs = 1; }
    if collect_refs == 0 {
        asm_set_collecting_refs(0);
        asm_release_ref_state();
    } else {
        asm_set_collecting_refs(1);
    }
    var total_bytes: i32 = process_source(reader);
    if collect_refs != 0 { asm_set_collecting_refs(0); }
    close(reader);
    if have_path != 0 { do_close(src_fd); }

    // .idx emit: skip fixup / .lab dump and write the raw per-file
    // metadata (intra addrs, secsize, refs by name) to the requested
    // file. Drain intra-file forward refs first so backward-ref edges
    // are in g_refs; truly-cross-file refs stay in the deferred queue
    // and the link step resolves them.
    if emit_idx_path as u32 != 0u32 {
        asm_finalize_labels();           // hash for fast deferred drain
        asm_resolve_deferred_refs();     // intra-file forward refs only
        asm_set_src_bytes(total_bytes);  // captured into idx for link
        var out_fd: i32 = do_openat(0 - 100, emit_idx_path, 577);
        if out_fd >= 0 {
            asm_dump_idx_state(out_fd);
            do_close(out_fd);
        }
        km_dump_peak();
        return 0;
    }

    // .lab emit (no idx): finalize labels, then drain forward refs
    // and run a single fixup pass to turn intra addresses into
    // absolutes.
    asm_compute_sec_bases();
    asm_set_src_bytes(total_bytes);

    if have_path != 0 {
        asm_finalize_labels();
        asm_resolve_deferred_refs();
    }

    asm_fixup_labels();

    if lab_out_path as u32 != 0u32 {
        // O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 = 577.
        var lab_fd: i32 = do_openat(0 - 100, lab_out_path, 577);
        if lab_fd >= 0 {
            asm_dump_lab_state_to(lab_fd);
            do_close(lab_fd);
        }
    } else {
        asm_dump_lab_state();
    }

    km_dump_peak();
    return 0;
}

// Linker mode (Phase F of the asm split). No source walk — both
// inputs are pass1 outputs. Loads prelude.idx + user.idx, snapshots
// the prelude section sizes between the two loads (so user.reloc's
// text offsets can be shifted to section-absolute form), then dumps
// a .lab whose `src raw` entries point to all 6 bin files (text /
// rodata / data × prelude + user) and whose reloc lines splice
// prelude.reloc verbatim + user.reloc with offsets shifted by the
// snapshotted prelude text size.
//
// asm_pass3 then memcpies the bins in section order and patches the
// relocs — never reopening either source.
export fn run_link(
    prelude_idx: String, user_idx: String,
    prelude_text_bin: String, prelude_rodata_bin: String,
    prelude_data_bin: String, prelude_reloc: String,
    user_text_bin: String, user_rodata_bin: String,
    user_data_bin: String, user_reloc: String,
    idx_source: String,
    lab_out_path: String) -> i32 {
    asm_init_pass1();
    asm_set_pass(1);

    // Load the prelude idx; snapshot the post-load section sizes so
    // user reloc offsets land in section-absolute coordinates.
    if prelude_idx as u32 == 0u32 || user_idx as u32 == 0u32 {
        return 0 - 1;
    }
    asm_load_idx(prelude_idx);
    // Snapshot raw / load_base from the prelude (its `; raw` /
    // `; load_base` directives drive how the final binary is wrapped).
    // user.idx's defaults (`raw 0`, `load_base 65536`) would otherwise
    // overwrite them on the second load.
    var saved_raw:       i32 = asm_get_raw_mode();
    var saved_load_base: i32 = asm_get_load_base();

    // Load the user idx. `align <s> <n>` lines inside it pre-align
    // sec_pos[s] before the labels are installed; sections without an
    // align line just inherit the prelude's end position. Either way
    // asm_load_idx_content_start(s) afterwards reports the offset
    // within section s where user content actually begins — that's
    // what asm_pass3 needs as the per-bin pad target.
    asm_load_idx(user_idx);
    var user_text_start:   i32 = asm_load_idx_content_start(0);
    var user_rodata_start: i32 = asm_load_idx_content_start(1);
    var user_data_start:   i32 = asm_load_idx_content_start(2);
    asm_install_raw_mode(saved_raw);
    asm_install_load_base(saved_load_base);
    // user.reloc text offsets are relative to the user.text.bin start
    // — the link-time absolute position is user_text_start + offset,
    // so the lab needs each entry shifted by user_text_start.
    var prelude_text_size: i32 = user_text_start;

    // Wire path globals so asm_dump_lab_state_to emits the right
    // `src raw` lines and the right reloc-splice operations.
    asm_set_prelude_text_bin(prelude_text_bin);
    asm_set_prelude_rodata_bin(prelude_rodata_bin);
    asm_set_prelude_data_bin(prelude_data_bin);
    asm_set_prelude_reloc(prelude_reloc);
    asm_set_user_text_bin(user_text_bin);
    asm_set_user_rodata_bin(user_rodata_bin);
    asm_set_user_data_bin(user_data_bin);
    asm_set_user_reloc(user_reloc);
    asm_set_user_text_shift(prelude_text_size);
    asm_set_user_text_start(user_text_start);
    asm_set_user_rodata_start(user_rodata_start);
    asm_set_user_data_start(user_data_start);
    if idx_source as u32 != 0u32 { asm_set_src_path1(idx_source); }

    return run_link_finish(lab_out_path);
}

// Process any extra inputs (registered before the run_link call via
// asm_add_extra_input from the CLI parser), then dump the lab.
// Factored out of run_link so the extras-loop runs after every
// run_link variant, regardless of how the prelude/user pair was
// wired in.
fn run_link_finish(lab_out_path: String) -> i32 {
    // Snapshot raw / load_base from whichever input set them last
    // (typically the prelude). Each extra idx might carry its own
    // `raw 0` / `load_base 65536` defaults that would otherwise
    // overwrite the prelude's `; raw` setting on the second / Nth
    // load. Restore after every extra has been ingested.
    var saved_raw_2:       i32 = asm_get_raw_mode();
    var saved_load_base_2: i32 = asm_get_load_base();
    var ei: i32 = 0;
    while ei < asm_get_n_extras() {
        // Capture the running text size BEFORE this idx loads — this
        // is the shift to apply to its reloc text offsets so they
        // land at section-absolute coordinates in the merged lab.
        asm_set_extra_text_shift(ei, asm_sec_pos(0));
        var ex_idx: String = asm_get_extra_idx(ei);
        if ex_idx as u32 != 0u32 { asm_load_idx(ex_idx); }
        // After the idx's align directives have applied,
        // asm_load_idx_content_start tells us where this input's
        // bytes actually begin in each section.
        asm_set_extra_text_start(  ei, asm_load_idx_content_start(0));
        asm_set_extra_rodata_start(ei, asm_load_idx_content_start(1));
        asm_set_extra_data_start(  ei, asm_load_idx_content_start(2));
        ei = ei + 1;
    }
    asm_install_raw_mode(saved_raw_2);
    asm_install_load_base(saved_load_base_2);

    // After every input has loaded, compute section bases / sizes
    // from the merged sec_pos and turn intra label addresses into
    // absolutes. No dead-strip pass — every input's idx already
    // represents reachable code.
    asm_compute_sec_bases();
    asm_finalize_labels();
    asm_resolve_deferred_refs();
    asm_fixup_labels();

    if lab_out_path as u32 != 0u32 {
        var lab_fd: i32 = do_openat(0 - 100, lab_out_path, 577);
        if lab_fd >= 0 {
            asm_dump_lab_state_to(lab_fd);
            do_close(lab_fd);
        }
    } else {
        asm_dump_lab_state();
    }

    km_dump_peak();
    return 0;
}

