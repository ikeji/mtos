// asm_pass3.tc — encoder half of the asm split (Phase 2 #56).
//
// Reads stdin as a concatenation of:
//
//   1. (lab ... )                — wrapped .lab from asm_pass2
//   2. full source (pass A)      — scanned while emitting .text bytes
//   3. full source (pass B)      — scanned while emitting .rodata bytes
//   4. full source (pass C)      — scanned while emitting .data bytes
//
// Each of passes A/B/C sees the source in its entirety but emit8 only
// writes to stdout when the current section directive matches that
// pass's target section (g_target_section). Between passes each
// target section is padded with zeros to its aligned size (from the
// .lab) so the total byte count matches filesz.
//
// Phase 5 (2026-04-16): we stream bytes to stdout via a 4 KB
// g_out_buf and drop the ~300 KB g_code that used to hold the whole
// program image. asm_pass3 peak drops from ~400 KB (after the
// asm_pass2 label-pool shrink) to ~200 KB.
//
// bss is memsz-only and never writes file bytes, so there is no
// pass for section 3.
//
// Caller contract: the caller must duplicate the source 3 times in
// the stdin stream. compile-gen2.sh and kernel/build.sh do this
// automatically via `cat`; the OS-side sh pipeline does it via
// intermediate tmpfs files.

import "asm_common.tc";
import "string_buffer.tc";
import "source_reader.tc";
import "strlib.tc";

fn km_dump_peak() -> void;

// File-open syscalls (forward decls — bodies in crt0_tc.s / task_crt0.s).
fn do_openat(dirfd: i32, path: String, flags: i32) -> i32;
fn do_close(fd: i32) -> i32;

// Source-file paths captured from the .lab's `src raw` lines. Each
// entry is a String the .lab parser allocates from the lab line
// bytes. `src raw <path> <sec> [<start>]` lines record kind=1; the
// run_section_pass loop memcpys the bytes directly to the output.
// Parallel arrays keep kind / section_id alongside the path so the
// section pass can dispatch without re-parsing.
//
// Declared up front so raw_memcpy_section / record_src_path see them
// as I32Array / U32Array (not `?`); tcheck resolves global var types
// lazily and forward-references through fn bodies sometimes lose the
// type tag.
var g_src_starts: I32Array = 0 as I32Array;
var g_src_paths: U32Array = 0 as U32Array;
var g_src_secs:  I32Array = 0 as I32Array;
var g_n_src_paths: i32 = 0;
var SRC_PATHS_CAP: i32 = 64;

// Reloc state — streamed, not stored. The .lab parse pass only counts
// `reloc` lines (into g_n_relocs); the text section emit pass re-opens
// the .lab and reads one reloc line at a time. Relocs are emitted in
// section-offset order by asm_pass2, so the section emit can advance a
// single "pending" cursor monotonically with no array storage at all.
//
// Pre-2026-05-12 this kept three I32Array(g_relocs_cap=4096) buffers
// (g_reloc_offs/kinds/lab_idx) plus per-call pre_addrs/pre_secs
// (I32Array(g_n_relocs)) — ~128 KB of pool slots in asm_pass3 peak.
// Streaming drops all of that to a 4 KB read-ahead buffer + a 512 B
// line buffer + 5 scalar pending fields. See git blame on this file.
var g_n_relocs: i32 = 0;

// Streaming reloc reader. g_reloc_in_path caches the .lab path so the
// text section pass can re-open it on demand. g_reloc_pending_* holds
// the parsed "next reloc"; g_reloc_in_done=1 means the stream is at EOF
// (no more relocs, or never opened).
var g_reloc_in_path: String = 0 as String;
var g_reloc_in_fd:   i32 = 0 - 1;
var g_reloc_in_line: U8Array = 0 as U8Array;
var g_reloc_pending_off:     i32 = 0;
var g_reloc_pending_kind:    i32 = 0;
var g_reloc_pending_lab_idx: i32 = 0;
var g_reloc_pending_addr:    i32 = 0;
var g_reloc_pending_sec:     i32 = 0;
var g_reloc_in_done: i32 = 1;

// Dedicated 4 KB read-ahead buffer for the reloc fd. We can't reuse
// the shared rb_* reader because that one is bound to the main lab/
// source stdin fd; the reloc reader runs concurrently during the
// text section emit.
var RELOC_BUF_CAP: i32 = 4096;
var g_reloc_in_buf:     U8Array = 0 as U8Array;
var g_reloc_in_buf_pos: i32 = 0;
var g_reloc_in_buf_len: i32 = 0;
var g_reloc_in_buf_eof: i32 = 0;

// Apply one reloc kind=1 (auipc + addi/jalr pair, 8 bytes) at offset
// rel_off within `buf`. The original bytes were encoded with imm=0
// (or arbitrary placeholder) — we replace bits 31:12 of the auipc
// and bits 31:20 of the addi/jalr with hi20/lo12 of (target - pc),
// where pc = sec_base + chunk_off + rel_off. chunk_off lets the
// streaming caller pass a window-local offset for `rel_off` while
// still computing the correct absolute PC for the patch.
fn patch_reloc_at(buf: U8Array, rel_off: i32, sec_base: i32, chunk_off: i32, target: i32) -> void {
    var pc: i32 = sec_base + chunk_off + rel_off;
    var off: i32 = target - pc;
    // hi20: imm[31:12] of auipc
    var auipc_w: i32 =
        (get(buf, rel_off + 0) as i32) |
        ((get(buf, rel_off + 1) as i32) << 8) |
        ((get(buf, rel_off + 2) as i32) << 16) |
        ((get(buf, rel_off + 3) as i32) << 24);
    auipc_w = (auipc_w & 4095) | (asm_hi20(off) << 12);
    set(buf, rel_off + 0, (auipc_w & 255) as u8);
    set(buf, rel_off + 1, ((auipc_w >> 8) & 255) as u8);
    set(buf, rel_off + 2, ((auipc_w >> 16) & 255) as u8);
    set(buf, rel_off + 3, ((auipc_w >> 24) & 255) as u8);
    // lo12: imm[31:20] of addi/jalr
    var lo_w: i32 =
        (get(buf, rel_off + 4) as i32) |
        ((get(buf, rel_off + 5) as i32) << 8) |
        ((get(buf, rel_off + 6) as i32) << 16) |
        ((get(buf, rel_off + 7) as i32) << 24);
    lo_w = (lo_w & 1048575) | ((asm_lo12(off) & 4095) << 20);
    set(buf, rel_off + 4, (lo_w & 255) as u8);
    set(buf, rel_off + 5, ((lo_w >> 8) & 255) as u8);
    set(buf, rel_off + 6, ((lo_w >> 16) & 255) as u8);
    set(buf, rel_off + 7, ((lo_w >> 24) & 255) as u8);
    return;
}

// Apply one reloc kind=2 (gp-relative la, auipc + addi gp pair). The
// auipc bytes are preserved (its result is dead — the addi overwrites
// rd); only the addi's 12-bit imm field gets repatched with the new
// `target - g_gp_abs`. Used for `la rd, <data/bss label>` baked into
// the pre-encoded prelude — gpoff goes stale when user.s shifts the
// data_base at full link time.
fn patch_reloc_gprel_at(buf: U8Array, rel_off: i32, target: i32, gp_abs: i32) -> void {
    var gpoff: i32 = target - gp_abs;
    var lo_w: i32 =
        (get(buf, rel_off + 4) as i32) |
        ((get(buf, rel_off + 5) as i32) << 8) |
        ((get(buf, rel_off + 6) as i32) << 16) |
        ((get(buf, rel_off + 7) as i32) << 24);
    lo_w = (lo_w & 1048575) | ((gpoff & 4095) << 20);
    set(buf, rel_off + 4, (lo_w & 255) as u8);
    set(buf, rel_off + 5, ((lo_w >> 8) & 255) as u8);
    set(buf, rel_off + 6, ((lo_w >> 16) & 255) as u8);
    set(buf, rel_off + 7, ((lo_w >> 24) & 255) as u8);
    return;
}

// Apply one reloc kind=3 (auto-la). asm_pass1 emits this when la's
// target was undefined locally (cross-input ref) and we couldn't tell
// at encode time whether to use kind=1 (PC-rel) or kind=2 (gp-rel).
// At link time we know the target's final section and g_gp_abs, so
// we can pick the optimal encoding now.
//
// data/bss target with gpoff fitting 12-bit signed → kind=2 form:
//   auipc rd, 0  (imm dead, kept as encoded placeholder 0)
//   addi rd, gp, gpoff   (rs1 forced to gp = 3, imm = gpoff)
// otherwise → kind=1 form (PC-rel):
//   auipc rd, hi20(off)
//   addi rd, rd, lo12(off)
fn patch_reloc_auto_at(buf: U8Array, rel_off: i32, sec_base: i32, chunk_off: i32,
                       target: i32, target_sec: i32, gp_abs: i32) -> void {
    var pc: i32 = sec_base + chunk_off + rel_off;
    var off: i32 = target - pc;
    var pick_gprel: i32 = 0;
    if target_sec == 2 || target_sec == 3 {
        var gpoff: i32 = target - gp_abs;
        if gpoff >= (0 - 2048) && gpoff <= 2047 { pick_gprel = 1; }
    }
    if pick_gprel == 1 {
        // auipc imm stays whatever's encoded (placeholder 0). Rewrite
        // addi: rs1 = gp(3), imm = gpoff.
        var gpoff2: i32 = target - gp_abs;
        var lo_w: i32 =
            (get(buf, rel_off + 4) as i32) |
            ((get(buf, rel_off + 5) as i32) << 8) |
            ((get(buf, rel_off + 6) as i32) << 16) |
            ((get(buf, rel_off + 7) as i32) << 24);
        // Clear bits 19:15 (rs1) and bits 31:20 (imm[11:0]). Keep
        // opcode (6:0), rd (11:7), funct3 (14:12).
        lo_w = lo_w & 0x7FFF;  // 0x7FFF = bits 14:0
        lo_w = lo_w | (3 << 15);          // rs1 = gp
        lo_w = lo_w | ((gpoff2 & 4095) << 20);
        set(buf, rel_off + 4, (lo_w & 255) as u8);
        set(buf, rel_off + 5, ((lo_w >> 8) & 255) as u8);
        set(buf, rel_off + 6, ((lo_w >> 16) & 255) as u8);
        set(buf, rel_off + 7, ((lo_w >> 24) & 255) as u8);
        // Zero out auipc imm (bits 31:12). Preserve opcode (6:0) +
        // rd (11:7).
        var ah_w: i32 =
            (get(buf, rel_off + 0) as i32) |
            ((get(buf, rel_off + 1) as i32) << 8) |
            ((get(buf, rel_off + 2) as i32) << 16) |
            ((get(buf, rel_off + 3) as i32) << 24);
        ah_w = ah_w & 4095;
        set(buf, rel_off + 0, (ah_w & 255) as u8);
        set(buf, rel_off + 1, ((ah_w >> 8) & 255) as u8);
        set(buf, rel_off + 2, ((ah_w >> 16) & 255) as u8);
        set(buf, rel_off + 3, ((ah_w >> 24) & 255) as u8);
    } else {
        // PC-rel: same patch as kind=1.
        patch_reloc_at(buf, rel_off, sec_base, chunk_off, target);
    }
    return;
}

// Apply one reloc kind=0 (J-type single 32-bit instruction at offset
// rel_off within `buf`). Replaces imm[20|10:1|11|19:12] with the new
// pc-relative offset; opcode + rd are preserved. chunk_off mirrors
// patch_reloc_at: the streaming caller passes a window-local rel_off
// while still getting the correct absolute PC for patching.
fn patch_reloc_j_at(buf: U8Array, rel_off: i32, sec_base: i32, chunk_off: i32, target: i32) -> void {
    var pc: i32 = sec_base + chunk_off + rel_off;
    var off: i32 = target - pc;
    var w: i32 =
        (get(buf, rel_off + 0) as i32) |
        ((get(buf, rel_off + 1) as i32) << 8) |
        ((get(buf, rel_off + 2) as i32) << 16) |
        ((get(buf, rel_off + 3) as i32) << 24);
    // Mask out imm bits — keep bits 11:0 (opcode + rd):
    // imm encoding is bits 31|30:21|20|19:12, so the mask we KEEP is
    // bits 11:0 which is 0xFFF.
    w = w & 0xFFF;
    // Reconstruct J-type imm from `off`:
    //   imm[20]   → bit 31
    //   imm[10:1] → bits 30:21
    //   imm[11]   → bit 20
    //   imm[19:12]→ bits 19:12
    var b20:    i32 = (off >> 20) & 1;
    var b10_1:  i32 = (off >> 1)  & 1023;
    var b11:    i32 = (off >> 11) & 1;
    var b19_12: i32 = (off >> 12) & 255;
    w = w | (b20 << 31) | (b10_1 << 21) | (b11 << 20) | (b19_12 << 12);
    set(buf, rel_off + 0, (w & 255) as u8);
    set(buf, rel_off + 1, ((w >> 8) & 255) as u8);
    set(buf, rel_off + 2, ((w >> 16) & 255) as u8);
    set(buf, rel_off + 3, ((w >> 24) & 255) as u8);
    return;
}

// Pre-encoded section bytes: open `path`, copy its contents straight
// to g_out_fd in 4 KB chunks (no per-byte emit_stream overhead), then
// nudge the section cursor / emitted counter so subsequent asm src
// entries in the same section encode at the correct PC.
//
// When relocs are present and we're in the text section, buffer the
// file into memory first, apply each reloc patch, then sys_write
// the patched bytes.
fn raw_memcpy_section(path: String, start_off: i32) -> i32 {
    asm_flush_out_buf_export();
    // If the lab declared a per-section start offset for this bin
    // (linker mode, where the bin's bytes don't begin right after the
    // previous bin's bytes), emit zero padding from the current emit
    // cursor up to start_off before the memcpy. start_off=0 means no
    // padding (legacy single-bin path).
    var emitted_now: i32 = asm_get_section_emitted();
    var pad_n: i32 = start_off - emitted_now;
    if pad_n > 0 {
        // Pad in fixed-size chunks. Self_replicate's rodata gets a
        // ~384 KB pad before the deferred --incbin-skip blob (the
        // 3.5 MB disk-extra). Allocating U8Array(pad_n) directly
        // OOMed because pad_n exceeds the task arena. A 4 KB scratch
        // buffer in a write loop has the same effect with bounded
        // memory.
        var out_fd_pad: i32 = asm_get_out_fd();
        var zbuf: U8Array = U8Array(4096u32);
        var zi: i32 = 0;
        while zi < 4096 { set(zbuf, zi, 0u8); zi = zi + 1; }
        var pad_remain: i32 = pad_n;
        while pad_remain > 0 {
            var pad_chunk: i32 = pad_remain;
            if pad_chunk > 4096 { pad_chunk = 4096; }
            sys_write(out_fd_pad, zbuf, pad_chunk);
            pad_remain = pad_remain - pad_chunk;
        }
        delete(zbuf);
        asm_advance_section_pass2(pad_n);
    }
    var fd: i32 = do_openat(0 - 100, path, 0);
    if fd < 0 { return 0; }
    var out_fd: i32 = asm_get_out_fd();
    var total: i32 = 0;

    var apply_relocs: i32 = 0;
    if g_n_relocs > 0 && asm_get_target_section() == 0 { apply_relocs = 1; }

    if apply_relocs == 1 {
        // Streaming + patch path. Read the bin in 4 KB chunks into an
        // 8 KB sliding window. A 4-or-8-byte reloc near a chunk
        // boundary stays contiguous because we hold back 8 bytes of
        // emit at every iteration.
        //
        // Relocs come from g_reloc_pending_* (one record at a time,
        // sourced from the .lab fresh-open in reloc_stream_*). They
        // arrive in section-offset order, so a single "next" cursor
        // advances monotonically through the section emit. A reloc
        // that straddles the current emit_end shrinks it to its start
        // so the next iteration sees the full 8 bytes contiguous;
        // the reloc itself remains pending.
        var sec_base: i32 = asm_get_sec_base(0);
        var WIN:    i32 = 8192;
        var io:     U8Array = U8Array(4096u32);
        var win:    U8Array = U8Array(WIN as u32);
        var keep:   i32 = 0;       // bytes already in win[0..keep)
        // Anchor chunk_off at the section's running emit cursor. For
        // the first `src raw` entry in a section this is 0 (matches
        // the legacy single-bin case); for the second one (e.g.
        // user.tx chained after prelude.tx) it picks up where the
        // previous memcpy left off, so reloc offsets expressed in
        // concatenated-section coordinates patch the right bytes.
        var chunk_off: i32 = asm_get_section_emitted();
        var done_r: i32 = 0;
        while done_r == 0 {
            var nr: i32 = sys_read(fd, io, 4096);
            if nr <= 0 {
                if keep > 0 {
                    // Final flush: drain any remaining pending relocs
                    // within win[0..keep).
                    while g_reloc_in_done == 0 &&
                          g_reloc_pending_off < chunk_off + keep {
                        var w_off_final: i32 = g_reloc_pending_off - chunk_off;
                        if w_off_final >= 0 {
                            apply_pending_at(win, w_off_final, sec_base, chunk_off);
                        }
                        reloc_stream_next();
                    }
                    sys_write(out_fd, win, keep);
                    total = total + keep;
                }
                done_r = 1;
            } else {
                // Append io[0..nr) to win[keep..]
                var ai: i32 = 0;
                while ai < nr { set(win, keep + ai, get(io, ai)); ai = ai + 1; }
                var win_len: i32 = keep + nr;
                // Hold back the longest reloc length (8 bytes for
                // kind=1 / kind=2 / kind=3 auipc+addi pairs).
                var emit_end: i32 = win_len - 8;
                if emit_end < 0 { emit_end = 0; }
                // Advance through pending relocs whose offset falls
                // before chunk_off + emit_end. If one straddles emit_end,
                // shrink emit_end to its start and stop — the reloc
                // stays pending for the next iteration.
                var stopped: i32 = 0;
                while stopped == 0 && g_reloc_in_done == 0 &&
                      g_reloc_pending_off < chunk_off + emit_end {
                    var w_off: i32 = g_reloc_pending_off - chunk_off;
                    var ln: i32 = 4;
                    if g_reloc_pending_kind == 1 ||
                       g_reloc_pending_kind == 2 ||
                       g_reloc_pending_kind == 3 { ln = 8; }
                    if w_off + ln > emit_end {
                        emit_end = w_off;
                        stopped = 1;
                    } else if w_off >= 0 {
                        apply_pending_at(win, w_off, sec_base, chunk_off);
                        reloc_stream_next();
                    } else {
                        // Reloc offset is before chunk_off — shouldn't
                        // happen since relocs are sorted, but advance
                        // defensively so the loop terminates.
                        reloc_stream_next();
                    }
                }
                if emit_end > 0 {
                    sys_write(out_fd, win, emit_end);
                    total = total + emit_end;
                    var ti: i32 = 0;
                    while ti < win_len - emit_end {
                        set(win, ti, get(win, emit_end + ti));
                        ti = ti + 1;
                    }
                    keep = win_len - emit_end;
                    chunk_off = chunk_off + emit_end;
                } else {
                    keep = win_len;
                }
            }
        }
        delete(io);
        delete(win);
    } else {
        // Streaming pass-through (no relocs to apply).
        var buf2: U8Array = U8Array(4096);
        var done2: i32 = 0;
        while done2 == 0 {
            var n2: i32 = sys_read(fd, buf2, 4096);
            if n2 <= 0 { done2 = 1; }
            else {
                sys_write(out_fd, buf2, n2);
                total = total + n2;
            }
        }
        delete(buf2);
    }

    do_close(fd);
    asm_advance_section_pass2(total);
    return total;
}

// Read one byte from the streaming reloc fd via the 4 KB read-ahead
// buffer. Returns -1 at EOF.
fn reloc_buf_next() -> i32 {
    if g_reloc_in_buf_pos < g_reloc_in_buf_len {
        var c: u8 = get(g_reloc_in_buf, g_reloc_in_buf_pos);
        g_reloc_in_buf_pos = g_reloc_in_buf_pos + 1;
        return c as i32;
    }
    if g_reloc_in_buf_eof == 1 { return 0 - 1; }
    var n: i32 = sys_read(g_reloc_in_fd, g_reloc_in_buf, RELOC_BUF_CAP);
    if n <= 0 { g_reloc_in_buf_eof = 1; return 0 - 1; }
    g_reloc_in_buf_len = n;
    var c0: u8 = get(g_reloc_in_buf, 0);
    g_reloc_in_buf_pos = 1;
    return c0 as i32;
}

// Read one LF-terminated line from the reloc fd into buf. Truncates
// at `cap` bytes (caller guarantees that's enough). Returns line
// length, or -1 at EOF with no bytes read.
fn reloc_read_line(buf: U8Array, cap: i32) -> i32 {
    var llen: i32 = 0;
    var saw: i32 = 0;
    var done: i32 = 0;
    while done == 0 {
        var c: i32 = reloc_buf_next();
        if c < 0 {
            done = 1;
        } else {
            saw = 1;
            if llen < cap { set(buf, llen, c as u8); }
            llen = llen + 1;
            if c == 10 { done = 1; }
        }
    }
    if saw == 0 { return 0 - 1; }
    if llen > cap { llen = cap; }
    return llen;
}

// Parse one `reloc <off> <kind> <name>` line into g_reloc_pending_*.
// Returns 0 on success, -1 if malformed or if the target name doesn't
// resolve (dead-strip removed it from the .lab). The reloc_stream_next
// loop treats -1 as "skip this line and read the next" — for dead
// targets that's safe because BFS guarantees no live code references
// them, so leaving the bytes unpatched can't be observed at run time.
fn parse_reloc_into_pending(buf: U8Array, blen: i32) -> i32 {
    parse_dec(buf, 6, blen);
    g_reloc_pending_off = g_lab_int;
    parse_dec(buf, skip_ws(buf, g_lab_cur, blen), blen);
    g_reloc_pending_kind = g_lab_int;
    var ns: i32 = skip_ws(buf, g_lab_cur, blen);
    var ne: i32 = blen;
    var trimming: i32 = 1;
    while trimming == 1 && ne > ns {
        var tc: u8 = get(buf, ne - 1);
        if tc == 10u8 || tc == 13u8 || tc == ' ' || tc == 9u8 {
            ne = ne - 1;
        } else {
            trimming = 0;
        }
    }
    var nlen: i32 = ne - ns;
    if nlen <= 0 { return 0 - 1; }
    var name: U8Array = U8Array(nlen as u32);
    var i: i32 = 0;
    while i < nlen { set(name, i, get(buf, ns + i)); i = i + 1; }
    var lab_idx: i32 = asm_find_label_idx(name, nlen);
    delete(name);
    if lab_idx < 0 { return 0 - 1; }
    g_reloc_pending_lab_idx = lab_idx;
    g_reloc_pending_addr    = asm_label_addr_at(lab_idx);
    g_reloc_pending_sec     = asm_label_section_at(lab_idx);
    return 0;
}

// Advance the streaming reloc reader to the next `reloc ` line. Sets
// g_reloc_in_done=1 at EOF or on the closing `)`. Lines that aren't
// `reloc ` (leftover `lab`/`num` lines from the parse pass that ran
// against the same fd in a previous use of the .lab) are skipped.
fn reloc_stream_next() -> void {
    if g_reloc_in_done == 1 { return; }
    var found: i32 = 0;
    while found == 0 {
        var llen: i32 = reloc_read_line(g_reloc_in_line, 512);
        if llen < 0 { g_reloc_in_done = 1; return; }
        if llen >= 6 && cmp(g_reloc_in_line, 0, "reloc ") {
            if parse_reloc_into_pending(g_reloc_in_line, llen) == 0 {
                found = 1;
            }
        } else if llen >= 1 && get(g_reloc_in_line, 0) == ')' as u8 {
            g_reloc_in_done = 1;
            return;
        }
    }
    return;
}

// Open the .lab fresh, skip to the first `reloc ` line, and stash it
// in g_reloc_pending_*. Called once per text section pass before the
// raw_memcpy_section loop.
fn reloc_stream_open() -> void {
    if g_reloc_in_path as u32 == 0u32 { g_reloc_in_done = 1; return; }
    g_reloc_in_fd = do_openat(0 - 100, g_reloc_in_path, 0);
    if g_reloc_in_fd < 0 { g_reloc_in_done = 1; return; }
    if g_reloc_in_buf as u32 == 0u32 {
        g_reloc_in_buf = U8Array(RELOC_BUF_CAP as u32);
    }
    g_reloc_in_buf_pos = 0;
    g_reloc_in_buf_len = 0;
    g_reloc_in_buf_eof = 0;
    if g_reloc_in_line as u32 == 0u32 {
        g_reloc_in_line = U8Array(512u32);
    }
    g_reloc_in_done = 0;
    reloc_stream_next();
    return;
}

fn reloc_stream_close() -> void {
    if g_reloc_in_fd >= 0 {
        do_close(g_reloc_in_fd);
        g_reloc_in_fd = 0 - 1;
    }
    g_reloc_in_done = 1;
    return;
}

// Patch g_reloc_pending_* at win[w_off] (w_off is window-local).
fn apply_pending_at(win: U8Array, w_off: i32, sec_base: i32, chunk_off: i32) -> void {
    var k: i32 = g_reloc_pending_kind;
    var ta: i32 = g_reloc_pending_addr;
    if k == 1 {
        patch_reloc_at(win, w_off, sec_base, chunk_off, ta);
    } else if k == 2 {
        patch_reloc_gprel_at(win, w_off, ta, asm_get_gp_abs());
    } else if k == 3 {
        patch_reloc_auto_at(win, w_off, sec_base, chunk_off, ta,
                            g_reloc_pending_sec, asm_get_gp_abs());
    } else {
        patch_reloc_j_at(win, w_off, sec_base, chunk_off, ta);
    }
    return;
}

fn record_src_path(p: String, sec: i32, start_off: i32) -> void {
    if g_src_paths as u32 == 0u32 {
        g_src_paths  = U32Array((SRC_PATHS_CAP) as u32);
        g_src_secs   = I32Array((SRC_PATHS_CAP) as u32);
        g_src_starts = I32Array((SRC_PATHS_CAP) as u32);
        g_n_src_paths = 0;
    }
    if g_n_src_paths < SRC_PATHS_CAP {
        set(g_src_paths,  g_n_src_paths, p as u32);
        set(g_src_secs,   g_n_src_paths, sec);
        set(g_src_starts, g_n_src_paths, start_off);
        g_n_src_paths = g_n_src_paths + 1;
    }
    return;
}

// ===== .lab parsing helpers =====

fn is_ws(c: u8) -> bool { return c == ' ' || c == 9u8; }
fn lab_is_digit(c: u8) -> bool { return c >= '0' && c <= '9'; }

// Skip whitespace at *cursor and return the new cursor.
fn skip_ws(buf: U8Array, cursor: i32, end: i32) -> i32 {
    var p: i32 = cursor;
    while p < end && is_ws(get(buf, p)) { p = p + 1; }
    return p;
}

// Parse a non-negative decimal i32 starting at *cursor. Returns the
// value via g_lab_int and advances cursor (passed back via g_lab_cur).
var g_lab_int: i32 = 0;
var g_lab_cur: i32 = 0;
fn parse_dec(buf: U8Array, cursor: i32, end: i32) -> void {
    var p: i32 = cursor;
    var neg: i32 = 0;
    if p < end && get(buf, p) == '-' { neg = 1; p = p + 1; }
    var v: i32 = 0;
    while p < end && lab_is_digit(get(buf, p)) {
        v = v * 10 + (get(buf, p) as i32 - 48);
        p = p + 1;
    }
    if neg == 1 { v = 0 - v; }
    g_lab_int = v;
    g_lab_cur = p;
    return;
}

// Process one .lab line. Returns 1 if it's the closing ")", else 0.
// Mutates the asm_common state for sec / lab / num records, ignores
// blanks and comments.
fn parse_lab_line(buf: U8Array, blen: i32) -> i32 {
    var p: i32 = skip_ws(buf, 0, blen);
    if p >= blen { return 0; }
    var c: u8 = get(buf, p);
    if c == 10u8 || c == 13u8 { return 0; }
    if c == ';' { return 0; }
    if c == ')' { return 1; }
    if c == '(' { return 0; }   // (lab opener — already consumed in caller, defensive
    if blen - p >= 4 && cmp(buf, p, "sec ") {
        parse_dec(buf, p + 4, blen);
        var sec_id: i32 = g_lab_int;
        parse_dec(buf, skip_ws(buf, g_lab_cur, blen), blen);
        var sec_base: i32 = g_lab_int;
        parse_dec(buf, skip_ws(buf, g_lab_cur, blen), blen);
        var sec_size: i32 = g_lab_int;
        asm_install_sec_base_size(sec_id, sec_base, sec_size);
        return 0;
    }
    if blen - p >= 4 && cmp(buf, p, "raw ") {
        parse_dec(buf, p + 4, blen);
        asm_install_raw_mode(g_lab_int);
        return 0;
    }
    if blen - p >= 10 && cmp(buf, p, "load_base ") {
        parse_dec(buf, p + 10, blen);
        asm_install_load_base(g_lab_int);
        return 0;
    }
    if blen - p >= 10 && cmp(buf, p, "src_bytes ") {
        parse_dec(buf, p + 10, blen);
        asm_set_src_bytes(g_lab_int);
        return 0;
    }
    if blen - p >= 8 && cmp(buf, p, "src raw ") {
        // src raw <path> <sec> [<start>]
        //   memcpy bytes from <path> straight into section <sec>;
        //   optional <start> is the per-section offset where this
        //   bin's bytes begin (raw_memcpy_section pads zeros up to
        //   <start> first).
        var src_sec:  i32 = 0;
        var src_start: i32 = 0;
        var ps: i32 = skip_ws(buf, p + 8, blen);
        // Scan forward to the next whitespace as the path end.
        var pe: i32 = ps;
        while pe < blen && is_ws(get(buf, pe)) == false {
            pe = pe + 1;
        }
        parse_dec(buf, skip_ws(buf, pe, blen), blen);
        src_sec = g_lab_int;
        // Optional 4th token: per-section start offset.
        var maybe_start: i32 = skip_ws(buf, g_lab_cur, blen);
        if maybe_start < blen
           && get(buf, maybe_start) >= '0' as u8
           && get(buf, maybe_start) <= '9' as u8 {
            parse_dec(buf, maybe_start, blen);
            src_start = g_lab_int;
        }
        var plen: i32 = pe - ps;
        if plen > 0 {
            // U8Array(N) has the same on-wire layout as TC's String
            // (count-prefixed buffer), so we can cast the array as
            // a String once the bytes are filled. The path needs to
            // outlive parse_lab_line, so don't delete it. Allocate one
            // extra byte so the data area ends with a NUL — the host
            // do_openat stub strips the count prefix and hands the
            // bytes to Linux openat() unchanged.
            var path_buf: U8Array = U8Array((plen + 1) as u32);
            var pi: i32 = 0;
            while pi < plen { set(path_buf, pi, get(buf, ps + pi)); pi = pi + 1; }
            set(path_buf, plen, 0u8);
            // String layout has a 4-byte count up front; U8Array(N)
            // already wrote N as the count. We want the logical length
            // to be plen (without the trailing NUL we just appended).
            poke32(path_buf as u32, plen as u32);
            record_src_path(path_buf as String, src_sec, src_start);
        }
        return 0;
    }
    if blen - p >= 6 && cmp(buf, p, "reloc ") {
        // Count only — relocs are streamed from the .lab during the
        // text section emit by reloc_stream_open / reloc_stream_next.
        // Storing them here would cost ~128 KB of pool slots (3 ×
        // I32Array(4096) + 2 × I32Array(g_n_relocs) precomputed addr/
        // sec arrays per raw_memcpy_section call).
        g_n_relocs = g_n_relocs + 1;
        return 0;
    }
    if blen - p >= 4 && cmp(buf, p, "num ") {
        parse_dec(buf, p + 4, blen);
        var dig: i32 = g_lab_int;
        parse_dec(buf, skip_ws(buf, g_lab_cur, blen), blen);
        var addrv: i32 = g_lab_int;
        asm_install_numlab_from_lab(dig, addrv);
        return 0;
    }
    if blen - p >= 4 && cmp(buf, p, "lab ") {
        parse_dec(buf, p + 4, blen);
        var laddr: i32 = g_lab_int;
        parse_dec(buf, skip_ws(buf, g_lab_cur, blen), blen);
        var lsec: i32 = g_lab_int;
        var ns: i32 = skip_ws(buf, g_lab_cur, blen);
        // Trim trailing whitespace / line endings so the name length
        // doesn't include the LF the reader added.
        var ne: i32 = blen;
        var trimming: i32 = 1;
        while trimming == 1 && ne > ns {
            var tc: u8 = get(buf, ne - 1);
            if tc == 10u8 || tc == 13u8 || tc == ' ' || tc == 9u8 {
                ne = ne - 1;
            } else {
                trimming = 0;
            }
        }
        var name_len: i32 = ne - ns;
        var name: U8Array = U8Array((name_len) as u32);
        var i: i32 = 0;
        while i < name_len { set(name, i, get(buf, (ns + i))); i = i + 1; }
        asm_install_label_from_lab(name, name_len, laddr, lsec);
        delete(name);
        return 0;
    }
    return 0;
}

// ===== Source section pass =====
//
// Run one full traversal of the source from stdin, emitting only the
// bytes for sec_target. The .lab's `src raw` entries point at the
// per-section .bin files asm_pass1 pre-encoded; this pass memcpys
// the bins whose section_id matches sec_target.
fn run_section_pass(sec_target: i32) -> void {
    asm_set_target_section(sec_target);
    asm_set_pass(2);
    asm_pass2_reset_cursors();

    // --emit-bin mode: redirect this section's bytes to its dedicated
    // .bin file. Each section pass overwrites g_out_fd at start —
    // we save the previous fd in saved_fd so other passes are not
    // affected if only some sections have a per-section bin file.
    var saved_fd: i32 = asm_get_out_fd();
    var per_sec_fd: i32 = 0;
    if sec_target == 0 { per_sec_fd = asm_get_text_bin_fd(); }
    if sec_target == 1 { per_sec_fd = asm_get_rodata_bin_fd(); }
    if sec_target == 2 { per_sec_fd = asm_get_data_bin_fd(); }
    if per_sec_fd > 0 {
        asm_set_out_fd(per_sec_fd);
    }

    // Open the streaming reloc reader for the text section. Inspection
    // of the asm_pass2 .lab output confirms all relocs land in section
    // 0 — kind=1/2/3 patches are emitted only for .text instructions —
    // so only the text pass needs reloc patching.
    if sec_target == 0 && g_n_relocs > 0 {
        reloc_stream_open();
    }

    // Walk each `src raw` entry from the .lab: memcpy bytes straight
    // to g_out_fd when its section_id matches sec_target. Raw entries
    // that don't match are skipped entirely; their bytes were already
    // accounted for by asm_pass2 in the .lab's sec sizes.
    var pi: i32 = 0;
    while pi < g_n_src_paths {
        var p_addr: u32 = get(g_src_paths, pi);
        var path: String = p_addr as String;
        var ksec:  i32 = get(g_src_secs,  pi);
        if ksec == sec_target {
            raw_memcpy_section(path, get(g_src_starts, pi));
        }
        pi = pi + 1;
    }

    if sec_target == 0 && g_n_relocs > 0 {
        reloc_stream_close();
    }

    // Pad the target section with zeros up to its aligned size and
    // flush the output buffer. asm_flush_section_padding does both.
    //
    // --emit-bin mode: skip the per-section padding so the bin file
    // contains exactly the encoded source bytes. The link-time
    // asm_pass3 invocation re-pads after concatenating user code.
    if per_sec_fd > 0 {
        asm_flush_output();
    } else {
        asm_flush_section_padding();
    }
    // Restore the previous output fd so subsequent section passes
    // and final ELF emission continue to write where the caller
    // expects.
    asm_set_out_fd(saved_fd);
    return;
}

// ===== Shared buffered stdin reader (Phase 5) =====
//
// SourceReader's 4 KB read-ahead eats past one source copy into the
// next, which breaks the 3-pass scheme. We can't shrink its buffer
// to 1 byte (far too slow for kernel-sized inputs, would add ~20 s
// to make test). Instead this file keeps a single buffered reader
// state across all 4 phases (.lab + text + rodata + data pass) so
// the leftover bytes in the buffer carry over correctly into the
// next phase's reads. The caller still concatenates the source 3
// times, and src_bytes from the .lab tells each pass exactly when
// to stop consuming from the stream.
var G_BUF_CAP: i32 = 4096;
var g_buf:     U8Array = 0 as U8Array;
var g_buf_pos: i32 = 0;
var g_buf_len: i32 = 0;
var g_buf_eof: i32 = 0;
// rb_fill reads from this fd. Defaults to 0 (stdin) so the legacy
// single-source path keeps working; multi-src run_section_pass
// switches it via rb_switch_fd before each file.
var g_rb_fd: i32 = 0;

fn rb_init() -> void {
    g_buf     = U8Array((G_BUF_CAP) as u32);
    g_buf_pos = 0;
    g_buf_len = 0;
    g_buf_eof = 0;
    g_rb_fd   = 0;
    return;
}

// Switch the underlying fd, discard any read-ahead, clear EOF. Used
// to point the shared reader at a freshly-opened src file.
fn rb_switch_fd(fd: i32) -> void {
    g_rb_fd   = fd;
    g_buf_pos = 0;
    g_buf_len = 0;
    g_buf_eof = 0;
    return;
}

// Refill the buffer if empty. Returns 0 on success, 1 on EOF.
fn rb_fill() -> i32 {
    if g_buf_pos < g_buf_len { return 0; }
    if g_buf_eof == 1 { return 1; }
    var n: i32 = sys_read(g_rb_fd, g_buf, G_BUF_CAP);
    if n <= 0 {
        g_buf_eof = 1;
        return 1;
    }
    g_buf_pos = 0;
    g_buf_len = n;
    return 0;
}

// Read one byte. Returns -1 at EOF.
fn rb_next() -> i32 {
    if rb_fill() == 1 { return -1; }
    var c: u8 = get(g_buf, g_buf_pos);
    g_buf_pos = g_buf_pos + 1;
    return c as i32;
}

// Read one LF-terminated line into buf[0..]. Stops at LF (keeping it
// in the output), at EOF, or at byte_limit bytes consumed — the
// last stops mid-line exactly when a source pass finishes. Returns
// line length or -1 if EOF hit without any bytes.
//
// byte_budget is a POINTER-SEMANTICS i32 passed in as the caller's
// remaining budget for this pass. We decrement it in-place by
// returning the new value via a global; TC has no multi-return so
// we stash it in g_budget_after.
var g_budget_after: i32 = 0;
fn rb_read_line(buf: U8Array, buf_cap: i32, byte_budget: i32) -> i32 {
    var llen: i32 = 0;
    var saw_byte: i32 = 0;
    var budget: i32 = byte_budget;
    var done: i32 = 0;
    while done == 0 && budget > 0 {
        var c: i32 = rb_next();
        if c < 0 {
            done = 1;
        } else {
            saw_byte = 1;
            budget = budget - 1;
            if llen >= buf_cap {
                var eb: StringBuffer = StringBuffer_new();
                asm_err_begin(eb);
                emit_string(eb, "line too long (max ");
                emit_int(eb, buf_cap);
                emit_string(eb, " bytes)");
                asm_err_end(eb);
            }
            set(buf, llen, c as u8);
            llen = llen + 1;
            if c == 10 { done = 1; }
        }
    }
    g_budget_after = budget;
    if saw_byte == 0 { return -1; }
    return llen;
}

// ===== Main =====
export fn run_pass3(lab_path: String, out_path: String) -> i32 {
    asm_init_pass2();
    asm_enable_stream_mode();
    rb_init();

    // Stash for the streaming reloc reader. reloc_stream_open re-opens
    // this file fresh — its read cursor doesn't share with the main
    // .lab parse pass's rb_* reader.
    g_reloc_in_path = lab_path;

    // Read .lab from a file. The `src raw` lines inside drive
    // multi-source memcpy in the pass-C section loop.
    var lab_fd: i32 = do_openat(0 - 100, lab_path, 0);
    if lab_fd < 0 { sys_exit(20); }
    rb_switch_fd(lab_fd);
    // Note: the fd stays open until run_section_pass switches it;
    // we leak it to the kernel close-on-exit. Acceptable on host
    // / OS task exit.

    // Redirect the binary write target.
    var out_fd: i32 = do_openat(0 - 100, out_path, 577);
    if out_fd < 0 { sys_exit(21); }
    asm_set_out_fd(out_fd);

    var lab_line: U8Array = U8Array(4092);

    // Phase A: scan stdin to the "(lab" opener, then parse lab lines
    // until the closing ")". Uses the shared rb_* buffered reader
    // with an effectively infinite budget so we read line by line
    // until the `)` closer. The reader's internal buffer may have
    // bytes of the source body read-ahead at that point — they
    // carry over into run_section_pass automatically since we
    // keep the same reader state.
    var saw_open: i32 = 0;
    while saw_open == 0 {
        var llen: i32 = rb_read_line(lab_line, 4092, 0x7FFFFFFF);
        if llen < 0 { break; }
        if llen >= 4 && cmp(lab_line, 0, "(lab") {
            saw_open = 1;
        }
    }

    var done: i32 = 0;
    while done == 0 {
        var llen2: i32 = rb_read_line(lab_line, 4092, 0x7FFFFFFF);
        if llen2 < 0 { break; }
        if llen2 > 0 {
            if parse_lab_line(lab_line, llen2) == 1 { done = 1; }
        }
    }

    // All labels installed; build the hash table for O(1) find_label
    // during encoding. pass 1's define_label still uses linear search
    // but runs on a smaller working set.
    asm_finalize_labels();

    // Phase B: emit the ELF header upfront (raw mode skips this).
    // filesz/memsz/entry come entirely from the .lab, and `raw` /
    // `load_base` meta directives were captured by asm_pass2 from
    // the source body during pass 1 and written to the .lab as
    // their own lines — parse_lab_line has already installed them
    // via asm_install_raw_mode / asm_install_load_base.
    asm_write_elf_header_stream();

    // Phase C: 3 emit passes, one per section (text, rodata, data).
    // Each pass memcpys the .bin files whose section_id matches.
    // Bss is memsz-only and never writes file bytes.
    run_section_pass(0);
    run_section_pass(1);
    run_section_pass(2);

    delete(lab_line);

    // Close the output fd so fatfs flushes the directory entry size
    // update before sys_exit. Without this close, /sd/HW shows 0 bytes
    // in the directory even though sectors were written.
    var out_fd_final: i32 = asm_get_out_fd();
    if out_fd_final > 1 { do_close(out_fd_final); }

    km_dump_peak();
    return 0;
}

