// asm_pass1.tc — pre-encode driver (idx + per-section .bin + reloc).
//
// Phase C/D/E of the 3-binary asm split. Replaces what
// kernel/build.sh + the OS-side flow used to do as separate
// invocations (asm_pass2 stdin → .lab pipe, asm_pass3 --text-bin
// etc., legacy asm_pass2 emit-idx) with a single pre-encode tool.
//
// CLI:
//   asm_pass1 src.s \
//       --idx-out    out.idx \
//       --text-bin   out.text.bin \
//       --rodata-bin out.rodata.bin \
//       --data-bin   out.data.bin \
//       --reloc-out  out.reloc
//
// Implementation:
//   step 1: run() over the source with --emit-idx — captures the
//           per-file label table the link step expects.
//   step 2: run() over the source with --lab-out — produces a
//           temp .lab the encoder will read.
//   step 3: run_pass2() consumes the .lab and re-walks the source
//           per section, streaming bytes to .text.bin / .rodata.bin
//           / .data.bin and reloc edges to .reloc. With
//           asm_set_emit_undef_relocs(1) every label reference whose
//           name isn't in the per-file label table emits a reloc
//           (kind 0/1/2) instead of erroring. The link step resolves
//           these against the merged symbol table.
//
// Multiple run() calls in the same process are safe because
// asm_init_common resets g_lab_hash_ok to 0 — without it the second
// walk's find_label would reach into the previous walk's hash table
// indices that point into a freshly-reallocated g_labels.

import "asm_pass2_lib.tc";
import "asm_pass3_lib.tc";
import "asm_common.tc";

fn arg_eq(s: String, pat: StringLiteral) -> i32 {
    var ns: i32 = len(s);
    var np: i32 = len(pat);
    if ns != np { return 0; }
    var i: i32 = 0;
    while i < np {
        if get(s, i) != get(pat, i) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn err(s: StringLiteral) -> void {
    sys_write(2, s as u32 as U8Array, len(s));
    return;
}

fn run_pre_encode(src: String,
                  idx_out: String,
                  text_bin: String, rodata_bin: String, data_bin: String,
                  reloc_out: String) -> i32 {
    var lab_path: StringLiteral = "/tmp/_p1_combined.lab";

    // Step 1: idx for the source.
    if idx_out as u32 != 0u32 {
        asm_set_src_path1(src);
        var rc_idx: i32 = run(src, idx_out, 0 as String);
        if rc_idx != 0 { err("asm_pass1: idx emit failed\n"); return rc_idx; }
    }

    // Step 2: lab over the source.
    asm_set_src_path1(src);
    var rc1: i32 = run(src, 0 as String, lab_path as String);
    if rc1 != 0 { err("asm_pass1: lab build failed\n"); return rc1; }

    // Step 3: encode + per-section .bin + .reloc. Enable
    // emit-undef-relocs so cross-file references become reloc edges
    // instead of "undefined label" errors. The flag is benign for
    // prelude pre-encode — prelude refs that crossed the boundary
    // (main / main__StringArray) were already in the hardcoded extern
    // list, so they emit the same kind/op_idx either way.
    asm_set_emit_undef_relocs(1);
    var rc2: i32 = run_pass2(lab_path as String, 0 as String,
                             text_bin, rodata_bin, data_bin, reloc_out);
    asm_set_emit_undef_relocs(0);
    if rc2 != 0 { err("asm_pass1: bin emit failed\n"); return rc2; }
    return 0;
}

fn main() -> i32 {
    err("asm_pass1: requires arguments — see source for CLI shape\n");
    return 1;
}

fn main(argv: StringArray) -> i32 {
    var src:          String = 0 as String;
    var idx_out:      String = 0 as String;
    var text_bin:     String = 0 as String;
    var rodata_bin:   String = 0 as String;
    var data_bin:     String = 0 as String;
    var reloc_out:    String = 0 as String;
    if argv as u32 != 0u32 {
        var argc: i32 = len(argv);
        var i: i32 = 1;
        while i < argc {
            var a: String = get(argv, i);
            if arg_eq(a, "--idx-out") != 0 && i + 1 < argc {
                idx_out = get(argv, i + 1); i = i + 2;
            } else if arg_eq(a, "--text-bin") != 0 && i + 1 < argc {
                text_bin = get(argv, i + 1); i = i + 2;
            } else if arg_eq(a, "--rodata-bin") != 0 && i + 1 < argc {
                rodata_bin = get(argv, i + 1); i = i + 2;
            } else if arg_eq(a, "--data-bin") != 0 && i + 1 < argc {
                data_bin = get(argv, i + 1); i = i + 2;
            } else if arg_eq(a, "--reloc-out") != 0 && i + 1 < argc {
                reloc_out = get(argv, i + 1); i = i + 2;
            } else {
                if src as u32 == 0u32 { src = a; }
                i = i + 1;
            }
        }
    }
    if src as u32 == 0u32 ||
       text_bin as u32 == 0u32 || rodata_bin as u32 == 0u32 ||
       data_bin as u32 == 0u32 || reloc_out as u32 == 0u32 {
        err("usage: asm_pass1 src.s [--idx-out P] --text-bin P --rodata-bin P --data-bin P --reloc-out P\n");
        return 1;
    }
    return run_pre_encode(src, idx_out,
                          text_bin, rodata_bin, data_bin, reloc_out);
}
