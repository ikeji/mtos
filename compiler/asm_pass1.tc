// asm_pass1.tc — pre-encode driver (per-section .bin + reloc).
//
// Phase C of the 3-binary asm split. Replaces what
// kernel/build.sh + the OS-side flow used to do as two separate
// invocations (asm_pass2 stdin → .lab pipe, asm_pass3 --text-bin
// etc.) with a single pre-encode tool.
//
// CLI:
//   asm_pass1 prelude.s prelude_tail.s \
//       --text-bin prelude.text.bin \
//       --rodata-bin prelude.rodata.bin \
//       --data-bin prelude.data.bin \
//       --reloc-out prelude.reloc
//
// Outputs:
//   prelude.text.bin / .rodata.bin / .data.bin / .reloc
//
// The companion .idx file (per-file label + section-size table)
// is produced by `asm_pass2 --emit-idx <prelude.idx> <prelude.s>`
// — asm_pass1 does not currently emit it because asm_common's
// global state doesn't fully reset between the lab-build run() and
// a subsequent emit-idx run() (the second call crashes in
// process_line with "get: null"). Splitting along this boundary
// matches the user's intent for Phase D / E anyway: pass2's job is
// label-table generation (lab + idx); pass1's job is encoding
// (.bin + .reloc).
//
// Internally calls run() (from asm_pass2_lib.tc) over the combined
// prelude + prelude_tail to get a .lab in memory, then run_pass2()
// (from asm_pass3_lib.tc) to emit the .bin / .reloc files.

import "asm_pass2_lib.tc";
import "asm_pass3_lib.tc";
import "asm_common.tc";

fn do_openat(dirfd: i32, path: String,        flags: i32) -> i32;
fn do_openat(dirfd: i32, path: StringLiteral, flags: i32) -> i32;
fn do_close(fd: i32) -> i32;

fn arg_eq(s: String, pat: StringLiteral) -> i32 {
    var ns: i32 = len(s);
    var np: i32 = len(pat);
    if ns != np { return 0; }
    var i: i32 = 0;
    while i < np {
        if get(s, i) != get(pat, i) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn err(s: StringLiteral) -> void {
    sys_write(2, s as u32 as U8Array, len(s));
    return;
}

// Stream `src_path` into the already-open `out_fd`. Used by
// concat_to_file to splice prelude.s + prelude_tail.s together.
fn copy_into_fd(src_path: String, out_fd: i32) -> i32 {
    var fd: i32 = do_openat(0 - 100, src_path, 0);
    if fd < 0 { return -1; }
    var buf: U8Array = U8Array(4096);
    var total: i32 = 0;
    var done: i32 = 0;
    while done == 0 {
        var n: i32 = sys_read(fd, buf, 4096);
        if n <= 0 { done = 1; }
        else {
            sys_write(out_fd, buf, n);
            total = total + n;
        }
    }
    delete(buf);
    do_close(fd);
    return total;
}

fn concat_to_file(a: String, b: String, out_path: String) -> i32 {
    var fo: i32 = do_openat(0 - 100, out_path, 577);
    if fo < 0 { return -1; }
    if copy_into_fd(a, fo) < 0 { do_close(fo); return -1; }
    if copy_into_fd(b, fo) < 0 { do_close(fo); return -1; }
    do_close(fo);
    return 0;
}

fn run_pre_encode(prelude_s: String, prelude_tail_s: String,
                  text_bin: String, rodata_bin: String, data_bin: String,
                  reloc_out: String) -> i32 {
    var combined_path: StringLiteral = "/tmp/_p1_combined.s";
    var lab_path:      StringLiteral = "/tmp/_p1_combined.lab";
    if concat_to_file(prelude_s, prelude_tail_s, combined_path as String) != 0 {
        err("asm_pass1: concat failed\n");
        return -1;
    }
    // Bake `src <combined>` into the .lab so run_pass2 can re-open
    // the source per section pass.
    asm_set_src_path1(combined_path as String);
    var rc1: i32 = run(combined_path as String, 0 as String,
                       0 as String, 0 as String, lab_path as String);
    if rc1 != 0 { err("asm_pass1: lab build failed\n"); return rc1; }
    return run_pass2(lab_path as String, 0 as String,
                     text_bin, rodata_bin, data_bin, reloc_out);
}

fn main() -> i32 {
    err("asm_pass1: requires arguments — see source for CLI shape\n");
    return 1;
}

fn main(argv: StringArray) -> i32 {
    var prelude:      String = 0 as String;
    var prelude_tail: String = 0 as String;
    var text_bin:     String = 0 as String;
    var rodata_bin:   String = 0 as String;
    var data_bin:     String = 0 as String;
    var reloc_out:    String = 0 as String;
    if argv as u32 != 0u32 {
        var argc: i32 = len(argv);
        var i: i32 = 1;
        while i < argc {
            var a: String = get(argv, i);
            if arg_eq(a, "--text-bin") != 0 && i + 1 < argc {
                text_bin = get(argv, i + 1); i = i + 2;
            } else if arg_eq(a, "--rodata-bin") != 0 && i + 1 < argc {
                rodata_bin = get(argv, i + 1); i = i + 2;
            } else if arg_eq(a, "--data-bin") != 0 && i + 1 < argc {
                data_bin = get(argv, i + 1); i = i + 2;
            } else if arg_eq(a, "--reloc-out") != 0 && i + 1 < argc {
                reloc_out = get(argv, i + 1); i = i + 2;
            } else {
                if prelude as u32 == 0u32 {
                    prelude = a;
                } else if prelude_tail as u32 == 0u32 {
                    prelude_tail = a;
                }
                i = i + 1;
            }
        }
    }
    if prelude as u32 == 0u32 || prelude_tail as u32 == 0u32 ||
       text_bin as u32 == 0u32 || rodata_bin as u32 == 0u32 ||
       data_bin as u32 == 0u32 || reloc_out as u32 == 0u32 {
        err("usage: asm_pass1 prelude.s prelude_tail.s --text-bin P --rodata-bin P --data-bin P --reloc-out P\n");
        return 1;
    }
    return run_pre_encode(prelude, prelude_tail,
                          text_bin, rodata_bin, data_bin, reloc_out);
}
