// libtc_test.tc — minimal unit test framework for userland TC code.
//
// Each test file:
//
//   import "../../lib/libtc/libtc.tc";
//   import "../../lib/libtc_test.tc";
//
//   fn test_foo() -> void { assert_eq_int(2 + 2, 4, "math works"); }
//
//   fn main() -> i32 {
//       test_begin("test_foo"); test_foo();
//       return test_summary();
//   }
//
// Run with:
//
//   ./compiler/scripts/tc_run.sh bcrun userland/tests/sample/test_libtc.tc
//   make -C userland test-units              # all tests under userland/tests/
//
// Failures go to fd 2 (stderr), summary too. main() returns 0 on success,
// 1 if any assertion failed — so shell-level wrappers can fail fast.

import "../lib/libtc/libtc.tc";

var g_test_passed:  i32 = 0;
var g_test_failed:  i32 = 0;
// Mutable StringLiteral global: a literal initializer is a compile
// error (#36 — no load-time relocation for .data), so start null and
// let test_begin set it. The old literal init compiled to .word 0
// anyway, so the observable behavior is unchanged.
var g_test_current: StringLiteral = 0 as StringLiteral;

// test_begin — set the current test name for failure messages. Call once
// per logical test before its assertions so a failure tells you which
// scenario broke without grepping line numbers.
export fn test_begin(name: StringLiteral) -> void {
    g_test_current = name;
    return;
}

fn emit_dec_stderr(v: i32) -> void {
    if v == 0 { eputs("0"); return; }
    if v < 0 { eputs("-"); v = 0 - v; }
    var tmp: U8Array = U8Array(12u32);
    var n: i32 = 0;
    while v > 0 {
        set(tmp, n, ('0' as i32 + v % 10) as u8);
        v = v / 10;
        n = n + 1;
    }
    var out: U8Array = U8Array(n as u32);
    var k: i32 = 0;
    while k < n {
        set(out, k, get(tmp, n - 1 - k));
        k = k + 1;
    }
    sys_write(2, out, n);
    delete(out);
    delete(tmp);
    return;
}

fn fail_header() -> void {
    eputs("FAIL ["); eputs(g_test_current); eputs("] ");
    return;
}

// assert_true — fail unless cond.
export fn assert_true(cond: bool, msg: StringLiteral) -> void {
    if cond {
        g_test_passed = g_test_passed + 1;
    } else {
        g_test_failed = g_test_failed + 1;
        fail_header(); eputs(msg); eputs("\n");
    }
    return;
}

// assert_false — fail unless cond is false.
export fn assert_false(cond: bool, msg: StringLiteral) -> void {
    assert_true(!cond, msg);
    return;
}

// assert_eq_int — fail unless actual == expected. Both numbers and the
// label are printed on failure so you don't have to instrument the test
// further to localise the issue.
export fn assert_eq_int(actual: i32, expected: i32, msg: StringLiteral) -> void {
    if actual == expected {
        g_test_passed = g_test_passed + 1;
    } else {
        g_test_failed = g_test_failed + 1;
        fail_header(); eputs(msg);
        eputs(": expected="); emit_dec_stderr(expected);
        eputs(" actual="); emit_dec_stderr(actual);
        eputs("\n");
    }
    return;
}

// assert_eq_str_lit — fail unless the first `n` bytes of `buf` exactly
// match the StringLiteral `s`. Both are dumped on mismatch.
export fn assert_eq_str_lit(buf: U8Array, n: i32, s: StringLiteral,
                            msg: StringLiteral) -> void {
    if eq(buf, n, s) {
        g_test_passed = g_test_passed + 1;
    } else {
        g_test_failed = g_test_failed + 1;
        fail_header(); eputs(msg);
        eputs(": expected=\""); eputs(s);
        eputs("\" actual=\"");
        sys_write(2, buf, n);
        eputs("\"\n");
    }
    return;
}

// test_summary — print "== N passed, M failed ==" to stderr and return
// 1 if anything failed (suitable for `return test_summary();` at the
// end of main). 0 on all-pass.
export fn test_summary() -> i32 {
    eputs("\n== "); emit_dec_stderr(g_test_passed); eputs(" passed, ");
    emit_dec_stderr(g_test_failed); eputs(" failed ==\n");
    if g_test_failed > 0 { return 1; }
    return 0;
}
