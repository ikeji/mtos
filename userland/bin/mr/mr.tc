// mr.tc — XMODEM-ish framing decoder. Counterpart of mx.tc.
//
// Default frame (no flag): `[len:u16 LE][data:len bytes]`. mr reads
// data and writes it straight to stdout. A frame with len=0
// terminates the stream; mr returns 0.
//
// ACK+checksum frame (`mr -a`):
//   `[len:u16 LE][data:len bytes][sum:u32 LE]`
// where `sum` is the unsigned 32-bit sum of all `data` bytes
// (treating each byte as u32; arithmetic mod 2^32). mr:
//   - emits '.' to fd 2 (stderr → UART) at startup
//   - after each frame: writes data only if checksum matches,
//     emits '.' if match, '!' (NAK) if mismatch so the sender
//     can re-transmit. NAK does NOT write the (possibly corrupt)
//     bytes; the file stays at the offset before this frame.
//   - emits '.' at clean end-of-stream
// Length 0 still terminates (no trailing sum).
//
// The ACK byte gates the sender against streaming during mr's
// M-mode fatfs_write window (K11 PL011 RX FIFO overflow). The
// checksum catches UART bit errors that ACK alone wouldn't —
// observed in practice as non-deterministic device-built
// kernel.bin md5 after 3.5 MB ACK-only uploads.

import "../../lib/libtc/libtc.tc";

fn ack(enabled: i32, buf: U8Array) -> void {
    if enabled == 0 { return; }
    sys_write(2, buf, 1);
    return;
}

fn main(argv: StringArray) -> i32 {
    var ack_mode: i32 = 0;
    var ai: i32 = 1;
    while ai < len(argv) {
        var s: String = get(argv, ai);
        if len(s) == 2 && get(s, 0) == ('-' as u8) && get(s, 1) == ('a' as u8) {
            ack_mode = 1;
        }
        ai = ai + 1;
    }

    var hdr: U8Array = U8Array(2);
    var sum_buf: U8Array = U8Array(4);
    var buf: U8Array = U8Array(65536);
    var ack_buf: U8Array = U8Array(1);
    set(ack_buf, 0, '.' as u8);
    var nak_buf: U8Array = U8Array(1);
    set(nak_buf, 0, '!' as u8);
    var done: i32 = 0;

    // Initial ACK so the sender knows mr is up and ready to read.
    ack(ack_mode, ack_buf);

    while done == 0 {
        // Read the 2-byte little-endian size header.
        var got: i32 = 0;
        while got < 2 && done == 0 {
            var tmp: U8Array = U8Array((2 - got) as u32);
            var n: i32 = sys_read(0, tmp, 2 - got);
            if n <= 0 {
                done = 1;
            } else {
                var i: i32 = 0;
                while i < n {
                    set(hdr, got + i, get(tmp, i));
                    i = i + 1;
                }
                got = got + n;
            }
            delete(tmp);
        }
        if done == 1 { i_break(); }

        var sz: i32 = (get(hdr, 0) as i32) | ((get(hdr, 1) as i32) << 8);
        if sz == 0 {
            // End marker.
            done = 1;
        } else {
            // Read sz bytes of payload.
            var have: i32 = 0;
            while have < sz && done == 0 {
                var tmp2: U8Array = U8Array((sz - have) as u32);
                var m: i32 = sys_read(0, tmp2, sz - have);
                if m <= 0 {
                    done = 1;
                } else {
                    var j: i32 = 0;
                    while j < m {
                        set(buf, have + j, get(tmp2, j));
                        j = j + 1;
                    }
                    have = have + m;
                }
                delete(tmp2);
            }
            if done == 1 { i_break(); }

            // ACK mode reads a 4-byte little-endian sum32 trailer.
            // Silent mode (mr without -a) skips this entirely — its
            // legacy senders (qemu test fixtures, mx.tc) emit no
            // trailer.
            var ok: i32 = 1;
            if ack_mode != 0 {
                var sgot: i32 = 0;
                while sgot < 4 && done == 0 {
                    var tmp3: U8Array = U8Array((4 - sgot) as u32);
                    var k: i32 = sys_read(0, tmp3, 4 - sgot);
                    if k <= 0 {
                        done = 1;
                    } else {
                        var l: i32 = 0;
                        while l < k {
                            set(sum_buf, sgot + l, get(tmp3, l));
                            l = l + 1;
                        }
                        sgot = sgot + k;
                    }
                    delete(tmp3);
                }
                if done == 1 { i_break(); }
                var expected: u32 = (get(sum_buf, 0) as u32)
                                  | ((get(sum_buf, 1) as u32) << 8u32)
                                  | ((get(sum_buf, 2) as u32) << 16u32)
                                  | ((get(sum_buf, 3) as u32) << 24u32);
                // Sum all received bytes as u32 (mod 2^32).
                var actual: u32 = 0u32;
                var p: i32 = 0;
                while p < have {
                    actual = actual + (get(buf, p) as u32);
                    p = p + 1;
                }
                if actual != expected { ok = 0; }
            }

            if ok == 0 {
                // Checksum mismatch — NAK and DON'T write. Sender
                // re-transmits the same frame.
                sys_write(2, nak_buf, 1);
            } else if have > 0 {
                var wn: i32 = sys_write(1, buf, have);
                if wn != have {
                    done = 1;
                } else {
                    ack(ack_mode, ack_buf);
                }
            }
        }
    }
    ack(ack_mode, ack_buf);
    delete(hdr);
    delete(sum_buf);
    delete(buf);
    delete(ack_buf);
    delete(nak_buf);
    return 0;
}

fn i_break() -> void { return; }
