// mr.tc — XMODEM-ish framing decoder. Counterpart of mx.tc.
//
// Reads `[len:u16 LE][data:len bytes]` frames from stdin and writes
// `data` straight to stdout. A frame with len=0 terminates the
// stream; mr returns 0 at that point.
//
// Binary-transparent by construction (no inband escaping).
// Frame size limit: 65535 bytes. Actual max written by mx is 256.
//
// `mr -a` enables ACK mode: after each successful sys_write to stdout
// (and once at start, once before exiting), mr emits one '.' byte to
// stderr (fd 2 → UART). Senders that gate the next frame on the ACK
// avoid K11 (PL011 RX FIFO overflow during SD writes) because they
// stop transmitting while mr is busy in fatfs_write. The default
// (no `-a`) preserves the original silent behavior used by tests
// that consume the file output and don't read stderr.

import "../../lib/libtc/libtc.tc";

fn ack(enabled: i32, buf: U8Array) -> void {
    if enabled == 0 { return; }
    sys_write(2, buf, 1);
    return;
}

fn main(argv: StringArray) -> i32 {
    var ack_mode: i32 = 0;
    var ai: i32 = 1;
    while ai < len(argv) {
        var s: String = get(argv, ai);
        if len(s) == 2 && get(s, 0) == ('-' as u8) && get(s, 1) == ('a' as u8) {
            ack_mode = 1;
        }
        ai = ai + 1;
    }

    var hdr: U8Array = U8Array(2);
    var buf: U8Array = U8Array(65536);
    var ack_buf: U8Array = U8Array(1);
    set(ack_buf, 0, '.' as u8);
    var done: i32 = 0;

    // Initial ACK so the sender knows mr is up and ready to read.
    ack(ack_mode, ack_buf);

    while done == 0 {
        // Read the 2-byte little-endian size header.
        var got: i32 = 0;
        while got < 2 && done == 0 {
            var tmp: U8Array = U8Array((2 - got) as u32);
            var n: i32 = sys_read(0, tmp, 2 - got);
            if n <= 0 {
                done = 1;
            } else {
                var i: i32 = 0;
                while i < n {
                    set(hdr, got + i, get(tmp, i));
                    i = i + 1;
                }
                got = got + n;
            }
            delete(tmp);
        }
        if done == 1 { i_break(); }  // sys_read failed mid-header

        var sz: i32 = (get(hdr, 0) as i32) | ((get(hdr, 1) as i32) << 8);
        if sz == 0 {
            // End marker.
            done = 1;
        } else {
            // Read sz bytes of payload and forward.
            var have: i32 = 0;
            while have < sz && done == 0 {
                var tmp2: U8Array = U8Array((sz - have) as u32);
                var m: i32 = sys_read(0, tmp2, sz - have);
                if m <= 0 {
                    // Truncated payload — bail out.
                    done = 1;
                } else {
                    var j: i32 = 0;
                    while j < m {
                        set(buf, have + j, get(tmp2, j));
                        j = j + 1;
                    }
                    have = have + m;
                }
                delete(tmp2);
            }
            if have > 0 {
                var wn: i32 = sys_write(1, buf, have);
                if wn != have {
                    // Truncated write — bail rather than silently
                    // ACKing a partial sector. The sender will see
                    // the missing ACK and time out with a clear
                    // "frame@N" position.
                    done = 1;
                } else {
                    // ACK after fatfs_write completes — the sender's
                    // wait-for-ACK loop has been idle on the UART
                    // during the M-mode SD-write window, so the RX
                    // FIFO drained.
                    ack(ack_mode, ack_buf);
                }
            }
        }
    }
    // Final ACK on clean end-of-stream so the sender knows mr is done.
    ack(ack_mode, ack_buf);
    delete(hdr);
    delete(buf);
    delete(ack_buf);
    return 0;
}

// Tiny helper: TC doesn't have `break`, so we simulate early-exit with
// a no-op call that compilers can inline away. Used once above for
// clarity; the outer `while done == 0` would catch the exit anyway.
fn i_break() -> void { return; }
