// sl.tc — Steam Locomotive joke task (classic Unix `sl`).
//
// Animates a 10-line ASCII steam locomotive scrolling right-to-left on
// an 80x24 terminal. Each frame uses ANSI cursor positioning
// (ESC[<row>;1H) so the host UART terminal redraws in place; one
// sys_write per row keeps the per-frame syscall count predictable.
//
// On the LCD console (userland/bin/console/console.tc) the ESC bytes
// are silently dropped because the render() dispatcher only honours
// LF/CR/BS plus printable codepoints — the train still prints, just as
// scrolling rows instead of fixed-position animation. Either way the
// joke survives.

import "../../lib/libtc/libtc.tc";

fn do_nanosleep(ms: i32) -> i32;

// Terminal geometry. Defaults match a standard 80x24 host terminal
// (what UART users see). /etc/term.conf overrides for LCD consoles —
// disk-console-land.img ships 56x15, disk-console.img ships 40x30.
// `sl COLS ROWS` on the command line has the highest precedence.
var SW: i32 = 80;
var SH: i32 = 24;

// Train bounding box. 10 rows tall, max line is 53 cols wide. The
// animation loop runs while pos > -TRAIN_W so the train clears the
// left edge before we redraw the final clean frame.
var TRAIN_W: i32 = 53;
const TRAIN_H: i32 = 10;

// Parse a non-negative decimal — returns -1 on empty / non-digit input
// so callers can fall back to a default. Same logic as seq.tc but
// without the leading-minus handling (SW/SH are always positive).
fn parse_uint(s: String) -> i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    var ll: i32 = len(s);
    if ll == 0 { return -1; }
    while i < ll {
        var c: u8 = get(s, i);
        if c < ('0' as u8) || c > ('9' as u8) { return -1; }
        n = n * 10 + (c as i32 - 48);
        i = i + 1;
    }
    return n;
}

// Parse one i32 decimal starting at buf[off..n], stopping at the first
// non-digit. Returns the value (0 if no digits matched).
fn parse_dec_buf(buf: U8Array, off: i32, n: i32) -> i32 {
    var v: i32 = 0;
    while off < n {
        var c: u8 = get(buf, off);
        if c < ('0' as u8) || c > ('9' as u8) { return v; }
        v = v * 10 + (c as i32 - 48);
        off = off + 1;
    }
    return v;
}

// True iff `prefix` is a literal prefix of buf[off..n].
fn buf_starts_with(buf: U8Array, off: i32, n: i32, prefix: StringLiteral) -> bool {
    var pl: i32 = len(prefix);
    if off + pl > n { return false; }
    var i: i32 = 0;
    while i < pl {
        if get(buf, off + i) != get(prefix, i) { return false; }
        i = i + 1;
    }
    return true;
}

// Read /etc/term.conf and apply COLS / ROWS overrides. Format is
// trivial: each line is `KEY=VALUE`; '#' and blank lines are skipped.
// Silently no-ops when the file is absent so UART runs still see the
// 80x24 compile-time default.
fn load_term_conf() -> void {
    var fd: i32 = do_openat(0, "/etc/term.conf", 0);
    if fd < 0 { return; }
    var buf: U8Array = U8Array(256);
    var n: i32 = sys_read(fd, buf, 256);
    do_close(fd);
    if n <= 0 { delete(buf); return; }
    var i: i32 = 0;
    while i < n {
        // skip leading whitespace
        while i < n && (get(buf, i) == ' ' as u8 || get(buf, i) == '\t' as u8) {
            i = i + 1;
        }
        if i < n && get(buf, i) != '#' as u8 && get(buf, i) != '\n' as u8 {
            if buf_starts_with(buf, i, n, "COLS=") {
                SW = parse_dec_buf(buf, i + 5, n);
            } else if buf_starts_with(buf, i, n, "ROWS=") {
                SH = parse_dec_buf(buf, i + 5, n);
            }
        }
        // advance to next line
        while i < n && get(buf, i) != '\n' as u8 { i = i + 1; }
        if i < n { i = i + 1; }
    }
    delete(buf);
    return;
}

// Append a non-negative decimal `v` to buf starting at off; return
// the new offset. Used inline by render_row to splice the row number
// into the ESC[<row>;1H prefix without an extra sys_write.
fn put_dec(buf: U8Array, off: i32, v: i32) -> i32 {
    if v == 0 {
        set(buf, off, '0' as u8);
        return off + 1;
    }
    var tmp: U8Array = U8Array(12u32);
    var n: i32 = 0;
    while v > 0 {
        set(tmp, n, ('0' as i32 + v % 10) as u8);
        n = n + 1;
        v = v / 10;
    }
    var k: i32 = 0;
    while k < n {
        set(buf, off + k, get(tmp, n - 1 - k));
        k = k + 1;
    }
    delete(tmp);
    return off + n;
}

// Render one train row. Layout written into `buf`:
//   ESC '[' <row> ';' '1' 'H'   (cursor positioning, 5–7 bytes)
//   SW bytes of payload         (spaces overlaid with the train slice)
// We emit it as a single sys_write so each animation frame fires
// exactly TRAIN_H syscalls — important on UART where the slow path is
// the trap rather than the bytes themselves.
fn render_row(s: StringLiteral, pos: i32, row: i32, buf: U8Array) -> void {
    var o: i32 = 0;
    set(buf, o, 27u8);            o = o + 1;
    set(buf, o, '[' as u8);       o = o + 1;
    o = put_dec(buf, o, row);
    set(buf, o, ';' as u8);       o = o + 1;
    set(buf, o, '1' as u8);       o = o + 1;
    set(buf, o, 'H' as u8);       o = o + 1;
    var pad: i32 = o;
    var i: i32 = 0;
    while i < SW {
        set(buf, pad + i, ' ' as u8);
        i = i + 1;
    }
    var ll: i32 = len(s);
    var src: i32 = 0;
    var dst: i32 = pos;
    if dst < 0 { src = 0 - dst; dst = 0; }
    while src < ll && dst < SW {
        set(buf, pad + dst, get(s, src));
        src = src + 1;
        dst = dst + 1;
    }
    sys_write(1, buf, pad + SW);
    return;
}

// Inline-dispatched 10-row train. Returning a StringLiteral from a
// table function isn't exercised anywhere else in the codebase, so
// keep each row's literal at the call site instead.
fn render_train(pos: i32, start_row: i32, buf: U8Array) -> void {
    render_row("      ====        ________                ___________",
               pos, start_row + 0, buf);
    render_row("  _D _|  |_______/        \\__I_I_____===__|_________|",
               pos, start_row + 1, buf);
    render_row("   |(_)---  |   H\\________/ |   |        =|___ ___|",
               pos, start_row + 2, buf);
    render_row("   /     |  |   H  |  |     |   |         ||_| |_||",
               pos, start_row + 3, buf);
    render_row("  |      |  |   H  |__--------------------| [___] |",
               pos, start_row + 4, buf);
    render_row("  | ________|___H__/__|_____/[][]~\\_______|       |",
               pos, start_row + 5, buf);
    render_row("  |/ |   |-----------I_____I [][] []  D   |=======|__",
               pos, start_row + 6, buf);
    render_row("__/ =| o |=-~~\\  /~~\\  /~~\\  /~~\\ ____Y___________|__",
               pos, start_row + 7, buf);
    render_row(" |/-=|___||    ||    ||    ||    |_____/~\\___/",
               pos, start_row + 8, buf);
    render_row("  \\_/      \\O=====O=====O=====O_/      \\_/",
               pos, start_row + 9, buf);
    return;
}

// ESC [ 2 J + ESC [ H — clear + home. Single sys_write.
fn clear_screen() -> void {
    var buf: U8Array = U8Array(8u32);
    set(buf, 0, 27u8);          set(buf, 1, '[' as u8);
    set(buf, 2, '2' as u8);     set(buf, 3, 'J' as u8);
    set(buf, 4, 27u8);          set(buf, 5, '[' as u8);
    set(buf, 6, 'H' as u8);
    sys_write(1, buf, 7);
    delete(buf);
    return;
}

// ESC [ ? 2 5 l — hide the terminal cursor so it doesn't flicker
// across the locomotive while the frames repaint.
fn hide_cursor() -> void {
    var buf: U8Array = U8Array(8u32);
    set(buf, 0, 27u8);          set(buf, 1, '[' as u8);
    set(buf, 2, '?' as u8);     set(buf, 3, '2' as u8);
    set(buf, 4, '5' as u8);     set(buf, 5, 'l' as u8);
    sys_write(1, buf, 6);
    delete(buf);
    return;
}

// ESC [ ? 2 5 h — paired show_cursor for the wind-down.
fn show_cursor() -> void {
    var buf: U8Array = U8Array(8u32);
    set(buf, 0, 27u8);          set(buf, 1, '[' as u8);
    set(buf, 2, '?' as u8);     set(buf, 3, '2' as u8);
    set(buf, 4, '5' as u8);     set(buf, 5, 'h' as u8);
    sys_write(1, buf, 6);
    delete(buf);
    return;
}

fn main(argv: StringArray) -> i32 {
    // Precedence: compile-time defaults (80x24) → /etc/term.conf
    // (shipped on console disks) → argv (`sl COLS ROWS`). The conf
    // file lets the LCD pick up the right size automatically without
    // every script having to remember to type `sl 56 15`.
    load_term_conf();

    // argv: `sl [COLS [ROWS]]`. Missing or non-numeric args keep the
    // value resolved above. Caps SW at 240 because the row scratch
    // buffer is allocated against it and a typo'd 80000 should not
    // OOM the task arena.
    if (argv as u32) != 0u32 {
        var ac: i32 = len(argv);
        if ac >= 2 {
            var v0: i32 = parse_uint(get(argv, 1));
            if v0 > 0 && v0 <= 240 { SW = v0; }
        }
        if ac >= 3 {
            var v1: i32 = parse_uint(get(argv, 2));
            if v1 > 0 && v1 <= 200 { SH = v1; }
        }
    }

    var start_row: i32 = (SH - TRAIN_H) / 2;
    if start_row < 1 { start_row = 1; }

    hide_cursor();
    clear_screen();

    // Scratch holds the ESC prefix + SW bytes of payload; the longest
    // row prefix at SH up to 200 is 7 bytes, so SW+16 leaves slack.
    var buf: U8Array = U8Array((SW + 16) as u32);

    var pos:  i32 = SW;
    var step: i32 = 2;
    while pos > 0 - TRAIN_W {
        render_train(pos, start_row, buf);
        do_nanosleep(20);
        pos = pos - step;
    }

    delete(buf);
    clear_screen();
    show_cursor();
    return 0;
}
