// neofetch.tc — friendly system info splash.
//
// Reads /proc/tasks for task counts, /proc/meminfo for kernel
// kmalloc usage, and readdir on /bin + /sd for filesystem entry
// counts. Prints a small ASCII banner alongside the summary.

import "../../lib/libtc/libtc.tc";


// Count task slots by state. Reads /proc/tasks lines; each line starts
// with "N state ...". We classify tokens after the first space.
struct TaskStats {
    total:   i32,
    ready:   i32,
    done:    i32,
    unused:  i32,
    waiting: i32,
}

fn read_task_stats() -> TaskStats {
    var stats: TaskStats = TaskStats(0, 0, 0, 0, 0);
    var fd: i32 = do_openat(0, "/proc/tasks", 0);
    if fd < 0 { return stats; }
    var buf: U8Array = U8Array(4096);
    var n: i32 = sys_read(fd, buf, 4096);
    do_close(fd);
    if n <= 0 { delete(buf); return stats; }
    var i: i32 = 0;
    while i < n {
        // Skip leading digits (slot number)
        while i < n && get(buf, i) != 32u8 && get(buf, i) != 10u8 { i = i + 1; }
        while i < n && get(buf, i) == 32u8 { i = i + 1; }
        // i now points at state name
        var st_start: i32 = i;
        while i < n && get(buf, i) != 32u8 && get(buf, i) != 10u8 { i = i + 1; }
        var st_len: i32 = i - st_start;
        total(stats, total(stats) + 1);
        if st_len == 5 && get(buf, st_start) == 'r' as u8 {
            ready(stats, ready(stats) + 1);
        } else if st_len == 4 && get(buf, st_start) == 'd' as u8 {
            done(stats, done(stats) + 1);
        } else if st_len == 6 && get(buf, st_start) == 'u' as u8 {
            unused(stats, unused(stats) + 1);
        } else if st_len == 7 && get(buf, st_start) == 'w' as u8 {
            waiting(stats, waiting(stats) + 1);
        }
        // Skip to next line
        while i < n && get(buf, i) != 10u8 { i = i + 1; }
        if i < n { i = i + 1; }
    }
    delete(buf);
    return stats;
}

// /proc/meminfo layout (from kernel/src/procfs.tc::synth_meminfo):
//   peak: <decimal>\n
//   used: <decimal>\n
// We parse it by scanning labels; whichever orders procfs uses, the
// match is by label so reordering doesn't break us.
struct MemInfo {
    used: i32,
    peak: i32,
}

fn parse_dec_at(buf: U8Array, off: i32, n: i32) -> i32 {
    var v: i32 = 0;
    while off < n {
        var c: u8 = get(buf, off);
        if c < ('0' as u8) || c > ('9' as u8) { return v; }
        v = v * 10 + ((c as i32) - ('0' as i32));
        off = off + 1;
    }
    return v;
}

// True iff `prefix` is at buf[off..]. Returns the length on match, 0 on miss.
fn match_prefix(buf: U8Array, off: i32, n: i32, prefix: StringLiteral) -> i32 {
    var pl: i32 = len(prefix);
    if off + pl > n { return 0; }
    var i: i32 = 0;
    while i < pl {
        if get(buf, off + i) != get(prefix, i) { return 0; }
        i = i + 1;
    }
    return pl;
}

fn read_meminfo() -> MemInfo {
    var info: MemInfo = MemInfo(0, 0);
    var fd: i32 = do_openat(0, "/proc/meminfo", 0);
    if fd < 0 { return info; }
    var buf: U8Array = U8Array(256);
    var n: i32 = sys_read(fd, buf, 256);
    do_close(fd);
    if n <= 0 { delete(buf); return info; }
    var i: i32 = 0;
    while i < n {
        var m: i32 = match_prefix(buf, i, n, "peak: ");
        if m > 0 {
            peak(info, parse_dec_at(buf, i + m, n));
        } else {
            m = match_prefix(buf, i, n, "used: ");
            if m > 0 {
                used(info, parse_dec_at(buf, i + m, n));
            }
        }
        // skip to next line
        while i < n && get(buf, i) != 10u8 { i = i + 1; }
        if i < n { i = i + 1; }
    }
    delete(buf);
    return info;
}

// Count NUL-terminated entries in a readdir buffer. Returns -1 when
// the path can't be enumerated (e.g. /sd on virt without fatfs).
fn count_dir(path: StringLiteral) -> i32 {
    var buf: U8Array = U8Array(2048);
    var n: i32 = do_readdir(path, buf as u32 + 4u32, 2048);
    if n <= 0 { delete(buf); return 0 - 1; }
    var i: i32 = 0;
    var count: i32 = 0;
    while i < n {
        if get(buf, i) == 0u8 { count = count + 1; }
        i = i + 1;
    }
    delete(buf);
    return count;
}

// Print v as "X.Y KB" — one decimal digit, rounded. v is bytes.
fn print_kb(v: i32) -> void {
    var tenths: i32 = (v * 10 + 512) / 1024;   // round to one decimal
    print(tenths / 10);
    puts(".");
    print(tenths % 10);
    puts(" KB");
    return;
}

fn main() -> i32 {
    var stats: TaskStats = read_task_stats();
    var mem:   MemInfo   = read_meminfo();
    var n_bin: i32       = count_dir("/bin");
    var n_sd:  i32       = count_dir("/sd");

    puts("      ___      \n");
    puts("     |___|     ");
    puts("  riscv-os\n");
    puts("    __|_|__    ");
    puts("  ------------\n");
    puts("   /__|__|__\\   ");
    puts("  kernel: TinyC-riscv\n");
    puts("  /___|___|__\\  ");
    puts("  arch  : RV32IM\n");
    puts(" /____|_____|_\\ ");
    puts("  tasks : ");
    print(ready(stats));
    puts(" ready / ");
    print(total(stats));
    puts(" total\n");
    puts("                ");
    puts("  done  : ");
    print(done(stats));
    puts("\n");
    puts("                ");
    puts("  wait  : ");
    print(waiting(stats));
    puts("\n");
    puts("                ");
    puts("  mem   : ");
    print_kb(used(mem));
    puts(" used / ");
    print_kb(peak(mem));
    puts(" peak\n");
    puts("                ");
    puts("  bin   : ");
    print(n_bin);
    puts(" tasks\n");
    puts("                ");
    puts("  /sd   : ");
    if n_sd < 0 {
        puts("(unmounted)\n");
    } else {
        print(n_sd);
        puts(" files\n");
    }
    delete(stats);
    delete(mem);
    return 0;
}
