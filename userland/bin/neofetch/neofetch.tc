// neofetch.tc — friendly system info splash.
//
// Reads /proc/tasks for task counts, /proc/meminfo for kernel
// kmalloc usage, and readdir on /bin + /sd for filesystem entry
// counts. Prints a small ASCII banner alongside the summary.

import "../../lib/libtc/libtc.tc";


// Count task slots by state. Reads /proc/tasks lines; each line starts
// with "N state ...". We classify tokens after the first space.
struct TaskStats {
    total:   i32,
    ready:   i32,
    done:    i32,
    unused:  i32,
    waiting: i32,
}

fn read_task_stats() -> TaskStats {
    var stats: TaskStats = TaskStats(0, 0, 0, 0, 0);
    var fd: i32 = do_openat(0, "/proc/tasks", 0);
    if fd < 0 { return stats; }
    var buf: U8Array = U8Array(4096);
    var n: i32 = sys_read(fd, buf, 4096);
    do_close(fd);
    if n <= 0 { delete(buf); return stats; }
    var i: i32 = 0;
    while i < n {
        // Skip leading digits (slot number)
        while i < n && get(buf, i) != 32u8 && get(buf, i) != 10u8 { i = i + 1; }
        while i < n && get(buf, i) == 32u8 { i = i + 1; }
        // i now points at state name
        var st_start: i32 = i;
        while i < n && get(buf, i) != 32u8 && get(buf, i) != 10u8 { i = i + 1; }
        var st_len: i32 = i - st_start;
        total(stats, total(stats) + 1);
        if st_len == 5 && get(buf, st_start) == 'r' as u8 {
            ready(stats, ready(stats) + 1);
        } else if st_len == 4 && get(buf, st_start) == 'd' as u8 {
            done(stats, done(stats) + 1);
        } else if st_len == 6 && get(buf, st_start) == 'u' as u8 {
            unused(stats, unused(stats) + 1);
        } else if st_len == 7 && get(buf, st_start) == 'w' as u8 {
            waiting(stats, waiting(stats) + 1);
        }
        // Skip to next line
        while i < n && get(buf, i) != 10u8 { i = i + 1; }
        if i < n { i = i + 1; }
    }
    delete(buf);
    return stats;
}

// /proc/meminfo layout (from kernel/src/procfs.tc::synth_meminfo):
//   peak: <decimal>\n
//   used: <decimal>\n
// We parse it by scanning labels; whichever orders procfs uses, the
// match is by label so reordering doesn't break us.
struct MemInfo {
    used: i32,
    peak: i32,
}

fn parse_dec_at(buf: U8Array, off: i32, n: i32) -> i32 {
    var v: i32 = 0;
    while off < n {
        var c: u8 = get(buf, off);
        if c < ('0' as u8) || c > ('9' as u8) { return v; }
        v = v * 10 + ((c as i32) - ('0' as i32));
        off = off + 1;
    }
    return v;
}

// True iff `prefix` is at buf[off..]. Returns the length on match, 0 on miss.
fn match_prefix(buf: U8Array, off: i32, n: i32, prefix: StringLiteral) -> i32 {
    var pl: i32 = len(prefix);
    if off + pl > n { return 0; }
    var i: i32 = 0;
    while i < pl {
        if get(buf, off + i) != get(prefix, i) { return 0; }
        i = i + 1;
    }
    return pl;
}

fn read_meminfo() -> MemInfo {
    var info: MemInfo = MemInfo(0, 0);
    var fd: i32 = do_openat(0, "/proc/meminfo", 0);
    if fd < 0 { return info; }
    var buf: U8Array = U8Array(256);
    var n: i32 = sys_read(fd, buf, 256);
    do_close(fd);
    if n <= 0 { delete(buf); return info; }
    var i: i32 = 0;
    while i < n {
        var m: i32 = match_prefix(buf, i, n, "peak: ");
        if m > 0 {
            peak(info, parse_dec_at(buf, i + m, n));
        } else {
            m = match_prefix(buf, i, n, "used: ");
            if m > 0 {
                used(info, parse_dec_at(buf, i + m, n));
            }
        }
        // skip to next line
        while i < n && get(buf, i) != 10u8 { i = i + 1; }
        if i < n { i = i + 1; }
    }
    delete(buf);
    return info;
}

// Print v as "X.Y KB" — one decimal digit, rounded. v is bytes.
fn print_kb(v: i32) -> void {
    var tenths: i32 = (v * 10 + 512) / 1024;   // round to one decimal
    print(tenths / 10);
    puts(".");
    print(tenths % 10);
    puts(" KB");
    return;
}

// Print v KiB as "X.Y MB" or "X.Y GB" depending on magnitude. Used
// for fatfs sizes that don't fit cleanly in KB.
fn print_kib_human(v: i32) -> void {
    if v < 0 { puts("?"); return; }
    if v < 1024 {
        print(v);
        puts(" KB");
        return;
    }
    var mib_tenths: i32 = (v * 10 + 512) / 1024;
    if mib_tenths < 10240 {
        print(mib_tenths / 10);
        puts(".");
        print(mib_tenths % 10);
        puts(" MB");
        return;
    }
    var gib_tenths: i32 = (mib_tenths + 512) / 1024;
    print(gib_tenths / 10);
    puts(".");
    print(gib_tenths % 10);
    puts(" GB");
    return;
}

// Emit `count` bytes starting at buf[off] to stdout. The caller is
// expected to size `count` against `len(buf)`; we keep the temp
// allocation small to avoid pressuring the task arena.
fn write_bytes(buf: U8Array, off: i32, count: i32) -> void {
    if count <= 0 { return; }
    var out: U8Array = U8Array(count as u32);
    var i: i32 = 0;
    while i < count {
        set(out, i, get(buf, off + i));
        i = i + 1;
    }
    sys_write(1, out, count);
    delete(out);
    return;
}

// Print one line from /etc/version for the named key (e.g. "build="
// or "date="). Cap at 32 bytes — long enough for K21 milestone tags
// or a short hash, short enough to keep the splash from wrapping.
// Trims trailing CR so files saved with CRLF still align cleanly.
fn print_version_field(buf: U8Array, n: i32, prefix: StringLiteral) -> void {
    var i: i32 = 0;
    while i < n {
        var m: i32 = match_prefix(buf, i, n, prefix);
        if m > 0 {
            var start: i32 = i + m;
            var end: i32 = start;
            while end < n && get(buf, end) != 10u8 && get(buf, end) != 13u8 {
                end = end + 1;
            }
            var w: i32 = end - start;
            if w > 32 { w = 32; }
            write_bytes(buf, start, w);
            return;
        }
        while i < n && get(buf, i) != 10u8 { i = i + 1; }
        if i < n { i = i + 1; }
    }
    puts("?");
    return;
}

// /etc/version is a KEY=VALUE file shipped on every disk (see
// kernel/fs-spec/default.spec). When the file is missing — e.g. a
// hand-built disk that omits default.spec — we degrade to "(unknown)"
// rather than hide the line entirely so the splash still tells you
// what info isn't available.
fn print_build_line() -> void {
    var fd: i32 = do_openat(0, "/etc/version", 0);
    if fd < 0 {
        puts("  build : (unknown)\n");
        return;
    }
    var buf: U8Array = U8Array(128);
    var n: i32 = sys_read(fd, buf, 128);
    do_close(fd);
    if n <= 0 {
        delete(buf);
        puts("  build : (unknown)\n");
        return;
    }
    puts("  build : ");
    print_version_field(buf, n, "build=");
    puts(" (");
    print_version_field(buf, n, "date=");
    puts(")\n");
    delete(buf);
    return;
}

// Stream /proc/diskinfo into stdout, one line per mounted FS, each
// preceded by the 16-space banner padding so the FS table aligns
// with the rest of the right column. Lines from the kernel are key=
// value records (see kernel/src/procfs.tc::synth_diskinfo); we pretty-
// print them per-FS into "name path  <human-readable>".
fn print_diskinfo() -> void {
    var fd: i32 = do_openat(0, "/proc/diskinfo", 0);
    if fd < 0 { return; }
    var buf: U8Array = U8Array(512);
    var n: i32 = sys_read(fd, buf, 512);
    do_close(fd);
    if n <= 0 { delete(buf); return; }
    var i: i32 = 0;
    while i < n {
        var line_start: i32 = i;
        while i < n && get(buf, i) != 10u8 { i = i + 1; }
        var line_end: i32 = i;
        if i < n { i = i + 1; }
        // Recognise the FS by the first whitespace-delimited token.
        if match_prefix(buf, line_start, line_end, "mtfs ") > 0 {
            puts("                  mtfs  : ");
            var fc: i32 = 0 - 1; var tot: i32 = 0 - 1;
            // walk tokens
            var k: i32 = line_start;
            while k < line_end {
                var m: i32 = match_prefix(buf, k, line_end, "total=");
                if m > 0 { tot = parse_dec_at(buf, k + m, line_end); }
                m = match_prefix(buf, k, line_end, "files=");
                if m > 0 { fc = parse_dec_at(buf, k + m, line_end); }
                while k < line_end && get(buf, k) != ' ' as u8 { k = k + 1; }
                while k < line_end && get(buf, k) == ' ' as u8 { k = k + 1; }
            }
            print(fc); puts(" files, "); print_kib_human(tot / 1024); puts("\n");
        } else if match_prefix(buf, line_start, line_end, "tmpfs ") > 0 {
            puts("                  tmpfs : ");
            var used_b: i32 = 0; var fc: i32 = 0; var max_f: i32 = 0;
            var k: i32 = line_start;
            while k < line_end {
                var m: i32 = match_prefix(buf, k, line_end, "files=");
                if m > 0 {
                    fc = parse_dec_at(buf, k + m, line_end);
                    // skip past N
                    while k + m < line_end && get(buf, k + m) >= '0' as u8
                          && get(buf, k + m) <= '9' as u8 { m = m + 1; }
                    if k + m < line_end && get(buf, k + m) == '/' as u8 {
                        max_f = parse_dec_at(buf, k + m + 1, line_end);
                    }
                }
                m = match_prefix(buf, k, line_end, "used=");
                if m > 0 { used_b = parse_dec_at(buf, k + m, line_end); }
                while k < line_end && get(buf, k) != ' ' as u8 { k = k + 1; }
                while k < line_end && get(buf, k) == ' ' as u8 { k = k + 1; }
            }
            print(fc); puts("/"); print(max_f); puts(" files, ");
            print(used_b); puts(" B\n");
        } else if match_prefix(buf, line_start, line_end, "fatfs ") > 0 {
            puts("                  fatfs : ");
            var tot_kib: i32 = 0 - 1; var free_kib: i32 = 0 - 1;
            var k: i32 = line_start;
            while k < line_end {
                var m: i32 = match_prefix(buf, k, line_end, "total_kib=");
                if m > 0 { tot_kib = parse_dec_at(buf, k + m, line_end); }
                m = match_prefix(buf, k, line_end, "free_kib=");
                if m > 0 { free_kib = parse_dec_at(buf, k + m, line_end); }
                while k < line_end && get(buf, k) != ' ' as u8 { k = k + 1; }
                while k < line_end && get(buf, k) == ' ' as u8 { k = k + 1; }
            }
            print_kib_human(tot_kib);
            if free_kib >= 0 {
                puts(" total, "); print_kib_human(free_kib); puts(" free");
            }
            puts("\n");
        }
    }
    delete(buf);
    return;
}

fn main() -> i32 {
    var stats: TaskStats = read_task_stats();
    var mem:   MemInfo   = read_meminfo();

    puts("      ___      \n");
    puts("     |___|     ");
    puts("  riscv-os\n");
    puts("    __|_|__    ");
    puts("  ------------\n");
    puts("   /__|__|__\\   ");
    puts("  kernel: TinyC-riscv\n");
    puts("  /___|___|__\\  ");
    puts("  arch  : RV32IM\n");
    puts(" /____|_____|_\\ ");
    puts("  tasks : ");
    print(ready(stats));
    puts(" ready / ");
    print(total(stats));
    puts(" total\n");
    puts("                ");
    print_build_line();
    puts("                ");
    puts("  done  : ");
    print(done(stats));
    puts("\n");
    puts("                ");
    puts("  wait  : ");
    print(waiting(stats));
    puts("\n");
    puts("                ");
    puts("  mem   : ");
    print_kb(used(mem));
    puts(" used / ");
    print_kb(peak(mem));
    puts(" peak\n");
    print_diskinfo();
    delete(stats);
    delete(mem);
    return 0;
}
