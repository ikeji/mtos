// sh.tc — human-friendly interactive shell with sys_spawn + sys_wait.
//
// On each iteration: print "sh$ ", read a line from stdin (fd 0 →
// UART) with echo-back so the user can see what they type, tokenize
// on whitespace, classify tokens into (argv, in_path, out_path),
// then spawn "/bin/<argv[0]>" via do_spawn with all four pieces.
// The redirect operators are the standard `<` and `>`; the token
// following each is consumed as the redirected path. do_wait blocks
// until the child finishes. The loop exits on the built-in command
// "quit".
//
// do_uart_read has no concept of EOF, so we cannot rely on closing
// stdin to terminate the shell — a "quit" line is required.
//
// Echo-back: each received byte is written back to stdout so a raw
// serial console (where the host terminal isn't doing local echo)
// still shows the typed command. read_line is a small line editor
// (cursor keys, Home / End, Delete, Ctrl-A/E/U/K, UTF-8 aware, redraws
// with CSI only — see its comment). For programmatic drivers that
// don't want this, use msh instead.

import "../../lib/libtc/libtc.tc";


// CMD_MAX sized for self_replicate step 2: asm_pass2 with 13 inputs
// (`--add <idx>` × 13 + `--lab-out`) on /sd/pico2_self_step2.sh
// works out to ~250 chars; 1024 leaves comfortable headroom.
// PATH_MAX stays at 70 because individual paths still fit.
var CMD_MAX:  i32 = 1024;
// "/bin/" (5) + path bytes + NUL ≤ 70. argv[0] alone, no command line.
var PATH_MAX: i32 = 70;
const HIST_MAX: i32 = 8;

// Redirect results produced by parse_redir. Globals because TC
// functions return a single value and we need three outputs (argv
// + in_path + out_path). Cleared after each do_spawn. Stored as
// String so the count header is the content length and the values
// can be passed straight to do_openat / sys_write.
var g_in_path:  String = 0 as String;
var g_out_path: String = 0 as String;

// Echo one byte back to stdout so the user sees what they typed.
// Kept as a separate function so read_line stays readable.
fn echo_byte(c: u8) -> void {
    var one: U8Array = U8Array(1);
    set(one, 0, c);
    sys_write(1, one, 1);
    delete(one);
    return;
}

// Emit ESC[?47l on stdout. Console treats this as "the foreground
// task has released /dev/fb; please reopen it and repaint." sh sends
// this after every do_wait so a child that took /dev/fb via ESC[?47h
// and crashed without restoring it can't leave the LCD stuck on the
// frozen frame.
fn send_unfreeze_console() -> void {
    var seq: U8Array = U8Array(6u32);
    set(seq, 0, 27u8);            // ESC
    set(seq, 1, '[' as u8);
    set(seq, 2, '?' as u8);
    set(seq, 3, '4' as u8);
    set(seq, 4, '7' as u8);
    set(seq, 5, 'l' as u8);
    sys_write(1, seq, 6);
    delete(seq);
    return;
}

// --- Line editing helpers ----------------------------------------------
//
// read_line keeps the command in buf[0..n) with a cursor at byte offset
// cur. Redraws use CSI only (ESC[nC / ESC[nD / ESC[K), which both
// xterm.js on the UART and /bin/console on the LCD implement. Cursor
// movement is per UTF-8 codepoint, with East Asian wide characters
// counted as 2 columns (same table as vi.tc's char_width).

// Byte count for a UTF-8 lead byte (1–4); continuation bytes count 1.
fn utf8_len(c: u8) -> i32 {
    if c < 128u8 { return 1; }
    if c < 0xC0u8 { return 1; }
    if c < 0xE0u8 { return 2; }
    if c < 0xF0u8 { return 3; }
    return 4;
}

fn is_cont(c: u8) -> bool {
    return c >= 0x80u8 && c < 0xC0u8;
}

// Decode the codepoint at buf[off] (sequence must end by `end`).
fn utf8_decode(buf: U8Array, off: i32, end: i32) -> i32 {
    var c0: i32 = get(buf, off) as i32;
    if c0 < 128 { return c0; }
    var l: i32 = utf8_len(c0 as u8);
    if off + l > end { return 0xFFFD; }
    if l == 2 {
        return ((c0 & 0x1F) << 6) | (get(buf, off + 1) as i32 & 0x3F);
    }
    if l == 3 {
        return ((c0 & 0x0F) << 12)
             | ((get(buf, off + 1) as i32 & 0x3F) << 6)
             | (get(buf, off + 2) as i32 & 0x3F);
    }
    return ((c0 & 0x07) << 18)
         | ((get(buf, off + 1) as i32 & 0x3F) << 12)
         | ((get(buf, off + 2) as i32 & 0x3F) << 6)
         | (get(buf, off + 3) as i32 & 0x3F);
}

// Display width of a codepoint (1 or 2).
fn char_width(cp: i32) -> i32 {
    if cp >= 0x1100 && cp <= 0x115F { return 2; }
    if cp >= 0x2E80 && cp <= 0x9FFF { return 2; }
    if cp >= 0xF900 && cp <= 0xFAFF { return 2; }
    if cp >= 0xFE10 && cp <= 0xFE6F { return 2; }
    if cp >= 0xFF01 && cp <= 0xFF60 { return 2; }
    if cp >= 0xFFE0 && cp <= 0xFFE6 { return 2; }
    return 1;
}

// Display columns occupied by buf[from..to).
fn disp_cols(buf: U8Array, from: i32, to: i32) -> i32 {
    var col: i32 = 0;
    var i: i32 = from;
    while i < to {
        var l: i32 = utf8_len(get(buf, i));
        if i + l > to { l = to - i; }
        col = col + char_width(utf8_decode(buf, i, to));
        i = i + l;
    }
    return col;
}

// Start offset of the codepoint before buf[cur] (cur > 0).
fn prev_cp(buf: U8Array, cur: i32) -> i32 {
    var p: i32 = cur - 1;
    while p > 0 && is_cont(get(buf, p)) { p = p - 1; }
    return p;
}

// Offset just past the codepoint at buf[cur] (cur < n).
fn next_cp(buf: U8Array, cur: i32, n: i32) -> i32 {
    var q: i32 = cur + utf8_len(get(buf, cur));
    if q > n { q = n; }
    return q;
}

// Emit ESC [ <k> <final> — CUF ('C') / CUB ('D'); nothing for k == 0.
fn csi_move(k: i32, final: u8) -> void {
    if k <= 0 { return; }
    var seq: U8Array = U8Array(16u32);
    set(seq, 0, 27u8);
    set(seq, 1, '[' as u8);
    var p: i32 = 2;
    var d: U8Array = U8Array(12u32);
    var nd: i32 = 0;
    var x: i32 = k;
    while x > 0 {
        set(d, nd, (('0' as i32) + x % 10) as u8);
        nd = nd + 1;
        x = x / 10;
    }
    while nd > 0 {
        nd = nd - 1;
        set(seq, p, get(d, nd));
        p = p + 1;
    }
    delete(d);
    set(seq, p, final);
    p = p + 1;
    sys_write(1, seq, p);
    delete(seq);
    return;
}

// ESC [ K — erase from the cursor to the end of the line.
fn csi_erase_eol() -> void {
    var seq: U8Array = U8Array(3u32);
    set(seq, 0, 27u8);
    set(seq, 1, '[' as u8);
    set(seq, 2, 'K' as u8);
    sys_write(1, seq, 3);
    delete(seq);
    return;
}

// Write buf[from..to) to the terminal in one sys_write.
fn echo_range(buf: U8Array, from: i32, to: i32) -> void {
    if to <= from { return; }
    var tmp: U8Array = U8Array((to - from) as u32);
    var i: i32 = 0;
    while from + i < to {
        set(tmp, i, get(buf, from + i));
        i = i + 1;
    }
    sys_write(1, tmp, to - from);
    delete(tmp);
    return;
}

// Redraw buf[cur..n) at the cursor, clear what was there before, and
// put the terminal cursor back at cur.
fn redraw_tail(buf: U8Array, n: i32, cur: i32) -> void {
    echo_range(buf, cur, n);
    csi_erase_eol();
    csi_move(disp_cols(buf, cur, n), 'D' as u8);
    return;
}

// Remove buf[a..b) from a line of n bytes; returns the new length.
fn ed_delete(buf: U8Array, n: i32, a: i32, b: i32) -> i32 {
    var i: i32 = b;
    while i < n {
        set(buf, a + (i - b), get(buf, i));
        i = i + 1;
    }
    return n - (b - a);
}

// Clear the whole edited line on the terminal (cursor may be anywhere
// in it) so something else can be drawn in its place.
fn ed_clear(buf: U8Array, n: i32, cur: i32) -> void {
    csi_move(disp_cols(buf, cur, n), 'C' as u8);
    csi_move(disp_cols(buf, 0, n), 'D' as u8);
    csi_erase_eol();
    return;
}

// --- History --------------------------------------------------------
//
// Ring buffer of the last HIST_MAX commands. Each entry is a U8Array
// holding the raw command bytes (NUL-terminated). hist_head points
// one past the most recent entry; hist_count is clamped to HIST_MAX.

var g_hist: StringArray = 0 as StringArray;
var g_hist_head:  i32 = 0;
var g_hist_count: i32 = 0;

fn hist_init() -> void {
    g_hist = StringArray(HIST_MAX as u32);
    // Slots default to null String, which hist_recall / hist_push
    // treat as "empty". No per-slot init needed.
    return;
}

fn hist_push(buf: U8Array, n: i32) -> void {
    if n == 0 { return; }
    var slot: i32 = g_hist_head % HIST_MAX;
    var old: String = get(g_hist, slot);
    if old as u32 != 0u32 { delete(old); }
    set(g_hist, slot, string_from_bytes(buf, 0, n));
    g_hist_head = g_hist_head + 1;
    if g_hist_count < HIST_MAX { g_hist_count = g_hist_count + 1; }
    return;
}

// Replace the edited line (n bytes, cursor at cur) with history entry
// `idx` (0 = most recent), echoing it. Returns the new length; the
// caller puts the cursor at the end.
fn hist_recall(buf: U8Array, n: i32, cur: i32, idx: i32) -> i32 {
    ed_clear(buf, n, cur);
    if idx < 0 || idx >= g_hist_count { set(buf, 0, 0u8); return 0; }
    var slot: i32 = (g_hist_head - 1 - idx + HIST_MAX * 256) % HIST_MAX;
    var entry: String = get(g_hist, slot);
    if entry as u32 == 0u32 { set(buf, 0, 0u8); return 0; }
    var elen: i32 = len(entry);
    var i: i32 = 0;
    while i < elen && i < CMD_MAX - 1 {
        set(buf, i, get(entry, i));
        i = i + 1;
    }
    set(buf, i, 0u8);
    echo_range(buf, 0, i);
    return i;
}

// --- Tab completion -------------------------------------------------
//
// On TAB, look at the current whitespace-separated token and try to
// complete it against a directory listing:
//   * first token on the line → /bin entries (command names) + builtins
//                               (quit / setenv / unsetenv / getenv / env)
//   * token containing '/'    → readdir of the parent, match basename
//   * other tokens            → readdir of "/" (no CWD concept)
// Exactly one match: the remaining bytes are typed in (echoed to the
// user as if they pressed them). Multiple matches: all candidates are
// printed on a new line, the prompt and current buffer are re-echoed
// so editing can continue.
//
// Keep the helpers local to sh.tc; they're not useful elsewhere.

fn tab_is_path_char(c: u8) -> bool {
    if c >= 'a' as u8 && c <= 'z' as u8 { return true; }
    if c >= 'A' as u8 && c <= 'Z' as u8 { return true; }
    if c >= '0' as u8 && c <= '9' as u8 { return true; }
    if c == '_' as u8 || c == '.' as u8 ||
       c == '/' as u8 || c == '-' as u8 { return true; }
    return false;
}

// Walk backwards from pos to find the start of the current token.
fn tab_token_start(buf: U8Array, pos: i32) -> i32 {
    var i: i32 = pos;
    while i > 0 && tab_is_path_char(get(buf, i - 1)) {
        i = i - 1;
    }
    return i;
}

// True iff the token at tok_start is in command position: either the
// first token on the line (only whitespace before) or the token
// immediately after a `|` pipe operator.
fn tab_is_first_token(buf: U8Array, tok_start: i32) -> bool {
    var i: i32 = tok_start;
    while i > 0 && (get(buf, i - 1) == ' ' as u8 || get(buf, i - 1) == 9u8) {
        i = i - 1;
    }
    if i == 0 { return true; }
    if get(buf, i - 1) == '|' as u8 { return true; }
    return false;
}

// Find the offset of the last '/' in buf[start..end]. Returns -1
// when the range contains no slash.
fn tab_last_slash(buf: U8Array, start: i32, end: i32) -> i32 {
    var i: i32 = end - 1;
    while i >= start {
        if get(buf, i) == '/' as u8 { return i; }
        i = i - 1;
    }
    return -1;
}

// Echo one byte via sh's existing helper (fd=1). Wrapped here so
// the many spots below stay terse.
fn tab_echo_str(s: StringLiteral) -> void {
    var sl: i32 = len(s);
    var i: i32 = 0;
    while i < sl { echo_byte(get(s, i)); i = i + 1; }
    return;
}

// Append one NUL-terminated name to the readdir-style listing in dirbuf
// at offset n (capacity cap). Returns the new length; a name that does
// not fit is dropped.
fn tab_append_name(dirbuf: U8Array, n: i32, cap: i32, name: StringLiteral) -> i32 {
    var nl: i32 = len(name);
    if n + nl + 1 > cap { return n; }
    var i: i32 = 0;
    while i < nl { set(dirbuf, n + i, get(name, i)); i = i + 1; }
    set(dirbuf, n + nl, 0u8);
    return n + nl + 1;
}

// sh builtins, completed in command position alongside /bin. Keep in
// sync with exec_command / builtin_env below.
fn tab_append_builtins(dirbuf: U8Array, n: i32, cap: i32) -> i32 {
    n = tab_append_name(dirbuf, n, cap, "quit");
    n = tab_append_name(dirbuf, n, cap, "setenv");
    n = tab_append_name(dirbuf, n, cap, "unsetenv");
    n = tab_append_name(dirbuf, n, cap, "getenv");
    n = tab_append_name(dirbuf, n, cap, "env");
    return n;
}

// Perform tab completion and return the new end-of-buffer position.
// The caller keeps pos at the end of buf; we inject the completion
// bytes into buf and echo them so sh's outer state stays consistent.
fn complete(buf: U8Array, pos: i32) -> i32 {
    var tok_start: i32 = tab_token_start(buf, pos);
    var base_start: i32 = tok_start;
    // dir holds the path to enumerate (NUL-terminated, <= 128 chars).
    var dir: U8Array = U8Array(128);
    var dir_len: i32 = 0;
    if tab_is_first_token(buf, tok_start) {
        // command completion → /bin
        var s: StringLiteral = "/bin";
        var sl: i32 = len(s);
        var i: i32 = 0;
        while i < sl { set(dir, i, get(s, i)); i = i + 1; }
        dir_len = sl;
    } else {
        // Non-first tokens must be absolute paths — the shell has no
        // CWD concept, so `ls tmp` fails even if "tmp" exists at "/".
        // Require a leading '/' before attempting path completion to
        // avoid completing the user into an unrunnable command.
        if get(buf, tok_start) != '/' as u8 {
            delete(dir);
            return pos;
        }
        var slash_idx: i32 = tab_last_slash(buf, tok_start, pos);
        // dir = buf[tok_start..slash_idx] (no trailing /), except
        // for the root ("/xxx" → dir "/").
        var start: i32 = tok_start;
        var end: i32 = slash_idx;
        if end == start {
            // Path starts with '/', dir is "/"
            set(dir, 0, '/' as u8);
            dir_len = 1;
        } else {
            var k: i32 = 0;
            while start + k < end {
                set(dir, k, get(buf, start + k));
                k = k + 1;
            }
            dir_len = end - start;
        }
        base_start = slash_idx + 1;
    }
    set(dir, dir_len, 0u8);
    // Patch dir's count header to the content length so do_readdir
    // (which consumes a String-layout path) reads the right size.
    poke32(dir as u32, dir_len as u32);
    var base_len: i32 = pos - base_start;

    // 4092 keeps total alloc at one page (count header 4B + 4092 data =
    // 4096); U8Array(4096) would round up to two pages and OOM on the
    // second tab after history pushes fragment the free list.
    var dirbuf: U8Array = U8Array(4092);
    var n: i32 = do_readdir(dir as String,
                            dirbuf as u32 + 4u32, 4092);
    // Entries at offset >= listing_n are builtins (no file behind them).
    var listing_n: i32 = n;
    if tab_is_first_token(buf, tok_start) {
        // Command position: the builtins (quit + the env family) live
        // in no directory, so append them to the /bin listing as extra
        // NUL-terminated entries and let the matching below treat them
        // like any other command name.
        if n < 0 { n = 0; }
        n = tab_append_builtins(dirbuf, n, 4092);
    }
    if n <= 0 { delete(dir); delete(dirbuf); return pos; }

    // First pass: count matches + remember the first one.
    var match_count: i32 = 0;
    var first_start: i32 = 0;
    var first_len: i32 = 0;
    var i: i32 = 0;
    while i < n {
        var ns: i32 = i;
        while i < n && get(dirbuf, i) != 0u8 { i = i + 1; }
        var nl: i32 = i - ns;
        if i < n { i = i + 1; }
        if nl < base_len {
            // too short; skip
        } else {
            var matches: i32 = 1;
            var j: i32 = 0;
            while j < base_len {
                if get(dirbuf, ns + j) != get(buf, base_start + j) {
                    matches = 0;
                    j = base_len;
                }
                j = j + 1;
            }
            if matches == 1 {
                if match_count == 0 {
                    first_start = ns;
                    first_len = nl;
                }
                match_count = match_count + 1;
            }
        }
    }

    if match_count == 1 {
        // Unique: inject the remaining bytes.
        var extra: i32 = first_len - base_len;
        var k: i32 = 0;
        while k < extra && pos < CMD_MAX - 1 {
            var c: u8 = get(dirbuf, first_start + base_len + k);
            set(buf, pos, c);
            pos = pos + 1;
            echo_byte(c);
            k = k + 1;
        }
        // If the completed entry is a directory, append '/' so the user
        // can keep typing the next path component without re-tabbing.
        // Probe by opening as a regular file — mtfs/tmpfs/procfs all
        // reject directories, so open-failure ⇒ directory. Builtins
        // have no file to probe, so skip them.
        if pos < CMD_MAX - 1 && first_start < listing_n {
            var cp: U8Array = U8Array(256u32);
            var cpos: i32 = 0;
            var ci: i32 = 0;
            while ci < dir_len {
                set(cp, cpos, get(dir, ci));
                cpos = cpos + 1;
                ci = ci + 1;
            }
            if cpos == 0 || get(cp, cpos - 1) != '/' as u8 {
                set(cp, cpos, '/' as u8);
                cpos = cpos + 1;
            }
            var nl: i32 = pos - base_start;
            var nk: i32 = 0;
            while nk < nl {
                set(cp, cpos, get(buf, base_start + nk));
                cpos = cpos + 1;
                nk = nk + 1;
            }
            set(cp, cpos, 0u8);
            poke32(cp as u32, cpos as u32);
            var fd: i32 = do_openat(0, cp as String, 0);
            delete(cp);
            if fd < 0 {
                set(buf, pos, '/' as u8);
                pos = pos + 1;
                echo_byte('/' as u8);
            } else {
                do_close(fd);
            }
        }
    } else if match_count > 1 {
        // Compute the longest common prefix among all matches.
        var common_len: i32 = first_len;
        var ii: i32 = 0;
        while ii < n {
            var ns: i32 = ii;
            while ii < n && get(dirbuf, ii) != 0u8 { ii = ii + 1; }
            var nl: i32 = ii - ns;
            if ii < n { ii = ii + 1; }
            if nl >= base_len {
                var mm: i32 = 1;
                var jj: i32 = 0;
                while jj < base_len {
                    if get(dirbuf, ns + jj) != get(buf, base_start + jj) {
                        mm = 0;
                        jj = base_len;
                    }
                    jj = jj + 1;
                }
                if mm == 1 {
                    // Shrink common_len to match this candidate.
                    if nl < common_len { common_len = nl; }
                    var cc: i32 = base_len;
                    while cc < common_len {
                        if get(dirbuf, ns + cc) != get(dirbuf, first_start + cc) {
                            common_len = cc;
                        }
                        cc = cc + 1;
                    }
                }
            }
        }
        // Insert the common prefix extension.
        var extra: i32 = common_len - base_len;
        var k: i32 = 0;
        while k < extra && pos < CMD_MAX - 1 {
            var c: u8 = get(dirbuf, first_start + base_len + k);
            set(buf, pos, c);
            pos = pos + 1;
            echo_byte(c);
            k = k + 1;
        }
        // If there is still ambiguity (common prefix didn't uniquely
        // resolve), show all candidates on a new line.
        if common_len < first_len {
            echo_byte(13u8);
            echo_byte(10u8);
            ii = 0;
            while ii < n {
                var ns2: i32 = ii;
                while ii < n && get(dirbuf, ii) != 0u8 { ii = ii + 1; }
                var nl2: i32 = ii - ns2;
                if ii < n { ii = ii + 1; }
                if nl2 >= base_len {
                    var mm2: i32 = 1;
                    var jj2: i32 = 0;
                    while jj2 < base_len {
                        if get(dirbuf, ns2 + jj2) != get(buf, base_start + jj2) {
                            mm2 = 0;
                            jj2 = base_len;
                        }
                        jj2 = jj2 + 1;
                    }
                    if mm2 == 1 {
                        var kk: i32 = 0;
                        while kk < nl2 {
                            echo_byte(get(dirbuf, ns2 + kk));
                            kk = kk + 1;
                        }
                        echo_byte(' ' as u8);
                    }
                }
            }
            echo_byte(13u8);
            echo_byte(10u8);
            tab_echo_str("sh$ ");
            var pp: i32 = 0;
            while pp < pos {
                echo_byte(get(buf, pp));
                pp = pp + 1;
            }
        }
    }
    delete(dirbuf);
    delete(dir);
    return pos;
}

// Read one command line from stdin with line editing. Returns the
// number of command bytes stored in buf (NUL-terminated, < CMD_MAX).
//
//   printable / UTF-8 bytes  insert at the cursor
//   Backspace / DEL          delete the codepoint before the cursor
//   ESC [ 3 ~  (Delete)      delete the codepoint under the cursor
//   ESC [ D / C (← →)        move by one codepoint
//   Ctrl-A, ESC [ H, ESC [ 1 ~ / 7 ~   start of line
//   Ctrl-E, ESC [ F, ESC [ 4 ~ / 8 ~   end of line
//   Ctrl-U / Ctrl-K          delete before / after the cursor
//   ESC [ A / B (↑ ↓)        history (cursor goes to the end)
//   TAB                      completion, only with the cursor at the end
//   LF / CR                  done (echoed as CRLF for dumb terminals)
fn read_byte(one: U8Array) -> i32 {
    var n: i32 = sys_read(0, one, 1);
    if n <= 0 { return -1; }
    return get(one, 0) as i32;
}

fn read_line(buf: U8Array) -> i32 {
    var one: U8Array = U8Array(1);
    var n: i32 = 0;         // bytes in buf
    var cur: i32 = 0;       // cursor byte offset, 0..n
    var pend: i32 = 0;      // continuation bytes still due for a mid-line insert
    var cstart: i32 = 0;    // where that multibyte char starts
    var done: i32 = 0;
    var hist_idx: i32 = -1;
    while done == 0 {
        var r: i32 = sys_read(0, one, 1);
        if r <= 0 {
            done = 1;
        } else {
            var c: u8 = get(one, 0);
            if c >= 32u8 && c != 127u8 {
                // Insert at the cursor (printable ASCII or any UTF-8
                // byte; multibyte text such as Japanese passes through).
                if n < CMD_MAX - 1 {
                    var i: i32 = n;
                    while i > cur {
                        set(buf, i, get(buf, i - 1));
                        i = i - 1;
                    }
                    set(buf, cur, c);
                    n = n + 1;
                    cur = cur + 1;
                    if cur == n {
                        // At the end: let the terminal assemble the
                        // multibyte sequence byte by byte.
                        echo_byte(c);
                        pend = 0;
                    } else {
                        // Mid-line: wait for the whole codepoint, then
                        // redraw from its first byte so no CSI lands
                        // inside a half-sent UTF-8 sequence.
                        if pend == 0 {
                            cstart = cur - 1;
                            pend = utf8_len(c) - 1;
                        } else {
                            pend = pend - 1;
                        }
                        if pend == 0 {
                            echo_range(buf, cstart, n);
                            csi_erase_eol();
                            csi_move(disp_cols(buf, cur, n), 'D' as u8);
                        }
                    }
                }
            } else {
                pend = 0;
                if c == '\n' as u8 || c == '\r' as u8 {
                    echo_byte(13u8);
                    echo_byte(10u8);
                    done = 1;
                } else if c == 8u8 || c == 127u8 {
                    if cur > 0 {
                        var p: i32 = prev_cp(buf, cur);
                        csi_move(disp_cols(buf, p, cur), 'D' as u8);
                        n = ed_delete(buf, n, p, cur);
                        cur = p;
                        redraw_tail(buf, n, cur);
                    }
                } else if c == 9u8 {
                    if cur == n {
                        set(buf, n, 0u8);
                        n = complete(buf, n);
                        cur = n;
                    }
                } else if c == 1u8 {
                    // Ctrl-A: start of line
                    csi_move(disp_cols(buf, 0, cur), 'D' as u8);
                    cur = 0;
                } else if c == 5u8 {
                    // Ctrl-E: end of line
                    csi_move(disp_cols(buf, cur, n), 'C' as u8);
                    cur = n;
                } else if c == 21u8 {
                    // Ctrl-U: delete everything before the cursor
                    csi_move(disp_cols(buf, 0, cur), 'D' as u8);
                    n = ed_delete(buf, n, 0, cur);
                    cur = 0;
                    redraw_tail(buf, n, cur);
                } else if c == 11u8 {
                    // Ctrl-K: delete everything after the cursor
                    n = cur;
                    csi_erase_eol();
                } else if c == 27u8 {
                    // ESC [ <digits> <final>
                    var c2: i32 = read_byte(one);
                    if c2 == '[' as i32 {
                        var num: i32 = 0;
                        var c3: i32 = read_byte(one);
                        while c3 >= '0' as i32 && c3 <= '9' as i32 {
                            num = num * 10 + (c3 - ('0' as i32));
                            c3 = read_byte(one);
                        }
                        if c3 == 'A' as i32 {
                            // Up arrow: older history
                            if hist_idx + 1 < g_hist_count {
                                hist_idx = hist_idx + 1;
                                n = hist_recall(buf, n, cur, hist_idx);
                                cur = n;
                            }
                        } else if c3 == 'B' as i32 {
                            // Down arrow: newer history
                            if hist_idx > 0 {
                                hist_idx = hist_idx - 1;
                                n = hist_recall(buf, n, cur, hist_idx);
                                cur = n;
                            } else if hist_idx == 0 {
                                hist_idx = -1;
                                ed_clear(buf, n, cur);
                                n = 0;
                                cur = 0;
                            }
                        } else if c3 == 'D' as i32 {
                            if cur > 0 {
                                var p: i32 = prev_cp(buf, cur);
                                csi_move(disp_cols(buf, p, cur), 'D' as u8);
                                cur = p;
                            }
                        } else if c3 == 'C' as i32 {
                            if cur < n {
                                var q: i32 = next_cp(buf, cur, n);
                                csi_move(disp_cols(buf, cur, q), 'C' as u8);
                                cur = q;
                            }
                        } else if c3 == 'H' as i32 || (c3 == '~' as i32 && (num == 1 || num == 7)) {
                            csi_move(disp_cols(buf, 0, cur), 'D' as u8);
                            cur = 0;
                        } else if c3 == 'F' as i32 || (c3 == '~' as i32 && (num == 4 || num == 8)) {
                            csi_move(disp_cols(buf, cur, n), 'C' as u8);
                            cur = n;
                        } else if c3 == '~' as i32 && num == 3 {
                            // Delete: the codepoint under the cursor
                            if cur < n {
                                var q: i32 = next_cp(buf, cur, n);
                                n = ed_delete(buf, n, cur, q);
                                redraw_tail(buf, n, cur);
                            }
                        }
                    }
                }
                // Other C0 controls are ignored.
            }
        }
    }
    delete(one);
    set(buf, n, 0u8);
    return n;
}

// Compare a NUL-terminated byte sequence in buf against a string
// literal. Returns true iff they match exactly.
// (eq moved to libtc/libtc.tc)

// Count tokens in buf[0..n], treating runs of spaces as separators.
fn count_tokens(buf: U8Array, n: i32) -> i32 {
    var count: i32 = 0;
    var in_tok: i32 = 0;
    var i: i32 = 0;
    while i < n {
        var c: u8 = get(buf, i);
        if c == ' ' as u8 {
            in_tok = 0;
        } else {
            if in_tok == 0 {
                count = count + 1;
                in_tok = 1;
            }
        }
        i = i + 1;
    }
    return count;
}

// Scan cmd[0..n] into:
//   - g_in_path  (String, 0 if no `<`)
//   - g_out_path (String, 0 if no `>`)
//   - a returned StringArray of argv tokens (excluding the redirect
//     operators and their operands)
//
// A single pass over the buffer: we walk tokens twice, once to count
// argv / locate redirect operands, and once to fill the returned
// argv. Tokens `<` / `>` are single-char.
fn parse_redir(cmd: U8Array, n: i32) -> StringArray {
    // Pass 1: classify tokens.
    var argc: i32 = 0;
    var in_start:  i32 = -1;
    var in_len:    i32 = 0;
    var out_start: i32 = -1;
    var out_len:   i32 = 0;
    var want_in:  i32 = 0;
    var want_out: i32 = 0;

    var i: i32 = 0;
    while i < n {
        while i < n && get(cmd, i) == ' ' as u8 { i = i + 1; }
        if i < n {
            var start: i32 = i;
            while i < n && get(cmd, i) != ' ' as u8 { i = i + 1; }
            var tlen: i32 = i - start;

            if want_in == 1 {
                in_start = start;
                in_len   = tlen;
                want_in = 0;
            } else if want_out == 1 {
                out_start = start;
                out_len   = tlen;
                want_out = 0;
            } else if tlen == 1 && get(cmd, start) == '<' as u8 {
                want_in = 1;
            } else if tlen == 1 && get(cmd, start) == '>' as u8 {
                want_out = 1;
            } else {
                argc = argc + 1;
            }
        }
    }

    if in_start >= 0 {
        g_in_path = string_from_bytes(cmd, in_start, in_len);
    } else {
        g_in_path = 0 as U8Array;
    }
    if out_start >= 0 {
        g_out_path = string_from_bytes(cmd, out_start, out_len);
    } else {
        g_out_path = 0 as String;
    }

    // Pass 2: fill argv (only the non-redirect tokens).
    var argv: StringArray = StringArray(argc as u32);
    var idx: i32 = 0;
    want_in = 0;
    want_out = 0;
    i = 0;
    while i < n {
        while i < n && get(cmd, i) == ' ' as u8 { i = i + 1; }
        if i < n {
            var start2: i32 = i;
            while i < n && get(cmd, i) != ' ' as u8 { i = i + 1; }
            var tlen2: i32 = i - start2;

            if want_in == 1 {
                want_in = 0;
            } else if want_out == 1 {
                want_out = 0;
            } else if tlen2 == 1 && get(cmd, start2) == '<' as u8 {
                want_in = 1;
            } else if tlen2 == 1 && get(cmd, start2) == '>' as u8 {
                want_out = 1;
            } else {
                set(argv, idx, string_from_bytes(cmd, start2, tlen2));
                idx = idx + 1;
            }
        }
    }
    return argv;
}

// Free every String element in sa then the array itself. Called
// after do_spawn so the shell's arena does not accumulate argv
// allocations across iterations (the kernel has already cloned the
// contents for the child by this point).
fn free_argv(sa: StringArray) -> void {
    var n: i32 = len(sa);
    var i: i32 = 0;
    while i < n {
        delete(get(sa, i));
        i = i + 1;
    }
    delete(sa);
    return;
}

// Write the path to execute into `path` in String layout: bytes at
// offsets 0..n with the count header poked in afterwards so callers
// can hand `path as u32` straight to do_spawn / do_exec. Returns
// true on success. If argv[0] starts with '/' we treat it as an
// absolute path (used by phase 7 to run freshly compiled binaries
// out of /tmp). Otherwise we prepend "/bin/".
fn build_path(path: U8Array, argv: StringArray) -> bool {
    if len(argv) == 0 { return false; }
    var head: String = get(argv, 0);
    var hlen: i32 = len(head);
    if hlen == 0 { return false; }
    // Use poke8 so we can write past the current count header — the
    // previous iteration's build_path shrank `path`'s count to the
    // last path's length, which would make set() trip its bounds
    // check for any longer path this time around.
    var base: u32 = path as u32 + 4u32;
    var total: i32 = 0;
    if get(head, 0) == '/' as u8 {
        if hlen + 1 > PATH_MAX { return false; }
        var i: i32 = 0;
        while i < hlen {
            poke8(base + (i as u32), get(head, i));
            i = i + 1;
        }
        poke8(base + (hlen as u32), 0u8);
        total = hlen;
    } else {
        if hlen + 5 + 1 > PATH_MAX { return false; }
        poke8(base,          '/' as u8);
        poke8(base + 1u32,   'b' as u8);
        poke8(base + 2u32,   'i' as u8);
        poke8(base + 3u32,   'n' as u8);
        poke8(base + 4u32,   '/' as u8);
        var i: i32 = 0;
        while i < hlen {
            poke8(base + ((5 + i) as u32), get(head, i));
            i = i + 1;
        }
        poke8(base + ((5 + hlen) as u32), 0u8);
        total = 5 + hlen;
    }
    poke32(path as u32, total as u32);
    return true;
}

// --- Pipe support ---------------------------------------------------
//
// `cmd1 | cmd2` is implemented via tmpfs intermediate files:
//   cmd1 > /tmp/_p0  (spawn + wait)
//   cmd2 < /tmp/_p0  (spawn + wait)
// Multi-stage: cmd1 | cmd2 | cmd3 chains /tmp/_p0, /tmp/_p1, ...
// Sequential execution (not streaming). Max 4 pipes (5 segments).

// Scan for standalone `|` tokens in cmd[0..n-1]. Record their byte
// offsets in pipe_pos (up to len(pipe_pos) entries). Returns the
// number of `|` tokens found.
fn count_pipes(cmd: U8Array, n: i32, pipe_pos: I32Array) -> i32 {
    var count: i32 = 0;
    var i: i32 = 0;
    while i < n {
        while i < n && get(cmd, i) == ' ' as u8 { i = i + 1; }
        if i < n {
            var start: i32 = i;
            while i < n && get(cmd, i) != ' ' as u8 { i = i + 1; }
            var tlen: i32 = i - start;
            if tlen == 1 && get(cmd, start) == '|' as u8 {
                if count < len(pipe_pos) {
                    set(pipe_pos, count, start);
                }
                count = count + 1;
            }
        }
    }
    return count;
}

// Open a file path from g_in_path / g_out_path and return the VFS fd.
// Returns 0 if the path is NULL. flags: 0 = read, 577 = write+create+trunc.
fn open_redir_path(p: String, flags: i32) -> i32 {
    if p as u32 == 0u32 { return 0; }
    return do_openat(0, p, flags);
}

// Read one line from fd into buf, no echo / history / tab — meant for
// scripted input (e.g. /etc/login). Returns the line length, 0 on a
// blank line, -1 on clean EOF before any byte was read. Lines longer
// than CMD_MAX-1 are truncated silently; trailing \r is dropped.
// Read-ahead for the login script. Reading it a byte at a time cost one
// syscall per byte, and a syscall round trip is ~16 ms on the tn20k core — a
// 443-byte /etc/login spent ~7 s in read() alone, which was most of the delay
// between "SH: ready" and the first prompt. Refill in blocks instead.
// The buffer is fine as module state: run_login_script is the only caller and
// it reads exactly one file, once.
const SCRIPT_BUF: i32 = 256;
var g_sb:   U8Array = 0 as U8Array;
var g_sb_n: i32 = 0;      // valid bytes in the buffer
var g_sb_i: i32 = 0;      // next byte to hand out

// Next script byte, or -1 at EOF.
fn script_getc(fd: i32) -> i32 {
    if g_sb_i >= g_sb_n {
        if g_sb as u32 == 0u32 { g_sb = U8Array(SCRIPT_BUF as u32); }
        g_sb_n = sys_read(fd, g_sb, SCRIPT_BUF);
        g_sb_i = 0;
        if g_sb_n <= 0 { g_sb_n = 0; return 0 - 1; }
    }
    var c: i32 = get(g_sb, g_sb_i) as i32;
    g_sb_i = g_sb_i + 1;
    return c;
}

fn read_script_line(fd: i32, buf: U8Array) -> i32 {
    var pos: i32 = 0;
    var got_any: i32 = 0;
    var done: i32 = 0;
    while done == 0 {
        var n: i32 = script_getc(fd);
        if n < 0 {
            done = 1;
        } else {
            got_any = 1;
            var c: u8 = n as u8;
            if c == ('\n' as u8) {
                done = 1;
            } else if c == ('\r' as u8) {
                // swallow; LF will follow (or EOF)
            } else if pos < CMD_MAX - 1 {
                set(buf, pos, c);
                pos = pos + 1;
            }
        }
    }
    set(buf, pos, 0u8);
    if got_any == 0 { return -1; }
    return pos;
}

// emit_us_dec — print `us / 1000` (= ms) as decimal to fd 2 (stderr).
// Used by the one-shot first-prompt timestamp below so the host can
// time `power-on → prompt visible` end-to-end. Stderr goes to UART
// even when sh is wrapped by /bin/console (which redirects fd 1 to
// the pipe but inherits fd 2 from itself = UART), so the trace shows
// up in the openocd-captured UART log either way.
fn emit_ms_dec(us: u32) -> void {
    var ms: u32 = us / 1000u32;
    if ms == 0u32 { eputs("0"); return; }
    var tmp: U8Array = U8Array(12u32);
    var n: i32 = 0;
    while ms > 0u32 {
        set(tmp, n, ('0' as i32 + (ms % 10u32) as i32) as u8);
        n = n + 1;
        ms = ms / 10u32;
    }
    var out: U8Array = U8Array(n as u32);
    var k: i32 = 0;
    while k < n {
        set(out, k, get(tmp, n - 1 - k));
        k = k + 1;
    }
    sys_write(2, out, n);
    delete(out);
    delete(tmp);
    return;
}

// --- env builtins (docs/task/proc_env.md) ---------------------------
//   setenv KEY [VALUE]   set (VALUE = rest of the line, may be empty)
//   unsetenv KEY         unset
//   getenv KEY           print the value
//   env                  print every KEY=VALUE
// Thin wrappers over libtc env_get / env_set / env_unset. A child task
// could read the same through /proc/self/env/, and `echo V >
// /proc/self/env/K` even sets sh's var (the redirect is opened in sh's
// context), but `rm` / `cat` run in their own task with their own
// inherited copy — so changing sh's variables is sh's job.
fn skip_sp(cmd: U8Array, i: i32, n: i32) -> i32 {
    while i < n && get(cmd, i) == ' ' as u8 { i = i + 1; }
    return i;
}
fn tok_end(cmd: U8Array, i: i32, n: i32) -> i32 {
    while i < n && get(cmd, i) != ' ' as u8 { i = i + 1; }
    return i;
}
fn tok_is(cmd: U8Array, s: i32, e: i32, lit: StringLiteral) -> bool {
    if e - s != len(lit) { return false; }
    var i: i32 = 0;
    while i < e - s {
        if get(cmd, s + i) != get(lit, i) { return false; }
        i = i + 1;
    }
    return true;
}

// Returns 1 if cmd was an env builtin (handled), 0 otherwise.
fn builtin_env(cmd: U8Array, n: i32) -> i32 {
    var i0: i32 = skip_sp(cmd, 0, n);
    var e0: i32 = tok_end(cmd, i0, n);
    var kind: i32 = 0;
    if tok_is(cmd, i0, e0, "setenv")   { kind = 1; }
    if tok_is(cmd, i0, e0, "unsetenv") { kind = 2; }
    if tok_is(cmd, i0, e0, "getenv")   { kind = 3; }
    if tok_is(cmd, i0, e0, "env")      { kind = 4; }
    if kind == 0 { return 0; }

    if kind == 4 {
        var names: U8Array = U8Array(512u32);
        var nb: i32 = do_readdir("/proc/self/env", names as u32 + 4u32, 512);
        var val: U8Array = U8Array(128u32);
        var p: i32 = 0;
        while p < nb {
            var q: i32 = p;
            while q < nb && get(names, q) != 0u8 { q = q + 1; }
            var key: String = string_from_bytes(names, p, q - p);
            var vl: i32 = env_get(key, val, 128);
            sys_write(1, key);
            putchar('=' as u8);
            if vl > 0 { sys_write(1, val, vl); }
            putchar(10u8);
            delete(key as U8Array);
            p = q + 1;
        }
        delete(names);
        delete(val);
        return 1;
    }

    var ks: i32 = skip_sp(cmd, e0, n);
    var ke: i32 = tok_end(cmd, ks, n);
    if ke == ks {
        puts("sh: usage: setenv KEY [VALUE] | unsetenv KEY | getenv KEY | env\n");
        return 1;
    }
    var key2: String = string_from_bytes(cmd, ks, ke - ks);
    if kind == 1 {
        var vs: i32 = skip_sp(cmd, ke, n);
        var ve: i32 = n;
        while ve > vs && get(cmd, ve - 1) == ' ' as u8 { ve = ve - 1; }
        var v: U8Array = U8Array((ve - vs + 1) as u32);
        var k: i32 = 0;
        while k < ve - vs { set(v, k, get(cmd, vs + k)); k = k + 1; }
        if env_set(key2, v, ve - vs) != 0 { puts("sh: setenv failed\n"); }
        delete(v);
    } else if kind == 2 {
        if env_unset(key2) != 0 { puts("sh: unsetenv: not set\n"); }
    } else {
        var gv: U8Array = U8Array(128u32);
        var gl: i32 = env_get(key2, gv, 128);
        if gl < 0 { puts("sh: getenv: not set\n"); }
        else { if gl > 0 { sys_write(1, gv, gl); } putchar(10u8); }
        delete(gv);
    }
    delete(key2 as U8Array);
    return 1;
}

// Dispatch one command line stored in cmd[0..n]. `path` is a scratch
// buffer the caller owns. Returns 0 if the shell should quit (the
// "quit" built-in), 1 otherwise. Extracted from main() so the same
// dispatch handles both interactive lines and lines coming from
// /etc/login at startup.
fn exec_command(cmd: U8Array, n: i32, path: U8Array) -> i32 {
    if eq(cmd, n, "quit") {
        return 0;
    }
    if builtin_env(cmd, n) != 0 { return 1; }
    var pipe_pos: I32Array = I32Array(4);
    var num_pipes: i32 = count_pipes(cmd, n, pipe_pos);

    if num_pipes == 0 {
        // No pipes: single command (existing path)
        delete(pipe_pos);
        var argv: StringArray = parse_redir(cmd, n);
        if !build_path(path, argv) {
            puts("sh: empty command\n");
            free_argv(argv);
            if g_in_path  as u32 != 0u32 { delete(g_in_path); g_in_path  = 0 as String; }
            if g_out_path as u32 != 0u32 { delete(g_out_path); g_out_path = 0 as String; }
        } else {
            var slot: i32 = do_spawn(path as String, argv as u32,
                                     g_in_path, g_out_path);
            free_argv(argv);
            if g_in_path  as u32 != 0u32 { delete(g_in_path); g_in_path  = 0 as String; }
            if g_out_path as u32 != 0u32 { delete(g_out_path); g_out_path = 0 as String; }
            if slot < 0 {
                puts("sh: spawn failed\n");
            } else {
                do_wait(slot);
                send_unfreeze_console();
            }
        }
    } else if num_pipes > 4 {
        puts("sh: too many pipes\n");
        delete(pipe_pos);
    } else {
        // Pipeline via kernel pipe syscall. All segments are spawned
        // first (concurrent execution), then waited on in order.
        var seg_buf: U8Array = U8Array(CMD_MAX as u32);
        var slots: I32Array = I32Array(5);
        var pipe_rfds: I32Array = I32Array(4);
        var pipe_wfds: I32Array = I32Array(4);
        var pipe_buf: U8Array = U8Array(8);
        var ok: i32 = 1;

        // Create all pipes up front
        var pi: i32 = 0;
        while pi < num_pipes && ok == 1 {
            if do_pipe(pipe_buf as u32 + 4u32) != 0 {
                puts("sh: pipe failed\n");
                ok = 0;
            } else {
                set(pipe_rfds, pi, peek32(pipe_buf as u32 + 4u32) as i32);
                set(pipe_wfds, pi, peek32(pipe_buf as u32 + 8u32) as i32);
            }
            pi = pi + 1;
        }

        // Spawn all segments concurrently
        var seg_idx: i32 = 0;
        var seg_start: i32 = 0;
        var num_spawned: i32 = 0;
        while seg_idx <= num_pipes && ok == 1 {
            var seg_end: i32 = n;
            if seg_idx < num_pipes {
                seg_end = get(pipe_pos, seg_idx);
            }
            var slen: i32 = 0;
            var j: i32 = seg_start;
            while j < seg_end {
                set(seg_buf, slen, get(cmd, j));
                slen = slen + 1;
                j = j + 1;
            }

            var argv: StringArray = parse_redir(seg_buf, slen);

            if !build_path(path, argv) {
                puts("sh: empty command in pipe\n");
                free_argv(argv);
                if g_in_path  as u32 != 0u32 { delete(g_in_path); g_in_path  = 0 as String; }
                if g_out_path as u32 != 0u32 { delete(g_out_path); g_out_path = 0 as String; }
                ok = 0;
            } else {
                // Determine fd redirects for this segment
                var in_fd:  i32 = 0;
                var out_fd: i32 = 0;
                if seg_idx > 0 {
                    in_fd = get(pipe_rfds, seg_idx - 1);
                }
                if seg_idx < num_pipes {
                    out_fd = get(pipe_wfds, seg_idx);
                }
                // Explicit < on first segment. A failed open aborts the
                // whole pipeline — keeping the pipe-fd input would
                // silently hide the missing redirect source.
                var redir_ok: i32 = 1;
                if g_in_path as u32 != 0u32 {
                    var ffd: i32 = open_redir_path(g_in_path, 0);
                    if ffd < 0 {
                        eputs("sh: ");
                        sys_write(2, g_in_path);
                        eputs(": open failed\n");
                        redir_ok = 0;
                    } else {
                        in_fd = ffd;
                    }
                    delete(g_in_path); g_in_path = 0 as String;
                }
                // Explicit > on last segment
                if redir_ok == 1 && g_out_path as u32 != 0u32 {
                    var ffd: i32 = open_redir_path(g_out_path, 577);
                    if ffd < 0 {
                        eputs("sh: ");
                        sys_write(2, g_out_path);
                        eputs(": open failed\n");
                        redir_ok = 0;
                    } else {
                        out_fd = ffd;
                    }
                    delete(g_out_path); g_out_path = 0 as String;
                }

                if redir_ok == 0 {
                    free_argv(argv);
                    ok = 0;
                } else {
                    var slot: i32 = do_spawn_fds(path as String,
                                                  argv as u32,
                                                  in_fd, out_fd);
                    free_argv(argv);
                    if slot < 0 {
                        puts("sh: pipe spawn failed\n");
                        ok = 0;
                    } else {
                        set(slots, seg_idx, slot);
                        num_spawned = num_spawned + 1;
                    }
                }
            }

            if seg_idx < num_pipes {
                seg_start = get(pipe_pos, seg_idx) + 1;
            }
            seg_idx = seg_idx + 1;
        }

        // Do NOT close the pipe fds here. do_spawn_fds passes fd
        // *numbers* (no dup) and transfers each fd's ownership to the
        // child it was handed to (vfs_set_owner). Closing them in the
        // shell would tear the pipe entry out from under the child
        // before it even runs. slot_free_allocs closes them at each
        // child's exit instead — and the writer child's close of its
        // write end is exactly what gives the reader child its EOF.

        // Wait for all spawned segments
        var wi: i32 = 0;
        while wi < num_spawned {
            do_wait(get(slots, wi));
            wi = wi + 1;
        }
        send_unfreeze_console();

        delete(pipe_buf);
        delete(pipe_wfds);
        delete(pipe_rfds);
        delete(slots);
        delete(seg_buf);
        delete(pipe_pos);
    }
    return 1;
}

// Run /etc/login if it exists. Each line is dispatched through
// exec_command exactly as if typed interactively, and is echoed as
// `sh$ <line>` first so the user sees what ran. A clean EOF ends
// the script and we fall through to the interactive loop. A "quit"
// in the script returns 0 to abort sh entirely (matches the
// interactive built-in's meaning).
fn run_login_script(cmd: U8Array, path: U8Array) -> i32 {
    var fd: i32 = do_openat(0, "/etc/login", 0);
    if fd < 0 { return 1; }
    eputs("SH: running /etc/login\n");
    var keep: i32 = 1;
    while keep == 1 {
        var ln: i32 = read_script_line(fd, cmd);
        if ln < 0 { keep = 0; }
        else if ln == 0 {
            // blank line — skip silently
        } else if get(cmd, 0) == ('#' as u8) {
            // comment — skip silently
        } else {
            puts("sh$ ");
            sys_write(1, cmd, ln);
            puts("\n");
            var t0: i32 = do_uptime_us();
            if exec_command(cmd, ln, path) == 0 {
                keep = 0;
                do_close(fd);
                return 0;
            }
            // Boot profiling: /etc/login is the bulk of the time between
            // "SH: ready" and the first prompt, so stamp each line's cost on
            // stderr (UART) where it is visible even when fd 1 goes to the LCD.
            eputs("[");
            emit_ms_dec(do_uptime_us() - t0);
            eputs("ms] SH: login line done\n");
        }
    }
    do_close(fd);
    return 1;
}

fn main() -> i32 {
    puts("SH: ready\n");
    hist_init();

    var cmd:  U8Array = U8Array(CMD_MAX  as u32);
    var path: U8Array = U8Array(PATH_MAX as u32);

    // /etc/login runs before the interactive prompt — used to seed
    // demo state (touch files, launch background tasks, etc) and to
    // hand the launcher / outline-processor a place to register
    // themselves without editing kern.conf.
    if run_login_script(cmd, path) == 0 {
        // Script ended with "quit" — skip the interactive loop.
        puts("SH: bye\n");
        delete(cmd);
        delete(path);
        return 0;
    }

    // One-shot trace: stamp the moment the first prompt is about to
    // hit fd 1 (= pipe → /bin/console → LCD). Capturing on UART
    // gives a clean "power-on → prompt visible" number when paired
    // with the orchestrator's host wall-clock cat reader.
    var first_prompt: i32 = 1;
    var running: i32 = 1;
    while running == 1 {
        if first_prompt == 1 {
            eputs("[");
            emit_ms_dec(do_uptime_us());
            eputs("ms] SH: first prompt\n");
            first_prompt = 0;
        }
        puts("sh$ ");
        var n: i32 = read_line(cmd);
        if n == 0 {
            // empty line, prompt again
        } else {
            hist_push(cmd, n);
            if exec_command(cmd, n, path) == 0 {
                running = 0;
            }
        }
    }

    puts("SH: bye\n");
    delete(cmd);
    delete(path);
    return 0;
}
