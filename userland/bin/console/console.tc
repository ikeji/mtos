// console.tc — /bin/console: userspace terminal emulator + getty.
//
// Hosts an interactive shell on the local display + keyboard instead
// of the UART:
//
//   /dev/kbd ──> sh stdin       sh stdout ──> pipe ──> console
//                                                        │
//                                            terminal render
//                                                        │
//                                                     /dev/fb
//
// console opens /dev/kbd and /dev/fb, creates one pipe, and spawns
// /bin/sh with stdin = /dev/kbd and stdout = the pipe write end. It
// reads the pipe and renders sh's output to /dev/fb. sh reads its own
// stdin directly, so console only ever waits on the pipe — no
// select/poll needed.
//
// Font: the build links the PC-98 font (jpfont_inc.s — a .incbin of
// jpfont.dat, built from font.bmp by genjpfont.py) into this binary.
// console renders 8x16 hankaku + 16x16 zenkaku glyphs, UTF-8 decoded,
// so Japanese displays. The blob is read in place via peek8 (no RAM
// copy; works from XIP flash too). font.bmp is mandatory — the build
// fails without it. Each glyph reaches /dev/fb as a single mode-0
// pixel blit.
//
// Orientation (argv): default is portrait (320x480), which scrolls
// with the ILI9488 hardware vertical scroll. `console -l` selects
// landscape (480x320) — rotated 90°, the hardware scroll axis is now
// horizontal and useless for text, so console scrolls in software:
// it keeps a codepoint grid and re-blits the screen on each scroll.
//
// Argv: `console [-l] [<path> [args...]]`. The first non-`-l` positional
// becomes the program to spawn (default `/bin/sh`), and any trailing
// argv slots are passed as that program's argv. `console -l /bin/msh`
// boots msh under the LCD instead of sh; `console /bin/sh -c ls` runs
// a one-shot command. kern.conf init lines pass no argv, in which
// case console falls back to portrait + `/bin/sh`.

import "../../lib/libtc/libtc.tc";

// Single-shot raw read (vs libtc's sys_read, which loops do_read until
// the full requested count is fulfilled — that would block console
// forever when sh writes 14 bytes and we ask for 64).
fn do_read(fd: i32, buf: u32, len: i32) -> i32;
// Non-blocking variant — returns -2 instead of blocking when the pipe
// has no data yet. Lets us poll + sleep instead of running a sibling
// blinker task just to drive the cursor heartbeat.
fn do_read_nb(fd: i32, buf: u32, len: i32) -> i32;
fn do_nanosleep(ms: i32) -> i32;

const FG: i32 = 65535;        // RGB565 white

// Win95-ish desktop palette (RGB565 from the canonical 8-bit values):
//   teal  #008080 → 0x0410 (desktop background)
//   grey  #C0C0C0 → 0xC618 (window chrome / taskbar)
//   navy  #000080 → 0x0010 (active title bar)
//   white #FFFFFF → 0xFFFF (3D highlight, title text)
//   black #000000 → 0x0000 (3D shadow, content area, DOS-style)
const COLOR_DESKTOP:  i32 = 0x0410;
const COLOR_FRAME:    i32 = 0xC618;
const COLOR_TITLE_BG: i32 = 0x0010;
const COLOR_TITLE_FG: i32 = 65535;
const COLOR_HILIGHT:  i32 = 65535;
const COLOR_SHADOW:   i32 = 0x0000;
const COLOR_CONTENT:  i32 = 0x0000;

// Cell geometry — 8x16 hankaku. Screen size, COLS/ROWS and the
// orientation are decided in main() from argv.
const CW:   i32 = 8;
const CH:   i32 = 16;
var SCREEN_W: i32 = 320;
var SCREEN_H: i32 = 480;
var COLS: i32 = 40;
var ROWS: i32 = 30;

// Pixel origin for cell (0, 0). 0 in fullscreen modes; nonzero when
// a Win95-style window decorates the screen and the console content
// is inset into the window's client area.
var g_content_x: i32 = 0;
var g_content_y: i32 = 0;
var g_have_chrome: i32 = 0;
// Top-left of the clock area inside the taskbar. Populated by
// draw_chrome and read by draw_clock to refresh the HH:MM display
// without redrawing the rest of the taskbar.
var g_clock_x: i32 = 0;
var g_clock_y: i32 = 0;

var g_col: i32 = 0;
var g_row: i32 = 0;
// Previous cursor cell so erase_cursor can blank the right spot
// regardless of newline / scroll movement that happened in between.
var g_cur_col: i32 = 0;
var g_cur_row: i32 = 0;

// Scrolling. Two modes, picked by orientation in main():
//
//  - Hardware (portrait): the ILI9488 vertical scroll only works on
//    the physical 480-line axis, which is vertical in portrait. The
//    framebuffer is a ring of FB_H lines; cell-row r lives at physical
//    y (g_scroll + r*CH) mod FB_H (phys_y). A scroll just clears the
//    oldest line and bumps VSCRSADD (mode 2) — O(1), no re-blit.
//
//  - Software (landscape): rotated 90°, the 480 axis is horizontal so
//    hardware vscroll cannot move text. console keeps a codepoint grid
//    (g_grid, COLS*ROWS cells) and on overflow shifts it up and
//    re-blits the whole screen. g_scroll stays 0 in this mode.
var FB_H:      i32 = 480;
var g_scroll:  i32 = 0;
var g_sw_scroll: i32 = 0;          // 1 = software scroll (landscape)

// VRAM mode (tn20k `console -v`): render pixels straight into the SDRAM
// framebuffer that the hw vram_lcd refresh engine streams to the panel,
// instead of poking the LCD over /dev/fb. No syscalls, no CPU-driven SPI —
// the engine paints the screen in the background. pico2 has no such engine,
// so it never passes -v and keeps the /dev/fb path. Physical addresses are
// fine: MTOS has no MMU. Layout: VRAM[y*480+x] RGB565, matching the engine.
var g_vram_mode: i32 = 0;
const VRAM_BASE_LO: u32 = 0x807A5000u32;   // VRAM byte address (reserved by crt0)
const VRAM_W:       i32 = 480;
const VRAM_CTRL:    u32 = 0x10050000u32;   // engine enable (bit0)
const VRAM_DIVREG:  u32 = 0x10050008u32;   // engine SCK divider
fn poke16(addr: u32, v: u16) -> void;      // runtime primitive
fn poke32(addr: u32, v: u32) -> void;      // runtime primitive

// TEXT mode (tn20k `console -t`): the hw text_lcd character-generator engine
// (hw/rtl/soc/text_lcd.v) rasters a 60x20 cell grid to the panel, expanding
// an on-chip hankaku font itself. The console just writes cells (char + fg/bg)
// over MMIO — no glyph expansion, no pixels, no SDRAM. Scroll is a cell-array
// shift. Hankaku only (font ROM has no zenkaku); non-ASCII shows '?'.
var g_text_mode: i32 = 0;
const TEXT_BASE:  u32 = 0x10060000u32;     // cell i at TEXT_BASE + i*4 (32-bit)
const TEXT_CTRL:  u32 = 0x10062000u32;     // word index 2048: enable (bit0)
const TEXT_DIV:   u32 = 0x10062004u32;     // word index 2049: SCK divider
const TEXT_ZBASE: u32 = 0x10062008u32;     // word index 2050: zenkaku font SDRAM word base
const TCOLS: i32 = 60;
const TROWS: i32 = 20;
// A box-drawing window frame occupies the border cells; sh output renders in
// the inner content region. The frame uses full-width (2-cell) JIS keisen
// glyphs, so the content starts at col 2 (past the left │) and row 1.
const TCONT_X0:   i32 = 2;
const TCONT_Y0:   i32 = 1;
const TCONT_COLS: i32 = 56;                // 60 - 2*(│ width in cells)
const TCONT_ROWS: i32 = 18;                // 20 - top - bottom
const ZEN_SZ: i32 = 282752;                // 94*94*32 = zenkaku font bytes (OFF_U2K-OFF_ZEN)
var g_cells: I32Array = 0 as I32Array;     // shadow of the cell grid (for scroll)
var g_trow:  i32 = 0;                       // content-relative cursor row (0..TCONT_ROWS-1)
var g_tcol:  i32 = 0;                       // content-relative cursor col (0..TCONT_COLS-1)
var g_zen_ok: i32 = 0;                     // 1 = zenkaku font loaded into SDRAM
fn peek8(addr: u32) -> u8;                 // runtime primitive
fn poke8(addr: u32, v: u8) -> void;        // runtime primitive
fn vram_fill(x: i32, y: i32, w: i32, h: i32, col: i32) -> void;   // defined below
var g_grid:      I32Array = 0 as I32Array;   // codepoint grid, sw mode only
// g_grid_prev shadows what we last painted to /dev/fb. redraw() only
// re-blits a cell where g_grid != g_grid_prev — typical sh output has
// long stretches of trailing empties, so the shifted-up grid still
// matches prev on most cells and we can skip the bulk of the blits.
// Sentinel -2 in g_grid_prev means "pixel state damaged, force redraw"
// (used after erase_cursor scribbled black across a glyph's bottom).
var g_grid_prev: I32Array = 0 as I32Array;

// Glyph batch (mode 5). Content-area text is all white-on-black, so a run
// of consecutive same-row cells is coalesced into ONE sys_write instead of
// one per glyph. Cuts a screenful (e.g. neofetch ~458 glyphs) from ~458
// fb writes to ~1 per row, dropping the per-glyph syscall overhead.
// Layout in g_batch: [x0][y][_][h=16][mode=5][fg][bg][count] then per glyph
// [gw:u8][bitmap: (gw/8)*16 bytes]. Flushed on a non-contiguous cell, before
// any direct fb paint (cursor/clock/fill/scroll), and at each render batch's end.
var g_batch:  U8Array = 0 as U8Array;
const BATCH_CAP: i32 = 2048;   // max glyph-data bytes before a forced flush
var g_bn:  i32 = 0;   // glyphs queued
var g_bp:  i32 = 0;   // bytes written into the glyph-data area
var g_bx0: i32 = 0;   // px of the first queued glyph (frame x)
var g_by:  i32 = 0;   // py of the queued row
var g_bxn: i32 = 0;   // px the next contiguous glyph must start at
fn flush_batch(fb: i32) -> void;   // defined below; called by fb_fill/scroll

// jpfont.dat is embedded in this binary via .incbin (jpfont_inc.s,
// generated by the build from font.bmp). jpfont_addr / jpfont_size_value
// are defined there. The blob is accessed in place via peek8 — no RAM
// copy, so it also works from XIP flash on pico2. Layout: "JPF1" + u32
// u2k_count + hankaku[256][16] + zenkaku[94*94][32] +
// u2k[u2k_count]{u16 unicode, u16 kuten}.
fn jpfont_addr() -> u32;
fn jpfont_size_value() -> u32;
var g_font_addr: u32 = 0u32;
var g_u2k:  i32 = 0;
const OFF_HAN: i32 = 8;
const OFF_ZEN: i32 = 4104;       // 8 + 256*16
const OFF_U2K: i32 = 286856;     // 4104 + 94*94*32

// UTF-8 decode state.
var g_un:  i32 = 0;            // continuation bytes still expected
var g_ucp: i32 = 0;            // codepoint being assembled

// ANSI CSI parser state.
//   0 = ground (regular bytes flow to the UTF-8 decoder),
//   1 = saw ESC, waiting for '[' (anything else aborts and is dropped),
//   2 = inside ESC[<params><final>,
//   3 = inside ESC[?<params><final> (DEC-private).
// Numeric params accumulate in g_csi_cur until ';' or the final byte
// pushes them into g_csi_p. CSI_PMAX caps the parameter list; extra
// params past it are discarded silently — the subset we care about
// (CUP up to 2 params, SGR-style not implemented) never overflows.
var g_esc_state:   i32 = 0;
var g_csi_cur:     i32 = 0;
var g_csi_has:     i32 = 0;
var g_csi_n:       i32 = 0;
var CSI_PMAX:      i32 = 4;
var g_csi_p:       I32Array = 0 as I32Array;
// DECTCEM: 0 hides the cursor entirely (draw_cursor becomes a no-op so
// the blink poll loop stops repainting it). Apps like /bin/sl flip
// this off while animating to keep the cursor bar from streaking
// through the frame.
var g_cur_enabled: i32 = 1;

// xterm-style alternate-screen freeze (ESC[?47h / ESC[?47l). When
// frozen, the console keeps draining the sh pipe so any output is
// recorded into g_grid but every /dev/fb write is suppressed, leaving
// the framebuffer free for a foreground task to own (e.g. touchtest's
// paint loop). On unfreeze (?47l) we invalidate g_grid_prev and
// repaint the whole chrome + content area so the previous look is
// restored.
//
// On top of suppressing writes, the main loop also CLOSES /dev/fb on
// ?47h and reopens it on ?47l. Kernel devfs enforces single-open on
// /dev/fb, so this hands exclusive ownership to the foreground task
// for the duration of the freeze and the kernel rejects any racing
// open. sh sends ?47l automatically after each spawn it waits on
// (sh.tc), so a crashing foreground task can't strand the LCD frozen.
var g_render_frozen: i32 = 0;
var g_fb_close_req: i32 = 0;     // ESC[?47h dispatched, main loop to close
var g_fb_open_req:  i32 = 0;     // ESC[?47l dispatched, main loop to open

// Read byte `off` of the embedded jpfont blob.
fn fbyte(off: i32) -> i32 {
    return peek8(g_font_addr + (off as u32)) as i32;
}

// Store a little-endian u16 at byte offset `pos`.
fn poke8(addr: u32, v: u8) -> void;   // runtime primitive (no bounds check)

fn put_u16(b: U8Array, pos: i32, v: i32) -> void {
    var d: u32 = (b as u32) + 4u32 + (pos as u32);   // U8Array data = header(4) + bytes
    poke8(d,        (v & 0xFF) as u8);
    poke8(d + 1u32, ((v >> 8) & 0xFF) as u8);
    return;
}

// Emit a mode-2 blit: set the hardware vertical-scroll start line
// (ILI9488 VSCRSADD) to `line`.
fn fb_scroll(fb: i32, frame: U8Array, line: i32) -> void {
    if g_vram_mode != 0 { return; }   // no /dev/fb writes once the engine owns the LCD
    flush_batch(fb);   // paint queued glyphs before the scroll moves them
    if g_render_frozen != 0 { return; }
    put_u16(frame, 0,  0);
    put_u16(frame, 2,  0);
    put_u16(frame, 4,  0);
    put_u16(frame, 6,  0);
    put_u16(frame, 8,  2);
    put_u16(frame, 10, line);
    sys_write(fb, frame, 12);
    return;
}

// Emit a mode-1 rectangle fill of colour `col` (RGB565). Suppressed
// while the alternate-screen toggle (ESC[?47h) is active so a
// foreground task can own /dev/fb without us painting over it.
fn fb_fill(fb: i32, frame: U8Array, x: i32, y: i32,
           w: i32, h: i32, col: i32) -> void {
    if g_render_frozen != 0 { return; }
    if g_vram_mode != 0 { vram_fill(x, y, w, h, col); return; }
    flush_batch(fb);   // paint queued glyphs before filling over them
    put_u16(frame, 0,  x);
    put_u16(frame, 2,  y);
    put_u16(frame, 4,  w);
    put_u16(frame, 6,  h);
    put_u16(frame, 8,  1);
    put_u16(frame, 10, col);
    sys_write(fb, frame, 12);
    return;
}

// ===== VRAM direct rendering (tn20k `console -v`) =====
// Write pixels straight into the SDRAM framebuffer at VRAM_BASE_LO; the
// hardware refresh engine streams it to the panel. No syscalls, no SPI.

// Fill rect (x,y,w,h) with RGB565 col.
fn fill32(addr: u32, val: u32, count: i32) -> void;   // runtime asm primitive

fn vram_fill(x: i32, y: i32, w: i32, h: i32, col: i32) -> void {
    var c16: u16 = (col & 0xFFFF) as u16;
    // Pack two identical RGB565 pixels into one 32-bit word so fill32
    // paints two pixels per store. VRAM is row-major and strips are
    // contiguous, so a full-width rect (x==0, w==VRAM_W) is one flat
    // fill; otherwise fill row by row. A tight asm sw-loop is ~10x the
    // poke16 TC loop on the multi-cycle core.
    var packed: u32 = (((c16 as u32) << 16u32) | (c16 as u32));
    if x == 0 && w == VRAM_W {
        var base: u32 = VRAM_BASE_LO + (((y * VRAM_W) * 2) as u32);
        fill32(base, packed, (w * h) / 2);
        return;
    }
    var yy: i32 = 0;
    while yy < h {
        var a: u32 = VRAM_BASE_LO + ((((y + yy) * VRAM_W + x) * 2) as u32);
        if (a & 3u32) == 0u32 && (w & 1) == 0 {
            fill32(a, packed, w / 2);
        } else {
            var xx: i32 = 0;
            while xx < w {
                poke16(a, c16);
                a = a + 2u32;
                xx = xx + 1;
            }
        }
        yy = yy + 1;
    }
    return;
}

// Expand a 1-bpp font glyph (bpr bytes/row, 16 rows, MSB = leftmost) into
// VRAM at pixel (px,py), fg on bg.
fn blit_glyph_row(addr: u32, bits: i32, gw: i32, fg: u16, bg: u16) -> void;

fn vram_blit_glyph(px: i32, py: i32, gw: i32, goff: i32, bpr: i32,
                   fg: i32, bg: i32) -> void {
    var fg16: u16 = (fg & 0xFFFF) as u16;
    var bg16: u16 = (bg & 0xFFFF) as u16;
    var ry: i32 = 0;
    while ry < 16 {
        var bits: i32 = 0;
        var k: i32 = 0;
        while k < bpr { bits = (bits << 8) | fbyte(goff + ry * bpr + k); k = k + 1; }
        var a: u32 = VRAM_BASE_LO + ((((py + ry) * VRAM_W + px) * 2) as u32);
        // one tight asm call expands the whole row (fg/bg per bit) — far
        // cheaper than gw poke16 TC calls on the multi-cycle core.
        blit_glyph_row(a, bits, gw, fg16, bg16);
        ry = ry + 1;
    }
    return;
}

// ===== TEXT mode: hw text_lcd character generator (tn20k `console -t`) =====
// A cell = char[7:0] | fg[11:8] | bg[15:12]. The engine expands the glyph.
// Content coords (row/col) are relative to the framed window's inner area.

fn u2k_lookup(cp: i32) -> i32;   // defined below; maps codepoint -> JIS kuten

// Write one cell at an absolute panel position (used for the window frame).
fn text_cell_abs(row: i32, col: i32, v: i32) -> void {
    var idx: i32 = row * TCOLS + col;
    set(g_cells, idx, v);
    poke32(TEXT_BASE + ((idx * 4) as u32), v as u32);
    return;
}

// Hankaku cell at a content-relative position (offset past the frame).
fn text_putcell(row: i32, col: i32, ch: i32, fg: i32, bg: i32) -> void {
    text_cell_abs(TCONT_Y0 + row, TCONT_X0 + col,
                  (ch & 0xFF) | ((fg & 0xF) << 8) | ((bg & 0xF) << 12));
    return;
}

// Zenkaku half-cell at a content-relative position. The engine fetches the
// 16x16 glyph row from the SDRAM font using `gi` and renders the left/right
// 8 px per `zright`.
fn text_putcell_zen(row: i32, col: i32, gi: i32, zright: i32,
                    fg: i32, bg: i32) -> void {
    text_cell_abs(TCONT_Y0 + row, TCONT_X0 + col,
                  ((fg & 0xF) << 8) | ((bg & 0xF) << 12)
                  | (1 << 16) | ((zright & 1) << 17) | ((gi & 0x3FFF) << 18));
    return;
}

// Shift only the inner content region up one row, blank the new bottom row.
// The frame cells are outside the region, so they stay put. g_cells is our
// shadow of the engine's write-only cell RAM. ~1000 MMIO stores, effectively
// free vs the ~10 s a pixel-framebuffer scroll costs.
fn text_scroll() -> void {
    var r: i32 = 0;
    while r < TCONT_ROWS - 1 {
        var c: i32 = 0;
        while c < TCONT_COLS {
            var src: i32 = (TCONT_Y0 + r + 1) * TCOLS + (TCONT_X0 + c);
            var dst: i32 = (TCONT_Y0 + r)     * TCOLS + (TCONT_X0 + c);
            var v: i32 = get(g_cells, src);
            set(g_cells, dst, v);
            poke32(TEXT_BASE + ((dst * 4) as u32), v as u32);
            c = c + 1;
        }
        r = r + 1;
    }
    var bc: i32 = 0;
    while bc < TCONT_COLS {
        var bidx: i32 = (TCONT_Y0 + TCONT_ROWS - 1) * TCOLS + (TCONT_X0 + bc);
        set(g_cells, bidx, 0);
        poke32(TEXT_BASE + ((bidx * 4) as u32), 0u32);
        bc = bc + 1;
    }
    return;
}

fn text_newline() -> void {
    g_tcol = 0;
    g_trow = g_trow + 1;
    if g_trow >= TCONT_ROWS {
        g_trow = TCONT_ROWS - 1;
        text_scroll();
    }
    return;
}

fn text_draw_cp(cp: i32) -> void {
    if cp == 10 { text_newline(); return; }
    if cp == 13 { g_tcol = 0; return; }
    if cp == 8  { if g_tcol > 0 { g_tcol = g_tcol - 1; } return; }
    if cp < 32 { return; }
    if cp >= 256 {
        // zenkaku: look up the JIS kuten, convert to a 0-based glyph index,
        // and paint two half-cells (16 px wide). Falls back to '?' if the
        // font isn't loaded or the codepoint isn't in the table.
        var kt: i32 = 0;
        if g_zen_ok != 0 { kt = u2k_lookup(cp); }
        if kt != 0 {
            var gi: i32 = ((kt >> 8) - 1) * 94 + ((kt & 0xFF) - 1);
            if g_tcol + 1 >= TCONT_COLS { text_newline(); }
            text_putcell_zen(g_trow, g_tcol,     gi, 0, 15, 0);
            text_putcell_zen(g_trow, g_tcol + 1, gi, 1, 15, 0);
            g_tcol = g_tcol + 2;
            if g_tcol >= TCONT_COLS { text_newline(); }
            return;
        }
        text_putcell(g_trow, g_tcol, 63, 15, 0);   // '?'
        g_tcol = g_tcol + 1;
        if g_tcol >= TCONT_COLS { text_newline(); }
        return;
    }
    text_putcell(g_trow, g_tcol, cp, 15, 0);   // white on black
    g_tcol = g_tcol + 1;
    if g_tcol >= TCONT_COLS { text_newline(); }
    return;
}

// PC-98 box-drawing (keisen) glyph indices, ku=12 in this font. The corners
// are the authentic rounded PC-98 shapes. Each is a full-width (2-cell) glyph.
const K_H:  i32 = 1037;   // ─
const K_V:  i32 = 1039;   // │
const K_TL: i32 = 1049;   // ┌ (rounded)
const K_TR: i32 = 1053;   // ┐ (rounded)
const K_BL: i32 = 1057;   // └ (rounded)
const K_BR: i32 = 1061;   // ┘ (rounded)

// Place a full-width keisen glyph (by gi) at an absolute panel position.
fn text_keisen(row: i32, col: i32, gi: i32) -> void {
    text_cell_abs(row, col,     (15 << 8) | (1 << 16) | (0 << 17) | ((gi & 0x3FFF) << 18));
    text_cell_abs(row, col + 1, (15 << 8) | (1 << 16) | (1 << 17) | ((gi & 0x3FFF) << 18));
    return;
}

// A single reverse-video (black on white) menu-bar cell.
fn text_menu_ch(col: i32, ch: i32) -> void {
    text_cell_abs(TROWS - 1, col, (ch & 0xFF) | (0 << 8) | (15 << 12));
    return;
}

// Uptime seconds from the CLINT mtime (tn20k has no wall-clock RTC). 64-bit
// mtime / ticks-per-second via bit-by-bit long division.
const MTIME_LO_A: u32 = 0x0200BFF8u32;
const MTIME_HI_A: u32 = 0x0200BFFCu32;
const TICKS_SEC:  u32 = 40500000u32;
fn peek32(addr: u32) -> u32;   // runtime primitive
fn uptime_sec() -> u32 {
    var lo: u32 = peek32(MTIME_LO_A);
    var hi: u32 = peek32(MTIME_HI_A);
    var q: u32 = 0u32;
    var rem: u32 = 0u32;
    var i: i32 = 63;
    while i >= 0 {
        var bit: u32 = 0u32;
        if i >= 32 { bit = (hi >> ((i - 32) as u32)) & 1u32; }
        else { bit = (lo >> (i as u32)) & 1u32; }
        rem = (rem << 1u32) | bit;
        q = q << 1u32;
        if rem >= TICKS_SEC { rem = rem - TICKS_SEC; q = q | 1u32; }
        i = i - 1;
    }
    return q;
}

// Redraw the HH:MM:SS clock at the right of the menu bar (reverse video).
var g_last_up: u32 = 0xFFFFFFFFu32;
fn text_draw_clock_t() -> void {
    var s: u32 = uptime_sec();
    if s == g_last_up { return; }
    g_last_up = s;
    var hh: i32 = ((s / 3600u32) % 24u32) as i32;
    var mm: i32 = ((s / 60u32) % 60u32) as i32;
    var ss: i32 = (s % 60u32) as i32;
    var col: i32 = TCOLS - 9;   // "HH:MM:SS " -> 9 cells from the right
    text_menu_ch(col,     ('0' as i32) + hh / 10);
    text_menu_ch(col + 1, ('0' as i32) + hh % 10);
    text_menu_ch(col + 2, ':' as i32);
    text_menu_ch(col + 3, ('0' as i32) + mm / 10);
    text_menu_ch(col + 4, ('0' as i32) + mm % 10);
    text_menu_ch(col + 5, ':' as i32);
    text_menu_ch(col + 6, ('0' as i32) + ss / 10);
    text_menu_ch(col + 7, ('0' as i32) + ss % 10);
    return;
}

// Bottom-row menu bar: full-width reverse video, menu labels on the left, the
// clock on the right (drawn by text_draw_clock_t).
fn text_draw_menubar() -> void {
    var c: i32 = 0;
    while c < TCOLS { text_menu_ch(c, ' ' as i32); c = c + 1; }
    var menu: StringLiteral = " File  Edit  View  Help ";
    var t: i32 = 0;
    while t < len(menu) {
        text_menu_ch(1 + t, get(menu, t) as i32);
        t = t + 1;
    }
    g_last_up = 0xFFFFFFFFu32;   // force the clock to paint on the next tick
    text_draw_clock_t();
    return;
}

// Draw the PC-98-style window: rounded-corner keisen frame (top + sides), a
// title on the top border, and a menu bar with a clock on the bottom row.
fn text_draw_frame() -> void {
    if g_zen_ok == 0 { return; }   // keisen glyphs live in the zenkaku font
    // top border: ┌ ─×N ┐
    text_keisen(0, 0, K_TL);
    var c: i32 = 2;
    while c <= TCOLS - 4 { text_keisen(0, c, K_H); c = c + 2; }
    text_keisen(0, TCOLS - 2, K_TR);
    // sides: │ down both edges of the content rows
    var r: i32 = 1;
    while r <= TROWS - 2 {
        text_keisen(r, 0, K_V);
        text_keisen(r, TCOLS - 2, K_V);
        r = r + 1;
    }
    // title over the top border (hankaku, white on black)
    var title: StringLiteral = " MTOS Console ";
    var t: i32 = 0;
    while t < len(title) {
        text_cell_abs(0, 4 + t, (get(title, t) as i32 & 0xFF) | (15 << 8) | (0 << 12));
        t = t + 1;
    }
    // bottom row: menu bar + clock (replaces the bottom border)
    text_draw_menubar();
    return;
}

// Copy the zenkaku font (jpfont OFF_ZEN..OFF_U2K) into a word-aligned SDRAM
// buffer the engine can read, and point ZBASE at it. Byte-read + word-write so
// the .incbin source needn't be word-aligned; dst is aligned. ~0.35 s once.
fn load_zen_font() -> void {
    var buf: U8Array = U8Array((ZEN_SZ + 8) as u32);
    if (buf as u32) == 0u32 { return; }
    var dst: u32 = (((buf as u32) + 4u32) + 3u32) & 0xFFFFFFFCu32;   // round up to word
    var src: u32 = g_font_addr + (OFF_ZEN as u32);
    var i: i32 = 0;
    while i < ZEN_SZ {
        var b0: u32 = peek8(src + (i as u32)) as u32;
        var b1: u32 = peek8(src + (i as u32) + 1u32) as u32;
        var b2: u32 = peek8(src + (i as u32) + 2u32) as u32;
        var b3: u32 = peek8(src + (i as u32) + 3u32) as u32;
        poke32(dst + (i as u32), b0 | (b1 << 8u32) | (b2 << 16u32) | (b3 << 24u32));
        i = i + 4;
    }
    poke32(TEXT_ZBASE, (dst - 0x80000000u32) >> 2u32);
    g_zen_ok = 1;
    return;
}

// Clear the grid to blanks, load the zenkaku font, hand the panel to the
// engine (SCK = clk/2).
fn text_init() -> void {
    g_cells = I32Array((TCOLS * TROWS) as u32);
    var i: i32 = 0;
    while i < TCOLS * TROWS {
        set(g_cells, i, 0);
        poke32(TEXT_BASE + ((i * 4) as u32), 0u32);
        i = i + 1;
    }
    g_trow = 0;
    g_tcol = 0;
    load_zen_font();
    text_draw_frame();     // box-drawing window (needs the zenkaku font loaded)
    poke32(TEXT_DIV, 0u32);
    poke32(TEXT_CTRL, 1u32);
    return;
}

// Emit a mode-3 MADCTL set. Rotates / mirrors the ILI9488 framebuffer
// so the X axis covers the wider edge in landscape. Portrait default
// is 0x48; 0xE8 (MY|MX|MV|BGR) is a 90° rotation that puts the
// 480-pixel edge along X AND flips both axes — gives the orientation
// where the board's USB-C points the same way as the text top.
fn fb_madctl(fb: i32, frame: U8Array, val: i32) -> void {
    put_u16(frame, 0,  0);
    put_u16(frame, 2,  0);
    put_u16(frame, 4,  0);
    put_u16(frame, 6,  0);
    put_u16(frame, 8,  3);
    put_u16(frame, 10, val);
    sys_write(fb, frame, 12);
    return;
}

// Physical y (pixels) of cell-row `row`, folded through the scroll
// ring. g_scroll and row*CH are both multiples of CH, so the result
// is too — a 16px glyph never straddles the FB_H wrap. g_content_y
// shifts the whole grid down so the content area sits below the
// window's title bar; 0 in fullscreen modes.
fn phys_y(row: i32) -> i32 {
    return (g_scroll + g_content_y + row * CH) % FB_H;
}

// Build and send one mode-0 glyph blit at raw pixel coords (px, py).
// gw x 16 pixels; each row's bitmap is read from `bpr` font bytes at
// goff (1 byte = 8 px hankaku, 2 bytes big-endian = 16 px zenkaku).
// Set bits paint `fg`, clear bits paint `bg` — useful for blue-on-
// title-bar text vs the default white-on-black content text.
fn blit_glyph_color(fb: i32, frame: U8Array, px: i32, py: i32,
                    gw: i32, goff: i32, bpr: i32,
                    fg: i32, bg: i32) -> void {
    if g_render_frozen != 0 { return; }
    if g_vram_mode != 0 { vram_blit_glyph(px, py, gw, goff, bpr, fg, bg); return; }
    // mode 4: hand the kernel the 1-bpp font glyph + fg/bg and let it
    // expand to pixels. The old RGB565 build looped per pixel in userland
    // (a put_u16 call + a y*gw multiply each), ~8x slower than the kernel
    // doing the same expansion. Here we just copy bpr*16 font bytes.
    put_u16(frame, 0, px);
    put_u16(frame, 2, py);
    put_u16(frame, 4, gw);
    put_u16(frame, 6, 16);
    put_u16(frame, 8, 4);
    put_u16(frame, 10, fg);
    put_u16(frame, 12, bg);
    var d: u32 = (frame as u32) + 4u32 + 14u32;
    var nb: i32 = bpr * 16;
    var i: i32 = 0;
    while i < nb {
        poke8(d + (i as u32), fbyte(goff + i) as u8);
        i = i + 1;
    }
    sys_write(fb, frame, 14 + nb);
    return;
}

// Emit the queued glyph batch (mode 5) as a single fb write, if any.
fn flush_batch(fb: i32) -> void {
    if g_bn == 0 { return; }
    put_u16(g_batch, 0, g_bx0);
    put_u16(g_batch, 2, g_by);
    put_u16(g_batch, 4, 0);
    put_u16(g_batch, 6, 16);
    put_u16(g_batch, 8, 5);
    put_u16(g_batch, 10, FG);
    put_u16(g_batch, 12, COLOR_CONTENT);
    put_u16(g_batch, 14, g_bn);
    sys_write(fb, g_batch, 16 + g_bp);
    g_bn = 0;
    g_bp = 0;
    return;
}

// Cell-coords wrapper for the content area: white-on-content-bg text.
// Appends the glyph to the batch (flushing first if it isn't the next
// contiguous cell on the current row, or if the buffer is full).
fn blit_glyph(fb: i32, frame: U8Array, col: i32, row: i32,
              gw: i32, goff: i32, bpr: i32) -> void {
    if g_render_frozen != 0 { return; }
    var px: i32 = g_content_x + col * CW;
    var py: i32 = phys_y(row);
    if g_vram_mode != 0 {
        vram_blit_glyph(px, py, gw, goff, bpr, FG, COLOR_CONTENT);
        return;
    }
    var nb: i32 = bpr * 16;
    if g_bn > 0 && (py != g_by || px != g_bxn || g_bp + 1 + nb > BATCH_CAP) {
        flush_batch(fb);
    }
    if g_bn == 0 { g_bx0 = px; g_by = py; g_bxn = px; }
    var d: u32 = (g_batch as u32) + 4u32 + 16u32 + (g_bp as u32);
    poke8(d, gw as u8);
    var i: i32 = 0;
    while i < nb {
        poke8(d + 1u32 + (i as u32), fbyte(goff + i) as u8);
        i = i + 1;
    }
    g_bp = g_bp + 1 + nb;
    g_bxn = g_bxn + gw;
    g_bn = g_bn + 1;
    return;
}

// ===== JP font (embedded jpfont blob) =====

// Point g_font_addr at the .incbin'd font and read its header.
// Returns 0 on success, 1 if the embedded blob is corrupt.
fn jp_load() -> i32 {
    g_font_addr = jpfont_addr();
    if fbyte(0) != 'J' as i32 || fbyte(1) != 'P' as i32
        || fbyte(2) != 'F' as i32 || fbyte(3) != '1' as i32 {
        eputs("CONSOLE: jpfont blob corrupt\n");
        return 1;
    }
    g_u2k = fbyte(4) | (fbyte(5) << 8) | (fbyte(6) << 16) | (fbyte(7) << 24);
    // The linked blob size must match what the header implies —
    // catches a truncated or mismatched .incbin link.
    if (jpfont_size_value() as i32) != OFF_U2K + g_u2k * 4 {
        eputs("CONSOLE: jpfont size mismatch\n");
        return 1;
    }
    eputs_t("CONSOLE: jpfont loaded\n");
    return 0;
}

// Binary-search the Unicode->kuten table. Returns (ku<<8)|ten, or 0.
fn u2k_lookup(cp: i32) -> i32 {
    var lo: i32 = 0;
    var hi: i32 = g_u2k - 1;
    while lo <= hi {
        var mid: i32 = (lo + hi) / 2;
        var off: i32 = OFF_U2K + mid * 4;
        var ucp: i32 = fbyte(off) | (fbyte(off + 1) << 8);
        if ucp == cp {
            return fbyte(off + 2) | (fbyte(off + 3) << 8);
        }
        if ucp < cp { lo = mid + 1; } else { hi = mid - 1; }
    }
    return 0;
}

// 8x16 hankaku glyph (1 byte per row) at cell (col,row).
fn draw_hankaku(fb: i32, frame: U8Array, col: i32, row: i32, code: i32) -> void {
    blit_glyph(fb, frame, col, row, 8, OFF_HAN + code * 16, 1);
    return;
}

// 16x16 zenkaku glyph (2 bytes per row, big-endian) at cell (col,row).
fn draw_zenkaku(fb: i32, frame: U8Array, col: i32, row: i32, kuten: i32) -> void {
    var ku:  i32 = kuten >> 8;
    var ten: i32 = kuten & 0xFF;
    blit_glyph(fb, frame, col, row, 16,
               OFF_ZEN + ((ku - 1) * 94 + (ten - 1)) * 32, 2);
    return;
}

// ===== Win95 chrome: window + title bar + taskbar =====

// Paint each printable byte of `s` as an 8x16 hankaku glyph starting
// at raw pixel (px, py), in (fg) on (bg). Used for the title-bar
// label and the Start button caption — neither lives on the cell
// grid, so they go through blit_glyph_color rather than blit_glyph.
fn draw_text_at(fb: i32, frame: U8Array, px: i32, py: i32,
                s: StringLiteral, fg: i32, bg: i32) -> void {
    var n: i32 = len(s);
    var i: i32 = 0;
    while i < n {
        var c: i32 = get(s, i) as i32;
        if c >= 32 && c < 256 {
            blit_glyph_color(fb, frame, px + i * 8, py, 8,
                             OFF_HAN + c * 16, 1, fg, bg);
        }
        i = i + 1;
    }
    return;
}

// Paint a 1-px raised (button-up) or sunken (button-down) 3D bevel
// around the rectangle (x, y, w, h).
fn draw_3d_bevel(fb: i32, frame: U8Array,
                 x: i32, y: i32, w: i32, h: i32, raised: i32) -> void {
    var hl: i32 = COLOR_HILIGHT;
    var sh: i32 = COLOR_SHADOW;
    if raised == 0 { hl = COLOR_SHADOW; sh = COLOR_HILIGHT; }
    fb_fill(fb, frame, x,         y,         w, 1, hl);
    fb_fill(fb, frame, x,         y,         1, h, hl);
    fb_fill(fb, frame, x,         y + h - 1, w, 1, sh);
    fb_fill(fb, frame, x + w - 1, y,         1, h, sh);
    return;
}

// Paint a small chunky icon as a 14x14 raised tile sitting in the
// title bar's left margin. Two diagonal lines form a stylised glyph
// (a >-prompt). Cheap and recognisably "DOS prompt" at this scale.
fn draw_titlebar_icon(fb: i32, frame: U8Array, x: i32, y: i32) -> void {
    fb_fill(fb, frame, x, y, 14, 14, COLOR_FRAME);
    draw_3d_bevel(fb, frame, x, y, 14, 14, 1);
    // Crude > arrow inside.
    fb_fill(fb, frame, x + 3, y + 4, 2, 2, COLOR_SHADOW);
    fb_fill(fb, frame, x + 5, y + 6, 2, 2, COLOR_SHADOW);
    fb_fill(fb, frame, x + 3, y + 8, 2, 2, COLOR_SHADOW);
    fb_fill(fb, frame, x + 7, y + 10, 4, 2, COLOR_SHADOW);
    return;
}

// 16x16 raised close button with an "x" centred. Visual only — we
// don't currently dispatch clicks on it.
fn draw_close_button(fb: i32, frame: U8Array, x: i32, y: i32) -> void {
    fb_fill(fb, frame, x, y, 16, 16, COLOR_FRAME);
    draw_3d_bevel(fb, frame, x, y, 16, 16, 1);
    // Diagonal-ish x using 4 pixels off the corners.
    fb_fill(fb, frame, x + 4,  y + 4,  2, 2, COLOR_SHADOW);
    fb_fill(fb, frame, x + 6,  y + 6,  4, 4, COLOR_SHADOW);
    fb_fill(fb, frame, x + 10, y + 10, 2, 2, COLOR_SHADOW);
    fb_fill(fb, frame, x + 10, y + 4,  2, 2, COLOR_SHADOW);
    fb_fill(fb, frame, x + 4,  y + 10, 2, 2, COLOR_SHADOW);
    return;
}

// Paint the whole desktop: teal background, an "MTOS Prompt" window
// hosting the cell grid, and a Start-button + app-button + clock
// taskbar across the bottom. Geometry is fixed for 480x320 landscape.
fn draw_chrome(fb: i32, frame: U8Array) -> void {
    // 1. Desktop background.
    fb_fill(fb, frame, 0, 0, SCREEN_W, SCREEN_H, COLOR_DESKTOP);

    // 2. Window 12..467 × 14..285. Raised grey frame, 4 px desktop
    //    margin on the sides + 14 / 6 top / above-taskbar.
    var wx: i32 = 12;
    var wy: i32 = 14;
    var ww: i32 = SCREEN_W - 24;              // 456
    var wh: i32 = SCREEN_H - 14 - 28 - 6;     // 272
    fb_fill(fb, frame, wx, wy, ww, wh, COLOR_FRAME);
    draw_3d_bevel(fb, frame, wx, wy, ww, wh, 1);

    // 3. Title bar 16..463 × 16..33 (18 px), with icon (left), the
    //    title text in white-on-navy, and a close button (right).
    var tx: i32 = wx + 4;
    var ty: i32 = wy + 2;
    var tw: i32 = ww - 8;                     // 448
    var th: i32 = 18;
    fb_fill(fb, frame, tx, ty, tw, th, COLOR_TITLE_BG);
    draw_titlebar_icon(fb, frame, tx + 2, ty + 2);
    draw_text_at(fb, frame, tx + 20, ty + 1,
                 "MTOS Prompt", COLOR_TITLE_FG, COLOR_TITLE_BG);
    draw_close_button(fb, frame, tx + tw - 18, ty + 1);

    // 4. Content area (16..463 × 40..279, 56 cols × 15 rows of 8x16).
    //    g_content_y picks up the 4-px gap below the title bar that
    //    keeps the prompt from kissing the navy line.
    fb_fill(fb, frame, g_content_x, g_content_y,
            COLS * CW, ROWS * CH, COLOR_CONTENT);

    // 5. Taskbar across the bottom (0..480 × 292..320, 28 px tall).
    //    Top edge is a 1-px white highlight; the rest is plain frame
    //    grey.
    var bx: i32 = 0;
    var by: i32 = SCREEN_H - 28;
    var bw: i32 = SCREEN_W;
    var bh: i32 = 28;
    fb_fill(fb, frame, bx, by, bw, bh, COLOR_FRAME);
    fb_fill(fb, frame, bx, by, bw, 1,  COLOR_HILIGHT);

    // 6. Start button at left of the taskbar. Wider than v1 so the
    //    "Start" caption clears the bevel on both sides.
    var sbx: i32 = 4;
    var sby: i32 = by + 4;
    var sbw: i32 = 68;
    var sbh: i32 = 20;
    fb_fill(fb, frame, sbx, sby, sbw, sbh, COLOR_FRAME);
    draw_3d_bevel(fb, frame, sbx, sby, sbw, sbh, 1);
    draw_text_at(fb, frame, sbx + 14, sby + 2,
                 "Start", COLOR_SHADOW, COLOR_FRAME);

    // 7. App button for the currently running window. We only have
    //    the one DOS prompt for now; in Win95 the active window's
    //    button is drawn sunken to signal "focused / restored".
    var abx: i32 = sbx + sbw + 4;
    var aby: i32 = sby;
    var abw: i32 = 132;
    var abh: i32 = sbh;
    fb_fill(fb, frame, abx, aby, abw, abh, COLOR_FRAME);
    draw_3d_bevel(fb, frame, abx, aby, abw, abh, 0);    // sunken
    draw_titlebar_icon(fb, frame, abx + 4, aby + 3);
    draw_text_at(fb, frame, abx + 22, aby + 2,
                 "MTOS Prompt", COLOR_SHADOW, COLOR_FRAME);

    // 8. Clock placeholder at the far right of the taskbar. We blit
    //    "00:00" here so the slot is visible immediately; the real
    //    HH:MM is drawn periodically by draw_clock() from the read
    //    loop.
    g_clock_x = SCREEN_W - 48;
    g_clock_y = sby + 2;
    fb_fill(fb, frame, g_clock_x - 4, sby, 48, sbh, COLOR_FRAME);
    draw_3d_bevel(fb, frame, g_clock_x - 4, sby, 48, sbh, 0);
    draw_text_at(fb, frame, g_clock_x, g_clock_y,
                 "00:00", COLOR_SHADOW, COLOR_FRAME);
    return;
}

// Refresh just the HH:MM digits inside the clock sunken area. Called
// from the cursor-blink path (every 250 ms) and after each batch of
// rendered output; the kernel's /dev/rtc snapshots "YYYY-MM-DD
// HH:MM:SS\n" on open and the read drains it, so we open + read +
// close once per second. A short-circuit on (last_hh, last_mm) keeps
// the actual fb_fill / glyph blits down to once per minute.
fn draw_2digits(fb: i32, frame: U8Array, x: i32, y: i32, n: i32) -> void {
    var d1: i32 = (n / 10) % 10;
    var d2: i32 = n % 10;
    blit_glyph_color(fb, frame, x,     y, 8, OFF_HAN + (48 + d1) * 16, 1,
                     COLOR_SHADOW, COLOR_FRAME);
    blit_glyph_color(fb, frame, x + 8, y, 8, OFF_HAN + (48 + d2) * 16, 1,
                     COLOR_SHADOW, COLOR_FRAME);
    return;
}

var g_clock_tick: i32 = 0;
var g_last_hh:    i32 = 0 - 1;
var g_last_mm:    i32 = 0 - 1;

fn draw_clock(fb: i32, frame: U8Array) -> void {
    if g_text_mode != 0 { text_draw_clock_t(); return; }   // menu-bar clock
    if g_have_chrome == 0 { return; }
    // ~1 Hz poll. draw_clock fires at the 250 ms blink rate plus on
    // every byte batch from sh; without this gate the RTC would be
    // opened 4-10× per second for no visible gain.
    g_clock_tick = g_clock_tick + 1;
    if g_clock_tick < 4 { return; }
    g_clock_tick = 0;

    var rfd: i32 = do_openat(0, "/dev/rtc", 0);
    if rfd < 0 { return; }
    var buf: U8Array = U8Array(24u32);
    var n: i32 = sys_read(rfd, buf, 20);
    do_close(rfd);
    // "YYYY-MM-DD HH:MM:SS\n" — HH at offsets 11/12, MM at 14/15.
    if n < 16 { delete(buf); return; }
    var hh: i32 = ((get(buf, 11) as i32) - 48) * 10
                +  (get(buf, 12) as i32) - 48;
    var mm: i32 = ((get(buf, 14) as i32) - 48) * 10
                +  (get(buf, 15) as i32) - 48;
    delete(buf);

    if hh == g_last_hh && mm == g_last_mm { return; }
    g_last_hh = hh;
    g_last_mm = mm;

    draw_2digits(fb, frame, g_clock_x,      g_clock_y, hh);
    blit_glyph_color(fb, frame, g_clock_x + 16, g_clock_y, 8,
                     OFF_HAN + 58 * 16, 1,             // ':'
                     COLOR_SHADOW, COLOR_FRAME);
    draw_2digits(fb, frame, g_clock_x + 24, g_clock_y, mm);
    return;
}

// ===== Software scroll (landscape) =====

// Re-blit only the cells where the logical grid has drifted away from
// what /dev/fb currently shows. Cells unchanged since the last redraw
// (very common for trailing empties on terse shell output) are skipped
// entirely — that's the bulk of the SPI cost on a software scroll.
//
// Glyph cells repaint themselves (blit_glyph paints FG-on-black, so
// the cell background is implicit); empty cells get an 8x16 mode-1
// black fill. The upfront whole-screen fb_fill is gone — it would
// touch every pixel before we even consult the diff.
fn redraw(fb: i32, frame: U8Array) -> void {
    var r: i32 = 0;
    while r < ROWS {
        var c: i32 = 0;
        while c < COLS {
            var idx: i32 = r * COLS + c;
            var cp:   i32 = get(g_grid, idx);
            var prev: i32 = get(g_grid_prev, idx);
            if cp != prev {
                if cp >= 32 {
                    if cp < 256 {
                        draw_hankaku(fb, frame, c, r, cp);
                    } else {
                        var kt: i32 = u2k_lookup(cp);
                        if kt != 0 {
                            draw_zenkaku(fb, frame, c, r, kt);
                        } else {
                            fb_fill(fb, frame, g_content_x + c * CW,
                                    phys_y(r), CW, CH, COLOR_CONTENT);
                        }
                    }
                } else if cp != (0 - 1) {
                    // 0 = empty cell; -1 = trailing half of a zenkaku
                    // that was painted by its left cell, leave alone.
                    fb_fill(fb, frame, g_content_x + c * CW, phys_y(r),
                            CW, CH, COLOR_CONTENT);
                }
                set(g_grid_prev, idx, cp);
            }
            c = c + 1;
        }
        r = r + 1;
    }
    flush_batch(fb);
    return;
}

fn copy32(dst: u32, src: u32, count: i32) -> void;   // runtime asm primitive

// VRAM fast scroll: the framebuffer is plain SDRAM, so shift the content
// area up one text row (CH px) with a pixel memmove and clear the new
// bottom band — no per-cell re-blit. g_grid AND its shadow g_grid_prev are
// shifted identically so a following redraw() sees no drift and touches
// nothing. ~10 ms vs the ~10 s a full-grid re-blit costs on this CPU.
fn vram_scroll_up() -> void {
    var rows_px: i32 = (ROWS - 1) * CH;         // pixel rows that move up
    var wcount:  i32 = (COLS * CW) / 2;         // words per row (2 px/word)
    var py: i32 = 0;
    while py < rows_px {
        var dst_y: i32 = g_content_y + py;
        var src_y: i32 = dst_y + CH;
        var dst: u32 = VRAM_BASE_LO + ((((dst_y * VRAM_W) + g_content_x) * 2) as u32);
        var src: u32 = VRAM_BASE_LO + ((((src_y * VRAM_W) + g_content_x) * 2) as u32);
        copy32(dst, src, wcount);
        py = py + 1;
    }
    // clear the freed bottom text row to the content background
    vram_fill(g_content_x, g_content_y + rows_px, COLS * CW, CH, COLOR_CONTENT);
    // shift the logical grid + its shadow so redraw() stays in sync
    var r: i32 = 0;
    while r < ROWS - 1 {
        var c: i32 = 0;
        while c < COLS {
            set(g_grid,      r * COLS + c, get(g_grid,      (r + 1) * COLS + c));
            set(g_grid_prev, r * COLS + c, get(g_grid_prev, (r + 1) * COLS + c));
            c = c + 1;
        }
        r = r + 1;
    }
    var bc: i32 = 0;
    while bc < COLS {
        set(g_grid,      (ROWS - 1) * COLS + bc, 0);
        set(g_grid_prev, (ROWS - 1) * COLS + bc, 0);
        bc = bc + 1;
    }
    return;
}

// Software scroll: shift the codepoint grid up one row, blank the new
// bottom row, and re-blit the whole screen. Used in landscape, where
// the hardware vertical scroll cannot move text.
fn sw_scroll(fb: i32, frame: U8Array) -> void {
    if g_vram_mode != 0 { vram_scroll_up(); return; }
    var r: i32 = 0;
    while r < ROWS - 1 {
        var c: i32 = 0;
        while c < COLS {
            set(g_grid, r * COLS + c, get(g_grid, (r + 1) * COLS + c));
            c = c + 1;
        }
        r = r + 1;
    }
    var bc: i32 = 0;
    while bc < COLS {
        set(g_grid, (ROWS - 1) * COLS + bc, 0);
        bc = bc + 1;
    }
    redraw(fb, frame);
    return;
}

// Force a full repaint: invalidate g_grid_prev so every cell looks
// "changed", then redraw chrome + content. Called from
// dispatch_csi_private when ESC[?47l brings us out of the alternate-
// screen freeze and we need to undo whatever the foreground task
// scribbled on the LCD.
fn repaint_all(fb: i32, frame: U8Array) -> void {
    if (g_grid_prev as u32) != 0u32 {
        var i: i32 = 0;
        var n: i32 = ROWS * COLS;
        while i < n {
            // Sentinel that no real codepoint matches, so redraw will
            // overwrite every cell.
            set(g_grid_prev, i, 0 - 2);
            i = i + 1;
        }
    }
    draw_chrome(fb, frame);
    redraw(fb, frame);
    return;
}

// ===== Terminal state machine =====

fn newline() -> void {
    g_col = 0;
    g_row = g_row + 1;
    return;
}

// Render one decoded Unicode codepoint.
fn draw_cp(fb: i32, frame: U8Array, cp: i32) -> void {
    if g_text_mode != 0 { text_draw_cp(cp); return; }
    if cp == 10 {
        newline();
    } else if cp == 13 {
        g_col = 0;
    } else if cp == 8 {
        if g_col > 0 { g_col = g_col - 1; }
    } else if cp >= 32 {
        if cp < 256 {
            draw_hankaku(fb, frame, g_col, g_row, cp);
            if g_sw_scroll != 0 {
                // Direct paint — grid and grid_prev stay in sync so
                // the next redraw skips this cell unless a scroll
                // moves something else into it.
                var ix: i32 = g_row * COLS + g_col;
                set(g_grid,      ix, cp);
                set(g_grid_prev, ix, cp);
            }
            g_col = g_col + 1;
        } else {
            var kt: i32 = u2k_lookup(cp);
            if kt != 0 {
                if g_col + 1 >= COLS { newline(); }
                draw_zenkaku(fb, frame, g_col, g_row, kt);
                if g_sw_scroll != 0 {
                    // cp at the left cell, -1 marks the trailing cell.
                    var iz: i32 = g_row * COLS + g_col;
                    set(g_grid,      iz,     cp);
                    set(g_grid,      iz + 1, 0 - 1);
                    set(g_grid_prev, iz,     cp);
                    set(g_grid_prev, iz + 1, 0 - 1);
                }
                g_col = g_col + 2;
            }
        }
        if g_col >= COLS { newline(); }
    }
    if g_row >= ROWS {
        // Cursor fell off the bottom.
        g_row = ROWS - 1;
        if g_sw_scroll != 0 {
            sw_scroll(fb, frame);
        } else {
            // Hardware scroll: clear the oldest physical line at
            // y = g_scroll, advance VSCRSADD past it — phys_y(ROWS-1)
            // now folds back onto that freed strip.
            fb_fill(fb, frame, 0, g_scroll, SCREEN_W, CH, 0);
            g_scroll = (g_scroll + CH) % FB_H;
            fb_scroll(fb, frame, g_scroll);
        }
    }
    return;
}

// Cursor: a 4-pixel-tall white underline at the bottom of the cell.
// 2 px was too thin to spot on the panel; 4 px reads as a clear bar
// without covering enough of the glyph to be confusing.
var g_cur_on: i32 = 0;
const CUR_H:    i32 = 4;

fn draw_cursor(fb: i32, frame: U8Array) -> void {
    if g_text_mode != 0 {
        if g_cur_enabled == 0 { return; }     // DECTCEM ESC[?25l
        // Inverse (black-on-white) block at the cursor cell. Blank cells
        // read back as 0, so render a space glyph so the block is solid.
        var idx: i32 = (TCONT_Y0 + g_trow) * TCOLS + (TCONT_X0 + g_tcol);
        var cur: i32 = get(g_cells, idx);
        var ch:  i32 = cur & 0xFF;
        if ch == 0 { ch = 32; }
        var inv: i32 = ch | (0 << 8) | (15 << 12);   // fg black, bg white
        poke32(TEXT_BASE + ((idx * 4) as u32), inv as u32);
        g_cur_row = g_trow;  g_cur_col = g_tcol;  g_cur_on = 1;
        return;
    }
    if g_cur_enabled == 0 { return; }     // DECTCEM ESC[?25l
    if g_row < 0 || g_row >= ROWS { return; }
    if g_col < 0 || g_col >= COLS { return; }
    fb_fill(fb, frame, g_content_x + g_col * CW,
            phys_y(g_row) + CH - CUR_H, CW, CUR_H, FG);
    g_cur_col = g_col;
    g_cur_row = g_row;
    g_cur_on = 1;
    return;
}

fn erase_cursor(fb: i32, frame: U8Array) -> void {
    if g_cur_on == 0 { return; }
    if g_text_mode != 0 {
        // Restore the real cell (undo the inverse block).
        var idx: i32 = (TCONT_Y0 + g_cur_row) * TCOLS + (TCONT_X0 + g_cur_col);
        poke32(TEXT_BASE + ((idx * 4) as u32), get(g_cells, idx) as u32);
        g_cur_on = 0;
        return;
    }
    if g_cur_row < 0 || g_cur_row >= ROWS { return; }
    if g_cur_col < 0 || g_cur_col >= COLS { return; }
    fb_fill(fb, frame, g_content_x + g_cur_col * CW,
            phys_y(g_cur_row) + CH - CUR_H, CW, CUR_H, COLOR_CONTENT);
    // Bottom CUR_H pixels of any glyph in this cell are now black even
    // if the glyph itself had ink there. Mark the cell dirty so the
    // next redraw (e.g. after a scroll) repaints the glyph cleanly.
    if g_sw_scroll != 0 && (g_grid_prev as u32) != 0u32 {
        set(g_grid_prev, g_cur_row * COLS + g_cur_col, 0 - 2);
    }
    g_cur_on = 0;
    return;
}

// ===== ANSI CSI dispatch =====
//
// Implements the minimum the apps shipped in this tree actually emit:
//   ESC[<r>;<c>H / f   CUP — absolute cursor position (1-based; 0/blank → 1)
//   ESC[<n>A/B/C/D     CUU/CUD/CUF/CUB — relative cursor move
//   ESC[<n>J           ED  — erase display (n=0 below, 1 above, 2 all)
//   ESC[<n>K           EL  — erase line    (n=0 right, 1 left, 2 all)
//   ESC[?25h / ?25l    DECTCEM — show / hide cursor
// SGR (colour) and the more exotic CSI verbs intentionally fall
// through to "ignored" — sl/vi don't use them and skipping them is
// the same behaviour the host UART terminal exhibits when given an
// unsupported sequence (drop the bytes, move on).

// Read the i-th CSI numeric param; substitute `dflt` if it was absent
// or explicitly zero (ANSI says "0 means default for most verbs").
fn csi_param(i: i32, dflt: i32) -> i32 {
    if i >= g_csi_n { return dflt; }
    var v: i32 = get(g_csi_p, i);
    if v == 0 { return dflt; }
    return v;
}

// Blank `len` cells on `row` starting at column `c0`. Repaints in both
// scroll modes — software scroll's redraw skips cells where prev still
// matches grid, so this is cheap on no-op clears.
fn blank_cells(fb: i32, frame: U8Array, row: i32, c0: i32, len: i32) -> void {
    if row < 0 || row >= ROWS { return; }
    if c0 < 0 { len = len + c0; c0 = 0; }
    if c0 + len > COLS { len = COLS - c0; }
    if len <= 0 { return; }
    if g_sw_scroll != 0 {
        var c: i32 = 0;
        while c < len {
            set(g_grid, row * COLS + c0 + c, 0);
            c = c + 1;
        }
        redraw(fb, frame);
    } else {
        fb_fill(fb, frame, g_content_x + c0 * CW, phys_y(row),
                len * CW, CH, COLOR_CONTENT);
    }
    return;
}

// ED 2 — clear the whole content area. SW mode wipes g_grid + redraws;
// HW mode fb_fills the screen (no chrome in portrait, so 0,0,SW,SH is
// safe). g_grid_prev is left alone: redraw uses prev != grid to find
// the dirty cells, so leaving prev populated is what makes empties
// repaint with COLOR_CONTENT instead of being skipped.
fn erase_display_all(fb: i32, frame: U8Array) -> void {
    if g_sw_scroll != 0 {
        var i: i32 = 0;
        while i < COLS * ROWS {
            set(g_grid, i, 0);
            i = i + 1;
        }
        redraw(fb, frame);
    } else {
        fb_fill(fb, frame, 0, 0, SCREEN_W, SCREEN_H, COLOR_CONTENT);
        // Hardware scroll: the visible window may have rotated through
        // the framebuffer ring. A whole-FB fill blanks every line in
        // the ring so subsequent scrolls reveal black, not stale text.
    }
    return;
}

// ED 0 — clear from the cursor (inclusive) to the bottom-right.
fn erase_display_below(fb: i32, frame: U8Array) -> void {
    blank_cells(fb, frame, g_row, g_col, COLS - g_col);
    var r: i32 = g_row + 1;
    while r < ROWS {
        blank_cells(fb, frame, r, 0, COLS);
        r = r + 1;
    }
    return;
}

// ED 1 — clear from the top-left to the cursor (inclusive).
fn erase_display_above(fb: i32, frame: U8Array) -> void {
    var r: i32 = 0;
    while r < g_row {
        blank_cells(fb, frame, r, 0, COLS);
        r = r + 1;
    }
    blank_cells(fb, frame, g_row, 0, g_col + 1);
    return;
}

// ESC[<final> with g_csi_p / g_csi_n already populated.
fn dispatch_csi(fb: i32, frame: U8Array, final: i32) -> void {
    if final == ('H' as i32) || final == ('f' as i32) {
        var row: i32 = csi_param(0, 1) - 1;
        var col: i32 = csi_param(1, 1) - 1;
        if row < 0 { row = 0; }
        if col < 0 { col = 0; }
        if row >= ROWS { row = ROWS - 1; }
        if col >= COLS { col = COLS - 1; }
        g_row = row;
        g_col = col;
        return;
    }
    if final == ('A' as i32) {
        var n: i32 = csi_param(0, 1);
        g_row = g_row - n;
        if g_row < 0 { g_row = 0; }
        return;
    }
    if final == ('B' as i32) {
        var n: i32 = csi_param(0, 1);
        g_row = g_row + n;
        if g_row >= ROWS { g_row = ROWS - 1; }
        return;
    }
    if final == ('C' as i32) {
        var n: i32 = csi_param(0, 1);
        g_col = g_col + n;
        if g_col >= COLS { g_col = COLS - 1; }
        return;
    }
    if final == ('D' as i32) {
        var n: i32 = csi_param(0, 1);
        g_col = g_col - n;
        if g_col < 0 { g_col = 0; }
        return;
    }
    if final == ('J' as i32) {
        var nj: i32 = 0;
        if g_csi_n > 0 { nj = get(g_csi_p, 0); }
        if nj == 2 { erase_display_all(fb, frame); }
        else if nj == 1 { erase_display_above(fb, frame); }
        else { erase_display_below(fb, frame); }
        return;
    }
    if final == ('K' as i32) {
        var nk: i32 = 0;
        if g_csi_n > 0 { nk = get(g_csi_p, 0); }
        if nk == 2 { blank_cells(fb, frame, g_row, 0, COLS); }
        else if nk == 1 { blank_cells(fb, frame, g_row, 0, g_col + 1); }
        else { blank_cells(fb, frame, g_row, g_col, COLS - g_col); }
        return;
    }
    // SGR (m), DSR, etc. fall through unimplemented on purpose.
    return;
}

// ESC[? <final> — DEC-private mode set/reset. We only honour DECTCEM
// (?25 l/h) since that's the one cursor-aware apps actually emit.
fn dispatch_csi_private(fb: i32, frame: U8Array, final: i32) -> void {
    if g_csi_n > 0 && get(g_csi_p, 0) == 25 {
        if final == ('l' as i32) {
            erase_cursor(fb, frame);          // hide what may be on screen
            g_cur_enabled = 0;
        } else if final == ('h' as i32) {
            g_cur_enabled = 1;
        }
    } else if g_csi_n > 0 && get(g_csi_p, 0) == 47 {
        // xterm-compatible alternate-screen toggle:
        //   ESC[?47h → freeze console rendering so foreground apps can
        //              own /dev/fb without us painting over them
        //   ESC[?47l → resume rendering and repaint the whole window
        if final == ('h' as i32) {
            if g_render_frozen == 0 {
                g_render_frozen = 1;
                g_fb_close_req  = 1;
            }
        } else if final == ('l' as i32) {
            // Only act if we were actually frozen — sh sends ?47l after
            // every spawn it waits on as a safety net for crashing
            // foreground tasks, and the no-op case must not trigger a
            // full chrome repaint on every command.
            if g_render_frozen != 0 {
                g_render_frozen = 0;
                g_fb_open_req   = 1;
            }
        }
    }
    return;
}

// Feed one byte through the ANSI escape parser and (if it falls
// through) the UTF-8 decoder, then render completed codepoints. The
// CSI parser eats ESC + everything up to and including the final byte
// so escape bytes never reach draw_cp.
//
// Defensive structure: each state handler returns once it has consumed
// the byte. If `g_esc_state` is ever NOT 1/2/3 (i.e. a stale value or
// zero) the code falls through to the ground-state handling — and we
// stamp g_esc_state back to 0 so the next pass can't get stuck in a
// non-canonical state where bytes route around the parser entirely.
fn render(fb: i32, frame: U8Array, b: i32) -> void {
    // ESC at ANY state restarts the parser: hardware-style resync
    // for the realistic case where an app's partial sys_write left a
    // half-CSI in the pipe and the next sys_write started a fresh
    // ESC[ sequence. Without this the truncated CSI would consume the
    // new ESC, and `[<row>;1H` would leak straight to draw_cp.
    if b == 27 {
        g_un = 0;
        g_esc_state = 1;
        return;
    }
    if g_esc_state == 1 {
        if b == ('[' as i32) {
            g_esc_state = 2;
            g_csi_cur = 0;
            g_csi_has = 0;
            g_csi_n = 0;
        } else {
            // Two-byte ESC <X> sequences (DECSC, charset selects,
            // etc.) aren't useful here — drop the byte and return
            // to ground state. SL/vi/sh don't emit any of them.
            g_esc_state = 0;
        }
        return;
    }
    if g_esc_state == 2 || g_esc_state == 3 {
        // '?' as the first byte switches to private-mode CSI.
        if g_esc_state == 2 && b == ('?' as i32)
           && g_csi_has == 0 && g_csi_n == 0 {
            g_esc_state = 3;
            return;
        }
        if b >= ('0' as i32) && b <= ('9' as i32) {
            g_csi_cur = g_csi_cur * 10 + (b - ('0' as i32));
            g_csi_has = 1;
            return;
        }
        if b == (';' as i32) {
            if g_csi_n < CSI_PMAX {
                set(g_csi_p, g_csi_n, g_csi_cur);
                g_csi_n = g_csi_n + 1;
            }
            g_csi_cur = 0;
            g_csi_has = 0;
            return;
        }
        if b >= 0x40 && b <= 0x7E {
            if g_csi_has != 0 || g_csi_n > 0 {
                if g_csi_n < CSI_PMAX {
                    set(g_csi_p, g_csi_n, g_csi_cur);
                    g_csi_n = g_csi_n + 1;
                }
            }
            if g_esc_state == 2 {
                dispatch_csi(fb, frame, b);
            } else {
                dispatch_csi_private(fb, frame, b);
            }
            g_esc_state = 0;
            return;
        }
        // Intermediate bytes (0x20..0x2F) or anything else we don't
        // understand — abort the sequence and resume ground state.
        g_esc_state = 0;
        return;
    }
    // Ground state (canonical g_esc_state == 0). Pin the state to 0
    // defensively so a stale value caused by a memory glitch upstream
    // can't trap subsequent bytes in a dead branch above. The
    // top-of-function ESC check already handled b == 27, so the only
    // bytes reaching here flow into the UTF-8 decoder.
    g_esc_state = 0;
    var cp: i32 = 0 - 1;
    if g_un > 0 {
        if (b & 192) == 128 {
            g_ucp = (g_ucp << 6) | (b & 63);
            g_un = g_un - 1;
            if g_un == 0 { cp = g_ucp; }
        } else {
            g_un = 0;            // malformed — restart on this byte
        }
    }
    if g_un == 0 && cp < 0 {
        if b < 128 {
            cp = b;
        } else if (b & 224) == 192 {
            g_ucp = b & 31;  g_un = 1;
        } else if (b & 240) == 224 {
            g_ucp = b & 15;  g_un = 2;
        } else if (b & 248) == 240 {
            g_ucp = b & 7;   g_un = 3;
        }
    }
    if cp >= 0 {
        draw_cp(fb, frame, cp);
    }
    return;
}

fn print_us(us: u32) -> void {
    var ms: u32 = us / 1000u32;
    if ms == 0u32 { eputs("0"); }
    else {
        var tmp: U8Array = U8Array(12u32);
        var n: i32 = 0;
        while ms > 0u32 {
            set(tmp, n, ('0' as i32 + (ms % 10u32) as i32) as u8);
            n = n + 1;
            ms = ms / 10u32;
        }
        var out: U8Array = U8Array(n as u32);
        var k: i32 = 0;
        while k < n {
            set(out, k, get(tmp, n - 1 - k));
            k = k + 1;
        }
        sys_write(2, out, n);
        delete(out);
        delete(tmp);
    }
    return;
}

fn eputs_t(s: StringLiteral) -> void {
    eputs("[");
    print_us(do_uptime_us());
    eputs("ms] ");
    eputs(s);
    return;
}

fn main(argv: StringArray) -> i32 {
    eputs_t("CONSOLE: ready\n");
    if jp_load() != 0 { return 1; }

    g_csi_p = I32Array(CSI_PMAX as u32);

    // argv: `[-l] [path [args...]]`. -l selects landscape (panel
    // rotated 90° + software scroll); default is portrait + hardware
    // scroll. The first non-"-l" positional sets the program to spawn
    // (default /bin/sh) and the rest become its argv (program seen at
    // argv[0] of the child). kern.conf init tasks get no argv → default
    // portrait + /bin/sh.
    var land: i32 = 0;
    var spawn_path: String = 0 as String;
    var child_argv: StringArray = 0 as StringArray;
    if (argv as u32) != 0u32 {
        var argc: i32 = len(argv);
        var path_idx: i32 = 0 - 1;
        var positional_n: i32 = 0;
        var ai: i32 = 1;
        while ai < argc {
            var a: String = get(argv, ai);
            if len(a) == 2 && get(a, 0) == ('-' as u8)
                && get(a, 1) == ('l' as u8) {
                land = 1;
            } else if len(a) == 2 && get(a, 0) == ('-' as u8)
                && get(a, 1) == ('v' as u8) {
                g_vram_mode = 1;                 // tn20k VRAM refresh engine
            } else if len(a) == 2 && get(a, 0) == ('-' as u8)
                && get(a, 1) == ('t' as u8) {
                g_text_mode = 1;  land = 1;      // tn20k text_lcd char-gen engine
            } else {
                if path_idx < 0 { path_idx = ai; }
                positional_n = positional_n + 1;
            }
            ai = ai + 1;
        }
        if path_idx >= 0 {
            spawn_path = get(argv, path_idx);
            // Build child argv with positional args (path at [0]). The
            // String pointers reference our own argv storage, which the
            // task owns for its lifetime; pack_argv_at copies into the
            // child at spawn time. We only allocate the array container.
            child_argv = StringArray(positional_n as u32);
            var ci: i32 = 0;
            var ki: i32 = path_idx;
            while ki < argc {
                var ak: String = get(argv, ki);
                var is_l: i32 = 0;
                if len(ak) == 2 && get(ak, 0) == ('-' as u8)
                    && (get(ak, 1) == ('l' as u8) || get(ak, 1) == ('v' as u8)
                        || get(ak, 1) == ('t' as u8)) {
                    is_l = 1;
                }
                if is_l == 0 {
                    set(child_argv, ci, ak);
                    ci = ci + 1;
                }
                ki = ki + 1;
            }
        }
    }
    if land != 0 {
        SCREEN_W = 480;  SCREEN_H = 320;  g_sw_scroll = 1;
        // Landscape gets the Win95 desktop chrome. Content area runs
        // 56 cols × 15 rows inside a window sitting above a taskbar:
        //   window  12..467 × 14..285  (456 × 272)
        //   title   16..463 × 16..33   (448 × 18, navy)
        //   content 16..463 × 40..279  (448 × 240 = 56 × 15)
        //   taskbar  0..479 × 292..319 (480 × 28)
        g_have_chrome = 1;
        g_content_x = 16;
        g_content_y = 40;
        COLS = 56;
        ROWS = 15;
        eputs_t("CONSOLE: landscape, software scroll, chrome\n");
    } else {
        SCREEN_W = 320;  SCREEN_H = 480;  g_sw_scroll = 0;
        g_have_chrome = 0;
        g_content_x = 0;
        g_content_y = 0;
        COLS = SCREEN_W / CW;
        ROWS = SCREEN_H / CH;
        eputs_t("CONSOLE: portrait, hardware scroll\n");
    }
    // Text mode reuses the landscape MADCTL (0xE8) but owns the panel via the
    // hw text_lcd engine — no chrome, no pixel grid.
    if g_text_mode != 0 {
        g_have_chrome = 0;
        eputs_t("CONSOLE: text mode (hw char-gen)\n");
    }
    FB_H = SCREEN_H;
    if g_sw_scroll != 0 {
        g_grid      = I32Array((COLS * ROWS) as u32);
        g_grid_prev = I32Array((COLS * ROWS) as u32);
        var gi: i32 = 0;
        while gi < COLS * ROWS {
            set(g_grid,      gi, 0);
            // 0 also matches the initial fb_fill(black) we issue
            // right after — both arrays describe an empty screen.
            set(g_grid_prev, gi, 0);
            gi = gi + 1;
        }
    }

    eputs_t("CONSOLE: opening /dev/kbd\n");
    var kbd: i32 = do_openat(0, "/dev/kbd", 0);
    eputs_t("CONSOLE: opening /dev/fb\n");
    var fb:  i32 = do_openat(0, "/dev/fb", 1);
    if kbd < 0 || fb < 0 {
        eputs("CONSOLE: device open failed\n");
        return 1;
    }
    eputs_t("CONSOLE: devices open\n");

    var pb: U8Array = U8Array(8u32);
    if do_pipe(pb as u32 + 4u32) != 0 {
        eputs("CONSOLE: pipe failed\n");
        delete(pb);
        return 1;
    }
    var pr: i32 = peek32(pb as u32 + 4u32) as i32;
    var pw: i32 = peek32(pb as u32 + 8u32) as i32;

    eputs_t("CONSOLE: spawning child\n");
    // Spawn the chosen program with stdin = /dev/kbd, stdout = pipe
    // write end. When the user didn't pass a path, default to /bin/sh
    // with no argv (matches the historical seed-task behaviour).
    var slot: i32;
    if (spawn_path as u32) != 0u32 {
        slot = do_spawn_fds(spawn_path, child_argv as u32, kbd, pw);
    } else {
        slot = do_spawn_fds("/bin/sh", 0u32, kbd, pw);
    }
    delete(pb);
    // Drop the array container — its String entries belong to our argv
    // and stay alive for our lifetime, but pack_argv_at has already
    // copied them into the child.
    if (child_argv as u32) != 0u32 { delete(child_argv); }
    if slot < 0 {
        eputs("CONSOLE: child spawn failed\n");
        return 1;
    }
    eputs_t("CONSOLE: child spawned, entering render loop\n");
    // Do NOT close kbd / pw here: spawn_fds passes fd numbers (no
    // dup); the child owns them now and slot_free_allocs closes them
    // when it exits — that close of the pipe write end is our EOF.

    // /dev/fb framed-write buffer: 10-byte header + up to a 16x16
    // RGB565 glyph payload (16*16*2 = 512) = 522 bytes.
    var frame: U8Array = U8Array(522u32);
    var buf:   U8Array = U8Array(64u32);
    // mode-5 glyph batch: 16-byte header + up to BATCH_CAP glyph-data bytes.
    g_batch = U8Array((16 + BATCH_CAP) as u32);

    // Landscape: rotate the ILI9488 framebuffer so the 480-pixel edge
    // runs along X. Without this MADCTL change the panel stays in its
    // power-on portrait orientation and pixel writes past x=319 get
    // clipped to nothing — text would render only in the left
    // half-screen and look like portrait.
    //
    // 0xE8 (MY|MX|MV|BGR) is the 90° rotation that also flips both
    // axes, i.e. text reads with the board's USB-C side at the top.
    // Use 0x28 to flip the picture 180° on this board.
    if g_sw_scroll != 0 { fb_madctl(fb, frame, 0xE8); }

    // VRAM mode: the /dev/fb writes above already ran the kernel's ILI9488
    // bring-up + MADCTL. Now clear VRAM and hand the panel to the hardware
    // refresh engine — from here every fb_fill / glyph goes straight to VRAM
    // (no syscalls, no CPU-driven SPI) and the engine streams it in the bg.
    if g_vram_mode != 0 {
        vram_fill(0, 0, SCREEN_W, SCREEN_H, COLOR_CONTENT);
        poke32(VRAM_DIVREG, 0u32);
        poke32(VRAM_CTRL, 1u32);
        eputs_t("CONSOLE: VRAM engine enabled\n");
    }

    // Text mode: the fb_madctl above ran the kernel's ILI9488 bring-up +
    // landscape MADCTL. Now clear the cell grid and hand the panel to the hw
    // text_lcd char-gen engine — every character is a cell write from here.
    if g_text_mode != 0 {
        text_init();
        eputs_t("CONSOLE: text engine enabled\n");
    }

    // Paint the desktop. Landscape gets the Win95 chrome (desktop +
    // window + title + taskbar + Start button) and the content area
    // is sized to fit inside the window. Portrait clears the whole
    // panel to black. Text mode paints nothing here — the engine owns it.
    eputs_t("CONSOLE: before fb_fill (triggers lcd_init on first write)\n");
    if g_text_mode == 0 {
        if g_have_chrome != 0 {
            draw_chrome(fb, frame);
        } else {
            fb_fill(fb, frame, 0, 0, SCREEN_W, SCREEN_H, COLOR_CONTENT);
        }
    }
    eputs_t("CONSOLE: after fb_fill\n");
    // Initial cursor — sh will write the first prompt straight after
    // we enter the read loop, but the cursor sits at (0,0) until then.
    draw_cursor(fb, frame);
    eputs_t("CONSOLE: after draw_cursor\n");
    // At this point the LCD has been initialized + the background
    // cleared + the cursor painted. This is the earliest moment the
    // user sees something on the panel that says "the kernel is alive
    // and console is ready to render". Mark it so power-on → LCD
    // measurements are comparable across boot configurations.
    eputs_t("CONSOLE: LCD ready (background + cursor painted)\n");
    // The buf data area starts 4 bytes past the U8Array header. We pass
    // it raw to do_read (the syscall stub) instead of going through
    // libtc's sys_read — sys_read loops until the full requested count
    // is fulfilled, which would block forever on a slow pipe (sh's
    // initial 14-byte prompt vs. our 64-byte buffer).
    var buf_data: u32 = (buf as u32) + 4u32;
    // Poll-and-blink: do_read_nb returns -2 immediately when the pipe
    // is empty, so we sleep 250 ms and toggle the cursor between polls
    // instead of relying on a sibling task to write heartbeat bytes.
    // 250 ms × 2 toggles = ~2 Hz blink with at most one 250 ms latency
    // before sh output shows up on screen.
    var running: i32 = 1;
    var first_render: i32 = 1;
    // Adaptive poll pacing. sh output (e.g. neofetch) arrives in bursts
    // with sub-second compute gaps between them; a flat 250 ms idle sleep
    // slept through those gaps and roughly doubled the time to render a
    // screenful. So we poll fast right after activity to catch the next
    // burst, and only fall back to the 250 ms cursor-blink cadence once
    // the pipe has been quiet for POLL_FAST_MAX polls (~1.5 s).
    var g_idle_polls: i32 = 0;
    while running == 1 {
        var r: i32 = do_read_nb(pr, buf_data, 64);
        if r > 0 {
            g_idle_polls = 0;
            erase_cursor(fb, frame);
            var i: i32 = 0;
            while i < r {
                render(fb, frame, peek8(buf_data + (i as u32)) as i32);
                i = i + 1;
            }
            flush_batch(fb);   // paint any glyphs still queued from this batch
            // Honor ?47h / ?47l received in this batch.
            if g_fb_close_req != 0 {
                if fb >= 0 { do_close(fb); fb = 0 - 1; }
                g_fb_close_req = 0;
            }
            if g_fb_open_req != 0 {
                if fb < 0 { fb = do_openat(0, "/dev/fb", 1); }
                g_fb_open_req = 0;
                if fb >= 0 { repaint_all(fb, frame); }
            }
            draw_cursor(fb, frame);
            draw_clock(fb, frame);
            // One-shot trace: the moment sh's first byte (= part of
            // "SH: ready\n" or "sh$ ") has been rasterised to /dev/fb.
            // Pairs with sh.tc's "SH: first prompt" trace for a full
            // pipe-to-glass round trip number.
            if first_render == 1 {
                eputs_t("CONSOLE: first sh output rendered\n");
                first_render = 0;
            }
        } else if r == 0 {
            // Writer closed → EOF, time to wind down.
            running = 0;
        } else if r == (0 - 2) {
            g_idle_polls = g_idle_polls + 1;
            if g_idle_polls < 500 {
                // Recently active: more burst output is likely on its way.
                // Poll quickly with no cursor/clock work so we render it
                // promptly instead of sleeping 250 ms through the gap.
                do_nanosleep(3);
            } else {
                // Quiet for a while — behave as an idle prompt: blink the
                // cursor and refresh the clock at ~2 Hz.
                if g_cur_on != 0 {
                    erase_cursor(fb, frame);
                } else {
                    draw_cursor(fb, frame);
                }
                draw_clock(fb, frame);
                do_nanosleep(250);
            }
        } else {
            // Any other negative is a hard error.
            running = 0;
        }
    }

    do_wait(slot);
    do_close(pr);
    do_close(fb);
    delete(frame);
    delete(buf);
    if (g_grid as u32) != 0u32 { delete(g_grid); }
    if (g_grid_prev as u32) != 0u32 { delete(g_grid_prev); }
    if (g_csi_p as u32) != 0u32 { delete(g_csi_p); }
    eputs("CONSOLE: exit\n");
    return 0;
}
