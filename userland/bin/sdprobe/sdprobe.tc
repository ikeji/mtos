// sdprobe.tc — RP2350 bit-bang SD card bring-up probe (2026-05-21 board).
//
// Drives the same CMD0 → CMD8 → ACMD41 → CMD58 → CMD17 sequence the
// production block_sd.tc uses, but with extra diagnostic prints at
// each step so we can localise where bring-up dies on a freshly-wired
// board. Bit-bang because the new board's SD signal labels do not
// match RP2350 SPI0 funcsel pin order (see docs/pico2_hardware.md).
//
// Wiring:
//   GP34 → MISO   (input, IE + PUE)
//   GP35 → CS     (manual SIO output, idle high)
//   GP36 → SCK    (output, idle low — SPI mode 0)
//   GP37 → MOSI   (output)
//   3V3  → module 3V3 (or 5V → module 5V)
//   GND  → GND
//
// Diagnostics emitted (in order):
//   • MISO idle level right after pad init — should be HIGH if PUE
//     works and / or the card pulls MISO high in standby
//   • CMD0 R1 (expect 0x01 = idle)
//   • CMD8 R1 + 4-byte echo (expect R1=0x01 echo[2..3]=01 AA for v2)
//   • ACMD41 iteration count + final R1 (expect 0x00)
//   • CMD58 OCR (expect bit 30 / CCS = 1 for SDHC)
//   • CMD17 first 16 bytes + boot signature at [510..511]

import "../../lib/libtc/libtc.tc";

// ----- MMIO -----
var IO_BANK0_BASE:  u32 = 0x40028000u32;
var PADS_BANK0_CLR: u32 = 0x4003B000u32;
var PADS_BANK0_SET: u32 = 0x4003A000u32;
var SIO_BASE:       u32 = 0xD0000000u32;

// High-GPIO SIO offsets (GP32-47).
var HI_IN:      u32 = 0x008u32;
var HI_OUT_SET: u32 = 0x01Cu32;
var HI_OUT_CLR: u32 = 0x024u32;
var HI_OE_SET:  u32 = 0x03Cu32;

// Per-GPIO masks (n - 32).
var MISO_MASK: u32 = 0x04u32;   // GP34
var CS_MASK:   u32 = 0x08u32;   // GP35
var SCK_MASK:  u32 = 0x10u32;   // GP36
var MOSI_MASK: u32 = 0x20u32;   // GP37

// IO_BANK0 GPIO_CTRL offsets.
var CTRL_MISO: u32 = 0x114u32;  // GP34
var CTRL_CS:   u32 = 0x11Cu32;  // GP35
var CTRL_SCK:  u32 = 0x124u32;  // GP36
var CTRL_MOSI: u32 = 0x12Cu32;  // GP37

// PADS_BANK0 offsets.
var PAD_MISO: u32 = 0x08Cu32;
var PAD_CS:   u32 = 0x090u32;
var PAD_SCK:  u32 = 0x094u32;
var PAD_MOSI: u32 = 0x098u32;

// Bit-bang clock half-period. During init we need 100-400 kHz; after
// init, faster is fine. Caller flips g_clk_delay.
var g_clk_delay: i32 = 80;   // ~init speed

// ----- helpers -----

fn print_hex2(v: u32) -> void {
    var hi: u32 = (v >> 4u32) & 0xFu32;
    var lo: u32 = v & 0xFu32;
    var c1: u8;
    var c2: u8;
    if hi < 10u32 { c1 = ('0' as u32 + hi) as u8; }
    else          { c1 = ('A' as u32 + hi - 10u32) as u8; }
    if lo < 10u32 { c2 = ('0' as u32 + lo) as u8; }
    else          { c2 = ('A' as u32 + lo - 10u32) as u8; }
    putchar(c1);
    putchar(c2);
    return;
}

fn print_u32hex(v: u32) -> void {
    print_hex2((v >> 24u32) & 0xFFu32);
    print_hex2((v >> 16u32) & 0xFFu32);
    print_hex2((v >>  8u32) & 0xFFu32);
    print_hex2( v           & 0xFFu32);
    return;
}

fn clk_delay() -> void {
    var i: i32 = 0;
    while i < g_clk_delay { i = i + 1; }
    return;
}

fn sck_high() -> void { poke32(SIO_BASE + HI_OUT_SET, SCK_MASK); return; }
fn sck_low()  -> void { poke32(SIO_BASE + HI_OUT_CLR, SCK_MASK); return; }
fn mosi_high() -> void { poke32(SIO_BASE + HI_OUT_SET, MOSI_MASK); return; }
fn mosi_low()  -> void { poke32(SIO_BASE + HI_OUT_CLR, MOSI_MASK); return; }
fn cs_low()  -> void { poke32(SIO_BASE + HI_OUT_CLR, CS_MASK); return; }
fn cs_high() -> void { poke32(SIO_BASE + HI_OUT_SET, CS_MASK); return; }
fn miso_read() -> u32 { return peek32(SIO_BASE + HI_IN) & MISO_MASK; }

// Bit-bang one byte MSB-first, SPI mode 0.
fn spi_xfer(b: u8) -> u8 {
    var out: u32 = b as u32;
    var rx: u32 = 0u32;
    var i: i32 = 0;
    while i < 8 {
        if (out & 0x80u32) == 0u32 { mosi_low(); } else { mosi_high(); }
        out = out << 1u32;
        clk_delay();
        sck_high();
        rx = rx << 1u32;
        if miso_read() != 0u32 { rx = rx | 1u32; }
        clk_delay();
        sck_low();
        i = i + 1;
    }
    return (rx & 0xFFu32) as u8;
}

fn cs_high_clk() -> void {
    cs_high();
    spi_xfer(0xFFu8);
    return;
}

fn send_cmd(cmd: i32, arg: u32, crc: u8) -> u8 {
    cs_low();
    spi_xfer(0xFFu8);
    spi_xfer((0x40 | cmd) as u8);
    spi_xfer((arg >> 24u32) as u8);
    spi_xfer((arg >> 16u32) as u8);
    spi_xfer((arg >>  8u32) as u8);
    spi_xfer( arg            as u8);
    spi_xfer(crc);
    var r1: u8 = 0xFFu8;
    var i: i32 = 0;
    while i < 16 {
        r1 = spi_xfer(0xFFu8);
        if (r1 as u32 & 0x80u32) == 0u32 { break; }
        i = i + 1;
    }
    return r1;
}

fn busy_spin(n: i32) -> void {
    var i: i32 = 0;
    while i < n { i = i + 1; }
    return;
}

fn main() -> i32 {
    puts("\n=== sdprobe v4 (bit-bang, GP34-37): SD bring-up ===\n");

    // 1. Idle outputs: CS + MOSI high, SCK low.
    poke32(SIO_BASE + HI_OUT_SET, CS_MASK | MOSI_MASK);
    poke32(SIO_BASE + HI_OUT_CLR, SCK_MASK);

    // 2. Funcsel = 5 (SIOB_PROC) on all four pins.
    poke32(IO_BANK0_BASE + CTRL_MISO, 5u32);
    poke32(IO_BANK0_BASE + CTRL_CS,   5u32);
    poke32(IO_BANK0_BASE + CTRL_SCK,  5u32);
    poke32(IO_BANK0_BASE + CTRL_MOSI, 5u32);

    // 3. Pads: clear ISO + PDE on all four (PDE resets to 1 — both
    //    pulls would conflict if PUE were just set on top). Then
    //    set IE + PUE on MISO so the line idles high when undriven.
    poke32(PADS_BANK0_CLR + PAD_MISO, 0x104u32);   // ISO | PDE
    poke32(PADS_BANK0_CLR + PAD_CS,   0x104u32);
    poke32(PADS_BANK0_CLR + PAD_SCK,  0x104u32);
    poke32(PADS_BANK0_CLR + PAD_MOSI, 0x104u32);
    poke32(PADS_BANK0_SET + PAD_MISO, 0x48u32);    // IE | PUE

    // 4. OE: CS / SCK / MOSI as outputs.
    poke32(SIO_BASE + HI_OE_SET, CS_MASK | SCK_MASK | MOSI_MASK);

    // 5. Sanity probe — let MISO float for a moment, then read.
    //    With PUE on, no card / disconnected wiring should read HIGH.
    //    Card present + responding should also read HIGH at this point
    //    (cards leave DO high until CMD0). Reads LOW only if the line
    //    is shorted to GND or the PUE+ external pull-up is missing.
    busy_spin(1000);
    var miso0: u32 = miso_read();
    puts("MISO idle = ");
    if miso0 != 0u32 { puts("HIGH (good)\n"); }
    else             { puts("LOW (no pull-up? short to GND? check wiring/power)\n"); }

    // 6. 80 init clocks with CS=H, MOSI=H. Bit-bang clock rate is set
    //    by g_clk_delay; the default 80-iter delay puts each SCK
    //    half-period around a few microseconds — well within the
    //    100-400 kHz SD spec window even with TC overhead.
    cs_high();
    var ic: i32 = 0;
    while ic < 10 { spi_xfer(0xFFu8); ic = ic + 1; }

    // 7. CMD0: enter idle.
    var r1: u8 = 0xFFu8;
    var attempt: i32 = 0;
    while attempt < 5 {
        r1 = send_cmd(0, 0u32, 0x95u8);
        cs_high_clk();
        if r1 == 0x01u8 { break; }
        busy_spin(2000);
        attempt = attempt + 1;
    }
    puts("CMD0 R1 = 0x"); print_hex2(r1 as u32);
    if r1 == 0x01u8 { puts(" (idle OK)\n"); }
    else if r1 == 0xFFu8 {
        puts(" (no response — card absent / power / wiring)\n");
        return 1;
    }
    else {
        puts(" (FAIL — unexpected R1)\n");
        return 1;
    }

    // 8. CMD8: voltage check / v2 detect.
    cs_low();
    spi_xfer(0xFFu8);
    spi_xfer(0x48u8);
    spi_xfer(0x00u8); spi_xfer(0x00u8); spi_xfer(0x01u8); spi_xfer(0xAAu8);
    spi_xfer(0x87u8);
    var cmd8_r1: u8 = 0xFFu8;
    var k: i32 = 0;
    while k < 16 {
        cmd8_r1 = spi_xfer(0xFFu8);
        if (cmd8_r1 as u32 & 0x80u32) == 0u32 { break; }
        k = k + 1;
    }
    var e0: u8 = 0u8; var e1: u8 = 0u8; var e2: u8 = 0u8; var e3: u8 = 0u8;
    if cmd8_r1 != 0xFFu8 {
        e0 = spi_xfer(0xFFu8);
        e1 = spi_xfer(0xFFu8);
        e2 = spi_xfer(0xFFu8);
        e3 = spi_xfer(0xFFu8);
    }
    cs_high_clk();
    puts("CMD8 R1 = 0x"); print_hex2(cmd8_r1 as u32);
    puts(" echo = ");
    print_hex2(e0 as u32); putchar(' ' as u8);
    print_hex2(e1 as u32); putchar(' ' as u8);
    print_hex2(e2 as u32); putchar(' ' as u8);
    print_hex2(e3 as u32);
    putchar('\n' as u8);
    var v2: i32 = 0;
    if cmd8_r1 == 0x01u8 {
        if e2 == 0x01u8 {
            if e3 == 0xAAu8 { v2 = 1; }
        }
    }
    if v2 == 1 { puts("v2+ card (SDHC capable)\n"); }
    else       { puts("v1 card (SDSC) — or pattern mismatch\n"); }

    // 9. ACMD41 init loop (CMD55 + ACMD41).
    puts("ACMD41 init...\n");
    var inited: i32 = 0;
    var arg41: u32 = 0u32;
    if v2 == 1 { arg41 = 0x40000000u32; }
    var iter: i32 = 0;
    var last_r41: u8 = 0xFFu8;
    while iter < 1000 {
        var r55: u8 = send_cmd(55, 0u32, 0x65u8);
        cs_high_clk();
        last_r41 = send_cmd(41, arg41, 0x77u8);
        cs_high_clk();
        if last_r41 == 0x00u8 {
            inited = 1;
            puts("Card initialized after iter=0x");
            print_hex2(iter as u32);
            putchar('\n' as u8);
            break;
        }
        busy_spin(50000);
        iter = iter + 1;
    }
    if inited == 0 {
        puts("ACMD41 timeout, last R1 = 0x");
        print_hex2(last_r41 as u32);
        putchar('\n' as u8);
        return 1;
    }

    // 9b. CMD59 disable CRC.
    send_cmd(59, 0u32, 0x91u8);
    cs_high_clk();

    // 10. CMD58: read OCR, detect SDHC.
    var sdhc: i32 = 0;
    if v2 == 1 {
        cs_low();
        spi_xfer(0xFFu8);
        spi_xfer(0x7Au8);
        spi_xfer(0u8); spi_xfer(0u8); spi_xfer(0u8); spi_xfer(0u8);
        spi_xfer(0xFDu8);
        var r58: u8 = 0xFFu8;
        var m: i32 = 0;
        while m < 16 {
            r58 = spi_xfer(0xFFu8);
            if (r58 as u32 & 0x80u32) == 0u32 { break; }
            m = m + 1;
        }
        var o0: u8 = spi_xfer(0xFFu8);
        var o1: u8 = spi_xfer(0xFFu8);
        var o2: u8 = spi_xfer(0xFFu8);
        var o3: u8 = spi_xfer(0xFFu8);
        cs_high_clk();
        if (o0 as u32 & 0x40u32) != 0u32 { sdhc = 1; }
        puts("CMD58 R1=0x"); print_hex2(r58 as u32);
        puts(" OCR=");
        print_hex2(o0 as u32); putchar(' ' as u8);
        print_hex2(o1 as u32); putchar(' ' as u8);
        print_hex2(o2 as u32); putchar(' ' as u8);
        print_hex2(o3 as u32);
        if sdhc == 1 { puts(" (SDHC)\n"); } else { puts(" (SDSC)\n"); }
    }

    // 11. Bump clock for the data phase. With g_clk_delay=0 the bit-
    //     bang loop runs as fast as TC can drive it — still under the
    //     25 MHz SD spec post-init ceiling because of TC overhead.
    g_clk_delay = 0;
    puts("clock bumped to bit-bang max\n");

    // 12. CMD17: read LBA 0.
    var r17: u8 = send_cmd(17, 0u32, 0xFFu8);
    puts("CMD17 R1=0x"); print_hex2(r17 as u32); putchar('\n' as u8);
    if r17 == 0x00u8 {
        var tok: u8 = 0xFFu8;
        var w: i32 = 0;
        while w < 100000 {
            tok = spi_xfer(0xFFu8);
            if tok != 0xFFu8 { break; }
            w = w + 1;
        }
        puts("data token = 0x"); print_hex2(tok as u32); putchar('\n' as u8);
        if tok == 0xFEu8 {
            var b510: u8 = 0u8; var b511: u8 = 0u8;
            var bb: i32 = 0;
            puts("first 16 bytes:");
            while bb < 512 {
                var v: u8 = spi_xfer(0xFFu8);
                if bb < 16 {
                    putchar(' ' as u8);
                    print_hex2(v as u32);
                }
                if bb == 510 { b510 = v; }
                if bb == 511 { b511 = v; }
                bb = bb + 1;
            }
            spi_xfer(0xFFu8); spi_xfer(0xFFu8);
            putchar('\n' as u8);
            puts("boot sig [510]=0x"); print_hex2(b510 as u32);
            puts(" [511]=0x"); print_hex2(b511 as u32);
            if b510 == 0x55u8 {
                if b511 == 0xAAu8 { puts(" OK\n"); }
                else              { puts(" (no sig)\n"); }
            } else { puts(" (no sig)\n"); }
        }
    }
    cs_high_clk();

    puts("=== bring-up complete ===\n");
    return 0;
}
