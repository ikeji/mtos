// fbtest.tc — /dev/fb bring-up exerciser.
//
// Opens /dev/fb and issues one fill (mode 1), one pixel blit (mode 0)
// and one vertical-scroll (mode 2) request. Each blit is a single
// sys_write so the framed header arrives in one devfs_write call.
// With the current UART-dump driver each request shows up as an
// "FB: ..." line on the UART (フェーズ9 S3 swaps in the SPI backend).

import "../../lib/libtc/libtc.tc";

const O_WRONLY: i32 = 1;

// Store a little-endian u16 at byte offset `pos`.
fn put_u16(b: U8Array, pos: i32, v: i32) -> void {
    set(b, pos,     (v & 0xFF) as u8);
    set(b, pos + 1, ((v >> 8) & 0xFF) as u8);
    return;
}

fn main() -> i32 {
    var fd: i32 = do_openat(0, "/dev/fb", O_WRONLY);
    if fd < 0 {
        puts("FBTEST: open failed\n");
        return 1;
    }

    // fill: mode 1, full screen, color RGB565 0xF800 (= 63488, red)
    var f1: U8Array = U8Array(12u32);
    put_u16(f1, 0, 0);   put_u16(f1, 2, 0);
    put_u16(f1, 4, 320); put_u16(f1, 6, 480);
    put_u16(f1, 8, 1);   put_u16(f1, 10, 63488);
    sys_write(fd, f1, 12);
    delete(f1);

    // blit: mode 0, an 8x16 region — 8*16*2 = 256 bytes of pixels
    var pxn: i32 = 8 * 16 * 2;
    var f2: U8Array = U8Array((10 + pxn) as u32);
    put_u16(f2, 0, 10); put_u16(f2, 2, 20);
    put_u16(f2, 4, 8);  put_u16(f2, 6, 16);
    put_u16(f2, 8, 0);
    var i: i32 = 0;
    while i < pxn {
        set(f2, 10 + i, 0u8);
        i = i + 1;
    }
    sys_write(fd, f2, 10 + pxn);
    delete(f2);

    // vscroll: mode 2, scroll start line = 16
    var f3: U8Array = U8Array(12u32);
    put_u16(f3, 0, 0); put_u16(f3, 2, 0);
    put_u16(f3, 4, 0); put_u16(f3, 6, 0);
    put_u16(f3, 8, 2); put_u16(f3, 10, 16);
    sys_write(fd, f3, 12);
    delete(f3);

    do_close(fd);
    puts("FBTEST: done\n");
    return 0;
}
