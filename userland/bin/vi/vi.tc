// vi.tc — minimal vi-style editor.
//
// Usage:  vi <path>    — opens <path> (creates empty buffer on
//                          O_CREAT miss so a new file just works).
//
// Modes:
//   Normal  — entered on start + on ESC
//   Insert  — entered by i / a / A / I / o / O; ESC exits
//   Cmdline — entered by ':'; Enter runs the command
//
// Normal-mode keys:
//   h j k l  — move cursor left / down / up / right
//   0 $      — line start / line end
//   x        — delete the char under cursor
//   dd       — delete current line  (two 'd' keys in a row)
//   gg / G   — jump to first / last line
//   ZZ       — write + quit (same as :wq)
//   i        — insert before cursor
//   I        — insert at line start
//   a        — append (insert after cursor)
//   A        — append at line end
//   o        — open a new line below and enter insert
//   O        — open a new line above and enter insert
//   u        — undo the last edit (single-level, toggles with redo)
//
// Insert-mode: any printable byte is inserted at cursor. Backspace
// deletes the previous byte. Tab is inserted literally. Enter inserts
// a newline. Ctrl+J enters TUT-code mode for Japanese input;
// ESC exits TUT mode back to insert mode.
//
// TUT-code: two-stroke input for kana and kanji (773 characters).
//   The status line shows the pending stroke(s): "INSERT TUT k",
//   "INSERT TUT kl" (voiced), "INSERT TUT tlt" (ぱ行).
//   Kana: consonant + vowel (e.g. RK=あ, EK=か, FL=ん)
//   Kanji: any two keys from 40-key layout (e.g. KF=一, JD=二)
//   Voiced: consonant+L+vowel (e.g. ELK=が), T+L+T+vowel=ぱ行
//
// Kana→kanji conversion (in TUT mode, docs/task/vi_kanji_conv.md):
//   Ctrl+J    — take the hiragana run before the cursor (up to 8
//               chars), look up its suffixes longest-first in the
//               embedded SKK dictionary and replace it with the first
//               candidate. Candidates of shorter readings follow, then
//               katakana: the whole reading, then each shorter suffix
//               (あんぱん → 版 アンパン ンパン パン ン). Verbs and
//               adjectives come from the okuri-ari part: the reading
//               is split into stem + okurigana and the stem is looked
//               up with the SKK consonant of the first okurigana kana
//               (よむ → よm → 読む, たかい → たかi → 高い).
//   Ctrl+J / Space while converting — next candidate (wraps back to
//               the plain reading)
//   Backspace while converting — restore the reading
//   any other key — keep the shown candidate, then act normally
//   u (normal mode) undoes the whole conversion.
//
// Cmdline-mode (after ':'):
//   w        — write buffer back to the file
//   q        — quit if no unsaved changes
//   q!       — force quit, discard changes
//   wq  x    — write + quit
//
// Screen rendering uses plain ANSI codes (ESC[2J, ESC[H, ESC[R;CH) so
// a raw serial terminal or a Debug-Probe CDC-ACM viewer that passes
// bytes unchanged can display the editor. qemu with `-nographic
// -serial mon:stdio` + `stty raw` on the host works; so does a
// minicom session on pico2 / debug-probe. Inside `make run`'s default
// line-buffered stdio the cursor won't update per-keystroke — that's
// a terminal limitation, not a vi bug.

import "../../lib/libtc/libtc.tc";

fn _tut_grid_addr() -> u32;        // tut_data.s: 40×40 kanji/kana grid
fn vidict_addr() -> u32;           // vidict_inc.s: kana→kanji dictionary blob
fn vidict_size_value() -> i32;     // its byte size (empty dictionary = header only)
fn peek8(addr: u32) -> u8;         // task_crt0.s builtins
fn peek16(addr: u32) -> u16;
fn peek32(addr: u32) -> u32;

const BUF_CAP: i32 = 16384;      // max file size in bytes
const CMD_CAP: i32 = 128;        // max cmdline length
const IN_CAP: i32 = 8;           // bytes per stdin read (an arrow key is 3)

// Raw read syscall (task_crt0.s): returns what is available now, up to
// len, blocking only while nothing is. runtime's sys_read keeps reading
// until len bytes arrived, which would turn a batch read into "wait for
// 8 keystrokes".
fn do_read(fd: i32, buf: u32, len: i32) -> i32;

// Screen geometry: we don't query the terminal (would require reading
// the ESC[6n response back through stdin), so default to the classic
// 80x24 and let the ROWS / COLS env vars (docs/task/proc_env.md —
// /bin/console sets COLS=56 / ROWS=15 for `console -l` and the sh it
// spawns passes them on) override at startup — same scheme as sl. The
// UART shell has no env so it stays 80x24. The bottom row is kept for
// the status line.
var g_screen_rows: i32 = 24;
var g_text_rows:   i32 = 23;    // g_screen_rows - 1 (status line)
// Display columns emitted per line; the rest of a longer line is cut
// off (no soft wrap) so each buffer line costs exactly one screen row
// and the row bookkeeping above stays true. 80 on a UART terminal,
// which wraps lazily (a full 80-column line + CRLF is one row). The
// LCD console wraps eagerly — the COLS-th glyph already moves to the
// next row — so with env COLS=N we print at most N-1 columns.
var g_print_cols: i32 = 80;

// ===== global editor state =====

var g_buf: U8Array = 0 as U8Array;   // file content
var g_len: i32 = 0;                  // bytes currently in g_buf
var g_cur: i32 = 0;                  // cursor byte offset [0..g_len]
var g_mode: i32 = 0;                 // 0=normal, 1=insert, 2=cmdline
var g_path: U8Array = 0 as U8Array;  // NUL-terminated file path
var g_path_len: i32 = 0;
var g_modified: i32 = 0;
var g_running: i32 = 1;
var g_cmdbuf: U8Array = 0 as U8Array;
var g_cmdlen: i32 = 0;
var g_msg: U8Array = 0 as U8Array;   // status line (NUL-terminated)
var g_msg_len: i32 = 0;
var g_pending_d: i32 = 0;            // first 'd' of 'dd' seen
var g_pending_g: i32 = 0;            // first 'g' of 'gg' seen
var g_pending_Z: i32 = 0;            // first 'Z' of 'ZZ' seen

// 1-based logical row of the first visible line (vertical scroll).
// scroll_to_cursor() adjusts this before each render so g_cur's row
// is always on screen.
var g_top_line: i32 = 1;

// Single-level undo (classic vi, not vim's tree): save_undo snapshots
// the full buffer right before a mutation, and u swaps g_buf <->
// g_undo_buf so pressing u twice restores the pre-undo state.
var g_undo_buf:   U8Array = 0 as U8Array;
var g_undo_len:   i32 = 0;
var g_undo_cur:   i32 = 0;
var g_undo_valid: i32 = 0;

// TUT-code input state: 0=off, 1=waiting for first key,
// 2=got first key, 3=voiced (after L), 4=semi-voiced (T+L+T)
var g_tut: i32 = 0;
var g_tut_k1: i32 = 0;              // first key position (0-39)
const TUT_KEYS: StringLiteral = "1234567890qwertyuiopasdfghjkl;zxcvbnm,./";  // position → key
var g_tut_kmap: U8Array = 0 as U8Array;  // ASCII→key position+1 (128 bytes)
var g_tut_vo: U8Array = 0 as U8Array;    // voiced/small table (50 bytes)

// Kana→kanji conversion state. The dictionary (vidict.dat, generated
// from SKK-JISYO.M by userland/scripts/genvidict.py, layout documented
// there) sits in .rodata and is read in place with peek8/16/32 — on
// pico2 it stays in flash, nothing is copied into the arena.
const CONV_MAX_READ: i32 = 8;     // hiragana codepoints scanned back from the cursor
const CONV_MAX_CANDS: i32 = 48;   // candidate list cap (dictionary hits + katakana)
const VD_HEADER: i32 = 12;        // magic, n_entries, total_bytes; then u32 bucket[97]
const VD_BUCKETS: i32 = 96;       // one bucket per first codepoint U+3041..U+30A0

var g_conv_n: i32 = 0;            // candidates in the list, 0 = not converting
var g_conv_i: i32 = 0;            // current candidate, -1 = plain reading shown
var g_conv_start: i32 = 0;        // byte offset of the replaced region (it ends at g_cur)
var g_conv_rn: i32 = 0;           // reading length in codepoints
var g_conv_rcp: I32Array = 0 as I32Array;   // reading codepoints [CONV_MAX_READ]
var g_cand_addr: U32Array = 0 as U32Array;  // dictionary entry address, 0 = katakana
var g_cand_ci: I32Array = 0 as I32Array;    // candidate index inside that entry
var g_cand_rl: I32Array = 0 as I32Array;    // trailing reading codepoints it replaces
var g_cand_ok: I32Array = 0 as I32Array;    // of which okurigana kept after the kanji (0 = okuri-nasi)

// ===== terminal helpers =====

// (putchar, print moved to libtc/libtc.tc; emit_int / putc renamed.)
fn puts_n(buf: U8Array, n: i32) -> void {
    if n > 0 { sys_write(1, buf, n); }
    return;
}

// ===== UTF-8 helpers =====

// Byte count for a UTF-8 lead byte (1–4).
fn utf8_len(c: u8) -> i32 {
    if c < 128u8 { return 1; }
    if c < 0xC0u8 { return 1; }   // continuation byte — treat as 1
    if c < 0xE0u8 { return 2; }
    if c < 0xF0u8 { return 3; }
    return 4;
}

// True if c is a UTF-8 continuation byte (10xxxxxx).
fn is_cont(c: u8) -> bool {
    return c >= 0x80u8 && c < 0xC0u8;
}

// Decode a UTF-8 codepoint starting at g_buf[off].
fn utf8_decode_at(off: i32) -> i32 {
    var c0: i32 = get(g_buf, off) as i32;
    if c0 < 128 { return c0; }
    var n: i32 = utf8_len(c0 as u8);
    if off + n > g_len { return 0xFFFD; }  // truncated
    if n == 2 {
        return ((c0 & 0x1F) << 6)
             | (get(g_buf, off + 1) as i32 & 0x3F);
    }
    if n == 3 {
        return ((c0 & 0x0F) << 12)
             | ((get(g_buf, off + 1) as i32 & 0x3F) << 6)
             | (get(g_buf, off + 2) as i32 & 0x3F);
    }
    return ((c0 & 0x07) << 18)
         | ((get(g_buf, off + 1) as i32 & 0x3F) << 12)
         | ((get(g_buf, off + 2) as i32 & 0x3F) << 6)
         | (get(g_buf, off + 3) as i32 & 0x3F);
}

// Display width of a Unicode codepoint (1 or 2).
fn char_width(cp: i32) -> i32 {
    if cp >= 0x1100 && cp <= 0x115F { return 2; }
    if cp >= 0x2E80 && cp <= 0x9FFF { return 2; }
    if cp >= 0xF900 && cp <= 0xFAFF { return 2; }
    if cp >= 0xFE10 && cp <= 0xFE6F { return 2; }
    if cp >= 0xFF01 && cp <= 0xFF60 { return 2; }
    if cp >= 0xFFE0 && cp <= 0xFFE6 { return 2; }
    return 1;
}

// Display columns from g_buf[from] to g_buf[to] (same line, 0-based).
fn display_col(from: i32, to: i32) -> i32 {
    var col: i32 = 0;
    var i: i32 = from;
    while i < to && i < g_len {
        var c: u8 = get(g_buf, i);
        if c == 10u8 { return col; }
        if !is_cont(c) {
            col = col + char_width(utf8_decode_at(i));
        }
        i = i + 1;
    }
    return col;
}

// Find byte offset in line starting at ls for target display column.
fn byte_at_dcol(ls: i32, target: i32) -> i32 {
    var col: i32 = 0;
    var i: i32 = ls;
    while i < g_len && get(g_buf, i) != 10u8 {
        var c: u8 = get(g_buf, i);
        if !is_cont(c) {
            var w: i32 = char_width(utf8_decode_at(i));
            if col + w > target { return i; }
            col = col + w;
        }
        i = i + 1;
    }
    return i;
}

// Clear screen + home cursor. TC string literals don't interpret
// \xHH escapes, so we emit the ESC bytes raw (ESC [ 2 J ESC [ H).
fn clear_screen() -> void {
    putchar(27u8); putchar('[' as u8); putchar('2' as u8); putchar('J' as u8);
    putchar(27u8); putchar('[' as u8); putchar('H' as u8);
    return;
}

// Move cursor to row (1-based), col (1-based).
fn goto_xy(row: i32, col: i32) -> void {
    putchar(27u8);                      // ESC
    putchar('[' as u8);
    print(row);
    putchar(';' as u8);
    print(col);
    putchar('H' as u8);
    return;
}

// ===== buffer navigation =====

// Find the byte offset of the start of the line containing `off`.
fn line_start_at(off: i32) -> i32 {
    var i: i32 = off;
    while i > 0 && get(g_buf, i - 1) != 10u8 { i = i - 1; }
    return i;
}

// Find the byte offset of the end of the line (exclusive of the LF).
fn line_end_at(off: i32) -> i32 {
    var i: i32 = off;
    while i < g_len && get(g_buf, i) != 10u8 { i = i + 1; }
    return i;
}

// Byte offset of the start of the 1-based logical line `target`.
// target <= 1 returns 0; past-last returns g_len.
fn line_start_of(target: i32) -> i32 {
    if target <= 1 { return 0; }
    var row: i32 = 1;
    var i: i32 = 0;
    while i < g_len {
        if get(g_buf, i) == 10u8 {
            row = row + 1;
            if row == target { return i + 1; }
        }
        i = i + 1;
    }
    return g_len;
}

// 1-based logical row of byte offset `off`.
fn row_of(off: i32) -> i32 {
    var row: i32 = 1;
    var i: i32 = 0;
    while i < off {
        if get(g_buf, i) == 10u8 { row = row + 1; }
        i = i + 1;
    }
    return row;
}

// Adjust g_top_line so g_cur is inside the visible [top, top+g_text_rows-1]
// window. Called at the top of render().
fn scroll_to_cursor() -> void {
    var cur_row: i32 = row_of(g_cur);
    if cur_row < g_top_line { g_top_line = cur_row; }
    if cur_row >= g_top_line + g_text_rows {
        g_top_line = cur_row - g_text_rows + 1;
    }
    if g_top_line < 1 { g_top_line = 1; }
    return;
}

// Row + col (both 1-based) for a given byte offset.
// col counts display columns (CJK = 2, ASCII = 1).
fn row_col(off: i32, out_row_col: U8Array) -> void {
    var row: i32 = 1;
    var col: i32 = 1;
    var i: i32 = 0;
    while i < off {
        var c: u8 = get(g_buf, i);
        if c == 10u8 {
            row = row + 1;
            col = 1;
        } else if !is_cont(c) {
            col = col + char_width(utf8_decode_at(i));
        }
        i = i + 1;
    }
    // Pack: bytes 0..3 = row (u32 LE), 4..7 = col.
    set(out_row_col, 0, (row & 0xff) as u8);
    set(out_row_col, 1, ((row >> 8) & 0xff) as u8);
    set(out_row_col, 2, ((row >> 16) & 0xff) as u8);
    set(out_row_col, 3, ((row >> 24) & 0xff) as u8);
    set(out_row_col, 4, (col & 0xff) as u8);
    set(out_row_col, 5, ((col >> 8) & 0xff) as u8);
    set(out_row_col, 6, ((col >> 16) & 0xff) as u8);
    set(out_row_col, 7, ((col >> 24) & 0xff) as u8);
    return;
}

// ===== editing primitives =====

// Snapshot the buffer into g_undo_buf so the next 'u' can restore it.
// Called once per edit unit (before 'x' / 'dd', on entering insert
// mode). Mutations *inside* insert mode don't re-snapshot — the
// insert-mode entry already captured the pre-edit state, so 'u' rolls
// the entire insert-mode session back as one unit.
fn save_undo() -> void {
    if g_undo_buf as u32 == 0u32 { return; }
    var i: i32 = 0;
    while i < g_len {
        set(g_undo_buf, i, get(g_buf, i));
        i = i + 1;
    }
    g_undo_len = g_len;
    g_undo_cur = g_cur;
    g_undo_valid = 1;
    return;
}

// Swap g_buf with g_undo_buf (and the len / cur tracking). The swap
// is a pointer shuffle rather than a byte copy, so redo via a second
// 'u' comes for free.
fn do_undo() -> void {
    if g_undo_valid == 0 {
        set_msg("Nothing to undo");
        return;
    }
    var tmp_buf: U8Array = g_buf;
    g_buf = g_undo_buf;
    g_undo_buf = tmp_buf;
    var tmp_len: i32 = g_len;   g_len = g_undo_len;   g_undo_len = tmp_len;
    var tmp_cur: i32 = g_cur;   g_cur = g_undo_cur;   g_undo_cur = tmp_cur;
    g_modified = 1;
    return;
}

// Insert one byte at g_cur. No-op at capacity.
fn insert_byte(c: u8) -> void {
    if g_len >= BUF_CAP { return; }
    var i: i32 = g_len;
    while i > g_cur {
        set(g_buf, i, get(g_buf, i - 1));
        i = i - 1;
    }
    set(g_buf, g_cur, c);
    g_len = g_len + 1;
    g_cur = g_cur + 1;
    g_modified = 1;
    return;
}

// Delete the character at g_cur (full UTF-8 sequence, no-op at end).
fn delete_byte_at_cur() -> void {
    if g_cur >= g_len { return; }
    var n: i32 = utf8_len(get(g_buf, g_cur));
    if g_cur + n > g_len { n = g_len - g_cur; }
    var i: i32 = g_cur;
    while i + n < g_len {
        set(g_buf, i, get(g_buf, i + n));
        i = i + 1;
    }
    g_len = g_len - n;
    g_modified = 1;
    return;
}

// Delete the character *before* the cursor (full UTF-8 sequence).
// Returns true if anything was deleted.
fn delete_byte_before_cur() -> bool {
    if g_cur == 0 { return false; }
    // Find start of previous character by skipping continuation bytes.
    var start: i32 = g_cur - 1;
    while start > 0 && is_cont(get(g_buf, start)) {
        start = start - 1;
    }
    var n: i32 = g_cur - start;
    var i: i32 = start;
    while i + n < g_len {
        set(g_buf, i, get(g_buf, i + n));
        i = i + 1;
    }
    g_len = g_len - n;
    g_cur = start;
    g_modified = 1;
    return true;
}

// Delete the entire line the cursor is on (including the trailing LF
// if one exists).
fn delete_line() -> void {
    var ls: i32 = line_start_at(g_cur);
    var le: i32 = line_end_at(ls);
    if le < g_len { le = le + 1; }   // include trailing '\n'
    var span: i32 = le - ls;
    if span == 0 { return; }
    var i: i32 = ls;
    while i + span < g_len {
        set(g_buf, i, get(g_buf, i + span));
        i = i + 1;
    }
    g_len = g_len - span;
    g_cur = ls;
    if g_cur > g_len { g_cur = g_len; }
    // Clamp to start of the next line (or EOF).
    g_modified = 1;
    return;
}

// ===== cursor motion =====

fn move_left() -> void {
    if g_cur == 0 { return; }
    if get(g_buf, g_cur - 1) == 10u8 { return; }
    // Skip back over continuation bytes to the lead byte.
    g_cur = g_cur - 1;
    while g_cur > 0 && is_cont(get(g_buf, g_cur)) {
        g_cur = g_cur - 1;
    }
    return;
}

fn move_right() -> void {
    if g_cur >= g_len { return; }
    if get(g_buf, g_cur) == 10u8 { return; }
    // Advance past the full UTF-8 character.
    var n: i32 = utf8_len(get(g_buf, g_cur));
    g_cur = g_cur + n;
    if g_cur > g_len { g_cur = g_len; }
    return;
}

fn move_up() -> void {
    var ls: i32 = line_start_at(g_cur);
    if ls == 0 { return; }
    var dcol: i32 = display_col(ls, g_cur);
    var prev_start: i32 = line_start_at(ls - 1);
    g_cur = byte_at_dcol(prev_start, dcol);
    return;
}

fn move_down() -> void {
    var ls: i32 = line_start_at(g_cur);
    var le: i32 = line_end_at(ls);
    if le >= g_len { return; }
    var dcol: i32 = display_col(ls, g_cur);
    var next_start: i32 = le + 1;
    g_cur = byte_at_dcol(next_start, dcol);
    return;
}

fn move_line_start() -> void {
    g_cur = line_start_at(g_cur);
    return;
}

fn move_line_end() -> void {
    g_cur = line_end_at(line_start_at(g_cur));
    return;
}

fn move_bof() -> void {
    g_cur = 0;
    return;
}

fn move_eof() -> void {
    g_cur = g_len;
    // Move to start of last line instead of past the final LF.
    if g_cur > 0 && get(g_buf, g_cur - 1) == 10u8 { g_cur = g_cur - 1; }
    g_cur = line_start_at(g_cur);
    return;
}

// ===== TUT-code input =====

fn tut_set5(tbl: U8Array, row: i32,
            a: i32, b: i32, c: i32, d: i32, e: i32) -> void {
    var base: i32 = row * 5;
    set(tbl, base, a as u8);
    set(tbl, base + 1, b as u8);
    set(tbl, base + 2, c as u8);
    set(tbl, base + 3, d as u8);
    set(tbl, base + 4, e as u8);
    return;
}

// Insert a Unicode codepoint as UTF-8 bytes.
fn insert_codepoint(cp: i32) -> void {
    if cp < 0x80 {
        insert_byte(cp as u8);
    } else if cp < 0x800 {
        insert_byte((0xC0 | (cp >> 6)) as u8);
        insert_byte((0x80 | (cp & 0x3F)) as u8);
    } else {
        insert_byte((0xE0 | (cp >> 12)) as u8);
        insert_byte((0x80 | ((cp >> 6) & 0x3F)) as u8);
        insert_byte((0x80 | (cp & 0x3F)) as u8);
    }
    return;
}

// --- Key position mapping and lookup ---

// Convert ASCII char to TUT key position (0-39), or -1 if invalid.
// Layout: 1234567890 qwertyuiop asdfghjkl; zxcvbnm,./
fn tut_keypos(c: u8) -> i32 {
    var ci: i32 = c as i32;
    if ci < 128 { return (get(g_tut_kmap, ci) as i32) - 1; }
    return -1;
}

// Map key position back to TUT consonant row (0-9), or -1.
fn tut_pos_to_row(pos: i32) -> i32 {
    if pos == 13 { return 0; }
    if pos == 12 { return 1; }
    if pos == 21 { return 2; }
    if pos == 22 { return 3; }
    if pos == 23 { return 4; }
    if pos == 14 { return 5; }
    if pos == 11 { return 6; }
    if pos == 10 { return 7; }
    if pos == 24 { return 8; }
    if pos == 20 { return 9; }
    return -1;
}

// Map key position to TUT vowel column (0-4), or -1.
fn tut_pos_to_col(pos: i32) -> i32 {
    if pos == 27 { return 0; }
    if pos == 17 { return 1; }
    if pos == 16 { return 2; }
    if pos == 25 { return 3; }
    if pos == 26 { return 4; }
    return -1;
}

// Look up the 40×40 grid in .rodata (tut_data.s). Returns codepoint or 0.
fn tut_grid_lookup(k1: i32, k2: i32) -> i32 {
    var off: u32 = ((k1 * 40 + k2) * 2) as u32;
    return peek16(_tut_grid_addr() + off) as i32;
}

fn tut_init() -> void {
    // Key position map (ASCII → pos+1, 0 = invalid)
    g_tut_kmap = U8Array(128);
    var keys: StringLiteral = TUT_KEYS;
    var i: i32 = 0;
    while i < 40 {
        set(g_tut_kmap, get(keys, i) as i32, (i + 1) as u8);
        i = i + 1;
    }

    // Kanji/kana grid is in .rodata (tut_data.s), no init needed.

    // Voiced/small kana table (for 3-stroke input via L prefix)
    g_tut_vo = U8Array(50);
    tut_set5(g_tut_vo, 0, 0x41,0x43,0x45,0x47,0x49); // R ぁ行 (small)
    tut_set5(g_tut_vo, 1, 0x4C,0x4E,0x50,0x52,0x54); // E が行
    tut_set5(g_tut_vo, 2, 0x56,0x58,0x5A,0x5C,0x5E); // S ざ行
    tut_set5(g_tut_vo, 3, 0x60,0x62,0x63,0x67,0x69); // D だ行 (u=っ)
    tut_set5(g_tut_vo, 4,    0,   0,   0,   0,   0); // F (none)
    tut_set5(g_tut_vo, 5, 0x70,0x73,0x76,0x79,0x7C); // T ば行
    tut_set5(g_tut_vo, 6,    0,   0,   0,   0,   0); // W (none)
    tut_set5(g_tut_vo, 7, 0x83,   0,0x85,   0,0x87); // Q ゃ行 (small)
    tut_set5(g_tut_vo, 8,    0,   0,   0,   0,   0); // G (none)
    tut_set5(g_tut_vo, 9, 0x8E,   0,   0,   0,   0); // A ゎ (small)
    return;
}

fn handle_tut(c: u8) -> void {
    // Conversion in progress: Ctrl+J / Space cycle, Backspace restores
    // the reading, anything else keeps the shown candidate and is then
    // handled as usual (so ESC still leaves TUT, a TUT key starts a
    // new stroke).
    if g_conv_n > 0 {
        if c == 10u8 || c == ' ' as u8 {
            var ni: i32 = g_conv_i + 1;
            if ni >= g_conv_n { ni = -1; }
            conv_apply(ni);
            return;
        }
        if c == 8u8 || c == 127u8 { conv_apply(-1); conv_commit(); return; }
        conv_commit();
    }
    // ESC: exit TUT mode, stay in insert mode
    if c == 27u8 { g_tut = 0; return; }
    // Ctrl+J: convert the hiragana before the cursor (a pending first
    // stroke is dropped).
    if c == 10u8 {
        g_tut = 1;
        if conv_build() { save_undo(); conv_apply(0); }
        else { set_msg("no kana before cursor"); }
        return;
    }
    // Backspace: delete previous character normally
    if c == 8u8 || c == 127u8 { delete_byte_before_cur(); return; }
    // Enter: insert newline
    if c == '\r' as u8 { insert_byte('\n' as u8); return; }

    if g_tut == 1 {
        // Waiting for first key — accept any key in the 40-key layout
        var pos: i32 = tut_keypos(c);
        if pos >= 0 { g_tut_k1 = pos; g_tut = 2; }
        return;
    }

    if g_tut == 2 {
        // Got first key, waiting for second key
        var p2: i32 = tut_keypos(c);
        if p2 < 0 { g_tut = 1; return; }
        // Look up the 2-stroke grid (kana + kanji)
        var cp: i32 = tut_grid_lookup(g_tut_k1, p2);
        if cp != 0 {
            insert_codepoint(cp);
            g_tut = 1;
            return;
        }
        // Grid miss: if second key is 'l' (pos 28), try voiced mode
        if p2 == 28 {
            var row: i32 = tut_pos_to_row(g_tut_k1);
            if row >= 0 { g_tut = 3; return; }
        }
        // Treat second key as new first key
        g_tut_k1 = p2;
        return;
    }

    if g_tut == 3 {
        // Consonant + L: voiced/small kana
        var row: i32 = tut_pos_to_row(g_tut_k1);
        // Semi-voiced: T(pos 14)+L then T → state 4
        if row == 5 && tut_keypos(c) == 14 {
            g_tut = 4;
            return;
        }
        var p2: i32 = tut_keypos(c);
        if p2 >= 0 {
            var col: i32 = tut_pos_to_col(p2);
            if col >= 0 {
                var off: i32 = get(g_tut_vo, row * 5 + col) as i32;
                if off != 0 { insert_codepoint(0x3000 + off); }
            }
        }
        g_tut = 1;
        return;
    }

    if g_tut == 4 {
        // T+L+T + vowel → ぱ行 (0x3071 + col*3)
        var p2: i32 = tut_keypos(c);
        if p2 >= 0 {
            var col: i32 = tut_pos_to_col(p2);
            if col >= 0 { insert_codepoint(0x3071 + col * 3); }
        }
        g_tut = 1;
        return;
    }

    return;
}

// ===== kana→kanji conversion =====

fn is_reading_cp(cp: i32) -> bool {
    return (cp >= 0x3041 && cp <= 0x3096) || cp == 0x30FC;
}

fn kata_cp(cp: i32) -> i32 {
    if cp >= 0x3041 && cp <= 0x3096 { return cp + 0x60; }
    return cp;
}

// Emit a codepoint to stdout as UTF-8 (BMP only, like insert_codepoint).
fn put_cp(cp: i32) -> void {
    if cp < 0x80 { putchar(cp as u8); }
    else if cp < 0x800 {
        putchar((0xC0 | (cp >> 6)) as u8);
        putchar((0x80 | (cp & 0x3F)) as u8);
    } else {
        putchar((0xE0 | (cp >> 12)) as u8);
        putchar((0x80 | ((cp >> 6) & 0x3F)) as u8);
        putchar((0x80 | (cp & 0x3F)) as u8);
    }
    return;
}

// Remove g_buf[a..b) and leave the cursor at a.
fn delete_range(a: i32, b: i32) -> void {
    var n: i32 = b - a;
    if n <= 0 { return; }
    var i: i32 = a;
    while i + n < g_len {
        set(g_buf, i, get(g_buf, i + n));
        i = i + 1;
    }
    g_len = g_len - n;
    g_cur = a;
    g_modified = 1;
    return;
}

// Scan back from the cursor over hiragana / ー, at most CONV_MAX_READ
// codepoints (a newline or any other character ends the run). Fills
// g_conv_start / g_conv_rn / g_conv_rcp.
fn conv_collect() -> void {
    var start: i32 = g_cur;
    var n: i32 = 0;
    var go: bool = true;
    while go && n < CONV_MAX_READ && start > 0 {
        var p: i32 = start - 1;
        while p > 0 && is_cont(get(g_buf, p)) { p = p - 1; }
        if is_reading_cp(utf8_decode_at(p)) {
            start = p;
            n = n + 1;
        } else {
            go = false;
        }
    }
    g_conv_start = start;
    g_conv_rn = n;
    var i: i32 = 0;
    var q: i32 = start;
    while i < n {
        set(g_conv_rcp, i, utf8_decode_at(q));
        q = q + utf8_len(get(g_buf, q));
        i = i + 1;
    }
    return;
}

// SKK okuri letter for the first okurigana kana: the consonant of its
// row (か行 k, が行 g, ... っ t, ん n), the vowel for あ行. 0 for ー and
// anything else. genvidict normalises SKK's c/j/f to t/z/h to match.
fn okuri_letter(cp: i32) -> i32 {
    if cp >= 0x3041 && cp <= 0x304A {          // ぁあぃいぅうぇえぉお
        var v: i32 = (cp - 0x3041) / 2;
        if v == 0 { return 'a' as i32; }
        if v == 1 { return 'i' as i32; }
        if v == 2 { return 'u' as i32; }
        if v == 3 { return 'e' as i32; }
        return 'o' as i32;
    }
    if cp >= 0x304B && cp <= 0x3054 {          // か..ご: k / g alternate
        if (cp - 0x304B) % 2 == 0 { return 'k' as i32; } else { return 'g' as i32; }
    }
    if cp >= 0x3055 && cp <= 0x305E {          // さ..ぞ: s / z
        if (cp - 0x3055) % 2 == 0 { return 's' as i32; } else { return 'z' as i32; }
    }
    if cp >= 0x305F && cp <= 0x3062 {          // た だ ち ぢ
        if (cp - 0x305F) % 2 == 0 { return 't' as i32; } else { return 'd' as i32; }
    }
    if cp == 0x3063 || cp == 0x3064 { return 't' as i32; }   // っ つ
    if cp == 0x3065 { return 'd' as i32; }                    // づ
    if cp >= 0x3066 && cp <= 0x3069 {          // て で と ど
        if (cp - 0x3066) % 2 == 0 { return 't' as i32; } else { return 'd' as i32; }
    }
    if cp >= 0x306A && cp <= 0x306E { return 'n' as i32; }   // な行
    if cp >= 0x306F && cp <= 0x307D {          // は..ぽ: h / b / p
        var r: i32 = (cp - 0x306F) % 3;
        if r == 0 { return 'h' as i32; }
        if r == 1 { return 'b' as i32; }
        return 'p' as i32;
    }
    if cp >= 0x307E && cp <= 0x3082 { return 'm' as i32; }   // ま行
    if cp >= 0x3083 && cp <= 0x3088 { return 'y' as i32; }   // ゃやゅゆょよ
    if cp >= 0x3089 && cp <= 0x308D { return 'r' as i32; }   // ら行
    if cp >= 0x308E && cp <= 0x3092 { return 'w' as i32; }   // ゎわゐゑを
    if cp == 0x3093 { return 'n' as i32; }                    // ん
    if cp == 0x3094 { return 'v' as i32; }                    // ゔ
    if cp == 0x3095 || cp == 0x3096 { return 'k' as i32; }   // ゕ ゖ
    return 0;
}

// Look up the reading g_conv_rcp[off..off+n) in the dictionary: pick
// the bucket of its first codepoint and walk the entries in it. With
// letter != 0 the okuri-ari entry "reading + letter" is looked up
// instead (its rlen is n + 1).
// Returns the entry address (rlen, ncand, reading, candidates) or 0.
fn dict_lookup(off: i32, n: i32, letter: i32) -> u32 {
    if vidict_size_value() < VD_HEADER + (VD_BUCKETS + 1) * 4 { return 0u32; }
    var base: u32 = vidict_addr();
    var b: i32 = get(g_conv_rcp, off) - 0x3041;
    if b < 0 || b >= VD_BUCKETS { return 0u32; }
    var p: u32 = base + peek32(base + ((VD_HEADER + b * 4) as u32));
    var end: u32 = base + peek32(base + ((VD_HEADER + (b + 1) * 4) as u32));
    while p < end {
        var rlen: i32 = peek8(p) as i32;
        var ncand: i32 = peek8(p + 1u32) as i32;
        var want: i32 = n;
        if letter != 0 { want = n + 1; }
        if rlen == want {
            var i: i32 = 0;
            while i < n
                && (peek16(p + ((2 + 2 * i) as u32)) as i32) == get(g_conv_rcp, off + i) {
                i = i + 1;
            }
            if i == n && (letter == 0 || (peek16(p + ((2 + 2 * n) as u32)) as i32) == letter) {
                return p;
            }
        }
        var q: u32 = p + ((2 + 2 * rlen) as u32);
        var c: i32 = 0;
        while c < ncand {
            q = q + ((2 + 2 * (peek8(q) as i32)) as u32);
            c = c + 1;
        }
        p = q;
    }
    return 0u32;
}

// Address of candidate ci (its clen byte) inside entry e.
fn cand_addr(e: u32, ci: i32) -> u32 {
    var q: u32 = e + ((2 + 2 * (peek8(e) as i32)) as u32);
    var c: i32 = 0;
    while c < ci {
        q = q + ((2 + 2 * (peek8(q) as i32)) as u32);
        c = c + 1;
    }
    return q;
}

fn conv_put(cp: i32, mode: i32) -> i32 {
    if mode == 0 { insert_codepoint(cp); }
    else if mode == 1 { put_cp(cp); }
    return char_width(cp);
}

// Walk candidate i (-1 = the plain reading): mode 0 inserts it at the
// cursor (including the untouched prefix of the reading when the
// candidate only covers a suffix), mode 1 prints the candidate text to
// stdout, mode 2 just measures. Returns the candidate's display width.
fn conv_walk(i: i32, mode: i32) -> i32 {
    var w: i32 = 0;
    var rl: i32 = g_conv_rn;
    var e: u32 = 0u32;
    var ci: i32 = 0;
    var ok: i32 = 0;
    if i >= 0 {
        rl = get(g_cand_rl, i);
        e = get(g_cand_addr, i);
        ci = get(g_cand_ci, i);
        ok = get(g_cand_ok, i);
    }
    var j: i32 = 0;
    if mode == 0 {
        while j < g_conv_rn - rl { insert_codepoint(get(g_conv_rcp, j)); j = j + 1; }
    }
    if e == 0u32 {
        // plain reading (i == -1) or the katakana candidate
        j = g_conv_rn - rl;
        while j < g_conv_rn {
            var cp: i32 = get(g_conv_rcp, j);
            if i >= 0 { cp = kata_cp(cp); }
            w = w + conv_put(cp, mode);
            j = j + 1;
        }
        return w;
    }
    var q: u32 = cand_addr(e, ci);
    var clen: i32 = peek8(q) as i32;
    j = 0;
    while j < clen {
        w = w + conv_put(peek16(q + ((2 + 2 * j) as u32)) as i32, mode);
        j = j + 1;
    }
    // okuri-ari: the okurigana the user typed follows the kanji
    j = g_conv_rn - ok;
    while j < g_conv_rn {
        w = w + conv_put(get(g_conv_rcp, j), mode);
        j = j + 1;
    }
    return w;
}

// Replace the region g_conv_start..g_cur with candidate i.
fn conv_apply(i: i32) -> void {
    delete_range(g_conv_start, g_cur);
    conv_walk(i, 0);
    g_conv_i = i;
    return;
}

fn conv_commit() -> void {
    g_conv_n = 0;
    g_conv_i = 0;
    return;
}

// Append the candidates of dictionary entry e (0 = none) to the list
// at n: each replaces the last rl reading codepoints, of which the
// last ok are okurigana kept after the kanji. Returns the new n.
fn conv_add(e: u32, rl: i32, ok: i32, n: i32) -> i32 {
    if e == 0u32 { return n; }
    var ncand: i32 = peek8(e + 1u32) as i32;
    var ci: i32 = 0;
    while ci < ncand && n < CONV_MAX_CANDS - g_conv_rn {
        set(g_cand_addr, n, e);
        set(g_cand_ci, n, ci);
        set(g_cand_rl, n, rl);
        set(g_cand_ok, n, ok);
        n = n + 1;
        ci = ci + 1;
    }
    return n;
}

// Build the candidate list for the hiragana before the cursor. For
// each suffix of the reading, longest first: the okuri-nasi entry of
// the whole suffix, then its stem + okurigana splits (shortest
// okurigana first: よむ → よm, かんじる → かんじr, かんz). Then
// katakana of the whole reading and of each shorter suffix (so あんパン
// is reachable from あんぱん even though the dictionary only knows
// ぱん = 版). False if there is no reading.
fn conv_build() -> bool {
    conv_collect();
    if g_conv_rn == 0 { return false; }
    var n: i32 = 0;
    var k: i32 = g_conv_rn;
    while k >= 1 {
        var off: i32 = g_conv_rn - k;
        n = conv_add(dict_lookup(off, k, 0), k, 0, n);
        var ok: i32 = 1;
        while ok < k {
            var letter: i32 = okuri_letter(get(g_conv_rcp, g_conv_rn - ok));
            if letter != 0 {
                n = conv_add(dict_lookup(off, k - ok, letter), k, ok, n);
            }
            ok = ok + 1;
        }
        k = k - 1;
    }
    // Katakana, longest suffix first; a suffix starting with ー is
    // skipped (ーメン from らーめん is never wanted).
    k = g_conv_rn;
    while k >= 1 {
        if get(g_conv_rcp, g_conv_rn - k) != 0x30FC {
            set(g_cand_addr, n, 0u32);
            set(g_cand_ci, n, 0);
            set(g_cand_rl, n, k);
            set(g_cand_ok, n, 0);
            n = n + 1;
        }
        k = k - 1;
    }
    g_conv_n = n;
    return true;
}

// Status-line view of the candidates: "2/5 [感じ] 幹事 監事 …" starting
// at the current one, cut to what fits in g_print_cols after the
// 17-column "-- INSERT TUT -- " prefix.
fn conv_status() -> void {
    var budget: i32 = g_print_cols - 17 - 6;
    print(g_conv_i + 1);
    putchar('/' as u8);
    print(g_conv_n);
    putchar(' ' as u8);
    var j: i32 = g_conv_i;
    if j < 0 { j = 0; }
    var go: bool = true;
    while go && j < g_conv_n {
        var w: i32 = conv_walk(j, 2) + 3;
        if w > budget {
            go = false;
        } else {
            if j == g_conv_i { putchar('[' as u8); } else { putchar(' ' as u8); }
            conv_walk(j, 1);
            if j == g_conv_i { putchar(']' as u8); } else { putchar(' ' as u8); }
            budget = budget - w;
            j = j + 1;
        }
    }
    return;
}

// ===== file I/O =====

fn set_msg(s: StringLiteral) -> void {
    if g_msg as u32 != 0u32 { delete(g_msg); }
    var sl: i32 = len(s);
    g_msg = U8Array((sl + 1) as u32);
    var i: i32 = 0;
    while i < sl {
        set(g_msg, i, get(s, i));
        i = i + 1;
    }
    set(g_msg, sl, 0u8);
    g_msg_len = sl;
    return;
}

fn load_file() -> void {
    var fd: i32 = do_openat(0, g_path as String, 0);
    if fd < 0 {
        g_len = 0;
        set_msg("[new file]");
        return;
    }
    var n: i32 = sys_read(fd, g_buf, BUF_CAP);
    if n < 0 { do_close(fd); g_len = 0; return; }
    g_len = n;
    // If we filled the buffer, the file may be larger. Try to read one
    // more byte: >0 means truncation, 0 means the file fit exactly.
    if n == BUF_CAP {
        var probe: U8Array = U8Array(1u32);
        var extra: i32 = sys_read(fd, probe, 1);
        delete(probe);
        if extra > 0 {
            set_msg("[read, truncated: file exceeds 16KB]");
        } else {
            set_msg("[read]");
        }
    } else {
        set_msg("[read]");
    }
    do_close(fd);
    return;
}

// O_WRONLY | O_CREAT | O_TRUNC — tmpfs opens these correctly today.
// Returns true on success, false on failure.
fn save_file() -> bool {
    var flags: i32 = 1 | 0x40 | 0x200;
    var fd: i32 = do_openat(0, g_path as String, flags);
    if fd < 0 {
        set_msg("write failed: open");
        return false;
    }
    var n: i32 = sys_write(fd, g_buf, g_len);
    do_close(fd);
    if n < g_len {
        set_msg("write failed: short write");
        return false;
    }
    g_modified = 0;
    set_msg("[written]");
    return true;
}

// ===== rendering =====

// Write the lines in g_buf[start..end) to stdout one byte at a time
// (sys_write has no offset argument, so a per-byte loop beats an
// intermediate copy), cutting each line at g_print_cols display
// columns. A wide (CJK) glyph that would straddle the cut is dropped
// too. Returns the number of lines written, counting a final
// unterminated line; every line ends with CRLF on screen.
fn write_lines(start: i32, end: i32) -> i32 {
    var rows: i32 = 0;
    var col: i32 = 0;
    var i: i32 = start;
    while i < end {
        var c: u8 = get(g_buf, i);
        if c == 10u8 {
            putchar(13u8); putchar(10u8);
            rows = rows + 1;
            col = 0;
            i = i + 1;
        } else {
            var n: i32 = utf8_len(c);
            if i + n > end { n = end - i; }
            var w: i32 = char_width(utf8_decode_at(i));
            if col + w <= g_print_cols {
                var k: i32 = 0;
                while k < n { putchar(get(g_buf, i + k)); k = k + 1; }
                col = col + w;
            }
            i = i + n;
        }
    }
    if end > start && get(g_buf, end - 1) != 10u8 {
        putchar(13u8); putchar(10u8);
        rows = rows + 1;
    }
    return rows;
}

fn render() -> void {
    clear_screen();
    scroll_to_cursor();

    // Visible byte range: lines [g_top_line .. g_top_line + g_text_rows).
    var vstart: i32 = line_start_of(g_top_line);
    var vend:   i32 = line_start_of(g_top_line + g_text_rows);
    var visible_rows: i32 = write_lines(vstart, vend);

    // Pad to status line: if the visible region ended before filling
    // g_text_rows (short file), emit LFs so the status line lands on the
    // bottom row and cursor positioning stays predictable.
    while visible_rows < g_text_rows {
        putchar(13u8); putchar(10u8);
        visible_rows = visible_rows + 1;
    }

    // Status line on row g_screen_rows.
    puts("-- ");
    if g_mode == 1 {
        if g_tut > 0 {
            puts("INSERT TUT");
            // pending strokes: "k" (first key), "kl" (voiced), "tlt" (ぱ行)
            if g_tut >= 2 { putchar(' ' as u8); putchar(get(TUT_KEYS, g_tut_k1)); }
            if g_tut >= 3 { putchar('l' as u8); }
            if g_tut == 4 { putchar('t' as u8); }
        }
        else { puts("INSERT"); }
    }
    else if g_mode == 2 {
        puts(":");
        if g_cmdlen > 0 { puts_n(g_cmdbuf, g_cmdlen); }
    }
    else { puts("NORMAL"); }
    puts(" -- ");
    if g_conv_n > 0 {
        conv_status();
    } else if g_msg as u32 != 0u32 && g_msg_len > 0 {
        puts_n(g_msg, g_msg_len);
    }

    // In normal / insert mode, position the cursor. Screen row is the
    // cursor's logical row minus g_top_line, +1 for 1-based ANSI.
    if g_mode != 2 {
        var rc: U8Array = U8Array(8);
        row_col(g_cur, rc);
        var logical_row: i32 = (get(rc, 0) as i32)
                             | ((get(rc, 1) as i32) << 8)
                             | ((get(rc, 2) as i32) << 16)
                             | ((get(rc, 3) as i32) << 24);
        var col: i32 = (get(rc, 4) as i32)
                     | ((get(rc, 5) as i32) << 8)
                     | ((get(rc, 6) as i32) << 16)
                     | ((get(rc, 7) as i32) << 24);
        var screen_row: i32 = logical_row - g_top_line + 1;
        if screen_row < 1 { screen_row = 1; }
        if screen_row > g_text_rows { screen_row = g_text_rows; }
        if col > g_print_cols { col = g_print_cols; }   // past the cut: park at the edge
        goto_xy(screen_row, col);
        delete(rc);
    }
    return;
}

// ===== command handling =====

fn cmd_eq(s: StringLiteral) -> bool {
    var sl: i32 = len(s);
    if g_cmdlen != sl { return false; }
    var i: i32 = 0;
    while i < sl {
        if get(g_cmdbuf, i) != get(s, i) { return false; }
        i = i + 1;
    }
    return true;
}

fn run_cmd() -> void {
    if cmd_eq("w") {
        save_file();
    } else if cmd_eq("q") {
        if g_modified == 1 {
            set_msg("unsaved changes (use :q!)");
        } else {
            g_running = 0;
        }
    } else if cmd_eq("q!") {
        g_running = 0;
    } else if cmd_eq("wq") || cmd_eq("x") {
        if save_file() { g_running = 0; }
    } else {
        set_msg("unknown command");
    }
    return;
}

// ===== main key dispatch =====

fn handle_normal(c: u8) -> void {
    // Most commands reset the pending multi-key state; only 'dd' / 'gg'
    // advance it. Mirror vi's "any other key aborts the operator".
    if g_pending_d == 1 && c == 'd' as u8 {
        save_undo();
        delete_line();
        g_pending_d = 0;
        return;
    }
    if g_pending_g == 1 && c == 'g' as u8 {
        move_bof();
        g_pending_g = 0;
        return;
    }
    if g_pending_Z == 1 && c == 'Z' as u8 {
        if save_file() { g_running = 0; }
        g_pending_Z = 0;
        return;
    }
    g_pending_d = 0;
    g_pending_g = 0;
    g_pending_Z = 0;

    if c == 'h' as u8 { move_left(); }
    else if c == 'l' as u8 { move_right(); }
    else if c == 'j' as u8 { move_down(); }
    else if c == 'k' as u8 { move_up(); }
    else if c == '0' as u8 { move_line_start(); }
    else if c == '$' as u8 { move_line_end(); }
    else if c == 'G' as u8 { move_eof(); }
    else if c == 'g' as u8 { g_pending_g = 1; }
    else if c == 'x' as u8 { save_undo(); delete_byte_at_cur(); }
    else if c == 'd' as u8 { g_pending_d = 1; }
    else if c == 'Z' as u8 { g_pending_Z = 1; }
    else if c == 'u' as u8 { do_undo(); }
    else if c == 'i' as u8 { save_undo(); g_mode = 1; }
    else if c == 'I' as u8 { save_undo(); move_line_start(); g_mode = 1; }
    else if c == 'a' as u8 {
        save_undo();
        if g_cur < g_len && get(g_buf, g_cur) != 10u8 {
            var n: i32 = utf8_len(get(g_buf, g_cur));
            g_cur = g_cur + n;
            if g_cur > g_len { g_cur = g_len; }
        }
        g_mode = 1;
    }
    else if c == 'A' as u8 { save_undo(); move_line_end(); g_mode = 1; }
    else if c == 'o' as u8 {
        save_undo();
        move_line_end();
        insert_byte(10u8);
        g_mode = 1;
    }
    else if c == 'O' as u8 {
        save_undo();
        move_line_start();
        insert_byte(10u8);
        g_cur = g_cur - 1;    // stay on the new empty line
        g_mode = 1;
    }
    else if c == ':' as u8 {
        g_mode = 2;
        g_cmdlen = 0;
    }
    // Unknown keys are silently ignored, matching vi convention.
    return;
}

// Arrow keys (CSI final byte A up / B down / C right / D left) move the
// cursor in normal and insert mode; the command line ignores them. In
// insert mode right may step onto the newline (the append position),
// which normal mode's move_right never does.
fn handle_arrow(k: u8) -> void {
    if g_mode == 2 { return; }
    if g_conv_n > 0 { conv_commit(); }
    if k == 'A' as u8 { move_up(); }
    else if k == 'B' as u8 { move_down(); }
    else if k == 'D' as u8 { move_left(); }
    else if g_mode == 1 && g_cur < g_len && get(g_buf, g_cur) != 10u8 {
        g_cur = g_cur + utf8_len(get(g_buf, g_cur));
        if g_cur > g_len { g_cur = g_len; }
    } else if g_mode == 0 { move_right(); }
    return;
}

fn handle_insert(c: u8) -> void {
    if c == 27u8 {
        // ESC → if TUT active, exit TUT only (keeping any candidate
        // being shown); else exit insert mode.
        if g_tut > 0 { conv_commit(); g_tut = 0; return; }
        g_mode = 0;
        if g_cur > 0 {
            var ls: i32 = line_start_at(g_cur);
            if g_cur > ls {
                g_cur = g_cur - 1;
                while g_cur > ls && is_cont(get(g_buf, g_cur)) {
                    g_cur = g_cur - 1;
                }
            }
        }
        return;
    }
    // TUT mode active: route all keys to TUT handler.
    if g_tut > 0 {
        handle_tut(c);
        return;
    }
    // Ctrl+J: enter TUT mode.
    if c == 10u8 {
        g_tut = 1;
        return;
    }
    if c == 8u8 || c == 127u8 {
        delete_byte_before_cur();
        return;
    }
    if c == '\r' as u8 { c = '\n' as u8; }
    // Accept LF (from CR), TAB and any printable byte.
    if c == 10u8 || c == 9u8 || c >= 32u8 { insert_byte(c); }
    return;
}

fn handle_cmdline(c: u8) -> void {
    if c == 27u8 {
        // ESC cancels the command and returns to normal.
        g_mode = 0;
        g_cmdlen = 0;
        return;
    }
    if c == '\r' as u8 || c == '\n' as u8 {
        run_cmd();
        g_mode = 0;
        g_cmdlen = 0;
        return;
    }
    if c == 8u8 || c == 127u8 {
        if g_cmdlen > 0 { g_cmdlen = g_cmdlen - 1; }
        return;
    }
    if c >= 32u8 && c < 127u8 && g_cmdlen < CMD_CAP - 1 {
        set(g_cmdbuf, g_cmdlen, c);
        g_cmdlen = g_cmdlen + 1;
    }
    return;
}

// ===== main =====

// ----- terminal geometry from the env -----

// ROWS is the screen height, COLS the console width (we print COLS-1,
// see g_print_cols). Unset vars keep the 80x24 defaults; ROWS below 2 /
// COLS below 3 are ignored since the status line and the cursor need
// room.
fn load_term_env() -> void {
    var buf: U8Array = U8Array(16u32);
    var n: i32 = env_get("ROWS", buf, 16);
    if n > 0 {
        var rows: i32 = parse_dec(buf, 0, n);
        if rows >= 2 {
            g_screen_rows = rows;
            g_text_rows = rows - 1;
        }
    }
    n = env_get("COLS", buf, 16);
    if n > 0 {
        var cols: i32 = parse_dec(buf, 0, n);
        if cols >= 3 { g_print_cols = cols - 1; }
    }
    delete(buf);
    return;
}

fn main(argv: StringArray) -> i32 {
    if len(argv) < 2 {
        puts("usage: vi <file>\n");
        return 1;
    }
    var arg: String = get(argv, 1);
    g_path_len = len(arg);
    // g_path stores the path in String layout (count header = content
    // length) so it can be handed straight to do_openat without an
    // extra copy. +1 byte of spare capacity is kept for safety.
    g_path = U8Array((g_path_len + 1) as u32);
    var i: i32 = 0;
    while i < g_path_len {
        set(g_path, i, get(arg, i));
        i = i + 1;
    }
    set(g_path, g_path_len, 0u8);
    poke32(g_path as u32, g_path_len as u32);

    g_buf = U8Array(BUF_CAP as u32);
    g_undo_buf = U8Array(BUF_CAP as u32);
    g_cmdbuf = U8Array(CMD_CAP as u32);
    g_conv_rcp = I32Array(CONV_MAX_READ as u32);
    g_cand_addr = U32Array(CONV_MAX_CANDS as u32);
    g_cand_ci = I32Array(CONV_MAX_CANDS as u32);
    g_cand_rl = I32Array(CONV_MAX_CANDS as u32);
    g_cand_ok = I32Array(CONV_MAX_CANDS as u32);
    tut_init();
    load_term_env();
    load_file();

    // Read whatever is pending (up to IN_CAP bytes) rather than one
    // byte: an arrow key arrives as the 3 bytes ESC [ A..D in one
    // read (the matrix keyboard driver queues them together, a UART
    // terminal sends them back to back), so a lone ESC is a lone ESC
    // and ESC [ X in the same batch is an arrow instead of ESC + two
    // stray commands. (A sequence split across two reads, possible on
    // a slow real UART, degrades to the old ESC + 2 keys behaviour.)
    var inb: U8Array = U8Array(IN_CAP as u32);
    render();
    while g_running == 1 {
        var n: i32 = do_read(0, (inb as u32) + 4u32, IN_CAP);
        if n <= 0 {
            // Treat read error/EOF as implicit quit — avoids pinning
            // a detached serial console forever.
            g_running = 0;
        } else {
            var i: i32 = 0;
            while i < n && g_running == 1 {
                var c: u8 = get(inb, i);
                // Any key clears the status message (like vi): a
                // message only describes the previous command. Keys
                // that produce a message set it again below.
                g_msg_len = 0;
                if c == 27u8 && i + 2 < n && get(inb, i + 1) == '[' as u8
                    && get(inb, i + 2) >= 'A' as u8 && get(inb, i + 2) <= 'D' as u8 {
                    handle_arrow(get(inb, i + 2));
                    i = i + 3;
                } else {
                    if g_mode == 0 { handle_normal(c); }
                    else if g_mode == 1 { handle_insert(c); }
                    else { handle_cmdline(c); }
                    i = i + 1;
                }
            }
            render();
        }
    }
    delete(inb);

    // Leave the terminal in a sane state for the next shell prompt.
    clear_screen();

    delete(g_buf);
    delete(g_undo_buf);
    delete(g_cmdbuf);
    delete(g_tut_kmap);
    delete(g_tut_vo);
    delete(g_conv_rcp);
    delete(g_cand_addr);
    delete(g_cand_ci);
    delete(g_cand_rl);
    delete(g_cand_ok);
    delete(g_path);
    if g_msg as u32 != 0u32 { delete(g_msg); }
    return 0;
}
