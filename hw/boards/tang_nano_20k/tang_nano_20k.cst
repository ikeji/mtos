// Tang Nano 20K pin constraints (GW2AR-LV18QN88). Bank voltages are 3.3 V.
IO_LOC "clk" 4;
IO_PORT "clk" PULL_MODE=UP;

// Buttons S1 / S2. They read LOW when idle and HIGH when pressed
// (active high) — a design that gates reset on ~key[0] never starts.
IO_LOC "key[0]" 88;
IO_LOC "key[1]" 87;
IO_PORT "key[0]" PULL_MODE=DOWN;
IO_PORT "key[1]" PULL_MODE=DOWN;

// On-board LEDs (active low).
IO_LOC "led[0]" 15;
IO_LOC "led[1]" 16;
IO_LOC "led[2]" 17;
IO_LOC "led[3]" 18;
IO_LOC "led[4]" 19;
IO_LOC "led[5]" 20;
IO_PORT "led[0]" PULL_MODE=NONE DRIVE=8;
IO_PORT "led[1]" PULL_MODE=NONE DRIVE=8;
IO_PORT "led[2]" PULL_MODE=NONE DRIVE=8;
IO_PORT "led[3]" PULL_MODE=NONE DRIVE=8;
IO_PORT "led[4]" PULL_MODE=NONE DRIVE=8;
IO_PORT "led[5]" PULL_MODE=NONE DRIVE=8;

// UART via the BL616 USB bridge.
IO_LOC "uart_tx" 69;
IO_LOC "uart_rx" 70;
IO_PORT "uart_tx" PULL_MODE=NONE DRIVE=8;
IO_PORT "uart_rx" PULL_MODE=UP;

// In-package SDRAM (GW2AR-18C, 2M x 32). Locations from apicula doc/sdram.md.
// Only applies to tops that have these ports (top_memtest, top_soc_sdram).
IO_LOC "O_sdram_clk" IOR11B;
IO_LOC "O_sdram_cke" IOL13A;
IO_LOC "O_sdram_cs_n" IOL14B;
IO_LOC "O_sdram_cas_n" IOL14A;
IO_LOC "O_sdram_ras_n" IOL13B;
IO_LOC "O_sdram_wen_n" IOL12B;
IO_LOC "O_sdram_dqm[0]" IOL12A;
IO_LOC "O_sdram_dqm[1]" IOR11A;
IO_LOC "O_sdram_dqm[2]" IOL18A;
IO_LOC "O_sdram_dqm[3]" IOR15B;
IO_LOC "O_sdram_addr[0]" IOR14A;
IO_LOC "O_sdram_addr[1]" IOR13B;
IO_LOC "O_sdram_addr[2]" IOR14B;
IO_LOC "O_sdram_addr[3]" IOR15A;
IO_LOC "O_sdram_addr[4]" IOL16B;
IO_LOC "O_sdram_addr[5]" IOL17B;
IO_LOC "O_sdram_addr[6]" IOL16A;
IO_LOC "O_sdram_addr[7]" IOL17A;
IO_LOC "O_sdram_addr[8]" IOL15B;
IO_LOC "O_sdram_addr[9]" IOL15A;
IO_LOC "O_sdram_addr[10]" IOR12B;
IO_LOC "O_sdram_ba[0]" IOR13A;
IO_LOC "O_sdram_ba[1]" IOR12A;
IO_LOC "IO_sdram_dq[0]" IOL3A;
IO_LOC "IO_sdram_dq[1]" IOL3B;
