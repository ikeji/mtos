// Tang Nano 20K pin constraints (GW2AR-LV18QN88). Bank voltages are 3.3 V.
IO_LOC "clk" 4;
IO_PORT "clk" PULL_MODE=UP;

// Buttons S1 / S2. They read LOW when idle and HIGH when pressed
// (active high) — a design that gates reset on ~key[0] never starts.
IO_LOC "key[0]" 88;
IO_LOC "key[1]" 87;
IO_PORT "key[0]" PULL_MODE=DOWN;
IO_PORT "key[1]" PULL_MODE=DOWN;

// On-board LEDs (active low).
IO_LOC "led[0]" 15;
IO_LOC "led[1]" 16;
IO_LOC "led[2]" 17;
IO_LOC "led[3]" 18;
IO_LOC "led[4]" 19;
IO_LOC "led[5]" 20;
IO_PORT "led[0]" PULL_MODE=NONE DRIVE=8;
IO_PORT "led[1]" PULL_MODE=NONE DRIVE=8;
IO_PORT "led[2]" PULL_MODE=NONE DRIVE=8;
IO_PORT "led[3]" PULL_MODE=NONE DRIVE=8;
IO_PORT "led[4]" PULL_MODE=NONE DRIVE=8;
IO_PORT "led[5]" PULL_MODE=NONE DRIVE=8;

// UART via the BL616 USB bridge.
IO_LOC "uart_tx" 69;
IO_LOC "uart_rx" 70;
IO_PORT "uart_tx" PULL_MODE=NONE DRIVE=8;
IO_PORT "uart_rx" PULL_MODE=UP;

// In-package SDRAM (GW2AR-18C, 2M x 32). Locations from apicula doc/sdram.md.
// Only applies to tops that have these ports (top_memtest, top_soc_sdram).
IO_LOC "O_sdram_clk" IOR11B;
IO_LOC "O_sdram_cke" IOL13A;
IO_LOC "O_sdram_cs_n" IOL14B;
IO_LOC "O_sdram_cas_n" IOL14A;
IO_LOC "O_sdram_ras_n" IOL13B;
IO_LOC "O_sdram_wen_n" IOL12B;
IO_LOC "O_sdram_dqm[0]" IOL12A;
IO_LOC "O_sdram_dqm[1]" IOR11A;
IO_LOC "O_sdram_dqm[2]" IOL18A;
IO_LOC "O_sdram_dqm[3]" IOR15B;
IO_LOC "O_sdram_addr[0]" IOR14A;
IO_LOC "O_sdram_addr[1]" IOR13B;
IO_LOC "O_sdram_addr[2]" IOR14B;
IO_LOC "O_sdram_addr[3]" IOR15A;
IO_LOC "O_sdram_addr[4]" IOL16B;
IO_LOC "O_sdram_addr[5]" IOL17B;
IO_LOC "O_sdram_addr[6]" IOL16A;
IO_LOC "O_sdram_addr[7]" IOL17A;
IO_LOC "O_sdram_addr[8]" IOL15B;
IO_LOC "O_sdram_addr[9]" IOL15A;
IO_LOC "O_sdram_addr[10]" IOR12B;
IO_LOC "O_sdram_ba[0]" IOR13A;
IO_LOC "O_sdram_ba[1]" IOR12A;
IO_LOC "IO_sdram_dq[0]" IOL3A;
IO_LOC "IO_sdram_dq[1]" IOL3B;
IO_LOC "IO_sdram_dq[2]" IOL8A;
IO_LOC "IO_sdram_dq[3]" IOL8B;
IO_LOC "IO_sdram_dq[4]" IOL9A;
IO_LOC "IO_sdram_dq[5]" IOL9B;
IO_LOC "IO_sdram_dq[6]" IOL11A;
IO_LOC "IO_sdram_dq[7]" IOL11B;
IO_LOC "IO_sdram_dq[8]" IOR9B;
IO_LOC "IO_sdram_dq[9]" IOR9A;
IO_LOC "IO_sdram_dq[10]" IOR5B;
IO_LOC "IO_sdram_dq[11]" IOR6A;
IO_LOC "IO_sdram_dq[12]" IOR5A;
IO_LOC "IO_sdram_dq[13]" IOR4B;
IO_LOC "IO_sdram_dq[14]" IOR3B;
IO_LOC "IO_sdram_dq[15]" IOR3A;
IO_LOC "IO_sdram_dq[16]" IOL39B;
IO_LOC "IO_sdram_dq[17]" IOL39A;
IO_LOC "IO_sdram_dq[18]" IOL35B;
IO_LOC "IO_sdram_dq[19]" IOL35A;
IO_LOC "IO_sdram_dq[20]" IOL30B;
IO_LOC "IO_sdram_dq[21]" IOL30A;
IO_LOC "IO_sdram_dq[22]" IOL20A;
IO_LOC "IO_sdram_dq[23]" IOL18B;
IO_LOC "IO_sdram_dq[24]" IOR17A;
IO_LOC "IO_sdram_dq[25]" IOR16A;
IO_LOC "IO_sdram_dq[26]" IOR16B;
IO_LOC "IO_sdram_dq[27]" IOR17B;
IO_LOC "IO_sdram_dq[28]" IOR18A;
IO_LOC "IO_sdram_dq[29]" IOR18B;
IO_LOC "IO_sdram_dq[30]" IOR44A;
IO_LOC "IO_sdram_dq[31]" IOR44B;

// ---- header GPIO for the LCD + matrix keyboard (top_soc_sdram) ----
// kbd[i] = GP(i+1) for i<10, kbd[10] = GP12. All idle-high with pull-ups
// (the pico2 driver relies on internal pull-ups; here it is a static attribute).
IO_LOC "kbd[0]" 73;
IO_LOC "kbd[1]" 74;
IO_LOC "kbd[2]" 75;
IO_LOC "kbd[3]" 77;
IO_LOC "kbd[4]" 27;
IO_LOC "kbd[5]" 28;
IO_LOC "kbd[6]" 25;
IO_LOC "kbd[7]" 26;
IO_LOC "kbd[8]" 29;
IO_LOC "kbd[9]" 30;
IO_LOC "kbd[10]" 31;
IO_PORT "kbd[0]" PULL_MODE=UP;
IO_PORT "kbd[1]" PULL_MODE=UP;
IO_PORT "kbd[2]" PULL_MODE=UP;
IO_PORT "kbd[3]" PULL_MODE=UP;
IO_PORT "kbd[4]" PULL_MODE=UP;
IO_PORT "kbd[5]" PULL_MODE=UP;
IO_PORT "kbd[6]" PULL_MODE=UP;
IO_PORT "kbd[7]" PULL_MODE=UP;
IO_PORT "kbd[8]" PULL_MODE=UP;
IO_PORT "kbd[9]" PULL_MODE=UP;
IO_PORT "kbd[10]" PULL_MODE=UP;
// lcd[i] = GP(38+i): DC CS SCK MOSI MISO RST BL
IO_LOC "lcd[0]" 76;
IO_LOC "lcd[1]" 42;
IO_LOC "lcd[2]" 41;
IO_LOC "lcd[3]" 48;
IO_LOC "lcd[4]" 49;
IO_LOC "lcd[5]" 86;
IO_LOC "lcd[6]" 72;
IO_PORT "lcd[0]" PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd[1]" PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd[2]" PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd[3]" PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd[4]" PULL_MODE=UP;
IO_PORT "lcd[5]" PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd[6]" PULL_MODE=NONE DRIVE=8;

// ---- configuration SPI flash (MSPI pins of the GW2AR-18, apicula pinout: MCLK/MCS_N/MO/MI) ----
IO_LOC "flash_clk" 59;
IO_LOC "flash_cs" 60;
IO_LOC "flash_mosi" 61;
IO_LOC "flash_miso" 62;
IO_PORT "flash_clk" PULL_MODE=NONE DRIVE=8;
IO_PORT "flash_cs" PULL_MODE=UP DRIVE=8;
IO_PORT "flash_mosi" PULL_MODE=NONE DRIVE=8;
IO_PORT "flash_miso" PULL_MODE=UP;

// ---- on-board microSD in SPI mode (top_soc_sdram): MISO=D0 CS=D3 SCK=CLK MOSI=CMD ----
IO_LOC "sd_miso" 84;
IO_LOC "sd_cs" 81;
IO_LOC "sd_sck" 83;
IO_LOC "sd_mosi" 82;
IO_PORT "sd_miso" PULL_MODE=UP;
IO_PORT "sd_cs" PULL_MODE=UP DRIVE=8;
IO_PORT "sd_sck" PULL_MODE=NONE DRIVE=8;
IO_PORT "sd_mosi" PULL_MODE=UP DRIVE=8;
