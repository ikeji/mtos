// kernel/block_sd.tc — SD card SPI0 block backend for Pico 2.
//
// Drop-in replacement for block_fat_stub.tc on the pico2 target:
// exports fat_block_init / fat_block_read / fat_block_write with the
// same signatures fatfs.tc expects, talking to a Catalex-style SD
// breakout over SPI0 + GP4-7 (see docs/pico2_hardware.md).
//
// Init flow: CMD0 → CMD8 → ACMD41 → CMD58 (OCR → SDHC bit) → bump
// SPI clock to ~6 MHz. After init, fat_block_read/write use CMD17 /
// CMD24 against block-addressed (SDHC) or byte-addressed (SDSC) LBAs.

// Drain the kernel UART RX ring from inside SD busy-waits. Without
// this, fat_block_write spends ~10 ms in a single ecall with
// hardware-cleared mstatus.MIE, the timer trap can't fire, and the
// PL011 32-byte RX FIFO overflows under sustained input. See K11 in
// docs/problem.md. uart_rx_drain itself is just a non-blocking PL011
// FIFO drain into a kernel ring buffer — cheap to call frequently.
fn uart_rx_drain() -> void;

// ----- MMIO -----
var SD_RESETS_CLR:    u32 = 0x40023000u32;
var SD_RESETS_DONE:   u32 = 0x40020008u32;
var SD_IO_BANK0:      u32 = 0x40028000u32;
var SD_PADS_CLR:      u32 = 0x4003B000u32;
var SD_PADS_SET:      u32 = 0x4003A000u32;
var SD_SIO:           u32 = 0xD0000000u32;
var SD_SPI0:          u32 = 0x40080000u32;
var SD_RESETS_BIT:    u32 = 0x40000u32;  // RP2350 RESETS bit 18 = SPI0

// ----- module state -----
var g_sd_sdhc:        i32 = 0;     // 1 = SDHC, 0 = SDSC
var g_sd_inited:      i32 = 0;

// ----- low level -----

fn sd_spi_xfer(b: u8) -> u8 {
    while (peek32(SD_SPI0 + 0x0Cu32) & 0x2u32) == 0u32 { }
    poke32(SD_SPI0 + 0x08u32, b as u32);
    while (peek32(SD_SPI0 + 0x0Cu32) & 0x4u32) == 0u32 { }
    var v: u8 = peek32(SD_SPI0 + 0x08u32) as u8;
    // Drain UART RX every SPI byte. Any SD path (block_read /
    // block_write / sd_busy_spin / fatfs FAT walk / cluster alloc)
    // funnels through here, so a single drain hook covers them all.
    // Without this, fatfs_open during do_spawn (~10 ms of FAT + dir
    // traffic in M-mode with mstatus.MIE=0) overruns the PL011 FIFO
    // before mr even starts — that was the actual K11 wedge for
    // 128 byte uploads, not the data-phase write loop. The drain is
    // a non-blocking PL011 status read + at most one byte copy
    // into the kernel ring; ~10 cycles when idle, swamped by the
    // SPI transfer itself (~10 us at 6 MHz with kernel overhead).
    uart_rx_drain();
    return v;
}

fn sd_cs_low()  -> void { poke32(SD_SIO + 0x20u32, 0x20u32); return; }
fn sd_cs_high() -> void { poke32(SD_SIO + 0x18u32, 0x20u32); return; }
fn sd_cs_high_clk() -> void { sd_cs_high(); sd_spi_xfer(0xFFu8); return; }

// Send a 6-byte SD command frame, return R1.
fn sd_cmd(cmd: i32, arg: u32, crc: u8) -> u8 {
    sd_cs_low();
    sd_spi_xfer(0xFFu8);
    sd_spi_xfer((0x40 | cmd) as u8);
    sd_spi_xfer((arg >> 24u32) as u8);
    sd_spi_xfer((arg >> 16u32) as u8);
    sd_spi_xfer((arg >>  8u32) as u8);
    sd_spi_xfer( arg            as u8);
    sd_spi_xfer(crc);
    var r1: u8 = 0xFFu8;
    var i: i32 = 0;
    while i < 16 {
        r1 = sd_spi_xfer(0xFFu8);
        if (r1 as u32 & 0x80u32) == 0u32 { break; }
        i = i + 1;
    }
    return r1;
}

fn sd_busy_spin(n: i32) -> void {
    var i: i32 = 0;
    while i < n { i = i + 1; }
    return;
}

// ----- public API expected by fatfs.tc -----

export fn fat_block_init() -> i32 {
    if g_sd_inited == 1 { return 0; }

    // 1. Take SPI0 out of reset.
    poke32(SD_RESETS_CLR, SD_RESETS_BIT);
    while (peek32(SD_RESETS_DONE) & SD_RESETS_BIT) == 0u32 { }

    // 2. Pre-drive CS high before turning OE on.
    poke32(SD_SIO + 0x18u32, 0x20u32);

    // 3. GPIO funcsel: GP4/6/7 = SPI0, GP5 = SIO (CS).
    poke32(SD_IO_BANK0 + 0x024u32, 1u32);
    poke32(SD_IO_BANK0 + 0x02Cu32, 5u32);
    poke32(SD_IO_BANK0 + 0x034u32, 1u32);
    poke32(SD_IO_BANK0 + 0x03Cu32, 1u32);

    // 4. Pads: clear ISO on GP4-7, IE+PUE on MISO.
    poke32(SD_PADS_CLR + 0x14u32, 0x100u32);
    poke32(SD_PADS_CLR + 0x18u32, 0x100u32);
    poke32(SD_PADS_CLR + 0x1Cu32, 0x100u32);
    poke32(SD_PADS_CLR + 0x20u32, 0x100u32);
    poke32(SD_PADS_SET + 0x14u32, 0x48u32);

    // 5. CS as SIO output.
    poke32(SD_SIO + 0x38u32, 0x20u32);

    // 6. SPI0 @ 400 kHz init clock.
    poke32(SD_SPI0 + 0x10u32, 30u32);
    poke32(SD_SPI0 + 0x00u32, 0x07u32);
    poke32(SD_SPI0 + 0x04u32, 0x02u32);

    // 7. 80 init clocks with CS=H.
    sd_cs_high();
    var ic: i32 = 0;
    while ic < 10 { sd_spi_xfer(0xFFu8); ic = ic + 1; }

    // 8. CMD0 → idle state.
    var r1: u8 = 0xFFu8;
    var attempt: i32 = 0;
    while attempt < 5 {
        r1 = sd_cmd(0, 0u32, 0x95u8);
        sd_cs_high_clk();
        if r1 == 0x01u8 { break; }
        sd_busy_spin(2000);
        attempt = attempt + 1;
    }
    if r1 != 0x01u8 { return -1; }

    // 9. CMD8: SDHC voltage check.
    sd_cs_low();
    sd_spi_xfer(0xFFu8);
    sd_spi_xfer(0x48u8);
    sd_spi_xfer(0x00u8); sd_spi_xfer(0x00u8);
    sd_spi_xfer(0x01u8); sd_spi_xfer(0xAAu8);
    sd_spi_xfer(0x87u8);
    var cmd8_r1: u8 = 0xFFu8;
    var k: i32 = 0;
    while k < 16 {
        cmd8_r1 = sd_spi_xfer(0xFFu8);
        if (cmd8_r1 as u32 & 0x80u32) == 0u32 { break; }
        k = k + 1;
    }
    var e2: u8 = 0u8;
    var e3: u8 = 0u8;
    if cmd8_r1 != 0xFFu8 {
        sd_spi_xfer(0xFFu8);
        sd_spi_xfer(0xFFu8);
        e2 = sd_spi_xfer(0xFFu8);
        e3 = sd_spi_xfer(0xFFu8);
    }
    sd_cs_high_clk();
    var v2: i32 = 0;
    if cmd8_r1 == 0x01u8 {
        if e2 == 0x01u8 {
            if e3 == 0xAAu8 { v2 = 1; }
        }
    }

    // 10. ACMD41 init loop.
    var arg41: u32 = 0u32;
    if v2 == 1 { arg41 = 0x40000000u32; }
    var done: i32 = 0;
    var iter: i32 = 0;
    while iter < 1000 {
        sd_cmd(55, 0u32, 0x65u8);
        sd_cs_high_clk();
        var r41: u8 = sd_cmd(41, arg41, 0x77u8);
        sd_cs_high_clk();
        if r41 == 0x00u8 { done = 1; break; }
        sd_busy_spin(50000);
        iter = iter + 1;
    }
    if done == 0 { return -2; }

    // 10b. CMD59 disable CRC checking (some cards leave it on after CMD8).
    // Argument 0 → CRC off. CRC for CMD59(0) is 0x91.
    sd_cmd(59, 0u32, 0x91u8);
    sd_cs_high_clk();

    // 11. CMD58: read OCR, detect SDHC.
    g_sd_sdhc = 0;
    if v2 == 1 {
        sd_cs_low();
        sd_spi_xfer(0xFFu8);
        sd_spi_xfer(0x7Au8);
        sd_spi_xfer(0u8); sd_spi_xfer(0u8); sd_spi_xfer(0u8); sd_spi_xfer(0u8);
        sd_spi_xfer(0xFDu8);
        var r58: u8 = 0xFFu8;
        var m: i32 = 0;
        while m < 16 {
            r58 = sd_spi_xfer(0xFFu8);
            if (r58 as u32 & 0x80u32) == 0u32 { break; }
            m = m + 1;
        }
        var o0: u8 = sd_spi_xfer(0xFFu8);
        sd_spi_xfer(0xFFu8); sd_spi_xfer(0xFFu8); sd_spi_xfer(0xFFu8);
        sd_cs_high_clk();
        if (o0 as u32 & 0x40u32) != 0u32 { g_sd_sdhc = 1; }
    }

    // 12. Bump SPI clock. CPSR=2 → clk_peri / 2 (= 6 MHz on XOSC).
    poke32(SD_SPI0 + 0x10u32, 2u32);

    g_sd_inited = 1;
    return 0;
}

// CMD17 (READ_SINGLE_BLOCK).
export fn fat_block_read(sector: u32, buf: U8Array) -> i32 {
    if g_sd_inited == 0 { return -1; }
    var arg: u32 = sector;
    if g_sd_sdhc == 0 { arg = sector * 512u32; }

    var r1: u8 = sd_cmd(17, arg, 0xFFu8);
    if r1 != 0x00u8 { sd_cs_high_clk(); return -1; }

    // Wait for data token 0xFE.
    var tok: u8 = 0xFFu8;
    var w: i32 = 0;
    while w < 100000 {
        tok = sd_spi_xfer(0xFFu8);
        if tok != 0xFFu8 { break; }
        w = w + 1;
    }
    if tok != 0xFEu8 { sd_cs_high_clk(); return -1; }

    var i: i32 = 0;
    while i < 512 {
        set(buf, i, sd_spi_xfer(0xFFu8));
        i = i + 1;
    }
    sd_spi_xfer(0xFFu8);  // CRC hi
    sd_spi_xfer(0xFFu8);  // CRC lo
    sd_cs_high_clk();
    return 512;
}

// CMD24 (WRITE_BLOCK).
export fn fat_block_write(sector: u32, buf: U8Array) -> i32 {
    if g_sd_inited == 0 { return -1; }
    var arg: u32 = sector;
    if g_sd_sdhc == 0 { arg = sector * 512u32; }

    var r1: u8 = sd_cmd(24, arg, 0xFFu8);
    if r1 != 0x00u8 { sd_cs_high_clk(); return -1; }

    // 1 byte gap, then start token 0xFE.
    sd_spi_xfer(0xFFu8);
    sd_spi_xfer(0xFEu8);
    var i: i32 = 0;
    while i < 512 {
        sd_spi_xfer(get(buf, i));
        i = i + 1;
    }
    sd_spi_xfer(0xFFu8);  // CRC dummy
    sd_spi_xfer(0xFFu8);

    // Data response: token format `xxx0sssY` (lower 5 bits = `0sss1`).
    // 0x05 = accepted, 0x0B = CRC error, 0x0D = write error. Some cards
    // delay the token by an extra clock or two; poll up to 8 bytes for
    // a non-FF response before giving up. We strictly require the
    // accepted code (0x05) — accepting anything else risks treating a
    // dropped block as written, which silently corrupts the FS later.
    var resp: u8 = 0xFFu8;
    var rp: i32 = 0;
    while rp < 8 {
        resp = sd_spi_xfer(0xFFu8);
        if resp != 0xFFu8 { break; }
        rp = rp + 1;
    }
    if (resp as u32 & 0x1Fu32) != 0x05u32 {
        sd_cs_high_clk();
        return -1;
    }

    // Wait while card is busy (MISO held low while writing). SD CMD24
    // sector-write completion is typically 1-10 ms at SPI 6 MHz; the
    // sd_spi_xfer hook keeps the PL011 RX FIFO drained while we wait.
    var w: i32 = 0;
    while w < 1000000 {
        var bb: u8 = sd_spi_xfer(0xFFu8);
        if bb == 0xFFu8 { break; }
        w = w + 1;
    }
    sd_cs_high_clk();
    return 512;
}
