// kernel/rtc_ds3231.tc — DS3231 real-time-clock backend for /dev/rtc
// on the Pico 2 (RP2350).
//
// Provides rtc_read_secs / rtc_set_secs (which rtc.tc forward-declares)
// by talking to a DS3231 over the RP2350 I2C0 hardware block:
// GP32 = SDA, GP33 = SCL — see docs/pico2_hardware.md. The 2026-05-21
// board moved RTC off GP2/3 (I2C1) and onto the high-GPIO group, which
// only has I2C0 available at funcsel 3.
//
// The DS3231 keeps the time as BCD calendar registers (sec/min/hour/
// dow/date/month/year at 0x00..0x06). This module reads/writes those
// and converts to/from the seconds-since-epoch that the rtc interface
// uses via rtc.tc's civil helpers.
//
// Hardware-only: qemu virt has no DS3231, so this path is not exercised
// by `make test` — the virt kernel uses kernel.tc's goldfish-rtc.

import "rtc.tc";

// ===== RP2350 register addresses =====
// Verified against the pico-sdk rp2350 hardware/regs headers.
var RTC_RESETS_CLR:  u32 = 0x40023000u32;   // RESETS, atomic-clear alias
var RTC_RESETS_DONE: u32 = 0x40020008u32;   // RESETS_DONE
var RTC_RESETS_I2C0: u32 = 0x10u32;         // RESETS bit 4 = I2C0
var RTC_IO_BANK0:    u32 = 0x40028000u32;
var RTC_PADS_SET:    u32 = 0x4003A000u32;   // PADS_BANK0 atomic-set alias
var RTC_PADS_CLR:    u32 = 0x4003B000u32;   // PADS_BANK0 atomic-clear alias
var RTC_I2C0:        u32 = 0x40090000u32;

// DW_apb_i2c register offsets (Synopsys IP — same layout as RP2040).
var IC_CON:           u32 = 0x00u32;
var IC_TAR:           u32 = 0x04u32;
var IC_DATA_CMD:      u32 = 0x10u32;
var IC_SS_SCL_HCNT:   u32 = 0x14u32;
var IC_SS_SCL_LCNT:   u32 = 0x18u32;
var IC_RAW_INTR_STAT: u32 = 0x34u32;
var IC_CLR_TX_ABRT:   u32 = 0x54u32;
var IC_ENABLE:        u32 = 0x6Cu32;
var IC_STATUS:        u32 = 0x70u32;

var DS3231_ADDR: u32 = 0x68u32;     // DS3231 7-bit I2C address

// Bound for the polling loops so an absent / unresponsive RTC degrades
// to an error return instead of hanging the kernel (~10 ms worst case).
var I2C_SPIN_MAX: i32 = 100000;

var g_rtc_inited: i32 = 0;

// Bring up the I2C0 master on GP32/GP33. Idempotent.
fn i2c0_init() -> void {
    // 1. Take I2C0 out of reset.
    poke32(RTC_RESETS_CLR, RTC_RESETS_I2C0);
    while (peek32(RTC_RESETS_DONE) & RTC_RESETS_I2C0) == 0u32 { }

    // 2. GP32 = I2C0 SDA, GP33 = I2C0 SCL. funcsel 3 = I2C. The GPn
    //    ctrl register is at IO_BANK0 + 8*n + 4: GP32 = 0x104, GP33 = 0x10C.
    poke32(RTC_IO_BANK0 + 0x104u32, 3u32);  // GP32 ctrl
    poke32(RTC_IO_BANK0 + 0x10Cu32, 3u32);  // GP33 ctrl

    // 3. Pads: clear ISO (bit 8) so the pad is live, set input-enable
    //    (bit 6) — I2C lines are bidirectional — and a weak pull-up
    //    (bit 3). The DS3231 module carries its own pull-ups; the
    //    internal ones are a harmless parallel safety net. The PADS
    //    register for GPn is at PADS_BANK0 + 4 + 4*n: GP32 = 0x84,
    //    GP33 = 0x88.
    poke32(RTC_PADS_CLR + 0x84u32, 0x100u32);   // GP32: clear ISO
    poke32(RTC_PADS_CLR + 0x88u32, 0x100u32);   // GP33: clear ISO
    poke32(RTC_PADS_SET + 0x84u32, 0x48u32);    // GP32: IE + pull-up
    poke32(RTC_PADS_SET + 0x88u32, 0x48u32);    // GP33: IE + pull-up

    // 4. Configure the master while disabled (IC_CON / IC_TAR / SCL
    //    timing can only change with IC_ENABLE == 0).
    poke32(RTC_I2C0 + IC_ENABLE, 0u32);
    // IC_CON = MASTER_MODE | SPEED=standard(01) | IC_RESTART_EN |
    //          IC_SLAVE_DISABLE = 1 | 2 | 0x20 | 0x40 = 0x63.
    poke32(RTC_I2C0 + IC_CON, 0x63u32);
    poke32(RTC_I2C0 + IC_TAR, DS3231_ADDR);
    // SCL ~100 kHz assuming clk_sys ~150 MHz (period ~1500 cycles).
    // A slower clk_sys only makes SCL slower, which the DS3231
    // tolerates; the counts are biased long to stay <= 100 kHz.
    poke32(RTC_I2C0 + IC_SS_SCL_HCNT, 600u32);
    poke32(RTC_I2C0 + IC_SS_SCL_LCNT, 900u32);

    // 5. Enable.
    poke32(RTC_I2C0 + IC_ENABLE, 1u32);
    g_rtc_inited = 1;
    return;
}

// Read-to-clear the TX_ABRT (NAK) latch before a fresh transaction.
fn i2c0_clear_abort() -> void {
    var v: u32 = peek32(RTC_I2C0 + IC_CLR_TX_ABRT);
    return;
}

// Push one IC_DATA_CMD entry once the TX FIFO has room. `extra` carries
// the CMD (bit 8 = read), STOP (bit 9) and RESTART (bit 10) bits.
// Returns 0, or -1 on a TX-FIFO-full timeout.
fn i2c0_put(data: u32, extra: u32) -> i32 {
    var spin: i32 = 0;
    // IC_STATUS bit 1 = TFNF (TX FIFO not full).
    while (peek32(RTC_I2C0 + IC_STATUS) & 0x2u32) == 0u32 {
        spin = spin + 1;
        if spin > I2C_SPIN_MAX { return -1; }
    }
    poke32(RTC_I2C0 + IC_DATA_CMD, (data & 0xFFu32) | extra);
    return 0;
}

// Read `n` bytes (n <= 8) from the DS3231 starting at register `reg`
// into buf[0..n]. Returns 0 on success, -1 on NAK / bus error / timeout.
fn ds3231_read(reg: i32, buf: U8Array, n: i32) -> i32 {
    i2c0_clear_abort();
    // Phase 1: write the register pointer, no STOP.
    if i2c0_put(reg as u32, 0u32) != 0 { return -1; }
    // Phase 2: issue n read commands. With IC_RESTART_EN the DW
    // inserts a repeated-START before the first one; STOP on the last.
    var i: i32 = 0;
    while i < n {
        var cmd: u32 = 0x100u32;            // bit 8 = read
        if i == n - 1 { cmd = 0x300u32; }   // bit 9 = STOP on the last
        if i2c0_put(0u32, cmd) != 0 { return -1; }
        i = i + 1;
    }
    // Phase 3: drain n bytes out of the RX FIFO.
    i = 0;
    while i < n {
        var spin: i32 = 0;
        // IC_STATUS bit 3 = RFNE (RX FIFO not empty).
        while (peek32(RTC_I2C0 + IC_STATUS) & 0x8u32) == 0u32 {
            // IC_RAW_INTR_STAT bit 6 = TX_ABRT: the slave NAK'd.
            if (peek32(RTC_I2C0 + IC_RAW_INTR_STAT) & 0x40u32) != 0u32 {
                return -1;
            }
            spin = spin + 1;
            if spin > I2C_SPIN_MAX { return -1; }
        }
        set(buf, i, peek32(RTC_I2C0 + IC_DATA_CMD) as u8);
        i = i + 1;
    }
    return 0;
}

// Write `n` bytes from buf[0..n] to the DS3231 starting at register
// `reg`. Returns 0 on success, -1 on NAK / bus error / timeout.
fn ds3231_write(reg: i32, buf: U8Array, n: i32) -> i32 {
    i2c0_clear_abort();
    if i2c0_put(reg as u32, 0u32) != 0 { return -1; }
    var i: i32 = 0;
    while i < n {
        var cmd: u32 = 0u32;
        if i == n - 1 { cmd = 0x200u32; }   // bit 9 = STOP on the last
        if i2c0_put(get(buf, i) as u32, cmd) != 0 { return -1; }
        i = i + 1;
    }
    // Wait for the master to finish (IC_STATUS bit 5 = MST_ACTIVITY).
    var spin: i32 = 0;
    while (peek32(RTC_I2C0 + IC_STATUS) & 0x20u32) != 0u32 {
        spin = spin + 1;
        if spin > I2C_SPIN_MAX { return -1; }
    }
    // IC_RAW_INTR_STAT bit 6 = TX_ABRT.
    if (peek32(RTC_I2C0 + IC_RAW_INTR_STAT) & 0x40u32) != 0u32 {
        return -1;
    }
    return 0;
}

fn bcd2dec(b: i32) -> i32 { return (b >> 4) * 10 + (b & 0xF); }
fn dec2bcd(d: i32) -> i32 { return ((d / 10) << 4) | (d % 10); }

// /dev/rtc backend: current time as seconds since the Unix epoch.
// Returns 0 (the epoch) if the DS3231 does not respond.
fn rtc_read_secs() -> u32 {
    if g_rtc_inited == 0 { i2c0_init(); }
    var buf: U8Array = U8Array(7u32);
    if ds3231_read(0, buf, 7) != 0 {
        delete(buf);
        return 0u32;
    }
    var ss:  i32 = bcd2dec((get(buf, 0) as i32) & 0x7F);
    var mm:  i32 = bcd2dec((get(buf, 1) as i32) & 0x7F);
    var hh:  i32 = bcd2dec((get(buf, 2) as i32) & 0x3F);  // 24-hour
    // buf[3] = day-of-week (DS3231-internal, unused here)
    var d:   i32 = bcd2dec((get(buf, 4) as i32) & 0x3F);
    var mon: i32 = bcd2dec((get(buf, 5) as i32) & 0x1F);
    var yr:  i32 = bcd2dec( get(buf, 6) as i32);
    delete(buf);
    return rtc_civil_to_secs((2000 + yr) as u32, mon as u32, d as u32,
                             hh as u32, mm as u32, ss as u32);
}

// /dev/rtc backend: set the clock from a Unix-epoch second count.
// Returns 0 on success, -1 if the DS3231 write fails.
fn rtc_set_secs(secs: u32) -> i32 {
    if g_rtc_inited == 0 { i2c0_init(); }
    rtc_secs_to_civil(secs);
    // DS3231 holds a 2-digit year + century bit; the OS clock lives in
    // 2000-2099, so store year-2000 with century 0.
    var yr: i32 = (rtc_cv_year() as i32) - 2000;
    if yr < 0  { yr = 0; }
    if yr > 99 { yr = yr % 100; }

    var buf: U8Array = U8Array(7u32);
    set(buf, 0, dec2bcd(rtc_cv_sec()   as i32) as u8);
    set(buf, 1, dec2bcd(rtc_cv_min()   as i32) as u8);
    set(buf, 2, dec2bcd(rtc_cv_hour()  as i32) as u8);  // bit 6 = 0: 24h
    set(buf, 3, 1u8);                                   // day-of-week
    set(buf, 4, dec2bcd(rtc_cv_day()   as i32) as u8);
    set(buf, 5, dec2bcd(rtc_cv_month() as i32) as u8);  // bit 7 = 0: century
    set(buf, 6, dec2bcd(yr) as u8);
    var rc: i32 = ds3231_write(0, buf, 7);
    delete(buf);
    if rc != 0 { return -1; }

    // Clear the status register (0x0F): drops the oscillator-stop flag
    // so a subsequent read is not treated as power-lost, and clears the
    // alarm flags. We do not use the DS3231 alarms.
    var st: U8Array = U8Array(1u32);
    set(st, 0, 0u8);
    var src: i32 = ds3231_write(0x0F, st, 1);
    delete(st);
    return 0;
}
