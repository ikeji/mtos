// kernel/rtc_ds3231.tc — DS3231 real-time-clock backend for /dev/rtc
// on the Pico 2 (RP2350).
//
// Provides rtc_read_secs / rtc_set_secs (which rtc.tc forward-declares)
// by bit-banging an I²C master on GP32 (SDA) / GP33 (SCL). The hardware
// I²C0 block at funcsel 3 is present and addressable from the CPU side
// (IC_COMP_TYPE reads "DW@") but the master refuses to drain its
// command FIFO into the bus on this RP2350 silicon — we get the
// command sitting in the TX FIFO with MST_ACTIVITY=0 and no abort
// flag, indefinitely. We tried matching pico-sdk i2c_init() exactly
// (fast-mode IC_CON 0x165, DMA_CR=3, SDA_HOLD, threshold zeros, the
// disable-set-TAR-reenable kick before every transaction) — none kick
// the master into transmitting. Bit-banging from SIO confirmed the
// DS3231 ACKs at 0x68, so the wiring is fine and the workaround is
// just to keep driving the bus from the CPU.
//
// The DS3231 keeps the time as BCD calendar registers (sec/min/hour/
// dow/date/month/year at 0x00..0x06). This module reads/writes those
// and converts to/from the seconds-since-epoch that the rtc interface
// uses via rtc.tc's civil helpers.
//
// Hardware-only: qemu virt has no DS3231, so this path is not exercised
// by `make test` — the virt kernel uses kernel.tc's goldfish-rtc.

import "rtc.tc";

// ===== RP2350 register addresses =====
var RTC_IO_BANK0:    u32 = 0x40028000u32;
var RTC_PADS_SET:    u32 = 0x4003A000u32;   // PADS_BANK0 atomic-set alias
var RTC_PADS_CLR:    u32 = 0x4003B000u32;   // PADS_BANK0 atomic-clear alias

// SIO high-GPIO bank (GP32-47). Bit 0 = GP32 = SDA, bit 1 = GP33 = SCL.
var SIO_HI_IN:      u32 = 0xD0000008u32;
var SIO_HI_OUT_CLR: u32 = 0xD0000024u32;
var SIO_HI_OE_SET:  u32 = 0xD000003Cu32;
var SIO_HI_OE_CLR:  u32 = 0xD0000044u32;
var BB_SDA: u32 = 0x1u32;
var BB_SCL: u32 = 0x2u32;

var DS3231_ADDR: u32 = 0x68u32;     // DS3231 7-bit I2C address

var g_rtc_inited: i32 = 0;

// ~5 µs busy-loop @ 150 MHz core — keeps SCL period >= 10 µs (~100 kHz)
// even though we're bit-banging, well inside DS3231 standard-mode timing.
fn bb_delay() -> void {
    var i: i32 = 0;
    while i < 100 { i = i + 1; }
    return;
}

// Release a line: drop output-enable so the external pull-up wins.
fn bb_release(mask: u32) -> void {
    poke32(SIO_HI_OE_CLR, mask);
    return;
}

// Drive a line low: clear OUT then assert OE.
fn bb_drive_low(mask: u32) -> void {
    poke32(SIO_HI_OUT_CLR, mask);
    poke32(SIO_HI_OE_SET, mask);
    return;
}

fn bb_read_sda() -> i32 {
    if (peek32(SIO_HI_IN) & BB_SDA) != 0u32 { return 1; }
    return 0;
}

fn bb_start() -> void {
    bb_release(BB_SDA);
    bb_release(BB_SCL);
    bb_delay();
    bb_drive_low(BB_SDA);
    bb_delay();
    bb_drive_low(BB_SCL);
    return;
}

fn bb_stop() -> void {
    bb_drive_low(BB_SDA);
    bb_delay();
    bb_release(BB_SCL);
    bb_delay();
    bb_release(BB_SDA);
    bb_delay();
    return;
}

// Issue a repeated START between transactions of a combined transfer.
fn bb_restart() -> void {
    bb_release(BB_SDA);
    bb_delay();
    bb_release(BB_SCL);
    bb_delay();
    bb_drive_low(BB_SDA);
    bb_delay();
    bb_drive_low(BB_SCL);
    return;
}

fn bb_send_bit(b: i32) -> void {
    if b == 0 { bb_drive_low(BB_SDA); }
    else      { bb_release(BB_SDA); }
    bb_delay();
    bb_release(BB_SCL);
    bb_delay();
    bb_drive_low(BB_SCL);
    return;
}

fn bb_recv_bit() -> i32 {
    bb_release(BB_SDA);
    bb_delay();
    bb_release(BB_SCL);
    bb_delay();
    var v: i32 = bb_read_sda();
    bb_drive_low(BB_SCL);
    return v;
}

// Send 8 bits MSB-first; returns 0 if the slave ACKed, 1 if NAK.
fn bb_send_byte(b: u32) -> i32 {
    var i: i32 = 7;
    while i >= 0 {
        var bit: i32 = ((b >> (i as u32)) & 1u32) as i32;
        bb_send_bit(bit);
        i = i - 1;
    }
    return bb_recv_bit();
}

// Receive 8 bits MSB-first; send `ack` (0 = ACK = more bytes wanted,
// 1 = NAK = last byte) after the data byte.
fn bb_recv_byte(ack: i32) -> u32 {
    var v: u32 = 0u32;
    var i: i32 = 0;
    while i < 8 {
        v = v << 1u32;
        v = v | (bb_recv_bit() as u32);
        i = i + 1;
    }
    bb_send_bit(ack);
    return v;
}

// Bring up GP32 (SDA) / GP33 (SCL) as SIO with both pulled up and the
// lines idle (input + external pull-up wins). Idempotent.
fn rtc_pins_init() -> void {
    // PAD: clear ISO and PDE, set IE + PUE.
    poke32(RTC_PADS_CLR + 0x84u32, 0x104u32);
    poke32(RTC_PADS_CLR + 0x88u32, 0x104u32);
    poke32(RTC_PADS_SET + 0x84u32, 0x48u32);
    poke32(RTC_PADS_SET + 0x88u32, 0x48u32);
    // Funcsel = 5 (SIO).
    poke32(RTC_IO_BANK0 + 0x104u32, 5u32);
    poke32(RTC_IO_BANK0 + 0x10Cu32, 5u32);
    // OE off so both lines are inputs (pulled high externally / weakly).
    bb_release(BB_SDA);
    bb_release(BB_SCL);
    g_rtc_inited = 1;
    return;
}

fn bcd2dec(b: i32) -> i32 { return (b >> 4) * 10 + (b & 0xF); }
fn dec2bcd(d: i32) -> i32 { return ((d / 10) << 4) | (d % 10); }

// Read `n` bytes from the DS3231 starting at register `reg`.
// Returns 0 on success, -1 on NAK.
fn ds3231_read(reg: i32, buf: U8Array, n: i32) -> i32 {
    if g_rtc_inited == 0 { rtc_pins_init(); }
    // Phase 1: write the register pointer.
    bb_start();
    if bb_send_byte((DS3231_ADDR << 1u32) & 0xFEu32) != 0 {
        bb_stop();
        return -1;
    }
    if bb_send_byte(reg as u32) != 0 {
        bb_stop();
        return -1;
    }
    // Phase 2: repeated START + read.
    bb_restart();
    if bb_send_byte(((DS3231_ADDR << 1u32) & 0xFEu32) | 1u32) != 0 {
        bb_stop();
        return -1;
    }
    var i: i32 = 0;
    while i < n {
        var ack: i32 = 0;
        if i == n - 1 { ack = 1; }   // NAK the last byte before STOP.
        set(buf, i, bb_recv_byte(ack) as u8);
        i = i + 1;
    }
    bb_stop();
    return 0;
}

// Write `n` bytes to the DS3231 starting at register `reg`.
// Returns 0 on success, -1 on NAK.
fn ds3231_write(reg: i32, buf: U8Array, n: i32) -> i32 {
    if g_rtc_inited == 0 { rtc_pins_init(); }
    bb_start();
    if bb_send_byte((DS3231_ADDR << 1u32) & 0xFEu32) != 0 {
        bb_stop();
        return -1;
    }
    if bb_send_byte(reg as u32) != 0 {
        bb_stop();
        return -1;
    }
    var i: i32 = 0;
    while i < n {
        if bb_send_byte(get(buf, i) as u32) != 0 {
            bb_stop();
            return -1;
        }
        i = i + 1;
    }
    bb_stop();
    return 0;
}

// /dev/rtc backend: current time as seconds since the Unix epoch.
// Returns 0 (the epoch) if the DS3231 does not respond.
fn rtc_read_secs() -> u32 {
    if g_rtc_inited == 0 { rtc_pins_init(); }
    var buf: U8Array = U8Array(7u32);
    if ds3231_read(0, buf, 7) != 0 {
        delete(buf);
        return 0u32;
    }
    var ss:  i32 = bcd2dec((get(buf, 0) as i32) & 0x7F);
    var mm:  i32 = bcd2dec((get(buf, 1) as i32) & 0x7F);
    var hh:  i32 = bcd2dec((get(buf, 2) as i32) & 0x3F);  // 24-hour
    // buf[3] = day-of-week (DS3231-internal, unused here)
    var d:   i32 = bcd2dec((get(buf, 4) as i32) & 0x3F);
    var mon: i32 = bcd2dec((get(buf, 5) as i32) & 0x1F);
    var yr:  i32 = bcd2dec( get(buf, 6) as i32);
    delete(buf);
    return rtc_civil_to_secs((2000 + yr) as u32, mon as u32, d as u32,
                             hh as u32, mm as u32, ss as u32);
}

// /dev/rtc backend: set the clock from a Unix-epoch second count.
// Returns 0 on success, -1 if the DS3231 write fails.
fn rtc_set_secs(secs: u32) -> i32 {
    if g_rtc_inited == 0 { rtc_pins_init(); }
    rtc_secs_to_civil(secs);
    // DS3231 holds a 2-digit year + century bit; the OS clock lives in
    // 2000-2099, so store year-2000 with century 0.
    var yr: i32 = (rtc_cv_year() as i32) - 2000;
    if yr < 0  { yr = 0; }
    if yr > 99 { yr = yr % 100; }

    var buf: U8Array = U8Array(7u32);
    set(buf, 0, dec2bcd(rtc_cv_sec()   as i32) as u8);
    set(buf, 1, dec2bcd(rtc_cv_min()   as i32) as u8);
    set(buf, 2, dec2bcd(rtc_cv_hour()  as i32) as u8);  // bit 6 = 0: 24h
    set(buf, 3, 1u8);                                   // day-of-week
    set(buf, 4, dec2bcd(rtc_cv_day()   as i32) as u8);
    set(buf, 5, dec2bcd(rtc_cv_month() as i32) as u8);  // bit 7 = 0: century
    set(buf, 6, dec2bcd(yr) as u8);
    var rc: i32 = ds3231_write(0, buf, 7);
    delete(buf);
    if rc != 0 { return -1; }

    // Clear the status register (0x0F): drops the oscillator-stop flag
    // so a subsequent read is not treated as power-lost, and clears the
    // alarm flags. We do not use the DS3231 alarms.
    var st: U8Array = U8Array(1u32);
    set(st, 0, 0u8);
    var src: i32 = ds3231_write(0x0F, st, 1);
    delete(st);
    return 0;
}
