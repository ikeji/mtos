// kernel/display_ili9488.tc — ILI9488 SPI display backend for /dev/fb
// on the Pico 2 (RP2350). Phase 9 S3 + S4.
//
// Drives a 320x480 ILI9488 panel over a bit-banged 4-wire SPI bus on
// the 2026-05-21 board's high GPIO group (see docs/pico2_hardware.md):
//   GP38 DC   (0 = command, 1 = data)   GP39 CS  (active low)
//   GP40 SCK  GP41 MOSI  GP42 MISO      GP43 RST GP44 BL (backlight)
//
// The board labels GP40-43 as SCK/MOSI/MISO/CS but RP2350's SPI1
// peripheral wires SCLK/TX/RX/SS_N in a different order on those
// pins, so we drive the bus with software bit-bang via SIO. The
// panel is the only device, MISO is unused (write-only), so the
// loss of hardware SPI speed costs nothing observable for /dev/fb.
//
// Provides fb_backend_write, which devfs.tc forward-declares and calls
// for every /dev/fb framed blit. The framed-write protocol is the
// header [x][y][w][h][mode] (5x u16 LE) + payload:
//   mode 0 — w*h RGB565 pixels      mode 1 — one RGB565 fill colour
//   mode 2 — VSCRSADD scroll line
//
// ILI9488 over 4-wire SPI cannot do 16 bpp — it needs 18-bit pixel
// writes (3 bytes/pixel, COLMOD 0x66), so RGB565 is expanded per pixel.
//
// Hardware-only: qemu virt has no ILI9488, so this path is not
// exercised by `make test` — the virt kernel links dev_backend_virt.tc.

// SIO timer (kernel_pico2.tc) — used for the power-on delays.
fn read_mtime() -> u32;

// ===== RP2350 register addresses =====
var LCD_IO_BANK0:    u32 = 0x40028000u32;
var LCD_PADS_SET:    u32 = 0x4003A000u32;
var LCD_PADS_CLR:    u32 = 0x4003B000u32;
var LCD_SIO:         u32 = 0xD0000000u32;

// High-GPIO SIO offsets (GP32-47).
var LCD_HI_OUT_SET:  u32 = 0x01Cu32;
var LCD_HI_OUT_CLR:  u32 = 0x024u32;
var LCD_HI_OE_SET:   u32 = 0x03Cu32;

// Per-GPIO masks (n - 32) for all seven pins.
var LCD_DC_MASK:   u32 = 0x040u32;   // GP38
var LCD_CS_MASK:   u32 = 0x080u32;   // GP39
var LCD_SCK_MASK:  u32 = 0x100u32;   // GP40
var LCD_MOSI_MASK: u32 = 0x200u32;   // GP41
var LCD_RST_MASK:  u32 = 0x800u32;   // GP43
var LCD_BL_MASK:   u32 = 0x1000u32;  // GP44

// IO_BANK0 GPIO_CTRL offsets (= 4 + 8*n) for GP38-44.
var LCD_CTRL_DC:   u32 = 0x134u32;
var LCD_CTRL_CS:   u32 = 0x13Cu32;
var LCD_CTRL_SCK:  u32 = 0x144u32;
var LCD_CTRL_MOSI: u32 = 0x14Cu32;
var LCD_CTRL_MISO: u32 = 0x154u32;
var LCD_CTRL_RST:  u32 = 0x15Cu32;
var LCD_CTRL_BL:   u32 = 0x164u32;

// PADS_BANK0 offsets (= 4 + 4*n) for GP38-44.
var LCD_PAD_DC:   u32 = 0x09Cu32;
var LCD_PAD_CS:   u32 = 0x0A0u32;
var LCD_PAD_SCK:  u32 = 0x0A4u32;
var LCD_PAD_MOSI: u32 = 0x0A8u32;
var LCD_PAD_MISO: u32 = 0x0ACu32;
var LCD_PAD_RST:  u32 = 0x0B0u32;
var LCD_PAD_BL:   u32 = 0x0B4u32;

// SIO MTIME tick rate on the Pico 2 (~131.5 MHz — see kernel_pico2.tc).
var LCD_MTIME_PER_MS: u32 = 131500u32;

var g_lcd_inited: i32 = 0;

// Busy-wait `ms` milliseconds against the SIO timer.
fn lcd_delay_ms(ms: i32) -> void {
    var start: u32 = read_mtime();
    var want:  u32 = (ms as u32) * LCD_MTIME_PER_MS;
    while (read_mtime() - start) < want { }
    return;
}

// Drive one high-GPIO line high (hi != 0) or low.
fn lcd_gpio(mask: u32, hi: i32) -> void {
    if hi != 0 {
        poke32(LCD_SIO + LCD_HI_OUT_SET, mask);
    } else {
        poke32(LCD_SIO + LCD_HI_OUT_CLR, mask);
    }
    return;
}

// Shift one byte out MSB-first by toggling SCK/MOSI. SPI mode 0
// (CPOL=0, CPHA=0): MOSI changes while SCK is low, slave samples on
// rising SCK edge. No MISO read — the ILI9488 is write-only here.
fn lcd_spi(b: i32) -> void {
    var out: u32 = (b & 0xFF) as u32;
    var i: i32 = 0;
    while i < 8 {
        if (out & 0x80u32) == 0u32 {
            poke32(LCD_SIO + LCD_HI_OUT_CLR, LCD_MOSI_MASK);
        } else {
            poke32(LCD_SIO + LCD_HI_OUT_SET, LCD_MOSI_MASK);
        }
        out = out << 1u32;
        poke32(LCD_SIO + LCD_HI_OUT_SET, LCD_SCK_MASK);
        poke32(LCD_SIO + LCD_HI_OUT_CLR, LCD_SCK_MASK);
        i = i + 1;
    }
    return;
}

// Send a command byte (DC = 0) / a data byte (DC = 1).
fn lcd_cmd(c: i32) -> void { lcd_gpio(LCD_DC_MASK, 0); lcd_spi(c); return; }
fn lcd_dat(d: i32) -> void { lcd_gpio(LCD_DC_MASK, 1); lcd_spi(d); return; }

// Read a little-endian u16 from a raw address.
fn fb_rd16(addr: u32) -> i32 {
    return (peek8(addr) as i32) | ((peek8(addr + 1u32) as i32) << 8);
}

// Bring up the bit-banged SPI + the ILI9488. Idempotent.
fn lcd_init() -> void {
    if g_lcd_inited != 0 { return; }

    // 1. Funcsel 5 (SIOB_PROC) on all seven LCD pins.
    poke32(LCD_IO_BANK0 + LCD_CTRL_DC,   5u32);
    poke32(LCD_IO_BANK0 + LCD_CTRL_CS,   5u32);
    poke32(LCD_IO_BANK0 + LCD_CTRL_SCK,  5u32);
    poke32(LCD_IO_BANK0 + LCD_CTRL_MOSI, 5u32);
    poke32(LCD_IO_BANK0 + LCD_CTRL_MISO, 5u32);
    poke32(LCD_IO_BANK0 + LCD_CTRL_RST,  5u32);
    poke32(LCD_IO_BANK0 + LCD_CTRL_BL,   5u32);

    // 2. Pads: clear ISO (bit 8) on all seven.
    poke32(LCD_PADS_CLR + LCD_PAD_DC,   0x100u32);
    poke32(LCD_PADS_CLR + LCD_PAD_CS,   0x100u32);
    poke32(LCD_PADS_CLR + LCD_PAD_SCK,  0x100u32);
    poke32(LCD_PADS_CLR + LCD_PAD_MOSI, 0x100u32);
    poke32(LCD_PADS_CLR + LCD_PAD_MISO, 0x100u32);
    poke32(LCD_PADS_CLR + LCD_PAD_RST,  0x100u32);
    poke32(LCD_PADS_CLR + LCD_PAD_BL,   0x100u32);

    // 3. Idle the control lines, then enable their outputs: CS + RST
    //    high (idle), DC + BL + SCK + MOSI low. MISO stays input.
    poke32(LCD_SIO + LCD_HI_OUT_SET, LCD_CS_MASK | LCD_RST_MASK);
    poke32(LCD_SIO + LCD_HI_OUT_CLR,
        LCD_DC_MASK | LCD_BL_MASK | LCD_SCK_MASK | LCD_MOSI_MASK);
    poke32(LCD_SIO + LCD_HI_OE_SET,
        LCD_DC_MASK | LCD_CS_MASK | LCD_SCK_MASK | LCD_MOSI_MASK |
        LCD_RST_MASK | LCD_BL_MASK);

    // 4. Backlight on; hardware reset pulse (RST low ~20 ms).
    lcd_gpio(LCD_BL_MASK, 1);
    lcd_gpio(LCD_RST_MASK, 1);  lcd_delay_ms(5);
    lcd_gpio(LCD_RST_MASK, 0);  lcd_delay_ms(20);
    lcd_gpio(LCD_RST_MASK, 1);  lcd_delay_ms(150);

    // 5. CS low — a single device owns the bus, so it is held asserted.
    lcd_gpio(LCD_CS_MASK, 0);

    // 6. ILI9488 init. Software reset, power/VCOM, MADCTL, 18-bit
    //    pixel format, then the vertical-scroll area and display-on.
    //    Gamma (0xE0/0xE1) is left at reset defaults — fine for a
    //    text console; add it here if colours look off.
    lcd_cmd(0x01);  lcd_delay_ms(120);                          // SWRESET
    lcd_cmd(0xC0);  lcd_dat(0x17); lcd_dat(0x15);               // Power Ctl 1
    lcd_cmd(0xC1);  lcd_dat(0x41);                              // Power Ctl 2
    lcd_cmd(0xC5);  lcd_dat(0x00); lcd_dat(0x12); lcd_dat(0x80);// VCOM
    lcd_cmd(0x36);  lcd_dat(0x48);             // MADCTL: portrait, BGR
    lcd_cmd(0x3A);  lcd_dat(0x66);             // pixel format: 18 bpp
    lcd_cmd(0xB0);  lcd_dat(0x00);             // interface mode control
    lcd_cmd(0xB1);  lcd_dat(0xA0);             // frame rate
    lcd_cmd(0xB4);  lcd_dat(0x02);             // display inversion control
    lcd_cmd(0xB6);  lcd_dat(0x02); lcd_dat(0x02); lcd_dat(0x3B);// disp func
    // Vertical scroll: full 480-line area (TFA = 0, VSA = 480, BFA = 0).
    lcd_cmd(0x33);
    lcd_dat(0x00); lcd_dat(0x00);
    lcd_dat(0x01); lcd_dat(0xE0);
    lcd_dat(0x00); lcd_dat(0x00);
    lcd_cmd(0x11);  lcd_delay_ms(120);         // sleep out
    lcd_cmd(0x29);                             // display on

    g_lcd_inited = 1;
    return;
}

// Set the GRAM address window to (x0,y0)-(x1,y1) and issue RAMWR, so
// the bytes that follow are pixel data.
fn lcd_window(x0: i32, y0: i32, x1: i32, y1: i32) -> void {
    lcd_cmd(0x2A);                                  // CASET
    lcd_dat((x0 >> 8) & 0xFF); lcd_dat(x0 & 0xFF);
    lcd_dat((x1 >> 8) & 0xFF); lcd_dat(x1 & 0xFF);
    lcd_cmd(0x2B);                                  // PASET
    lcd_dat((y0 >> 8) & 0xFF); lcd_dat(y0 & 0xFF);
    lcd_dat((y1 >> 8) & 0xFF); lcd_dat(y1 & 0xFF);
    lcd_cmd(0x2C);                                  // RAMWR
    return;
}

// Push one RGB565 colour as a single 18-bit ILI9488 pixel (3 bytes:
// each colour component left-justified in its byte).
fn lcd_pixel(c: i32) -> void {
    lcd_dat(((c >> 11) & 0x1F) << 3);   // R: 5 bits -> bits 7..3
    lcd_dat(((c >> 5)  & 0x3F) << 2);   // G: 6 bits -> bits 7..2
    lcd_dat(( c        & 0x1F) << 3);   // B: 5 bits -> bits 7..3
    return;
}

// mode 1: fill the rect (x,y,w,h) with one RGB565 colour.
fn lcd_fill(x: i32, y: i32, w: i32, h: i32, col: i32) -> void {
    if w <= 0 || h <= 0 { return; }
    lcd_window(x, y, x + w - 1, y + h - 1);
    var rb: i32 = ((col >> 11) & 0x1F) << 3;
    var gb: i32 = ((col >> 5)  & 0x3F) << 2;
    var bb: i32 = ( col        & 0x1F) << 3;
    var count: i32 = w * h;
    var i: i32 = 0;
    while i < count {
        lcd_dat(rb); lcd_dat(gb); lcd_dat(bb);
        i = i + 1;
    }
    return;
}

// mode 0: blit w*h RGB565 pixels from `pix` into the rect (x,y,w,h).
fn lcd_blit(x: i32, y: i32, w: i32, h: i32, pix: u32) -> void {
    if w <= 0 || h <= 0 { return; }
    lcd_window(x, y, x + w - 1, y + h - 1);
    var count: i32 = w * h;
    var i: i32 = 0;
    while i < count {
        var o: u32 = pix + ((i * 2) as u32);
        lcd_pixel((peek8(o) as i32) | ((peek8(o + 1u32) as i32) << 8));
        i = i + 1;
    }
    return;
}

// /dev/fb backend: render one framed blit.
export fn fb_backend_write(buf_addr: u32, n: i32) -> void {
    if g_lcd_inited == 0 { lcd_init(); }
    if n < 10 { return; }
    var x:    i32 = fb_rd16(buf_addr);
    var y:    i32 = fb_rd16(buf_addr + 2u32);
    var w:    i32 = fb_rd16(buf_addr + 4u32);
    var h:    i32 = fb_rd16(buf_addr + 6u32);
    var mode: i32 = fb_rd16(buf_addr + 8u32);
    if mode == 0 {
        lcd_blit(x, y, w, h, buf_addr + 10u32);
    } else if mode == 1 {
        if n >= 12 { lcd_fill(x, y, w, h, fb_rd16(buf_addr + 10u32)); }
    } else if mode == 2 {
        // hardware vertical scroll — VSCRSADD
        if n >= 12 {
            lcd_cmd(0x37);
            var line: i32 = fb_rd16(buf_addr + 10u32);
            lcd_dat((line >> 8) & 0xFF);
            lcd_dat(line & 0xFF);
        }
    }
    return;
}
