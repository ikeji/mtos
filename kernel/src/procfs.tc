// procfs.tc — virtual filesystem rooted at /proc.
//
// Synthesized files (read-only snapshots):
//   /proc/tasks   — one line per scheduler slot:
//                   "<slot> <state> <frame> <wait_on>"
//                   state names: ready / done / unused / waiting
//   /proc/meminfo /proc/cpuinfo /proc/uptime /proc/diskinfo /proc/soc
//   /proc/kernel
//   /proc/self/cmdline    — the opening task's argv, space-joined + LF
//   /proc/self/env/<KEY>  — the opening task's env value + LF
//                           (docs/task/proc_env.md). `self` is resolved
//                           to sched_current_idx() at open / readdir time,
//                           so `echo 15 > /proc/self/env/ROWS` typed at sh
//                           lands in sh's env: the redirect is opened by
//                           sys_spawn_handler in sh's context.
//
// On open, we snapshot the contents into a kmalloc'd byte buffer and
// return a procfs-fd. sys_read consumes from the buffer. close frees
// the snapshot. Writes (env set) come in Phase 2.
//
// Concurrent readers: up to PROCFS_MAX_FDS (4) snapshots alive
// simultaneously. Each snapshot is its own buffer so readers don't
// see torn updates.

import "kernel_common.tc";

// Runtime allocator (compiler/runtime.tc)
fn kfree(ptr: u32) -> void;
fn km_peak_bytes() -> i32;
fn km_curr_bytes() -> i32;
fn km_heap_bytes() -> i32;
fn km_free_bytes() -> i32;
fn km_largest_free() -> i32;

// Per-FS stats consumed by synth_diskinfo. mtfs / tmpfs are always
// present; fatfs is optional (vfs_fatfs_ready reports the mount).
fn mtfs_total_bytes() -> i32;
fn mtfs_file_count() -> i32;
fn tmpfs_file_count() -> i32;
fn tmpfs_max_files()  -> i32;
fn tmpfs_used_bytes() -> i32;
fn vfs_fatfs_ready()  -> i32;
fn fatfs_total_kib()  -> i32;
fn fatfs_free_kib()   -> i32;

var PROCFS_MAX_FDS: i32 = 4;

struct ProcFD {
    // kmalloc'd U8Array holding the synthesized file contents. 0u32
    // means this slot is free.
    buf:  u32,
    size: i32,
    pos:  i32,
}

var g_procfs_fds:   ProcFDArray = 0 as ProcFDArray;
var g_procfs_ready: i32 = 0;

export fn procfs_init() -> void {
    if g_procfs_ready != 0 { return; }
    g_procfs_fds = ProcFDArray(PROCFS_MAX_FDS as u32);
    var i: i32 = 0;
    while i < PROCFS_MAX_FDS {
        set(g_procfs_fds, i, ProcFD(0, 0, 0));
        i = i + 1;
    }
    g_procfs_ready = 1;
    return;
}

// ===== helpers =====

var g_procfs_warned: i32 = 0;

fn append_byte(buf: U8Array, pos: i32, c: u8, cap: i32) -> i32 {
    if pos < cap {
        set(buf, pos, c);
        return pos + 1;
    }
    // Overflow: don't advance pos past cap. The final poke32(buf, pos)
    // then writes a correct length and procfs_read stays in bounds.
    // Emit a one-shot warning so a subsequent truncation is noticed.
    if g_procfs_warned == 0 {
        kputs("procfs: output buffer truncated\n");
        g_procfs_warned = 1;
    }
    return pos;
}

fn append_dec(buf: U8Array, pos: i32, v: i32, cap: i32) -> i32 {
    var x: i32 = v;
    var sign: i32 = 0;
    if x < 0 { sign = 1; x = 0 - x; }
    if x == 0 {
        return append_byte(buf, pos, '0' as u8, cap);
    }
    // write digits LSB first, then reverse
    var d: U8Array = U8Array(12);
    var n: i32 = 0;
    while x > 0 {
        set(d, n, ('0' as i32 + x % 10) as u8);
        n = n + 1;
        x = x / 10;
    }
    if sign == 1 { pos = append_byte(buf, pos, '-' as u8, cap); }
    while n > 0 {
        n = n - 1;
        pos = append_byte(buf, pos, get(d, n), cap);
    }
    delete(d);
    return pos;
}

fn append_hex(buf: U8Array, pos: i32, v: u32, cap: i32) -> i32 {
    pos = append_byte(buf, pos, '0' as u8, cap);
    pos = append_byte(buf, pos, 'x' as u8, cap);
    var d: U8Array = U8Array(8);
    var n: i32 = 0;
    var x: u32 = v;
    if x == 0u32 {
        pos = append_byte(buf, pos, '0' as u8, cap);
        delete(d);
        return pos;
    }
    while x > 0u32 {
        var dig: i32 = (x & 15u32) as i32;
        var c: u8 = 0u8;
        if dig < 10 { c = (dig + 48) as u8; }
        else { c = (dig - 10 + 97) as u8; }
        set(d, n, c);
        n = n + 1;
        x = x >> 4u32;
    }
    while n > 0 {
        n = n - 1;
        pos = append_byte(buf, pos, get(d, n), cap);
    }
    delete(d);
    return pos;
}

fn append_str(buf: U8Array, pos: i32, s: StringLiteral, cap: i32) -> i32 {
    var sl: i32 = len(s);
    var i: i32 = 0;
    while i < sl {
        pos = append_byte(buf, pos, get(s, i), cap);
        i = i + 1;
    }
    return pos;
}

fn state_name(s: i32) -> StringLiteral {
    if s == 0 { return "ready"; }
    if s == 1 { return "done"; }
    if s == 2 { return "unused"; }
    if s == 3 { return "waiting"; }
    if s == 4 { return "sleep"; }
    return "?";
}

// Snapshot /proc/tasks into a new kmalloc'd buffer. Returns header
// address (U8Array), caller uses buf+4 as data. The buffer is sized
// to fit N slots × ~64 bytes = ~512 bytes max.
fn synth_tasks() -> u32 {
    var cap: i32 = 4096;
    var buf: U8Array = U8Array(cap as u32);
    var pos: i32 = 0;
    pos = append_str(buf, pos, "SLOT STATE   FRAME      WAIT RAM    STACK  NAME\n", cap);
    var n: i32 = sched_task_count();
    var i: i32 = 0;
    while i < n {
        pos = append_dec(buf, pos, i, cap);
        pos = append_byte(buf, pos, ' ' as u8, cap);
        pos = append_str(buf, pos, state_name(task_get_state(i)), cap);
        pos = append_byte(buf, pos, ' ' as u8, cap);
        pos = append_hex(buf, pos, task_get_frame(i), cap);
        pos = append_byte(buf, pos, ' ' as u8, cap);
        pos = append_dec(buf, pos, task_get_wait_on(i), cap);
        pos = append_byte(buf, pos, ' ' as u8, cap);
        pos = append_dec(buf, pos, task_get_ram_size(i), cap);
        pos = append_byte(buf, pos, ' ' as u8, cap);
        pos = append_dec(buf, pos, task_get_stack_size(i), cap);
        pos = append_byte(buf, pos, ' ' as u8, cap);
        var nm: U8Array = task_get_name(i);
        if nm as u32 != 0u32 {
            // task_set_name* store the NUL past the count, so len(nm) is
            // the name length already; only strip a NUL if one is counted.
            var nlen: i32 = len(nm);
            if nlen > 0 && get(nm, nlen - 1) == 0u8 { nlen = nlen - 1; }
            var j: i32 = 0;
            while j < nlen {
                pos = append_byte(buf, pos, get(nm, j), cap);
                j = j + 1;
            }
        } else {
            pos = append_str(buf, pos, "-", cap);
        }
        pos = append_byte(buf, pos, 10u8, cap);
        i = i + 1;
    }
    // overwrite the U8Array length prefix with the actual content size
    poke32(buf as u32, pos as u32);
    return buf as u32;
}

// /proc/meminfo — kernel heap (runtime.tc kmalloc arena) in bytes:
//   total: <heap size>        used: <live blocks incl. headers>
//   free:  total - used        peak: high-water mark of used
//   largest: biggest contiguous free block (max single allocation)
fn synth_meminfo() -> u32 {
    var cap: i32 = 256;
    var buf: U8Array = U8Array(cap as u32);
    var pos: i32 = 0;
    pos = append_str(buf, pos, "total: ", cap);
    pos = append_dec(buf, pos, km_heap_bytes(), cap);
    pos = append_byte(buf, pos, 10u8, cap);
    pos = append_str(buf, pos, "used: ", cap);
    pos = append_dec(buf, pos, km_curr_bytes(), cap);
    pos = append_byte(buf, pos, 10u8, cap);
    pos = append_str(buf, pos, "free: ", cap);
    pos = append_dec(buf, pos, km_free_bytes(), cap);
    pos = append_byte(buf, pos, 10u8, cap);
    pos = append_str(buf, pos, "peak: ", cap);
    pos = append_dec(buf, pos, km_peak_bytes(), cap);
    pos = append_byte(buf, pos, 10u8, cap);
    pos = append_str(buf, pos, "largest: ", cap);
    pos = append_dec(buf, pos, km_largest_free(), cap);
    pos = append_byte(buf, pos, 10u8, cap);
    poke32(buf as u32, pos as u32);
    return buf as u32;
}

// /proc/diskinfo — one whitespace-separated line per mounted FS:
//   name path key=value [key=value...]
// keys:
//   total=<bytes>   total capacity (mtfs)
//   files=<n>/<m>   used / max file slots (tmpfs)
//   used=<bytes>    bytes in use (tmpfs)
//   total_kib=<n>   total capacity in KiB (fatfs, fits >2 GB in i32)
//   free_kib=<n>    free capacity in KiB (fatfs, -1 if not scanned)
// Lines are ordered mtfs, tmpfs, fatfs. fatfs only appears when mounted.
fn synth_diskinfo() -> u32 {
    var cap: i32 = 256;
    var buf: U8Array = U8Array(cap as u32);
    var pos: i32 = 0;
    // mtfs
    pos = append_str(buf, pos, "mtfs / total=", cap);
    pos = append_dec(buf, pos, mtfs_total_bytes(), cap);
    pos = append_str(buf, pos, " files=", cap);
    pos = append_dec(buf, pos, mtfs_file_count(), cap);
    pos = append_byte(buf, pos, 10u8, cap);
    // tmpfs
    pos = append_str(buf, pos, "tmpfs /tmp files=", cap);
    pos = append_dec(buf, pos, tmpfs_file_count(), cap);
    pos = append_byte(buf, pos, '/' as u8, cap);
    pos = append_dec(buf, pos, tmpfs_max_files(), cap);
    pos = append_str(buf, pos, " used=", cap);
    pos = append_dec(buf, pos, tmpfs_used_bytes(), cap);
    pos = append_byte(buf, pos, 10u8, cap);
    // fatfs (only when mounted)
    if vfs_fatfs_ready() != 0 {
        pos = append_str(buf, pos, "fatfs /sd total_kib=", cap);
        pos = append_dec(buf, pos, fatfs_total_kib(), cap);
        pos = append_str(buf, pos, " free_kib=", cap);
        pos = append_dec(buf, pos, fatfs_free_kib(), cap);
        pos = append_byte(buf, pos, 10u8, cap);
    }
    poke32(buf as u32, pos as u32);
    return buf as u32;
}

fn synth_cpuinfo() -> u32 {
    var cap: i32 = 128;
    var buf: U8Array = U8Array(cap as u32);
    var pos: i32 = 0;
    pos = append_str(buf, pos, "arch: rv32ima\n", cap);
    poke32(buf as u32, pos as u32);
    return buf as u32;
}

// Append a NUL-terminated C string living at `addr` (a linked-in .string, not
// a TC String — hence the byte loop).
fn append_cstr(buf: U8Array, pos: i32, addr: u32, cap: i32) -> i32 {
    var i: i32 = 0;
    while pos < cap {
        var c: u8 = peek8(addr + (i as u32));
        if c == 0u8 { return pos; }
        set(buf, pos, c);
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}

// /proc/soc — which SoC/gateware this kernel is running on. On tn20k `build`
// is the git hash the bitstream was synthesized from, so a stale FPGA image is
// visible without reflashing to check.
fn synth_soc() -> u32 {
    var cap: i32 = 128;
    var buf: U8Array = U8Array(cap as u32);
    var pos: i32 = 0;
    pos = append_str(buf, pos, "soc: ", cap);
    pos = append_str(buf, pos, kern_soc_name(), cap);
    pos = append_byte(buf, pos, 10u8, cap);
    var id: u32 = kern_soc_id();
    pos = append_str(buf, pos, "build: ", cap);
    if id == 0u32 {
        pos = append_str(buf, pos, "n/a", cap);
    } else {
        // Exactly 7 nibbles, zero-padded — append_hex would drop the leading
        // zero of a hash like 0abc123 and stop matching `git log --oneline`.
        var sh: i32 = 24;
        while sh >= 0 {
            var dig: i32 = ((id >> (sh as u32)) & 15u32) as i32;
            if dig < 10 { pos = append_byte(buf, pos, (dig + 48) as u8, cap); }
            else { pos = append_byte(buf, pos, (dig - 10 + 97) as u8, cap); }
            sh = sh - 4;
        }
        if (id & 0x80000000u32) != 0u32 {
            pos = append_str(buf, pos, "+dirty", cap);
        }
    }
    pos = append_byte(buf, pos, 10u8, cap);
    poke32(buf as u32, pos as u32);
    return buf as u32;
}

// /proc/kernel — which kernel binary is running. See kernel/scripts/gen_build_id.sh.
fn synth_kernel() -> u32 {
    var cap: i32 = 128;
    var buf: U8Array = U8Array(cap as u32);
    var pos: i32 = 0;
    pos = append_str(buf, pos, "kernel: mtos\n", cap);
    pos = append_str(buf, pos, "build: ", cap);
    var addr: u32 = kern_kernel_build_addr();
    if addr == 0u32 {
        // Platform links no stamp (pico2) — the mtfs is inside the kernel image
        // there, so /etc/version identifies this binary.
        pos = append_str(buf, pos, "see /etc/version", cap);
    } else {
        pos = append_cstr(buf, pos, addr, cap);
    }
    pos = append_byte(buf, pos, 10u8, cap);
    poke32(buf as u32, pos as u32);
    return buf as u32;
}

fn synth_uptime() -> u32 {
    var cap: i32 = 64;
    var buf: U8Array = U8Array(cap as u32);
    var pos: i32 = 0;
    pos = append_str(buf, pos, "mtime: ", cap);
    // read_mtime returns u32; cast to i32 for append_dec (wraps at ~214s @10MHz)
    var mt: u32 = kern_read_mtime();
    pos = append_hex(buf, pos, mt, cap);
    pos = append_byte(buf, pos, 10u8, cap);
    poke32(buf as u32, pos as u32);
    return buf as u32;
}

// /proc/self/cmdline — argv joined by single spaces + LF. Init tasks
// (kern.conf, no argv) show their task name instead.
fn synth_cmdline(slot: i32) -> u32 {
    var cap: i32 = 256;
    var buf: U8Array = U8Array(cap as u32);
    var pos: i32 = 0;
    var argv: u32 = task_get_argv(slot);
    if argv == 0u32 {
        var nm: U8Array = task_get_name(slot);
        if nm as u32 != 0u32 {
            var nlen: i32 = len(nm);
            if nlen > 0 && get(nm, nlen - 1) == 0u8 { nlen = nlen - 1; }
            var j: i32 = 0;
            while j < nlen { pos = append_byte(buf, pos, get(nm, j), cap); j = j + 1; }
        }
    } else {
        // Packed layout (loader.tc pack_argv_at):
        //   [count][ptr_i ...] with each ptr → [len][bytes]
        var n: i32 = peek32(argv) as i32;
        var i: i32 = 0;
        while i < n {
            if i > 0 { pos = append_byte(buf, pos, ' ' as u8, cap); }
            var sp: u32 = peek32(argv + ((4 + 4 * i) as u32));
            if sp != 0u32 {
                var slen: i32 = peek32(sp) as i32;
                var j: i32 = 0;
                while j < slen {
                    pos = append_byte(buf, pos, peek8(sp + 4u32 + (j as u32)), cap);
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }
    pos = append_byte(buf, pos, 10u8, cap);
    poke32(buf as u32, pos as u32);
    return buf as u32;
}

// /proc/self/env/<KEY> read: value + LF, or 0 when the key is unset
// (→ open fails, like a missing file).
fn synth_env_value(slot: i32, key_addr: u32, klen: i32) -> u32 {
    var cap: i32 = 160;                    // ENV_VAL_MAX (127) + LF
    var buf: U8Array = U8Array(cap as u32);
    var vlen: i32 = task_env_get(slot, key_addr, klen, buf as u32 + 4u32, cap - 1);
    if vlen < 0 { delete(buf); return 0u32; }
    if vlen > cap - 1 { vlen = cap - 1; }
    set(buf, vlen, 10u8);
    poke32(buf as u32, (vlen + 1) as u32);
    return buf as u32;
}

// True iff path[0..plen) starts with `prefix`.
fn path_prefix(path_addr: u32, plen: i32, prefix: StringLiteral) -> bool {
    var pl: i32 = len(prefix);
    if plen < pl { return false; }
    var i: i32 = 0;
    while i < pl {
        if peek8(path_addr + (i as u32)) != get(prefix, i) { return false; }
        i = i + 1;
    }
    return true;
}

// True iff path is exactly `s` or `s` + "/" (directory spellings).
fn path_is_dir(path_addr: u32, plen: i32, s: StringLiteral) -> bool {
    var sl: i32 = len(s);
    if plen == sl { return path_is(path_addr, plen, s); }
    if plen != sl + 1 { return false; }
    if peek8(path_addr + (sl as u32)) != '/' as u8 { return false; }
    return path_prefix(path_addr, plen, s);
}

// Env keys: [A-Za-z0-9_]+, 1..31 bytes (ENV_KEY_MAX in kernel_common).
fn env_key_ok(key_addr: u32, klen: i32) -> bool {
    if klen <= 0 || klen > 31 { return false; }
    var i: i32 = 0;
    while i < klen {
        var c: u8 = peek8(key_addr + (i as u32));
        var ok: bool = false;
        if c >= 'a' as u8 && c <= 'z' as u8 { ok = true; }
        if c >= 'A' as u8 && c <= 'Z' as u8 { ok = true; }
        if c >= '0' as u8 && c <= '9' as u8 { ok = true; }
        if c == '_' as u8 { ok = true; }
        if !ok { return false; }
        i = i + 1;
    }
    return true;
}

const PROC_ENV_PREFIX_LEN: i32 = 15;   // len("/proc/self/env/")

// Match path against "/proc/tasks"; return true if so.
fn path_is(path_addr: u32, plen: i32, s: StringLiteral) -> bool {
    var sl: i32 = len(s);
    if plen != sl { return false; }
    var i: i32 = 0;
    while i < sl {
        if peek8(path_addr + (i as u32)) != get(s, i) { return false; }
        i = i + 1;
    }
    return true;
}

export fn procfs_open(path_addr: u32, plen: i32, flags: i32) -> i32 {
    procfs_init();
    var buf_hdr: u32 = 0u32;
    var size: i32 = 0;
    if path_prefix(path_addr, plen, "/proc/self/env/") {
        var key_addr: u32 = path_addr + (PROC_ENV_PREFIX_LEN as u32);
        var klen: i32 = plen - PROC_ENV_PREFIX_LEN;
        if !env_key_ok(key_addr, klen) { return -1; }
        // O_WRONLY / O_RDWR / O_CREAT / O_TRUNC: env set (Phase 2).
        if (flags & (1 | 2 | 64 | 512)) != 0 { return -1; }
        buf_hdr = synth_env_value(sched_current_idx(), key_addr, klen);
        if buf_hdr == 0u32 { return -1; }
    } else if path_is(path_addr, plen, "/proc/self/cmdline") {
        buf_hdr = synth_cmdline(sched_current_idx());
    } else if path_is(path_addr, plen, "/proc/tasks") {
        buf_hdr = synth_tasks();
    } else if path_is(path_addr, plen, "/proc/meminfo") {
        buf_hdr = synth_meminfo();
    } else if path_is(path_addr, plen, "/proc/cpuinfo") {
        buf_hdr = synth_cpuinfo();
    } else if path_is(path_addr, plen, "/proc/uptime") {
        buf_hdr = synth_uptime();
    } else if path_is(path_addr, plen, "/proc/diskinfo") {
        buf_hdr = synth_diskinfo();
    } else if path_is(path_addr, plen, "/proc/soc") {
        buf_hdr = synth_soc();
    } else if path_is(path_addr, plen, "/proc/kernel") {
        buf_hdr = synth_kernel();
    } else {
        return -1;
    }
    size = peek32(buf_hdr) as i32;
    // Allocate procfs fd
    var i: i32 = 0;
    while i < PROCFS_MAX_FDS {
        var e: ProcFD = get(g_procfs_fds, i);
        if buf(e) == 0u32 {
            buf(e, buf_hdr);
            size(e, size);
            pos(e, 0);
            return i;
        }
        i = i + 1;
    }
    // Table full
    kputs("procfs: fd table full\n");
    if buf_hdr != 0u32 { kfree(buf_hdr); }
    return -1;
}

export fn procfs_read(fd: i32, buf_addr: u32, n: i32) -> i32 {
    if fd < 0 || fd >= PROCFS_MAX_FDS { return -1; }
    var e: ProcFD = get(g_procfs_fds, fd);
    if buf(e) == 0u32 { return -1; }
    var remain: i32 = size(e) - pos(e);
    var want: i32 = n;
    if want > remain { want = remain; }
    if want <= 0 { return 0; }
    var src: u32 = buf(e) + 4u32 + (pos(e) as u32);
    var i: i32 = 0;
    while i < want {
        poke8(buf_addr + (i as u32), peek8(src + (i as u32)) as u8);
        i = i + 1;
    }
    pos(e, pos(e) + want);
    return want;
}

export fn procfs_size(fd: i32) -> i32 {
    if fd < 0 || fd >= PROCFS_MAX_FDS { return -1; }
    var e: ProcFD = get(g_procfs_fds, fd);
    if buf(e) == 0u32 { return -1; }
    return size(e);
}

export fn procfs_close(fd: i32) -> i32 {
    if fd < 0 || fd >= PROCFS_MAX_FDS { return -1; }
    var e: ProcFD = get(g_procfs_fds, fd);
    if buf(e) != 0u32 { kfree(buf(e)); }
    buf(e, 0);
    size(e, 0);
    pos(e, 0);
    return 0;
}

// Enumerate a /proc directory into `buf_addr` as NUL-separated names.
// Returns the number of bytes written (including trailing NULs), or -1
// when the path is not a procfs directory.
fn readdir_append_bytes(buf_addr: u32, buf_size: i32, pos: i32, src: u32, nlen: i32) -> i32 {
    if pos + nlen + 1 > buf_size { return pos; }
    var i: i32 = 0;
    while i < nlen {
        poke8(buf_addr + (pos as u32), peek8(src + (i as u32)));
        pos = pos + 1;
        i = i + 1;
    }
    poke8(buf_addr + (pos as u32), 0u8);
    return pos + 1;
}

fn readdir_append(buf_addr: u32, buf_size: i32, pos: i32, name: StringLiteral) -> i32 {
    var nlen: i32 = len(name);
    if pos + nlen + 1 > buf_size { return pos; }
    var i: i32 = 0;
    while i < nlen {
        poke8(buf_addr + (pos as u32), get(name, i));
        pos = pos + 1;
        i = i + 1;
    }
    poke8(buf_addr + (pos as u32), 0u8);
    return pos + 1;
}

export fn procfs_readdir(path_addr: u32, plen: i32, buf_addr: u32, buf_size: i32) -> i32 {
    var pos: i32 = 0;
    if path_is_dir(path_addr, plen, "/proc") {
        pos = readdir_append(buf_addr, buf_size, pos, "tasks");
        pos = readdir_append(buf_addr, buf_size, pos, "meminfo");
        pos = readdir_append(buf_addr, buf_size, pos, "cpuinfo");
        pos = readdir_append(buf_addr, buf_size, pos, "uptime");
        pos = readdir_append(buf_addr, buf_size, pos, "diskinfo");
        pos = readdir_append(buf_addr, buf_size, pos, "soc");
        pos = readdir_append(buf_addr, buf_size, pos, "kernel");
        pos = readdir_append(buf_addr, buf_size, pos, "self");
        return pos;
    }
    if path_is_dir(path_addr, plen, "/proc/self") {
        pos = readdir_append(buf_addr, buf_size, pos, "cmdline");
        pos = readdir_append(buf_addr, buf_size, pos, "env");
        return pos;
    }
    if path_is_dir(path_addr, plen, "/proc/self/env") {
        var slot: i32 = sched_current_idx();
        var key: U8Array = U8Array(32u32);
        var i: i32 = 0;
        var klen: i32 = task_env_key_at(slot, i, key as u32 + 4u32, 31);
        while klen >= 0 {
            if klen > 31 { klen = 31; }
            pos = readdir_append_bytes(buf_addr, buf_size, pos, key as u32 + 4u32, klen);
            i = i + 1;
            klen = task_env_key_at(slot, i, key as u32 + 4u32, 31);
        }
        delete(key);
        return pos;
    }
    return -1;
}
