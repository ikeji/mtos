// kernel/src/kernel_tn20k.tc — kernel main for the Tang Nano 20K (hw/ SoC).
//
// Derived from kernel.tc (qemu virt): same UART / CLINT / exit device
// addresses (the SoC mirrors virt), but the mtfs image is embedded in
// the kernel binary and served by block_flash.tc (XIP from SDRAM) like
// pico2, there is no virtio, no FAT (stub) and no RTC hardware (reads
// return 0). Timer constants assume mtime = 27 MHz CPU clock.
// See docs/task/tang_nano_20k.md Phase 4.
import "kernel_common.tc";
import "../platform/virt/platform_virt.tc";
// mtfs image embedded in the kernel (.incbin), XIP from SDRAM; no SD card
// yet (tn20k Phase 6) so FAT gets the stub. NOTE: no trailing comments on
// import lines — collect_imports.sh would not see them.
import "../platform/pico2/block_flash.tc";
import "../platform/virt/block_fat_stub.tc";
import "mtfs.tc";
import "fatfs.tc";
import "vfs.tc";
import "loader.tc";
// /dev/fb backend: a UART-dump stub (qemu virt has no SPI display).
// Defines fb_backend_write, which devfs.tc forward-declares.
// /dev/fb, /dev/kbd, /dev/touch backends: ILI9488 + matrix keyboard on the
// header GPIO (hw/ SoC SIO-compatible block), touch stubbed for now.
import "../platform/tn20k/display_ili9488.tc";
import "../platform/tn20k/keyboard_matrix.tc";
import "../platform/tn20k/touch_stub.tc";

// Assembly-defined functions
fn csr_read_mie() -> u32;
fn csr_write_mie(val: u32) -> void;
fn sched_start(frame: u32) -> void;

// Runtime allocator stats (compiler/runtime.tc)
fn km_live_count() -> i32;
fn println(v: i32) -> void;

// CLINT MMIO (qemu virt)
const MTIMECMP_LO: u32 = 0x02004000u32;
const MTIMECMP_HI: u32 = 0x02004004u32;
const MTIME_LO: u32    = 0x0200BFF8u32;
const MTIME_HI: u32    = 0x0200BFFCu32;
// hw/ SoC CLINT mtime runs at the CPU clock (27 MHz), so 27_000 ticks
// ≈ 1 ms between preemptions.
const TIMER_INTERVAL: u32 = 27000u32;

// Provided to kernel_common (called from trap_handler). 64-bit
// mtimecmp update: (a) guard against a spurious interrupt during the
// low / high writes by parking MTIMECMP_HI at 0xFFFFFFFF first;
// (b) read mtime_hi and carry so that past the 32-bit wrap
// (~7 min @ 10 MHz) the comparator stays ahead of mtime instead of
// hanging the scheduler.
fn rearm_timer() -> void {
    poke32(MTIMECMP_HI, 0xFFFFFFFFu32);
    var lo: u32 = peek32(MTIME_LO);
    var hi: u32 = peek32(MTIME_HI);
    var new_lo: u32 = lo + TIMER_INTERVAL;
    if new_lo < lo { hi = hi + 1u32; }
    poke32(MTIMECMP_LO, new_lo);
    poke32(MTIMECMP_HI, hi);
    return;
}

fn read_mtime() -> u32 {
    return peek32(MTIME_LO);
}

fn read_mtime_hi() -> u32 {
    return peek32(MTIME_HI);
}

// 27 MHz CLINT: 27000 ticks per millisecond
fn ticks_per_ms() -> u32 {
    return 27000u32;
}

// ===== goldfish-rtc (qemu virt) — backs /dev/rtc via rtc.tc =====
// qemu virt maps a goldfish-rtc at 0x101000. TIME_LOW (0x00) returns
// the low 32 bits of nanoseconds-since-epoch and latches the high
// 32 bits; TIME_HIGH (0x04) returns the latched high word.
const RTC_BASE: u32 = 0x101000u32;

// (hi:lo) / 1_000_000_000. The quotient (seconds) fits in u32.
fn rtc_div_1e9(hi: u32, lo: u32) -> u32 {
    var q:   u32 = 0u32;
    var rem: u32 = 0u32;
    var d:   u32 = 1000000000u32;
    var i: i32 = 63;
    while i >= 0 {
        var bit: u32 = 0u32;
        if i >= 32 {
            bit = (hi >> ((i - 32) as u32)) & 1u32;
        } else {
            bit = (lo >> (i as u32)) & 1u32;
        }
        rem = (rem << 1u32) | bit;
        q = q << 1u32;
        if rem >= d {
            rem = rem - d;
            q = q | 1u32;
        }
        i = i - 1;
    }
    return q;
}

fn rtc_read_secs() -> u32 {
    var lo: u32 = peek32(RTC_BASE);
    var hi: u32 = peek32(RTC_BASE + 4u32);
    return rtc_div_1e9(hi, lo);
}

fn rtc_set_secs(secs: u32) -> i32 {
    // ns = secs * 1_000_000_000 as a 64-bit (hi:lo) value via a
    // 16-bit-limb 32x32 multiply (1e9 = 15258 << 16 | 51712).
    var al: u32 = secs & 0xFFFFu32;
    var ah: u32 = secs >> 16u32;
    var p0: u32 = al * 51712u32;
    var p1: u32 = al * 15258u32;
    var p2: u32 = ah * 51712u32;
    var p3: u32 = ah * 15258u32;
    var lo: u32 = p0;
    var hi: u32 = p3;
    var t: u32 = lo + (p1 << 16u32);
    if t < lo { hi = hi + 1u32; }
    lo = t;
    hi = hi + (p1 >> 16u32);
    t = lo + (p2 << 16u32);
    if t < lo { hi = hi + 1u32; }
    lo = t;
    hi = hi + (p2 >> 16u32);
    // goldfish-rtc: write TIME_HIGH first, TIME_LOW commits.
    poke32(RTC_BASE + 4u32, hi);
    poke32(RTC_BASE, lo);
    return 0;
}

// Hex output helpers (used to dump sector 0 during bring-up)
fn kputchar(c: u8) -> void {
    var b: U8Array = U8Array(1);
    set(b, 0, c);
    sys_write(1, b, 1);
    delete(b);
    return;
}

fn kputs_hex8(x: u8) -> void {
    var hi: i32 = ((x as i32) >> 4) & 15;
    var lo: i32 = (x as i32) & 15;
    var c1: u8 = 0u8;
    var c2: u8 = 0u8;
    if hi < 10 { c1 = (hi + 48) as u8; } else { c1 = (hi - 10 + 97) as u8; }
    if lo < 10 { c2 = (lo + 48) as u8; } else { c2 = (lo - 10 + 97) as u8; }
    kputchar(c1);
    kputchar(c2);
    return;
}

fn dump_sector0() -> void {
    var buf: U8Array = U8Array(512);
    var n: i32 = block_read(0, buf);
    if n == 512 {
        kputs("SECTOR0:");
        var i: i32 = 0;
        while i < 16 {
            kputchar(' ');
            kputs_hex8(get(buf, i));
            i = i + 1;
        }
        kputs("\n");
    } else {
        kputs("SECTOR0: read failed\n");
    }
    delete(buf);
    return;
}

fn cat_hello_txt() -> void {
    var fd: i32 = vfs_open("/hello.txt" as String, 0);
    if fd < 0 {
        kputs("MTFS: hello.txt not found\n");
        return;
    }

    var buf: U8Array = U8Array(64);
    var n: i32 = vfs_read(fd, buf as u32 + 4u32, 64);
    if n > 0 {
        kputs("FILE:");
        vfs_write(1, buf as u32 + 4u32, n);
    } else {
        kputs("MTFS: read failed\n");
    }
    delete(buf);
    vfs_close(fd);
    return;
}

// Print "[N ms] " prefix for boot trace messages. N is wall-clock
// elapsed since power-on, computed from full 64-bit SIO_MTIME
// (kern_uptime_us / 1000) so it doesn't wrap every 32 sec the way
// reading just the low 32 bits would.
export fn kput_ms() -> void {
    var t: u32 = kern_uptime_us() / 1000u32;
    var buf: U8Array = U8Array(16);
    var n: i32 = 0;
    if t == 0u32 {
        set(buf, n, '0' as u8);
        n = n + 1;
    } else {
        var tmp: U8Array = U8Array(12);
        var k: i32 = 0;
        while t > 0u32 {
            set(tmp, k, ('0' as i32 + (t % 10u32) as i32) as u8);
            k = k + 1;
            t = t / 10u32;
        }
        while k > 0 {
            set(buf, n, get(tmp, k - 1));
            n = n + 1;
            k = k - 1;
        }
        delete(tmp);
    }
    uart_emit_frame("KERN", (buf as u32) + 4u32, n);
    uart_emit_frame("KERN", ("ms] " as u32) + 4u32, 4);
    delete(buf);
    return;
}

// kputs_t = kput_ms + kputs.  Use at boot trace points to make the
// per-step latency visible without re-reading kern.conf each time.
export fn kputs_t(s: StringLiteral) -> void {
    kputs("[");
    kput_ms();
    kputs(s);
    return;
}

fn main() -> i32 {
    kputs("KERN: starting\n");

    if block_init() != 0 {
        kputs("BLOCK: no mtfs image\n");
        return 1;
    }
    kputs("BLOCK: embedded mtfs image\n");
    dump_sector0();

    if vfs_init() != 0 {
        kputs("MTFS: mount failed\n");
        return 1;
    }
    kputs("MTFS: mounted\n");

    if fat_block_init() == 0 {
        if fatfs_mount() == 0 {
            kputs("FATFS: mounted\n");
            vfs_set_fatfs_ready();
        } else {
            kputs("FATFS: mount failed\n");
        }
    }

    cat_hello_txt();

    // 8 scheduler slots: slot 0 seeds /bin/sh, the remaining 7 are
    // reserved for sys_spawn children of the shell. The shell loops:
    // prompt → do_spawn("/bin/<cmd>") → do_wait(slot) → prompt ...
    // until it reads "quit".
    //
    // Per-task arena / stack sizes come from the 8-byte header at the
    // start of each task binary (see loader.tc's K3 section) — no more
    // hardcoded 16 MB blanket. crt0_data.s's arena stays big on virt
    // because the compiler tasks still need a few hundred KB each.
    kputs("KERN: sched_init\n");
    sched_init(8);
    kputs("KERN: start_init_tasks\n");

    // /etc/kern.conf (optional) overrides the init list + mux state.
    // start_init_tasks returns the number of slots populated from the
    // config, or 0 if no config was present.
    if start_init_tasks() == 0 {
        sched_register(0, load_task("/bin/sh"));
        var seed_nm: U8Array = to_cstr("sh");
        task_set_name(0, seed_nm);
        delete(seed_nm);
    }

    kputs("KERN: init tasks loaded, starting scheduler\n");
    rearm_timer();
    var mie: u32 = csr_read_mie();
    csr_write_mie(mie | 0x80u32);

    sched_start(sched_get_frame(0));

    kputs("\nKERN: all tasks done\n");
    // Leak canary: after the scheduler drains, only a few long-lived
    // kernel allocations (VFS fd table, block driver state, mtfs
    // inode cache...) should be outstanding. A regression that leaks
    // per-task frame_buf/ram/stack/img would push this count up
    // linearly with the number of spawn/wait cycles.
    kputs("KERN: live=");
    println(km_live_count());
    return 0;
}
