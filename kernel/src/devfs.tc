// kernel/devfs.tc — device filesystem rooted at /dev.
//
// Exposes hardware I/O endpoints as files. Unlike procfs (read-only
// status snapshots), devfs nodes are live device channels and may be
// both read and written.
//
// Nodes:
//   /dev/uart  — raw serial port (PL011 / 16550). Live, unbuffered:
//                read pulls from the kernel RX ring (-2 when empty so
//                the ecall handler yields), write goes straight to
//                the UART TX with no mux framing.
//   /dev/rtc   — real-time clock. read returns a one-shot snapshot
//                "YYYY-MM-DD HH:MM:SS\n" (EOF after). Writes are
//                accumulated and parsed+committed at close, because a
//                writer (e.g. /bin/echo) may split the datetime
//                string across several write() calls.
//   /dev/fb    — framebuffer. A write is a framed blit
//                [x:u16][y:u16][w:u16][h:u16][mode:u16] + payload;
//                1 blit = 1 write() (no framing state); read is not
//                supported. The backend (fb_backend_write) is
//                platform-specific: a real ILI9488 over SPI1 on pico2
//                (display_ili9488.tc), or a UART-dump stub on qemu
//                virt (dev_backend_virt.tc).
//   /dev/kbd   — keyboard. read returns a key-stream; -2 when no key
//                is available so the ecall handler yields. The backend
//                (kbd_backend_read) is platform-specific: a GPIO scan
//                matrix on pico2 (keyboard_matrix.tc), or a UART-RX
//                stub on qemu virt (dev_backend_virt.tc) so the serial
//                console doubles as the keyboard. Not writable.
//
// A small fd table backs buffered nodes: /dev/rtc snapshots its
// rendering at open so a `cat` terminates with EOF. /dev/uart and
// /dev/fb need no buffer (buf == 0).

import "kernel_common.tc";
import "rtc.tc";

// Platform UART helpers (platform_*.s / platform_*.tc).
fn do_uart_write(buf: u32, len: i32) -> i32;
fn uart_rx_pop(buf: u32, len: i32) -> i32;

// Runtime allocator (compiler/runtime.tc).
fn kfree(ptr: u32) -> void;

// Device ids.
const DEV_UART:  i32 = 0;
const DEV_RTC:   i32 = 1;
const DEV_FB:    i32 = 2;
const DEV_KBD:   i32 = 3;
const DEV_TOUCH: i32 = 4;

const DEVFS_MAX_FDS: i32 = 8;
// Data capacity of a buffered node's U8Array (after the 4-byte length
// prefix). Holds the RTC snapshot or an accumulated datetime write.
const DEVFS_BUF_CAP: i32 = 60;

struct DevFD {
    // dev:  device id, or -1 for a free slot.
    // buf:  U8Array header addr for buffered nodes (0 = live device).
    // size: snapshot length (read path).
    // pos:  read cursor.
    // wlen: bytes accumulated from write() calls (commit at close).
    dev:  i32,
    buf:  u32,
    size: i32,
    pos:  i32,
    wlen: i32,
}

var g_devfs_fds:   DevFDArray = 0 as DevFDArray;
var g_devfs_ready: i32 = 0;

fn devfs_init() -> void {
    if g_devfs_ready != 0 { return; }
    g_devfs_fds = DevFDArray(DEVFS_MAX_FDS as u32);
    var i: i32 = 0;
    while i < DEVFS_MAX_FDS {
        set(g_devfs_fds, i, DevFD(-1, 0u32, 0, 0, 0));
        i = i + 1;
    }
    g_devfs_ready = 1;
    return;
}

// Match a path against a literal (exact length).
fn dev_path_is(path_addr: u32, plen: i32, s: StringLiteral) -> bool {
    var sl: i32 = len(s);
    if plen != sl { return false; }
    var i: i32 = 0;
    while i < sl {
        if peek8(path_addr + (i as u32)) != get(s, i) { return false; }
        i = i + 1;
    }
    return true;
}

// Snapshot the RTC rendering into a fresh U8Array (4-byte length
// prefix + data, like procfs). Returns the header address.
fn devfs_snap_rtc() -> u32 {
    var buf: U8Array = U8Array((DEVFS_BUF_CAP + 4) as u32);
    var n: i32 = rtc_format((buf as u32) + 4u32);
    poke32(buf as u32, n as u32);
    return buf as u32;
}

// Allocate a devfs fd slot. Returns the slot index, or -1 if full.
fn devfs_alloc(dev: i32, buf_hdr: u32, size: i32) -> i32 {
    var i: i32 = 0;
    while i < DEVFS_MAX_FDS {
        var e: DevFD = get(g_devfs_fds, i);
        if dev(e) < 0 {
            dev(e, dev);
            buf(e, buf_hdr);
            size(e, size);
            pos(e, 0);
            wlen(e, 0);
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// ===== platform-specific device backend hooks =====
// Resolved at link time. pico2: kernel/display_ili9488.tc (a real
// ILI9488 over SPI1) + kernel/keyboard_matrix.tc (a GPIO scan matrix).
// qemu virt: kernel/dev_backend_virt.tc (a UART-dump fb stub that
// tests/fb_render.py can replay + a UART-RX keyboard stub).
//   fb_backend_write — devfs_write routes /dev/fb writes here.
//   kbd_backend_read — devfs_read routes /dev/kbd reads here; returns
//                      the byte count, 0 when no key is available.
fn fb_backend_write(buf_addr: u32, n: i32) -> void;
fn kbd_backend_read(buf_addr: u32, n: i32) -> i32;
// touch_backend_read — devfs_read routes /dev/touch reads here.
//   Returns 8 bytes per touch sample [x:u16 LE][y:u16 LE][z:u16 LE]
//   [state:u8 (1 = down)][reserved:u8] when n >= 8 and pen is down.
//   Returns 0 (and yields, as -2 at the ecall layer) while idle so a
//   tap-driven UI blocks cheaply. Platforms without a touch panel link
//   a stub that always returns 0.
fn touch_backend_read(buf_addr: u32, n: i32) -> i32;

// Open a /dev node. Returns a devfs slot index (>= 0) used as the
// VFS inner handle, or -1 if the path names no known device.
export fn devfs_open(path_addr: u32, plen: i32) -> i32 {
    devfs_init();
    if dev_path_is(path_addr, plen, "/dev/uart") {
        return devfs_alloc(DEV_UART, 0u32, 0);
    }
    if dev_path_is(path_addr, plen, "/dev/fb") {
        // Single-open: only one fd can hold /dev/fb at a time. A
        // foreground task that wants exclusive use of the LCD (e.g.
        // touchtest) asks the current owner (console) to close its
        // fd via ESC[?47h, retry-opens, then on exit lets sh send
        // ESC[?47l so console reopens + repaints. A second concurrent
        // open here means the protocol was skipped — refuse it
        // rather than have two fds racing on the same panel.
        var i: i32 = 0;
        while i < DEVFS_MAX_FDS {
            var e: DevFD = get(g_devfs_fds, i);
            if dev(e) == DEV_FB { return -1; }
            i = i + 1;
        }
        return devfs_alloc(DEV_FB, 0u32, 0);
    }
    if dev_path_is(path_addr, plen, "/dev/kbd") {
        return devfs_alloc(DEV_KBD, 0u32, 0);
    }
    if dev_path_is(path_addr, plen, "/dev/touch") {
        return devfs_alloc(DEV_TOUCH, 0u32, 0);
    }
    if dev_path_is(path_addr, plen, "/dev/rtc") {
        var hdr: u32 = devfs_snap_rtc();
        var size: i32 = peek32(hdr) as i32;
        var fd: i32 = devfs_alloc(DEV_RTC, hdr, size);
        if fd < 0 { kfree(hdr); }
        return fd;
    }
    return -1;
}

export fn devfs_read(fd: i32, buf_addr: u32, n: i32) -> i32 {
    if fd < 0 || fd >= DEVFS_MAX_FDS { return -1; }
    var e: DevFD = get(g_devfs_fds, fd);
    if dev(e) == DEV_UART {
        var nr: i32 = uart_rx_pop(buf_addr, n);
        if nr == 0 { return -2; }
        return nr;
    }
    if dev(e) == DEV_KBD {
        // Keyboard backend (platform-specific, like /dev/fb): the
        // GPIO matrix on pico2 (keyboard_matrix.tc) or a UART-RX stub
        // on qemu virt (dev_backend_virt.tc). 0 keys -> yield.
        var nk: i32 = kbd_backend_read(buf_addr, n);
        if nk == 0 { return -2; }
        return nk;
    }
    if dev(e) == DEV_TOUCH {
        // Touchscreen backend (pico2: XPT2046 over bit-bang SPI;
        // virt: stub returning 0). 0 → yield, otherwise byte count.
        var nt: i32 = touch_backend_read(buf_addr, n);
        if nt == 0 { return -2; }
        return nt;
    }
    // Buffered node: consume from the snapshot, EOF when drained.
    if buf(e) == 0u32 { return -1; }
    var remain: i32 = size(e) - pos(e);
    var want: i32 = n;
    if want > remain { want = remain; }
    if want <= 0 { return 0; }
    var src: u32 = buf(e) + 4u32 + (pos(e) as u32);
    var i: i32 = 0;
    while i < want {
        poke8(buf_addr + (i as u32), peek8(src + (i as u32)));
        i = i + 1;
    }
    pos(e, pos(e) + want);
    return want;
}

export fn devfs_write(fd: i32, buf_addr: u32, n: i32) -> i32 {
    if fd < 0 || fd >= DEVFS_MAX_FDS { return -1; }
    var e: DevFD = get(g_devfs_fds, fd);
    if dev(e) == DEV_UART {
        return do_uart_write(buf_addr, n);
    }
    if dev(e) == DEV_FB {
        fb_backend_write(buf_addr, n);
        return n;
    }
    if dev(e) == DEV_RTC {
        // Accumulate into the node buffer; the datetime string may
        // arrive split across calls. Committed at close.
        if buf(e) == 0u32 { return -1; }
        var wl: i32 = wlen(e);
        var w: i32 = 0;
        while w < n && wl < DEVFS_BUF_CAP {
            poke8(buf(e) + 4u32 + (wl as u32), peek8(buf_addr + (w as u32)));
            wl = wl + 1;
            w = w + 1;
        }
        wlen(e, wl);
        return n;
    }
    return -1;
}

export fn devfs_size(fd: i32) -> i32 {
    if fd < 0 || fd >= DEVFS_MAX_FDS { return -1; }
    var e: DevFD = get(g_devfs_fds, fd);
    if buf(e) == 0u32 { return -1; }
    return size(e);
}

export fn devfs_close(fd: i32) -> i32 {
    if fd < 0 || fd >= DEVFS_MAX_FDS { return -1; }
    var e: DevFD = get(g_devfs_fds, fd);
    // Commit an accumulated /dev/rtc write at close.
    if dev(e) == DEV_RTC && wlen(e) > 0 {
        rtc_parse_set(buf(e) + 4u32, wlen(e));
    }
    if buf(e) != 0u32 { kfree(buf(e)); }
    dev(e, -1);
    buf(e, 0u32);
    size(e, 0);
    pos(e, 0);
    wlen(e, 0);
    return 0;
}

// Enumerate /dev entries as NUL-separated names.
fn devfs_append(buf_addr: u32, buf_size: i32, pos: i32, name: StringLiteral) -> i32 {
    var nlen: i32 = len(name);
    if pos + nlen + 1 > buf_size { return pos; }
    var i: i32 = 0;
    while i < nlen {
        poke8(buf_addr + (pos as u32), get(name, i));
        pos = pos + 1;
        i = i + 1;
    }
    poke8(buf_addr + (pos as u32), 0u8);
    return pos + 1;
}

export fn devfs_readdir(buf_addr: u32, buf_size: i32) -> i32 {
    var pos: i32 = 0;
    pos = devfs_append(buf_addr, buf_size, pos, "uart");
    pos = devfs_append(buf_addr, buf_size, pos, "rtc");
    pos = devfs_append(buf_addr, buf_size, pos, "fb");
    pos = devfs_append(buf_addr, buf_size, pos, "kbd");
    return pos;
}
