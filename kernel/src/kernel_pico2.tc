// kernel_pico2.tc — preemptive multitasking kernel for RP2350 (Pico 2)

import "kernel_common.tc";
import "../platform/pico2/platform_pico2.tc";
import "../platform/pico2/block_flash.tc";
import "../platform/pico2/block_sd.tc";
import "fatfs.tc";
import "mtfs.tc";
import "vfs.tc";
import "loader.tc";
// /dev/rtc backend: DS3231 over I2C1. Defines rtc_read_secs /
// rtc_set_secs, which rtc.tc forward-declares.
import "../platform/pico2/rtc_ds3231.tc";
// /dev/fb backend: ILI9488 over SPI1. Defines fb_backend_write,
// which devfs.tc forward-declares.
import "../platform/pico2/display_ili9488.tc";
// /dev/kbd backend: GPIO scan matrix. Defines kbd_backend_read.
import "../platform/pico2/keyboard_matrix.tc";

fn csr_read_mie() -> u32;
fn csr_write_mie(val: u32) -> void;
fn sched_start(frame: u32) -> void;
fn do_uart_write(buf: u32, len: i32) -> i32;
fn _mtfs_image_addr() -> u32;
fn _mtfs_image_size_value() -> u32;

// RP2350 SIO timer (from pico-sdk)
var SIO_MTIME_CTRL: u32 = 0xD00001A4u32;
var SIO_MTIME_L: u32    = 0xD00001B0u32;
var SIO_MTIME_H: u32    = 0xD00001B4u32;
var SIO_MTIMECMP_L: u32 = 0xD00001B8u32;
var SIO_MTIMECMP_H: u32 = 0xD00001BCu32;
var TIMER_INTERVAL: u32 = 100000u32;

fn rearm_timer() -> void {
    // 64-bit mtimecmp write: prevent spurious interrupts during update
    poke32(SIO_MTIMECMP_H, 0xFFFFFFFFu32);
    var lo: u32 = peek32(SIO_MTIME_L);
    var hi: u32 = peek32(SIO_MTIME_H);
    var new_lo: u32 = lo + TIMER_INTERVAL;
    if new_lo < lo {
        hi = hi + 1u32;
    }
    poke32(SIO_MTIMECMP_L, new_lo);
    poke32(SIO_MTIMECMP_H, hi);
    return;
}

fn read_mtime() -> u32 {
    return peek32(SIO_MTIME_L);
}

fn read_mtime_hi() -> u32 {
    return peek32(SIO_MTIME_H);
}


// SIO MTIME tick rate: empirically ~131.5 MHz (calibrated 2026-04-30
// by timing 99 × nanosleep(1000ms) — 99 wall seconds were expected
// at 1 MHz but actually elapsed in 0.753 seconds, giving 131.5 MHz).
// The original 1000 (= 1 MHz) assumption was wrong; MTIME isn't
// driven by the TICK generator's 1 us pulse but by something close
// to clk_sys (PLL_SYS @ 150 MHz, so ~88% of clk_sys — likely an
// internal /1.14 divisor on the AUX path, exact source TBD).
//
// 131500 / 1000 = 131 (integer divide in kern_uptime_us); 0.4%
// rounding error is fine for the trace-prefix "[T.TTT]" use case.
// Affects nanosleep too: it now sleeps the requested wall time
// (count.tc with 99 × 1-sec sleeps takes 99 wall sec, as intended).
fn ticks_per_ms() -> u32 {
    return 131500u32;
}

// Print "[N ms] " prefix for boot trace messages. N is wall-clock
// elapsed since power-on, computed from full 64-bit SIO_MTIME
// (kern_uptime_us / 1000) so it doesn't wrap every 32 sec the way
// reading just the low 32 bits would.
fn kput_ms() -> void {
    var t: u32 = kern_uptime_us() / 1000u32;
    var buf: U8Array = U8Array(16);
    var n: i32 = 0;
    if t == 0u32 {
        set(buf, n, '0' as u8);
        n = n + 1;
    } else {
        var tmp: U8Array = U8Array(12);
        var k: i32 = 0;
        while t > 0u32 {
            set(tmp, k, ('0' as i32 + (t % 10u32) as i32) as u8);
            k = k + 1;
            t = t / 10u32;
        }
        while k > 0 {
            set(buf, n, get(tmp, k - 1));
            n = n + 1;
            k = k - 1;
        }
        delete(tmp);
    }
    uart_emit_frame("KERN", (buf as u32) + 4u32, n);
    uart_emit_frame("KERN", ("ms] " as u32) + 4u32, 4);
    delete(buf);
    return;
}

// kputs_t = kput_ms + kputs.  Use at boot trace points to make the
// per-step latency visible without re-reading kern.conf each time.
fn kputs_t(s: StringLiteral) -> void {
    kputs("[");
    kput_ms();
    kputs(s);
    return;
}

// Mount mtfs from XIP flash and announce it to the serial console. If
// block/vfs init fail we still start the hello/hello2/catfile tasks so
// that a regression in the FS code does not break visible progress.
// Write `s` (a StringLiteral) to fatfs fd. Used by the wrap.s
// emitter below.
fn dump_str(fd: i32, s: StringLiteral) -> void {
    var n: i32 = len(s);
    var buf: U8Array = U8Array((n + 1) as u32);
    var i: i32 = 0;
    while i < n { set(buf, i, get(s, i)); i = i + 1; }
    fatfs_write(fd, buf as u32 + 4u32, n);
    delete(buf);
    return;
}

// Emit a single decimal digit `d` (0..9) to fatfs fd.
fn dump_digit(fd: i32, d: i32) -> void {
    var buf: U8Array = U8Array(1);
    set(buf, 0, ('0' as u8) + (d as u8));
    fatfs_write(fd, buf as u32 + 4u32, 1);
    delete(buf);
    return;
}

// Emit a positive i32 as decimal text to fatfs fd.
fn dump_dec(fd: i32, v: i32) -> void {
    if v == 0 { dump_digit(fd, 0); return; }
    var digits: U8Array = U8Array(12);
    var n: i32 = 0;
    var x: i32 = v;
    while x > 0 {
        set(digits, n, (x % 10) as u8);
        x = x / 10;
        n = n + 1;
    }
    while n > 0 {
        n = n - 1;
        dump_digit(fd, get(digits, n) as i32);
    }
    delete(digits);
    return;
}

// dump_mtfs_to_sd — copy the kernel-embedded mtfs blob (the
// `_mtfs_image_*` block bin2s_incbin staged) onto /sd/dx.img and
// emit a matching /sd/wrap.s with `.incbin <SIZE> "/sd/dx.img"`
// so the on-device self-replicate bench can cat it directly into
// full.s without asking the user to swap the SD card.
// Idempotent: if /sd/dx.img already has the right size we skip
// the (slow) byte copy.
fn dump_mtfs_to_sd() -> void {
    kputs("DUMP: probing /sd/dx.img\r\n");
    var img_addr: u32 = _mtfs_image_addr();
    var img_size: i32 = _mtfs_image_size_value() as i32;

    var name: U8Array = U8Array(6);
    set(name, 0, 'd' as u8);
    set(name, 1, 'x' as u8);
    set(name, 2, '.' as u8);
    set(name, 3, 'i' as u8);
    set(name, 4, 'm' as u8);
    set(name, 5, 'g' as u8);
    var name_addr: u32 = name as u32 + 4u32;
    // Probe size + first 1 KB (mtfs superblock + first 16 inode
    // entries) against the embedded blob. Same-size disk-extra.img
    // builds with different file content end up with different
    // inode entries here, so this catches drift without needing to
    // stream the whole 3.5 MB disk back through fatfs.
    var skip: i32 = 0;
    var rfd: i32 = fatfs_open(name_addr, 6, 0);
    if rfd >= 0 {
        var existing: i32 = fatfs_size(rfd);
        if existing == img_size {
            var probe: U8Array = U8Array(1024);
            var pn: i32 = fatfs_read(rfd, probe as u32 + 4u32, 1024);
            if pn == 1024 {
                var match: i32 = 1;
                var pi: i32 = 0;
                while pi < 1024 {
                    if get(probe, pi) != peek8(img_addr + (pi as u32)) {
                        match = 0;
                        pi = 1024;
                    }
                    pi = pi + 1;
                }
                if match == 1 { skip = 1; }
            }
            delete(probe);
        }
        fatfs_close(rfd);
    }
    if skip == 0 {
        kputs("DUMP: writing /sd/dx.img (slow, ~6 s)\r\n");
        var fd: i32 = fatfs_open(name_addr, 6, 64 | 512 | 1);
        if fd < 0 {
            kputs("DUMP: fatfs_open /sd/dx.img failed\r\n");
            delete(name);
            return;
        }
        var BUF: i32 = 4096;
        var buf: U8Array = U8Array((BUF) as u32);
        var buf_payload: u32 = buf as u32 + 4u32;
        var off: i32 = 0;
        while off < img_size {
            var want: i32 = BUF;
            if want > img_size - off { want = img_size - off; }
            var i: i32 = 0;
            while i < want {
                set(buf, i, peek8(img_addr + (off as u32) + (i as u32)));
                i = i + 1;
            }
            var w: i32 = fatfs_write(fd, buf_payload, want);
            if w != want {
                kputs("DUMP: short write — abort\r\n");
                fatfs_close(fd);
                delete(buf);
                delete(name);
                return;
            }
            off = off + want;
        }
        fatfs_close(fd);
        delete(buf);
        kputs("DUMP: /sd/dx.img staged\r\n");
    }
    delete(name);

    // Emit /sd/wrap.s — a tiny .s wrapper that .incbin's /sd/dx.img
    // with the correct size. Bench scripts cat it into full.s.
    var wname: U8Array = U8Array(6);
    set(wname, 0, 'w' as u8);
    set(wname, 1, 'r' as u8);
    set(wname, 2, 'a' as u8);
    set(wname, 3, 'p' as u8);
    set(wname, 4, '.' as u8);
    set(wname, 5, 's' as u8);
    var wfd: i32 = fatfs_open(wname as u32 + 4u32, 6, 64 | 512 | 1);
    if wfd >= 0 {
        dump_str(wfd, "    .rodata\n    .align 4\n    .globl _mtfs_image_start\n_mtfs_image_start:\n    .incbin ");
        dump_dec(wfd, img_size);
        dump_str(wfd, " \"/sd/dx.img\"\n    .globl _mtfs_image_end\n_mtfs_image_end:\n    .globl _mtfs_image_size\n_mtfs_image_size:\n    .word ");
        dump_dec(wfd, img_size);
        dump_str(wfd, "\n    .text\n    .globl _mtfs_image_addr\n_mtfs_image_addr:\n    la   a0, _mtfs_image_start\n    ret\n");
        // Companion helper that returns the byte size as a value
        // (matches bin2s.sh / bin2s_incbin.sh — kernel_pico2's
        // dumper code calls it).
        dump_str(wfd, "    .globl _mtfs_image_size_value\n_mtfs_image_size_value:\n    li   a0, ");
        dump_dec(wfd, img_size);
        dump_str(wfd, "\n    ret\n");
        fatfs_close(wfd);
    }
    delete(wname);
    return;
}

fn mount_fs() -> void {
    if block_init() != 0 {
        kputs("BLOCK: flash init failed\r\n");
        return;
    }
    kputs("BLOCK: flash backend ready\r\n");
    if vfs_init() != 0 {
        kputs("MTFS: mount failed\r\n");
        return;
    }
    kputs("MTFS: mounted\r\n");

    // Try to bring up the SPI SD card. Failure is non-fatal: kernel
    // boots fine without /sd, and the user can re-run sdprobe to
    // diagnose. Success makes /sd available via fatfs.
    if fat_block_init() == 0 {
        kputs("SD: card init OK\r\n");
        var mret: i32 = fatfs_mount();
        if mret == 0 {
            kputs_t("FATFS: mounted\r\n");
            vfs_set_fatfs_ready();
            // dump_mtfs_to_sd() — removed from default boot path
            // (used to add ~6 s on first boot writing /sd/dx.img).
            // self_replicate orchestrator now stages dx.img via
            // mx → mr UART upload after flashing the kernel.
        } else {
            // Spell out which step in fatfs_mount tripped — far more
            // useful than a single "no FAT?" when triaging cards.
            kputs("FATFS: mount failed (code=");
            if mret == 0 - 2 { kputs("-2 sec0_read"); }
            else if mret == 0 - 3 { kputs("-3 sec0_sig"); }
            else if mret == 0 - 4 { kputs("-4 mbr_no_part"); }
            else if mret == 0 - 5 { kputs("-5 part_read"); }
            else if mret == 0 - 6 { kputs("-6 part_sig"); }
            else if mret == 0 - 7 { kputs("-7 bps"); }
            else if mret == 0 - 8 { kputs("-8 spc"); }
            else { kputs("?"); }
            kputs(")\r\n");
        }
    } else {
        kputs("SD: card init failed (no card / wiring?)\r\n");
    }
    return;
}

fn main() -> i32 {
    kputs_t("KERN: starting\r\n");

    mount_fs();
    kputs_t("KERN: mount_fs done\r\n");

    // 8 scheduler slots. Slot 0 seeds /bin/sh — the Debug Probe's
    // CDC-ACM line is bidirectional, so a connected host can type
    // commands and spawn any task from the image (hello, launcher,
    // catfile, or the EXTRA_TASKS compiler binaries). /etc/kern.conf
    // can add more seed tasks if needed; the remaining slots stay
    // STATE_UNUSED until sh's sys_spawn fills them.
    //
    // Step prints between "FATFS: mounted" and "SH: ready" let us
    // localize transient boot failures where the kernel reaches mount
    // but never lets a task print — without these the captured UART
    // log just stops at FATFS:mounted and we cannot tell whether
    // load_task failed, sched_register failed, the timer never armed,
    // or the first task crt0 deadlocked. Each kputs is one byte
    // worth of UART output, so the cost is negligible.
    kputs_t("KERN: sched_init\r\n");
    sched_init(8);

    kputs_t("KERN: start_init_tasks\r\n");
    var n_init: i32 = start_init_tasks();
    if n_init == 0 {
        kputs("KERN: load_task /bin/sh\r\n");
        var sh_frame: u32 = load_task("/bin/sh");
        if sh_frame == 0u32 {
            kputs("KERN: load_task /bin/sh FAILED\r\n");
        }
        kputs("KERN: sched_register slot 0\r\n");
        sched_register(0, sh_frame);
        var seed_nm: U8Array = to_cstr("sh");
        task_set_name(0, seed_nm);
        delete(seed_nm);
    }

    // Enable SIO MTIME counter: EN + FULLSPEED (keep DBGPAUSE defaults)
    kputs_t("KERN: timer arm\r\n");
    poke32(SIO_MTIME_CTRL, 0x0Fu32);
    rearm_timer();
    var mie: u32 = csr_read_mie();
    csr_write_mie(mie | 0x80u32);

    kputs_t("KERN: sched_start\r\n");
    sched_start(sched_get_frame(0));

    kputs("\r\nKERN: all tasks done\r\n");
    return 0;
}
