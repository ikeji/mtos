// console.tc — /bin/console: userspace terminal emulator + getty.
//
// Hosts an interactive shell on the local display + keyboard instead
// of the UART. Structure (フェーズ9 S6):
//
//   /dev/kbd ──> sh stdin       sh stdout ──> pipe ──> console
//                                                        │
//                                            terminal render
//                                                        │
//                                                     /dev/fb
//
// console opens /dev/kbd and /dev/fb, creates one pipe, and spawns
// /bin/sh with stdin = /dev/kbd and stdout = the pipe write end. It
// then reads the pipe and renders sh's output to /dev/fb. Because sh
// reads its own stdin (/dev/kbd) directly, console only ever waits on
// one fd (the pipe), so no select/poll is needed — both tasks do a
// single blocking read.
//
// Rendering: each printable char is drawn from the 5x7 bitmap font
// (font.tc) — every ON pixel of the glyph becomes a 1x1 /dev/fb
// mode-1 fill in white. The real S3 hardware driver can later batch
// a glyph into one mode-0 blit; the terminal state machine (grid,
// cursor, scroll) is unchanged either way.

import "../libtc/libtc.tc";
import "font.tc";

// Portrait ILI9488 (320x480) with a 6x8 cell (5x7 glyph + 1px gap):
// 53 cols x 60 rows.
var COLS:   i32 = 53;
var ROWS:   i32 = 60;
var CELL_W: i32 = 6;
var CELL_H: i32 = 8;
var FG:     i32 = 65535;   // RGB565 white

var g_col: i32 = 0;
var g_row: i32 = 0;

// Store a little-endian u16 at byte offset `pos`.
fn put_u16(b: U8Array, pos: i32, v: i32) -> void {
    set(b, pos,     (v & 0xFF) as u8);
    set(b, pos + 1, ((v >> 8) & 0xFF) as u8);
    return;
}

// Draw one printable char's 5x7 glyph at cell (col,row): each ON
// pixel is a 1x1 /dev/fb mode-1 fill in white. font.tc stores 7
// chars per glyph, each encoding a 5-bit row as (40 + bits).
fn fb_glyph(fb: i32, frame: U8Array, col: i32, row: i32, c: i32) -> void {
    if c < 32 || c > 126 { return; }
    var font: StringLiteral = console_font();
    var goff: i32 = (c - 32) * 7;
    var x0: i32 = col * CELL_W;
    var y0: i32 = row * CELL_H;
    var ry: i32 = 0;
    while ry < 7 {
        var bits: i32 = (get(font, goff + ry) as i32) - 40;
        var rx: i32 = 0;
        while rx < 5 {
            if (bits & (16 >> rx)) != 0 {
                put_u16(frame, 0,  x0 + rx);
                put_u16(frame, 2,  y0 + ry);
                put_u16(frame, 4,  1);
                put_u16(frame, 6,  1);
                put_u16(frame, 8,  1);
                put_u16(frame, 10, FG);
                sys_write(fb, frame, 12);
            }
            rx = rx + 1;
        }
        ry = ry + 1;
    }
    return;
}

// Emit a mode-2 vertical-scroll blit.
fn fb_scroll(fb: i32, frame: U8Array, line: i32) -> void {
    put_u16(frame, 0,  0);
    put_u16(frame, 2,  0);
    put_u16(frame, 4,  0);
    put_u16(frame, 6,  0);
    put_u16(frame, 8,  2);
    put_u16(frame, 10, line);
    sys_write(fb, frame, 12);
    return;
}

// Terminal state machine: advance the cursor and draw one byte.
fn render(fb: i32, frame: U8Array, c: i32) -> void {
    if c == 10 {              // '\n'
        g_col = 0;
        g_row = g_row + 1;
    } else if c == 13 {       // '\r'
        g_col = 0;
    } else if c == 8 {        // '\b'
        if g_col > 0 { g_col = g_col - 1; }
    } else if c >= 32 {
        fb_glyph(fb, frame, g_col, g_row, c);
        g_col = g_col + 1;
        if g_col >= COLS {
            g_col = 0;
            g_row = g_row + 1;
        }
    }
    if g_row >= ROWS {
        g_row = ROWS - 1;
        fb_scroll(fb, frame, g_row * CELL_H);
    }
    return;
}

fn main() -> i32 {
    eputs("CONSOLE: ready\n");

    var kbd: i32 = do_openat(0, "/dev/kbd", 0);
    var fb:  i32 = do_openat(0, "/dev/fb", 1);
    if kbd < 0 || fb < 0 {
        eputs("CONSOLE: device open failed\n");
        return 1;
    }

    var pb: U8Array = U8Array(8u32);
    if do_pipe(pb as u32 + 4u32) != 0 {
        eputs("CONSOLE: pipe failed\n");
        delete(pb);
        return 1;
    }
    var pr: i32 = peek32(pb as u32 + 4u32) as i32;
    var pw: i32 = peek32(pb as u32 + 8u32) as i32;

    // sh: stdin = /dev/kbd, stdout = pipe write end.
    var slot: i32 = do_spawn_fds("/bin/sh", 0u32, kbd, pw);
    delete(pb);
    if slot < 0 {
        eputs("CONSOLE: sh spawn failed\n");
        return 1;
    }
    // Do NOT close kbd / pw here: spawn_fds passes fd *numbers* (no
    // dup), so closing them would tear out sh's own stdin / stdout.
    // sh owns them now (vfs_set_owner); slot_free_allocs closes them
    // when sh exits — and that close of the pipe write end is what
    // gives our pipe reader its EOF.

    var frame: U8Array = U8Array(12u32);
    var buf:   U8Array = U8Array(64u32);
    var running: i32 = 1;
    while running == 1 {
        var r: i32 = sys_read(pr, buf, 64);
        if r <= 0 {
            running = 0;       // EOF: sh exited
        } else {
            var i: i32 = 0;
            while i < r {
                render(fb, frame, get(buf, i) as i32);
                i = i + 1;
            }
        }
    }

    do_wait(slot);
    do_close(pr);
    do_close(fb);
    delete(frame);
    delete(buf);
    eputs("CONSOLE: exit\n");
    return 0;
}
