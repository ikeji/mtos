// blinker.tc — periodic cursor-blink heartbeat for /bin/console.
//
// console can't poll the clock while it's blocked in do_read on the
// shell's stdout pipe, so we run a tiny sibling task that wakes every
// 500 ms and writes a single 0x05 (ENQ) control byte to stdout.
// console spawns blinker with stdout = the same pipe sh writes to,
// and treats every 0x05 it reads as "toggle the cursor".
//
// Side band would be cleaner but a second pipe + select would need
// more kernel work; reusing the pipe and reserving one control byte
// keeps the change tiny. 0x05 is a C0 control char that sh and
// userland programs do not normally emit.

import "../libtc/libtc.tc";

fn do_nanosleep(ms: i32) -> i32;

fn main() -> i32 {
    var buf: U8Array = U8Array(1u32);
    set(buf, 0, 5u8);   // 0x05 ENQ — console interprets as blink toggle
    var alive: i32 = 1;
    while alive == 1 {
        do_nanosleep(500);
        // sys_write returns -1 once console's sh exits and the pipe's
        // read end (or write entry) is gone. Stop quietly so we don't
        // pin the slot — console's read of EOF can now propagate.
        if sys_write(1, buf, 1) <= 0 { alive = 0; }
    }
    delete(buf);
    return 0;
}
