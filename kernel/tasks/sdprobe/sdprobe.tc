// sdprobe.tc — RP2350 SPI0 SD card full bring-up.
//
// RISC-V port of hardware-check/sd_probe.c. Drives the same CMD0 →
// CMD8 → ACMD41 → CMD58 → CMD17 sequence and reads LBA 0.
//
// Wiring (docs/pico2_hardware.md):
//   GP4 (Pin 6)  → MISO
//   GP5 (Pin 7)  → CS    (manual SIO output)
//   GP6 (Pin 9)  → SCK
//   GP7 (Pin 10) → MOSI
//   3V3 (Pin 36) → module 3V3
//   GND          → GND

import "../libtc/libtc.tc";

// ----- MMIO -----
var RESETS_CLR:    u32 = 0x40023000u32;
var RESETS_DONE:   u32 = 0x40020008u32;
var IO_BANK0_BASE: u32 = 0x40028000u32;
var PADS_BANK0_CLR: u32 = 0x4003B000u32;
var PADS_BANK0_SET: u32 = 0x4003A000u32;
var SIO_BASE:      u32 = 0xD0000000u32;
var SPI0_BASE:     u32 = 0x40080000u32;
var RESETS_BIT_SPI0: u32 = 0x40000u32;  // bit 18

// ----- helpers -----

fn print_hex2(v: u32) -> void {
    var hi: u32 = (v >> 4u32) & 0xFu32;
    var lo: u32 = v & 0xFu32;
    var c1: u8;
    var c2: u8;
    if hi < 10u32 { c1 = ('0' as u32 + hi) as u8; }
    else          { c1 = ('A' as u32 + hi - 10u32) as u8; }
    if lo < 10u32 { c2 = ('0' as u32 + lo) as u8; }
    else          { c2 = ('A' as u32 + lo - 10u32) as u8; }
    putchar(c1);
    putchar(c2);
    return;
}

// SSPSR @ +0x0C bit 1 = TNF, bit 2 = RNE.
fn spi_xfer(b: u8) -> u8 {
    while (peek32(SPI0_BASE + 0x0Cu32) & 0x2u32) == 0u32 { }
    poke32(SPI0_BASE + 0x08u32, b as u32);
    while (peek32(SPI0_BASE + 0x0Cu32) & 0x4u32) == 0u32 { }
    return peek32(SPI0_BASE + 0x08u32) as u8;
}

fn cs_low()  -> void { poke32(SIO_BASE + 0x20u32, 0x20u32); return; }
fn cs_high() -> void { poke32(SIO_BASE + 0x18u32, 0x20u32); return; }

// Send 6-byte SD command, return R1.
fn send_cmd(cmd: i32, arg: u32, crc: u8) -> u8 {
    cs_low();
    spi_xfer(0xFFu8);
    spi_xfer((0x40 | cmd) as u8);
    spi_xfer((arg >> 24u32) as u8);
    spi_xfer((arg >> 16u32) as u8);
    spi_xfer((arg >>  8u32) as u8);
    spi_xfer( arg            as u8);
    spi_xfer(crc);
    var r1: u8 = 0xFFu8;
    var i: i32 = 0;
    while i < 16 {
        r1 = spi_xfer(0xFFu8);
        if (r1 as u32 & 0x80u32) == 0u32 { break; }
        i = i + 1;
    }
    return r1;
}

fn cs_high_clk() -> void {
    cs_high();
    spi_xfer(0xFFu8);
    return;
}

fn busy_spin(n: i32) -> void {
    var i: i32 = 0;
    while i < n { i = i + 1; }
    return;
}

fn main() -> i32 {
    puts("\n=== sdprobe v3 (TC RISC-V): full SD bring-up ===\n");

    // 1. Take SPI0 out of reset.
    poke32(RESETS_CLR, RESETS_BIT_SPI0);
    while (peek32(RESETS_DONE) & RESETS_BIT_SPI0) == 0u32 { }

    // 2. CS pre-high before output enable.
    poke32(SIO_BASE + 0x18u32, 0x20u32);

    // 3. GPIO funcsel: GP4/6/7 = SPI0 (1), GP5 = SIO (5).
    poke32(IO_BANK0_BASE + 0x024u32, 1u32);  // GP4 RX
    poke32(IO_BANK0_BASE + 0x02Cu32, 5u32);  // GP5 SIO/CS
    poke32(IO_BANK0_BASE + 0x034u32, 1u32);  // GP6 SCK
    poke32(IO_BANK0_BASE + 0x03Cu32, 1u32);  // GP7 TX

    // 4. PAD: clear ISO, set IE for inputs, enable PUE on MISO.
    poke32(PADS_BANK0_CLR + 0x14u32, 0x100u32);  // GP4 ISO=0
    poke32(PADS_BANK0_CLR + 0x18u32, 0x100u32);
    poke32(PADS_BANK0_CLR + 0x1Cu32, 0x100u32);
    poke32(PADS_BANK0_CLR + 0x20u32, 0x100u32);
    poke32(PADS_BANK0_SET + 0x14u32, 0x48u32);   // GP4: IE=1 + PUE=1

    // 5. CS as SIO output, drive high.
    poke32(SIO_BASE + 0x38u32, 0x20u32);  // OE_SET: GP5 driven

    // 6. SPI0: 400 kHz init clock. clk_peri = 12 MHz (XOSC, no PLL).
    //    CPSR=30, SCR=0 → 12M / 30 = 400 kHz.
    poke32(SPI0_BASE + 0x10u32, 30u32);   // SSPCPSR
    poke32(SPI0_BASE + 0x00u32, 0x07u32); // SSPCR0: 8-bit, mode 0
    poke32(SPI0_BASE + 0x04u32, 0x02u32); // SSPCR1: SSE
    puts("SPI0 @ 400 kHz initialized.\n");

    // 7. 80 init clocks with CS=H, MOSI=H.
    cs_high();
    var i: i32 = 0;
    while i < 10 { spi_xfer(0xFFu8); i = i + 1; }

    // 8. CMD0: enter idle.
    var r1: u8 = 0xFFu8;
    var attempt: i32 = 0;
    while attempt < 5 {
        r1 = send_cmd(0, 0u32, 0x95u8);
        cs_high_clk();
        if r1 == 0x01u8 { break; }
        busy_spin(2000);
        attempt = attempt + 1;
    }
    puts("CMD0 R1 = 0x"); print_hex2(r1 as u32);
    if r1 == 0x01u8 { puts(" (idle OK)\n"); }
    else            { puts(" (FAIL)\n"); return 1; }

    // 9. CMD8: voltage check / v2 detect.
    cs_low();
    spi_xfer(0xFFu8);
    spi_xfer(0x48u8);
    spi_xfer(0x00u8); spi_xfer(0x00u8); spi_xfer(0x01u8); spi_xfer(0xAAu8);
    spi_xfer(0x87u8);
    var cmd8_r1: u8 = 0xFFu8;
    var k: i32 = 0;
    while k < 16 {
        cmd8_r1 = spi_xfer(0xFFu8);
        if (cmd8_r1 as u32 & 0x80u32) == 0u32 { break; }
        k = k + 1;
    }
    var e0: u8 = 0u8; var e1: u8 = 0u8; var e2: u8 = 0u8; var e3: u8 = 0u8;
    if cmd8_r1 != 0xFFu8 {
        e0 = spi_xfer(0xFFu8);
        e1 = spi_xfer(0xFFu8);
        e2 = spi_xfer(0xFFu8);
        e3 = spi_xfer(0xFFu8);
    }
    cs_high_clk();
    puts("CMD8 R1 = 0x"); print_hex2(cmd8_r1 as u32);
    puts(" echo = ");
    print_hex2(e0 as u32); putchar(' ' as u8);
    print_hex2(e1 as u32); putchar(' ' as u8);
    print_hex2(e2 as u32); putchar(' ' as u8);
    print_hex2(e3 as u32);
    putchar('\n' as u8);
    var v2: i32 = 0;
    if cmd8_r1 == 0x01u8 {
        if e2 == 0x01u8 {
            if e3 == 0xAAu8 { v2 = 1; }
        }
    }

    // 10. ACMD41 init loop (CMD55 + ACMD41).
    puts("ACMD41 init...\n");
    var inited: i32 = 0;
    var arg41: u32 = 0u32;
    if v2 == 1 { arg41 = 0x40000000u32; }
    var iter: i32 = 0;
    while iter < 1000 {
        var r55: u8 = send_cmd(55, 0u32, 0x65u8);
        cs_high_clk();
        var r41: u8 = send_cmd(41, arg41, 0x77u8);
        cs_high_clk();
        if r41 == 0x00u8 {
            inited = 1;
            puts("Card initialized after iter=");
            print_hex2(iter as u32);
            putchar('\n' as u8);
            break;
        }
        busy_spin(50000);
        iter = iter + 1;
    }
    if inited == 0 { puts("ACMD41 timeout\n"); return 1; }

    // 11. CMD58: read OCR, detect SDHC.
    var sdhc: i32 = 0;
    if v2 == 1 {
        cs_low();
        spi_xfer(0xFFu8);
        spi_xfer(0x7Au8);  // 0x40 | 58
        spi_xfer(0u8); spi_xfer(0u8); spi_xfer(0u8); spi_xfer(0u8);
        spi_xfer(0xFDu8);
        var r58: u8 = 0xFFu8;
        var m: i32 = 0;
        while m < 16 {
            r58 = spi_xfer(0xFFu8);
            if (r58 as u32 & 0x80u32) == 0u32 { break; }
            m = m + 1;
        }
        var o0: u8 = spi_xfer(0xFFu8);
        var o1: u8 = spi_xfer(0xFFu8);
        var o2: u8 = spi_xfer(0xFFu8);
        var o3: u8 = spi_xfer(0xFFu8);
        cs_high_clk();
        if (o0 as u32 & 0x40u32) != 0u32 { sdhc = 1; }
        puts("CMD58 R1=0x"); print_hex2(r58 as u32);
        puts(" OCR=");
        print_hex2(o0 as u32); putchar(' ' as u8);
        print_hex2(o1 as u32); putchar(' ' as u8);
        print_hex2(o2 as u32); putchar(' ' as u8);
        print_hex2(o3 as u32);
        if sdhc == 1 { puts(" (SDHC)\n"); } else { puts(" (SDSC)\n"); }
    }

    // 12. Bump SPI clock. CPSR=2 → 12M / 2 = 6 MHz (max with XOSC).
    poke32(SPI0_BASE + 0x10u32, 2u32);
    puts("SPI bumped to ~6 MHz\n");

    // 13. CMD17: read LBA 0.
    var r17: u8 = send_cmd(17, 0u32, 0xFFu8);
    puts("CMD17 R1=0x"); print_hex2(r17 as u32); putchar('\n' as u8);
    if r17 == 0x00u8 {
        // Wait for data token 0xFE
        var tok: u8 = 0xFFu8;
        var w: i32 = 0;
        while w < 5000 {
            tok = spi_xfer(0xFFu8);
            if tok != 0xFFu8 { break; }
            w = w + 1;
        }
        puts("data token = 0x"); print_hex2(tok as u32); putchar('\n' as u8);
        if tok == 0xFEu8 {
            // Read 512 bytes; print first 16 + the boot signature.
            var b510: u8 = 0u8; var b511: u8 = 0u8;
            var bb: i32 = 0;
            puts("first 16 bytes:");
            while bb < 512 {
                var v: u8 = spi_xfer(0xFFu8);
                if bb < 16 {
                    putchar(' ' as u8);
                    print_hex2(v as u32);
                }
                if bb == 510 { b510 = v; }
                if bb == 511 { b511 = v; }
                bb = bb + 1;
            }
            spi_xfer(0xFFu8); spi_xfer(0xFFu8);  // CRC
            putchar('\n' as u8);
            puts("boot sig [510]=0x"); print_hex2(b510 as u32);
            puts(" [511]=0x"); print_hex2(b511 as u32);
            if b510 == 0x55u8 {
                if b511 == 0xAAu8 { puts(" OK\n"); }
                else              { puts(" (no sig)\n"); }
            } else { puts(" (no sig)\n"); }
        }
    }
    cs_high_clk();

    puts("=== bring-up complete ===\n");
    return 0;
}
