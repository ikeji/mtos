// md5sum.tc — compute MD5 of a file (or stdin) and print 32 hex chars + path.
// Pico2 self-host verification helper: byte-exact match against host
// `md5sum file` output proves the OS-side compile pipeline produced a
// binary identical to a Gen2 reference build.
//
// Implements RFC 1321 MD5 in pure TC (~250 lines of arithmetic, no
// table — round constants and shift amounts inlined). Reads input
// 4096 bytes at a time, processes in 64-byte chunks, finalizes by
// padding + appending the 64-bit bit count.

import "../libtc/libtc.tc";

// ---- Round constants K[0..63] = floor(2^32 * abs(sin(i+1))) ----
fn K(i: i32) -> u32 {
    if i ==  0 { return 0xd76aa478u32; } if i ==  1 { return 0xe8c7b756u32; }
    if i ==  2 { return 0x242070dbu32; } if i ==  3 { return 0xc1bdceeeu32; }
    if i ==  4 { return 0xf57c0fafu32; } if i ==  5 { return 0x4787c62au32; }
    if i ==  6 { return 0xa8304613u32; } if i ==  7 { return 0xfd469501u32; }
    if i ==  8 { return 0x698098d8u32; } if i ==  9 { return 0x8b44f7afu32; }
    if i == 10 { return 0xffff5bb1u32; } if i == 11 { return 0x895cd7beu32; }
    if i == 12 { return 0x6b901122u32; } if i == 13 { return 0xfd987193u32; }
    if i == 14 { return 0xa679438eu32; } if i == 15 { return 0x49b40821u32; }
    if i == 16 { return 0xf61e2562u32; } if i == 17 { return 0xc040b340u32; }
    if i == 18 { return 0x265e5a51u32; } if i == 19 { return 0xe9b6c7aau32; }
    if i == 20 { return 0xd62f105du32; } if i == 21 { return 0x02441453u32; }
    if i == 22 { return 0xd8a1e681u32; } if i == 23 { return 0xe7d3fbc8u32; }
    if i == 24 { return 0x21e1cde6u32; } if i == 25 { return 0xc33707d6u32; }
    if i == 26 { return 0xf4d50d87u32; } if i == 27 { return 0x455a14edu32; }
    if i == 28 { return 0xa9e3e905u32; } if i == 29 { return 0xfcefa3f8u32; }
    if i == 30 { return 0x676f02d9u32; } if i == 31 { return 0x8d2a4c8au32; }
    if i == 32 { return 0xfffa3942u32; } if i == 33 { return 0x8771f681u32; }
    if i == 34 { return 0x6d9d6122u32; } if i == 35 { return 0xfde5380cu32; }
    if i == 36 { return 0xa4beea44u32; } if i == 37 { return 0x4bdecfa9u32; }
    if i == 38 { return 0xf6bb4b60u32; } if i == 39 { return 0xbebfbc70u32; }
    if i == 40 { return 0x289b7ec6u32; } if i == 41 { return 0xeaa127fau32; }
    if i == 42 { return 0xd4ef3085u32; } if i == 43 { return 0x04881d05u32; }
    if i == 44 { return 0xd9d4d039u32; } if i == 45 { return 0xe6db99e5u32; }
    if i == 46 { return 0x1fa27cf8u32; } if i == 47 { return 0xc4ac5665u32; }
    if i == 48 { return 0xf4292244u32; } if i == 49 { return 0x432aff97u32; }
    if i == 50 { return 0xab9423a7u32; } if i == 51 { return 0xfc93a039u32; }
    if i == 52 { return 0x655b59c3u32; } if i == 53 { return 0x8f0ccc92u32; }
    if i == 54 { return 0xffeff47du32; } if i == 55 { return 0x85845dd1u32; }
    if i == 56 { return 0x6fa87e4fu32; } if i == 57 { return 0xfe2ce6e0u32; }
    if i == 58 { return 0xa3014314u32; } if i == 59 { return 0x4e0811a1u32; }
    if i == 60 { return 0xf7537e82u32; } if i == 61 { return 0xbd3af235u32; }
    if i == 62 { return 0x2ad7d2bbu32; } if i == 63 { return 0xeb86d391u32; }
    return 0u32;
}

// ---- Per-round left-shift amounts S[0..63] ----
fn S(i: i32) -> i32 {
    // Rounds 0..15: 7,12,17,22 repeating
    if i < 16 {
        var r: i32 = i & 3;
        if r == 0 { return 7; }
        if r == 1 { return 12; }
        if r == 2 { return 17; }
        return 22;
    }
    // Rounds 16..31: 5,9,14,20 repeating
    if i < 32 {
        var r: i32 = i & 3;
        if r == 0 { return 5; }
        if r == 1 { return 9; }
        if r == 2 { return 14; }
        return 20;
    }
    // Rounds 32..47: 4,11,16,23 repeating
    if i < 48 {
        var r: i32 = i & 3;
        if r == 0 { return 4; }
        if r == 1 { return 11; }
        if r == 2 { return 16; }
        return 23;
    }
    // Rounds 48..63: 6,10,15,21 repeating
    var r: i32 = i & 3;
    if r == 0 { return 6; }
    if r == 1 { return 10; }
    if r == 2 { return 15; }
    return 21;
}

// Message-index function g(i) per round.
fn G_idx(i: i32) -> i32 {
    if i < 16 { return i; }
    if i < 32 { return (5 * i + 1) & 15; }
    if i < 48 { return (3 * i + 5) & 15; }
    return (7 * i) & 15;
}

fn rotl32(x: u32, n: i32) -> u32 {
    return (x << (n as u32)) | (x >> ((32 - n) as u32));
}

// MD5 state. Globals so process_block / finalize don't have to thread it.
var g_a: u32 = 0u32;
var g_b: u32 = 0u32;
var g_c: u32 = 0u32;
var g_d: u32 = 0u32;
var g_total_bits_lo: u32 = 0u32;
var g_total_bits_hi: u32 = 0u32;

fn md5_init() -> void {
    g_a = 0x67452301u32;
    g_b = 0xefcdab89u32;
    g_c = 0x98badcfeu32;
    g_d = 0x10325476u32;
    g_total_bits_lo = 0u32;
    g_total_bits_hi = 0u32;
    return;
}

// Process one 64-byte block. M[0..15] are the 16 LE32 words. We
// keep them in a stack-allocated U32Array — TC's get/set on a typed
// array dispatches via inner pointer arithmetic so 4-byte access is
// fine. Values stored as u32; readers cast back to u32 for arithmetic.
fn md5_process_block(blk: U8Array) -> void {
    var M: U32Array = U32Array(16u32);
    var i: i32 = 0;
    while i < 16 {
        var b0: u32 = get(blk, i * 4    ) as u32;
        var b1: u32 = get(blk, i * 4 + 1) as u32;
        var b2: u32 = get(blk, i * 4 + 2) as u32;
        var b3: u32 = get(blk, i * 4 + 3) as u32;
        set(M, i, b0 | (b1 << 8u32) | (b2 << 16u32) | (b3 << 24u32));
        i = i + 1;
    }

    var a: u32 = g_a;
    var b: u32 = g_b;
    var c: u32 = g_c;
    var d: u32 = g_d;

    var ALLONES: u32 = 0xFFFFFFFFu32;
    i = 0;
    while i < 64 {
        var f: u32 = 0u32;
        if i < 16 {
            f = (b & c) | ((b ^ ALLONES) & d);
        } else if i < 32 {
            f = (d & b) | ((d ^ ALLONES) & c);
        } else if i < 48 {
            f = b ^ c ^ d;
        } else {
            f = c ^ (b | (d ^ ALLONES));
        }
        var g: i32 = G_idx(i);
        var mw: u32 = get(M, g);
        var temp: u32 = d;
        d = c;
        c = b;
        var sum: u32 = a + f + K(i) + mw;
        b = b + rotl32(sum, S(i));
        a = temp;
        i = i + 1;
    }

    g_a = g_a + a;
    g_b = g_b + b;
    g_c = g_c + c;
    g_d = g_d + d;
    delete(M);
    return;
}

// Add `nbytes` to the running total bit count.
fn md5_count(nbytes: i32) -> void {
    var add_bits: u32 = (nbytes as u32) << 3u32;
    var prev: u32 = g_total_bits_lo;
    g_total_bits_lo = g_total_bits_lo + add_bits;
    if g_total_bits_lo < prev { g_total_bits_hi = g_total_bits_hi + 1u32; }
    // Also account for the high bits dropped from `nbytes << 3`. nbytes is i32
    // so its top 3 bits land in hi when shifted by 3.
    g_total_bits_hi = g_total_bits_hi + ((nbytes as u32) >> 29u32);
    return;
}

// Finalize: pad with 0x80, zeros, then 64-bit LE bit count. Process the
// remaining bytes from `tail` (length `tlen` < 64).
fn md5_finalize(tail: U8Array, tlen: i32) -> void {
    var blk: U8Array = U8Array(64u32);
    var i: i32 = 0;
    while i < tlen { set(blk, i, get(tail, i)); i = i + 1; }
    set(blk, tlen, 0x80u8);
    i = tlen + 1;
    while i < 64 { set(blk, i, 0u8); i = i + 1; }
    if tlen >= 56 {
        // Need an extra block: this one only carries the 0x80 + zeros,
        // the next one carries the bit count.
        md5_process_block(blk);
        i = 0;
        while i < 64 { set(blk, i, 0u8); i = i + 1; }
    }
    // Append 64-bit bit count, little-endian, last 8 bytes of block.
    set(blk, 56, ( g_total_bits_lo        & 0xFFu32) as u8);
    set(blk, 57, ((g_total_bits_lo >>  8u32) & 0xFFu32) as u8);
    set(blk, 58, ((g_total_bits_lo >> 16u32) & 0xFFu32) as u8);
    set(blk, 59, ((g_total_bits_lo >> 24u32) & 0xFFu32) as u8);
    set(blk, 60, ( g_total_bits_hi        & 0xFFu32) as u8);
    set(blk, 61, ((g_total_bits_hi >>  8u32) & 0xFFu32) as u8);
    set(blk, 62, ((g_total_bits_hi >> 16u32) & 0xFFu32) as u8);
    set(blk, 63, ((g_total_bits_hi >> 24u32) & 0xFFu32) as u8);
    md5_process_block(blk);
    delete(blk);
    return;
}

// Hex print a byte to fd 1.
fn put_hex(b: u8) -> void {
    var hi: i32 = (b as i32 >> 4) & 0xF;
    var lo: i32 = b as i32 & 0xF;
    var buf: U8Array = U8Array(2u32);
    if hi < 10 { set(buf, 0, ('0' as i32 + hi) as u8); }
    else       { set(buf, 0, ('a' as i32 + hi - 10) as u8); }
    if lo < 10 { set(buf, 1, ('0' as i32 + lo) as u8); }
    else       { set(buf, 1, ('a' as i32 + lo - 10) as u8); }
    sys_write(1, buf, 2);
    delete(buf);
    return;
}

// Print the 16-byte digest as 32 hex chars.
fn print_digest() -> void {
    var w: U32Array = U32Array(4u32);
    set(w, 0, g_a);
    set(w, 1, g_b);
    set(w, 2, g_c);
    set(w, 3, g_d);
    var i: i32 = 0;
    while i < 4 {
        var x: u32 = get(w, i);
        put_hex(( x        & 0xFFu32) as u8);
        put_hex(((x >>  8u32) & 0xFFu32) as u8);
        put_hex(((x >> 16u32) & 0xFFu32) as u8);
        put_hex(((x >> 24u32) & 0xFFu32) as u8);
        i = i + 1;
    }
    delete(w);
    return;
}

// Hash one open fd. Reads in 4 KB chunks, processes 64-byte blocks,
// finalizes when fd EOFs.
fn md5_fd(fd: i32) -> void {
    md5_init();
    var CH: i32 = 4096;
    var io: U8Array = U8Array(CH as u32);
    var blk: U8Array = U8Array(64u32);
    var blkpos: i32 = 0;
    var done: i32 = 0;
    while done == 0 {
        var n: i32 = sys_read(fd, io, CH);
        if n <= 0 { done = 1; }
        else {
            md5_count(n);
            var p: i32 = 0;
            while p < n {
                var space: i32 = 64 - blkpos;
                var take: i32 = n - p;
                if take > space { take = space; }
                var k: i32 = 0;
                while k < take {
                    set(blk, blkpos + k, get(io, p + k));
                    k = k + 1;
                }
                blkpos = blkpos + take;
                p = p + take;
                if blkpos == 64 {
                    md5_process_block(blk);
                    blkpos = 0;
                }
            }
        }
    }
    md5_finalize(blk, blkpos);
    delete(io);
    delete(blk);
    return;
}

fn main(argv: StringArray) -> i32 {
    var argc: i32 = len(argv);
    if argc < 2 {
        // No path — hash stdin.
        md5_fd(0);
        print_digest();
        eputs("  -\n");
        return 0;
    }
    var i: i32 = 1;
    while i < argc {
        var path: String = get(argv, i);
        var fd: i32 = do_openat(0 - 100, path, 0);
        if fd < 0 {
            eputs("md5sum: cannot open ");
            sys_write(2, path);
            eputs("\n");
            return 1;
        }
        md5_fd(fd);
        do_close(fd);
        print_digest();
        var space: U8Array = U8Array(2u32);
        set(space, 0, ' ' as u8);
        set(space, 1, ' ' as u8);
        sys_write(1, space, 2);
        delete(space);
        var plen: i32 = len(path);
        var pbuf: U8Array = U8Array(plen as u32);
        var j: i32 = 0;
        while j < plen { set(pbuf, j, get(path, j)); j = j + 1; }
        sys_write(1, pbuf, plen);
        delete(pbuf);
        var nl: U8Array = U8Array(1u32);
        set(nl, 0, '\n' as u8);
        sys_write(1, nl, 1);
        delete(nl);
        i = i + 1;
    }
    return 0;
}
