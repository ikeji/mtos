// mkdir.tc — create directories
//
// Usage: mkdir <dir> [dir2 ...]
// Calls sys_mkdir (ecall 34) for each argument.

import "../libtc/libtc.tc";

fn main(argv: StringArray) -> i32 {
    var argc: i32 = len(argv);
    if argc < 2 {
        eputs("mkdir: missing operand\n");
        return 1;
    }
    var ret: i32 = 0;
    var i: i32 = 1;
    while i < argc {
        var s: String = get(argv, i);
        var r: i32 = do_mkdir(s);
        if r != 0 {
            eputs("mkdir: cannot create directory: ");
            sys_write(2, s);
            eputs("\n");
            ret = 1;
        }
        i = i + 1;
    }
    return ret;
}
