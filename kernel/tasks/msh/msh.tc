// msh.tc — minimal programmatic shell. No prompt, no echo, no banner.
//
// Counterpart of sh.tc (human-friendly). msh is for scripted drivers
// (pico2_hw_driver / test harnesses) that send framed stdin via
// UART mux: they don't want to see "sh$ " prompts or typing echoed
// back, they just want to send a command and get the child's output.
//
// Same command grammar as sh: one line = one command, with `<` / `>`
// redirects, `quit` exits, empty lines are ignored. Errors go to
// stderr (fd=2 → KERN tag under mux) instead of stdout so a driver's
// T00N log only contains child output.
//
// Script mode (`msh /path/to/script.sh`): when invoked with argv[1],
// open it as the command source and run with implicit `set -ex`:
//   - Each line is traced to stderr as `[ T.TTT] >> CMD` before the
//     spawn and `[ T.TTT] << exit=N dt=D.DDD` after the wait.
//   - Lines starting with `#` (after optional leading whitespace) and
//     blank lines are skipped.
//   - On the first non-zero exit the script aborts and msh returns
//     that exit code so wrappers can detect failure.
// Without argv[1] msh keeps the original silent UART behavior used by
// the host UART-mux driver.

import "../libtc/libtc.tc";


// CMD_MAX bumped to 128 for the typecheck split (#54): commands like
//   cat /empty_imports.txt /self_open.txt /tmp/1.th /wrap_close.txt \
//       /tmp/1.ast > /tmp/1.wrap
// run ~85 chars, well past the original 64-byte limit. read_line was
// silently truncating past byte 63, which mangled the redirect target
// (e.g. ">/tmp/y.txt" → ">/tmp/y" → catfile open failed). PATH_MAX
// stays at 70 because individual paths still fit.
var CMD_MAX:  i32 = 128;
// "/bin/" (5) + path bytes + NUL ≤ 70. argv[0] alone, no command line.
var PATH_MAX: i32 = 70;

// Redirect results produced by parse_redir. Globals because TC
// functions return a single value and we need three outputs (argv
// + in_path + out_path). Cleared after each do_spawn.
var g_in_path:  String = 0 as String;
var g_out_path: String = 0 as String;

// Script mode state. g_script_fd >= 0 means commands come from a file
// (argv[1]). g_start_us is the boot-relative time msh entered script
// mode, used as the "0.000" reference for [T.TTT] trace prefixes.
var g_script_fd: i32 = -1;
var g_start_us:  u32 = 0u32;

// Read characters from the active command source until LF / CR.
// Source = g_script_fd if script mode, else fd 0 (UART). Returns the
// number of bytes stored in buf (excluding NUL terminator), or -1 on
// EOF with no bytes read (only meaningful in script mode; UART read
// blocks indefinitely so it never returns EOF here).
// buf must have room for CMD_MAX bytes including NUL.
fn read_line(buf: U8Array) -> i32 {
    var fd: i32 = 0;
    if g_script_fd >= 0 { fd = g_script_fd; }
    var one: U8Array = U8Array(1);
    var pos: i32 = 0;
    var got_any: i32 = 0;
    var done: i32 = 0;
    while done == 0 {
        var n: i32 = sys_read(fd, one, 1);
        if n <= 0 {
            done = 1;
        } else {
            got_any = 1;
            var c: u8 = get(one, 0);
            if c == '\n' as u8 || c == '\r' as u8 {
                done = 1;
            } else if c < 32u8 && c != 9u8 {
                // Skip C0 controls (except tab): PL011 RX FIFO on
                // Pico 2 sometimes carries stale/reset bytes (NUL +
                // small control codes) before the first user input.
                // These would otherwise corrupt cmd and propagate
                // through parse_redir into the spawn path as
                // "/bin/\0\x18catfile" etc.
            } else if c >= 127u8 {
                // Skip DEL + high-bit bytes (UART glitches / framing
                // errors). Real shell input is printable ASCII only.
            } else if pos < CMD_MAX - 1 {
                set(buf, pos, c);
                pos = pos + 1;
            }
        }
    }
    delete(one);
    set(buf, pos, 0u8);
    if got_any == 0 { return -1; }
    return pos;
}

// Compare a NUL-terminated byte sequence in buf against a string
// literal. Returns true iff they match exactly.
// (eq moved to libtc/libtc.tc)

// Count tokens in buf[0..n], treating runs of spaces as separators.
fn count_tokens(buf: U8Array, n: i32) -> i32 {
    var count: i32 = 0;
    var in_tok: i32 = 0;
    var i: i32 = 0;
    while i < n {
        var c: u8 = get(buf, i);
        if c == ' ' as u8 {
            in_tok = 0;
        } else {
            if in_tok == 0 {
                count = count + 1;
                in_tok = 1;
            }
        }
        i = i + 1;
    }
    return count;
}

// Scan cmd[0..n] into:
//   - g_in_path  (String, 0 if no `<`)
//   - g_out_path (String, 0 if no `>`)
//   - a returned StringArray of argv tokens (excluding the redirect
//     operators and their operands)
//
// A single pass over the buffer: we walk tokens twice, once to count
// argv / locate redirect operands, and once to fill the returned
// argv. Tokens `<` / `>` are single-char.
fn parse_redir(cmd: U8Array, n: i32) -> StringArray {
    // Pass 1: classify tokens.
    var argc: i32 = 0;
    var in_start:  i32 = -1;
    var in_len:    i32 = 0;
    var out_start: i32 = -1;
    var out_len:   i32 = 0;
    var want_in:  i32 = 0;
    var want_out: i32 = 0;

    var i: i32 = 0;
    while i < n {
        while i < n && get(cmd, i) == ' ' as u8 { i = i + 1; }
        if i < n {
            var start: i32 = i;
            while i < n && get(cmd, i) != ' ' as u8 { i = i + 1; }
            var tlen: i32 = i - start;

            if want_in == 1 {
                in_start = start;
                in_len   = tlen;
                want_in = 0;
            } else if want_out == 1 {
                out_start = start;
                out_len   = tlen;
                want_out = 0;
            } else if tlen == 1 && get(cmd, start) == '<' as u8 {
                want_in = 1;
            } else if tlen == 1 && get(cmd, start) == '>' as u8 {
                want_out = 1;
            } else {
                argc = argc + 1;
            }
        }
    }

    if in_start >= 0 {
        g_in_path = string_from_bytes(cmd, in_start, in_len);
    } else {
        g_in_path = 0 as U8Array;
    }
    if out_start >= 0 {
        g_out_path = string_from_bytes(cmd, out_start, out_len);
    } else {
        g_out_path = 0 as String;
    }

    // Pass 2: fill argv (only the non-redirect tokens).
    var argv: StringArray = StringArray(argc as u32);
    var idx: i32 = 0;
    want_in = 0;
    want_out = 0;
    i = 0;
    while i < n {
        while i < n && get(cmd, i) == ' ' as u8 { i = i + 1; }
        if i < n {
            var start2: i32 = i;
            while i < n && get(cmd, i) != ' ' as u8 { i = i + 1; }
            var tlen2: i32 = i - start2;

            if want_in == 1 {
                want_in = 0;
            } else if want_out == 1 {
                want_out = 0;
            } else if tlen2 == 1 && get(cmd, start2) == '<' as u8 {
                want_in = 1;
            } else if tlen2 == 1 && get(cmd, start2) == '>' as u8 {
                want_out = 1;
            } else {
                set(argv, idx, string_from_bytes(cmd, start2, tlen2));
                idx = idx + 1;
            }
        }
    }
    return argv;
}

// Free every String element in sa then the array itself. Called
// after do_spawn so the shell's arena does not accumulate argv
// allocations across iterations (the kernel has already cloned the
// contents for the child by this point).
fn free_argv(sa: StringArray) -> void {
    var n: i32 = len(sa);
    var i: i32 = 0;
    while i < n {
        delete(get(sa, i));
        i = i + 1;
    }
    delete(sa);
    return;
}

// Write the path to execute into `path`. If argv[0] starts with '/'
// we treat it as an absolute path (used by phase 7 to run freshly
// compiled binaries out of /tmp). Otherwise we prepend "/bin/".
fn build_path(path: U8Array, argv: StringArray) -> bool {
    if len(argv) == 0 { return false; }
    var head: String = get(argv, 0);
    var hlen: i32 = len(head);
    if hlen == 0 { return false; }
    // poke8 so we can write past the previous iteration's count.
    var base: u32 = path as u32 + 4u32;
    var total: i32 = 0;
    if get(head, 0) == '/' as u8 {
        if hlen + 1 > PATH_MAX { return false; }
        var i: i32 = 0;
        while i < hlen {
            poke8(base + (i as u32), get(head, i));
            i = i + 1;
        }
        poke8(base + (hlen as u32), 0u8);
        total = hlen;
    } else {
        if hlen + 5 + 1 > PATH_MAX { return false; }
        poke8(base,        '/' as u8);
        poke8(base + 1u32, 'b' as u8);
        poke8(base + 2u32, 'i' as u8);
        poke8(base + 3u32, 'n' as u8);
        poke8(base + 4u32, '/' as u8);
        var i: i32 = 0;
        while i < hlen {
            poke8(base + ((5 + i) as u32), get(head, i));
            i = i + 1;
        }
        poke8(base + ((5 + hlen) as u32), 0u8);
        total = 5 + hlen;
    }
    poke32(path as u32, total as u32);
    return true;
}

// Write a string literal to stderr (fd 2) so error messages don't
// pollute the stdout stream that drivers capture.
// (eputs moved to libtc/libtc.tc)

// Emit `v` as a zero-padded `width`-digit decimal to fd. Used by
// trace_ts to format the milliseconds field.
fn emit_dec_pad(fd: i32, v: u32, width: i32) -> void {
    var buf: U8Array = U8Array(width as u32);
    var i: i32 = width - 1;
    while i >= 0 {
        set(buf, i, ('0' as i32 + (v % 10u32) as i32) as u8);
        v = v / 10u32;
        i = i - 1;
    }
    sys_write(fd, buf, width);
    delete(buf);
    return;
}

// Emit `v` as a decimal to fd, no padding (1+ digits). 0 prints as "0".
fn emit_dec(fd: i32, v: u32) -> void {
    if v == 0u32 {
        var b: U8Array = U8Array(1u32);
        set(b, 0, '0' as u8);
        sys_write(fd, b, 1);
        delete(b);
        return;
    }
    var tmp: U8Array = U8Array(12u32);
    var dlen: i32 = 0;
    while v > 0u32 {
        set(tmp, dlen, ('0' as i32 + (v % 10u32) as i32) as u8);
        dlen = dlen + 1;
        v = v / 10u32;
    }
    var out: U8Array = U8Array(dlen as u32);
    var k: i32 = 0;
    while k < dlen {
        set(out, k, get(tmp, dlen - 1 - k));
        k = k + 1;
    }
    sys_write(fd, out, dlen);
    delete(out);
    delete(tmp);
    return;
}

// Print a microseconds value as "S.MMM" to fd 2 (stderr): seconds in
// minimal decimal, then '.', then 3-digit zero-padded ms.
fn emit_secms(us: u32) -> void {
    emit_dec(2, us / 1000000u32);
    eputs(".");
    emit_dec_pad(2, (us / 1000u32) % 1000u32, 3);
    return;
}

// Print "[ S.MMM] " to stderr, where the time is measured from
// g_start_us (msh script-mode start).
fn trace_ts() -> void {
    var us: u32 = do_uptime_us() - g_start_us;
    eputs("[");
    emit_secms(us);
    eputs("] ");
    return;
}

// Echo the raw command bytes (no NUL, no editing) to fd 2.
fn echo_cmd(buf: U8Array, n: i32) -> void {
    sys_write(2, buf, n);
    return;
}

// Returns 1 if the line is whitespace-only or starts with '#'
// (after optional leading whitespace). Used to skip comments and
// blank lines silently in script mode.
fn is_skip_line(buf: U8Array, n: i32) -> i32 {
    var i: i32 = 0;
    while i < n && (get(buf, i) == ' ' as u8 || get(buf, i) == 9u8) {
        i = i + 1;
    }
    if i >= n { return 1; }
    if get(buf, i) == '#' as u8 { return 1; }
    return 0;
}

fn main(argv: StringArray) -> i32 {
    // Script mode: argv[0] is the binary name (/bin/msh),
    // argv[1] (if present) is the script path.
    var script_mode: i32 = 0;
    if len(argv) >= 2 {
        var spath: String = get(argv, 1);
        var fd: i32 = do_openat(-100, spath, 0);
        if fd < 0 {
            eputs("msh: cannot open script\n");
            return 1;
        }
        g_script_fd = fd;
        g_start_us = do_uptime_us();
        script_mode = 1;
    }

    var cmd:  U8Array = U8Array(CMD_MAX  as u32);
    var path: U8Array = U8Array(PATH_MAX as u32);

    var running: i32 = 1;
    var rc: i32 = 0;
    var line_no: i32 = 0;

    while running == 1 {
        var n: i32 = read_line(cmd);
        if n < 0 {
            // EOF (script mode only — UART blocks indefinitely).
            running = 0;
        } else if script_mode == 1 && is_skip_line(cmd, n) == 1 {
            line_no = line_no + 1;
            // skip blank / comment line silently
        } else if n == 0 {
            // interactive: empty line, read next
        } else if eq(cmd, n, "quit") {
            running = 0;
        } else {
            line_no = line_no + 1;
            var args: StringArray = parse_redir(cmd, n);
            if !build_path(path, args) {
                eputs("msh: empty command\n");
                free_argv(args);
                if g_in_path  as u32 != 0u32 { delete(g_in_path); g_in_path  = 0 as String; }
                if g_out_path as u32 != 0u32 { delete(g_out_path); g_out_path = 0 as String; }
            } else {
                var t_start: u32 = 0u32;
                if script_mode == 1 {
                    trace_ts();
                    eputs(">> ");
                    echo_cmd(cmd, n);
                    eputs("\n");
                    t_start = do_uptime_us();
                }
                var slot: i32 = do_spawn(path as String, args as u32,
                                         g_in_path, g_out_path);
                free_argv(args);
                if g_in_path  as u32 != 0u32 { delete(g_in_path); g_in_path  = 0 as String; }
                if g_out_path as u32 != 0u32 { delete(g_out_path); g_out_path = 0 as String; }
                if slot < 0 {
                    eputs("msh: spawn failed\n");
                    if script_mode == 1 {
                        running = 0;
                        rc = 1;
                    }
                } else {
                    var ec: i32 = do_wait(slot);
                    if script_mode == 1 {
                        var dt: u32 = do_uptime_us() - t_start;
                        trace_ts();
                        eputs("<< exit=");
                        if ec < 0 {
                            eputs("-");
                            emit_dec(2, (0 - ec) as u32);
                        } else {
                            emit_dec(2, ec as u32);
                        }
                        eputs(" dt=");
                        emit_secms(dt);
                        eputs("\n");
                        if ec != 0 {
                            eputs("msh: aborting at line ");
                            emit_dec(2, line_no as u32);
                            eputs(" (exit=");
                            if ec < 0 {
                                eputs("-");
                                emit_dec(2, (0 - ec) as u32);
                            } else {
                                emit_dec(2, ec as u32);
                            }
                            eputs(")\n");
                            running = 0;
                            rc = ec;
                        }
                    }
                }
            }
        }
    }

    if g_script_fd >= 0 {
        do_close(g_script_fd);
        g_script_fd = -1;
    }
    delete(cmd);
    delete(path);
    return rc;
}
