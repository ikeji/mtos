// kernel/loader.tc — load guest tasks from the filesystem
//
// Reads a task binary through the VFS layer into freshly allocated
// RAM and returns a task frame ready to be registered with the
// scheduler. Memory allocated for the task image is intentionally
// leaked: the task runs until sys_exit, and we do not track binary
// lifetimes yet.
//
// Step 6.3 will add an XIP fast path via vfs_xip_addr so the Pico 2
// flash backend can skip the copy.

import "vfs.tc";
import "kernel_common.tc";

// Platform UART writer (platform_virt.s / platform_pico2.s). Used by
// debug_dump_path to bypass vfs since the spawn failure path wants
// raw UART emission even when vfs state is suspect.
fn do_uart_write(buf: u32, len: i32) -> i32;

// Runtime allocator (compiler/runtime.tc).
fn kmalloc(size: i32) -> u32;

// Copy the basename from a path into a kmalloc'd U8Array.
// "/bin/sh" → "sh". Caller stores the result via task_set_name, which
// owns the free.
export fn basename_copy(path: String) -> U8Array {
    var end: i32 = len(path);
    var last_slash: i32 = -1;
    var i: i32 = 0;
    while i < end {
        if get(path, i) == '/' as u8 { last_slash = i; }
        i = i + 1;
    }
    var start: i32 = last_slash + 1;
    var nlen: i32 = end - start;
    if nlen <= 0 { nlen = 1; start = 0; }
    var buf: U8Array = U8Array((nlen + 1) as u32);
    i = 0;
    while i < nlen {
        set(buf, i, get(path, start + i));
        i = i + 1;
    }
    set(buf, nlen, 0u8);
    return buf;
}

// ===== Task binary header (K3) =====
//
// The first 8 bytes of every task binary are a two-u32 header:
//
//     offset 0..4  arena_size  (task kmalloc pool bytes)
//     offset 4..8  stack_size  (task stack bytes)
//     offset 8..   _start code + sections
//
// kernel/build.sh prepends a 2-word .word directive file in front of
// task_crt0.s so asm_pass2/pass2 emits the header as the first 8 bytes
// of .text. Everything in the code section shifts by 8, but since all
// references are PC-relative / gp-relative and the whole section moves
// together, the linker / loader don't need to rewrite anything — the
// loader just points entry at img_base + 8.
//
// This replaces the old hardcoded 16 MB RAM + 64 KB stack defaults,
// which were too big for Pico 2 and wasteful on virt. Per-task peaks
// range from ~8 KB (hello) to 512 KB (asm_pass3), so a single constant
// was never going to be right.
var TASK_HEADER_SIZE: i32 = 8;

fn read_task_header_arena(img_addr: u32) -> i32 {
    return peek32(img_addr) as i32;
}
fn read_task_header_stack(img_addr: u32) -> i32 {
    return peek32(img_addr + 4u32) as i32;
}

// Build a task frame for the file already open at fd. Uses the XIP
// fast path when the block backend is memory-mapped (flash); otherwise
// allocates a kmalloc buffer and copies the file into it. Clears the
// g_last_* allocation bases first so the caller can cleanly snapshot
// them into the scheduler slot afterwards.
//
// Per-task arena_size / stack_size come from the 8-byte binary header
// (see above) — no explicit size arguments, each task declares its own
// needs at build time.
// Reasonable upper bounds for K3 task header values. If load_fd reads
// something outside these ranges, the file is almost certainly not a
// valid task binary (or we read the wrong file — see K7-3 in
// docs/problem.md). Bail out instead of passing garbage to make_task,
// which would kmalloc megabytes and OOM the kernel arena.
var TASK_ARENA_MAX: i32 = 4194304;  // 4 MB
var TASK_STACK_MAX: i32 = 131072;   // 128 KB
var TASK_ARENA_MIN: i32 = 4096;     // 4 KB
var TASK_STACK_MIN: i32 = 1024;     // 1 KB

fn load_fd_header_ok(arena: i32, stack: i32) -> bool {
    if arena < TASK_ARENA_MIN { return false; }
    if arena > TASK_ARENA_MAX { return false; }
    if stack < TASK_STACK_MIN { return false; }
    if stack > TASK_STACK_MAX { return false; }
    return true;
}

// Debug helper for K7-3: dump the path to UART as a sequence of
// escaped bytes. Used on spawn/exec failure so we can see exactly
// what path the kernel was handed. `tag` distinguishes the call site
// (e.g., "spawn" vs "exec").
fn debug_dump_path(path: String, tag: StringLiteral) -> void {
    kputs(tag);
    kputs(": path=\"");
    if path as u32 == 0u32 {
        kputs("(null)\"\n");
        return;
    }
    var one: U8Array = U8Array(1);
    var plen: i32 = len(path);
    if plen > 64 { plen = 64; }
    var i: i32 = 0;
    while i < plen {
        var b: u8 = get(path, i);
        if b < 32u8 || b >= 127u8 {
            kputs("?");
        } else {
            set(one, 0, b);
            do_uart_write(one as u32 + 4u32, 1);
        }
        i = i + 1;
    }
    delete(one);
    kputs("\"\n");
    return;
}

fn load_fd(fd: i32) -> u32 {
    reset_last_alloc();

    var xip: u32 = vfs_xip_addr(fd);
    if xip != 0u32 {
        // Pico 2 / flash fast path: execute directly out of the
        // XIP-mapped image, no RAM copy. make_task still records
        // frame_buf / ram / stack in g_last_*; img stays 0.
        var arena_x: i32 = read_task_header_arena(xip);
        var stack_x: i32 = read_task_header_stack(xip);
        if !load_fd_header_ok(arena_x, stack_x) {
            kputs("load_fd: invalid K3 header (xip)\n");
            return 0u32;
        }
        return make_task(xip + (TASK_HEADER_SIZE as u32), arena_x, stack_x);
    }

    var size: i32 = vfs_size(fd);
    if size <= TASK_HEADER_SIZE { return 0u32; }

    // Slow path (virt / virtio-blk): copy the image into RAM. Record
    // the img base in g_last_img so the scheduler slot owns it and can
    // free it in sched_task_exit / sys_exec.
    var img: U8Array = U8Array(size as u32);
    var img_base: u32 = img as u32 + 4u32;
    var n: i32 = vfs_read(fd, img_base, size);
    if n != size {
        delete(img);
        return 0u32;
    }

    var arena_s: i32 = read_task_header_arena(img_base);
    var stack_s: i32 = read_task_header_stack(img_base);
    if !load_fd_header_ok(arena_s, stack_s) {
        kputs("load_fd: invalid K3 header\n");
        delete(img);
        return 0u32;
    }
    var frame: u32 = make_task(img_base + (TASK_HEADER_SIZE as u32),
                               arena_s, stack_s);
    set_last_img(img as u32);
    return frame;
}

// Load the given path from the VFS and build a task frame.
// Returns 0 on any failure, otherwise a frame pointer ready for
// sched_register. Task sizes come from the binary header.
export fn load_task(path: StringLiteral) -> u32 {
    var fd: i32 = vfs_open(path as String, 0);
    if fd < 0 { return 0u32; }

    var frame: u32 = load_fd(fd);
    vfs_close(fd);
    return frame;
}

// Same as load_task but takes a runtime String (e.g. one parsed out
// of /etc/kern.conf).
export fn load_task_addr(path: String) -> u32 {
    var fd: i32 = vfs_open(path, 0);
    if fd < 0 { return 0u32; }
    var frame: u32 = load_fd(fd);
    vfs_close(fd);
    return frame;
}

// Drive init-task setup for both platforms: read /etc/kern.conf, flip
// on uart mux if the config requests it, and register the config's
// init list into scheduler slots 0..n_cfg-1. Returns the number of
// slots populated, or 0 if no config was present (the caller then
// seeds its own defaults — hello/hello2/sh in the current setup).
// Extracted from duplicated blocks in kernel.tc and kernel_pico2.tc.
export fn start_init_tasks() -> i32 {
    read_kern_config();
    if kern_config_mux() != 0 { uart_mux_enable(1); }
    var n_cfg: i32 = kern_config_init_count();
    var n_slots: i32 = sched_task_count();
    if n_cfg > n_slots {
        kputs("KERN: kern.conf init count exceeds sched slots, truncating\n");
        n_cfg = n_slots;
    }
    var i: i32 = 0;
    while i < n_cfg {
        sched_register(i, load_task_addr(kern_config_init_path(i)));
        task_set_name(i, basename_copy(kern_config_init_path(i)));
        i = i + 1;
    }
    return n_cfg;
}

// Allocate a fresh kernel-owned String that holds the same bytes as
// src. We deliberately avoid the `dst = append(dst, c)` pattern in a
// loop because every iteration kmallocs a new intermediate String
// and leaks the previous one, leaving O(N) garbage per copy. Instead
// we allocate once via U8Array (which shares String's len-prefixed
// layout) and poke the length field to exclude the NUL byte so
// delete() and len() still match String's convention.
fn copy_string(src: String) -> String {
    var sl: i32 = len(src);
    var buf: U8Array = U8Array((sl + 1) as u32);
    // U8Array() wrote (sl+1) as the length. Overwrite with sl so the
    // resulting String reports its byte count without the NUL, matching
    // runtime.tc's append() convention.
    poke32(buf as u32, sl as u32);
    var i: i32 = 0;
    while i < sl {
        set(buf, i, get(src, i));
        i = i + 1;
    }
    // Terminate for do_openat / do_exec consumers that scan for NUL.
    // poke8 bypasses bounds check (the slot is inside the kmalloc
    // block even though i == sl falls at or past the poked length).
    poke8(buf as u32 + 4u32 + sl as u32, 0u8);
    return buf as String;
}

// Deep-copy a StringArray owned by the calling task into a fresh
// StringArray owned by the kernel's kmalloc. Each element becomes a
// new String allocated from kernel memory, so the copy survives
// long after the caller exits or reuses its arena. Returns 0u32 if
// src_addr is 0, meaning "no argv".
//
// The caller's StringArray is treated as raw u32 memory because the
// kernel and user share the same (identity-mapped) address space:
// Packed-buffer clone of src argv: one kmalloc instead of (1 + N).
//
// Why: each kmalloc lands in a bucket free list and carves a NEW chunk
// out of the large heap when the bucket runs empty. Each carve becomes
// permanently bucket-cached and can never re-coalesce into a big
// contiguous block. Spawn tasks with many argv elements (tcheck 7,
// asm_pass1 11) end up adding 7+ bucket-16 chunks per spawn that
// fragment the kernel arena. After 6-7 spawns the largest contiguous
// free block drops below the 336 KB needed for asm_pass2's task arena
// and we OOM. See docs/scaling.md Q1 (2026-05-13 fragment analysis).
//
// Packed layout in one kmalloc:
//
//   [count: u32][ptr0: u32]...[ptrN-1: u32]  ← StringArray header
//   [len0: u32][bytes0...pad...]              ← each String inline
//   [len1: u32][bytes1...pad...]
//   ...
//
// Each ptr_i points to its String's start (the len_i field) inside
// this same buffer. The child task's `get(argv, i)` returns a String
// (= ptr_i), and len() / get() peek32 the len_i / bytes as usual.
//
// free path: free_argv_impl_packed kfree's the single buffer; no
// per-string loop. Returns to the large heap directly when the size
// crosses the 2048 byte threshold, otherwise to ONE bucket free slot.
fn clone_argv(src_addr: u32) -> u32 {
    if src_addr == 0u32 { return 0u32; }
    var src: StringArray = src_addr as StringArray;
    var n: i32 = len(src);
    if n <= 0 {
        // Empty argv: allocate just the StringArray header (count=0).
        var empty: u32 = kmalloc(4);
        if empty == 0u32 { return 0u32; }
        poke32(empty, 0u32);
        return empty;
    }

    // Pass 1: compute total bytes needed.
    var total: i32 = 4 + 4 * n;  // count + N pointer slots
    var i: i32 = 0;
    while i < n {
        var s: String = get(src, i);
        if s as u32 != 0u32 {
            // String: 4-byte len prefix + bytes, then align to 4.
            var slen: i32 = len(s);
            total = total + ((4 + slen + 3) & (0 - 4));
        }
        i = i + 1;
    }
    // Force this allocation into the large-heap path (bypass the
    // bucket allocator) so freeing it returns the bytes to the large
    // free list where they coalesce with neighbors. Bucket entries
    // ≤ 2048 stay bucket-cached after free and progressively
    // fragment the heap (docs/scaling.md Q1, 2026-05-13). The padding
    // cost is bounded — one extra ~2 KB per task spawn — and pays off
    // because asm_pass2 (336 KB task arena) needs a single contiguous
    // free block bigger than any single fragment.
    if total <= 2048 { total = 2049; }

    var buf: u32 = kmalloc(total);
    if buf == 0u32 { return 0u32; }

    // Write StringArray header (count).
    poke32(buf, n as u32);
    var write_off: i32 = 4 + 4 * n;

    // Pass 2: copy each String into the buffer + populate pointer slots.
    i = 0;
    while i < n {
        var s2: String = get(src, i);
        if s2 as u32 == 0u32 {
            poke32(buf + (4 + 4 * i) as u32, 0u32);
        } else {
            var s_dst: u32 = buf + write_off as u32;
            var s2_len: i32 = len(s2);
            poke32(s_dst, s2_len as u32);
            var j: i32 = 0;
            while j < s2_len {
                poke8(s_dst + 4u32 + j as u32, get(s2, j));
                j = j + 1;
            }
            poke32(buf + (4 + 4 * i) as u32, s_dst);
            write_off = write_off + ((4 + s2_len + 3) & (0 - 4));
        }
        i = i + 1;
    }

    return buf;
}

// Linux open() flags — duplicate the subset tmpfs understands so
// loader.tc can open redirected stdout files with O_WRONLY|O_CREAT|
// O_TRUNC. Defined inline to avoid an extra import.
var LOADER_O_WRONLY: i32 = 1;
var LOADER_O_CREAT:  i32 = 64;
var LOADER_O_TRUNC:  i32 = 512;

// Open an optional redirect path (may be 0 = "not set"). Returns
// the VFS fd on success, 0 if path is null, or -1 on error. `wr` is
// 1 for stdout (write-create-truncate) or 0 for stdin (read-only).
fn open_redir(path: String, wr: i32) -> i32 {
    if path as u32 == 0u32 { return 0; }
    var flags: i32 = 0;
    if wr != 0 { flags = LOADER_O_WRONLY | LOADER_O_CREAT | LOADER_O_TRUNC; }
    var fd: i32 = vfs_open(path, flags);
    if fd < 0 { return -1; }
    return fd;
}

// Close an fd that was opened by open_redir, iff it was actually
// assigned (fd > 0). Used by failure paths to undo partial opens.
fn close_redir(fd: i32) -> void {
    if fd > 0 { vfs_close(fd); }
    return;
}

// Handler for sys_exec (a7 = 221). Called from trap_common.s after a
// task issues ecall. path_addr is a NUL-terminated byte string already
// readable in the kernel address space (virt/pico2 are ID-mapped, so
// user pointers and kernel pointers coincide).
//
// On success: builds a new task frame, replaces the current scheduler
// slot with it, and returns the new frame. sched_replace_current
// frees the caller's old allocations (frame_buf / ram / stack / img
// / argv / stdio fds) before attaching the new bases — we are
// running on the kernel stack here, not the dying task's user stack,
// so it is safe to kfree the user-side allocations and vfs_close
// the redirected stdio fds.
//
// argv_addr points at a StringArray in the calling task's arena (may
// be 0 for "no argv"). in_addr / out_addr point at NUL-terminated
// path strings (also may be 0). We clone / open them before load_fd
// touches the old slot so the new frame carries its own copies.
//
// On failure: returns 0, and the caller delivers -1 to the task's a0.
// The old task keeps running in place (nothing was freed).
//
// Task sizing is hardcoded for now (16 KB RAM + 8 KB stack) — small
// enough for Pico 2, large enough for the current demo tasks.
// Ordering note: redirect opens happen BEFORE load_fd so a failure
// to open /tmp/out does not leak the frame_buf / ram / stack that
// make_task would have allocated inside load_fd. reset_last_alloc
// (called at the top of load_fd) still wipes any previous g_last_*,
// so the in_fd / out_fd we opened earlier live on the kernel's TC
// stack until we re-install them via set_last_stdio.
export fn sys_exec_handler(path: String, argv_addr: u32,
                           in_path: String, out_path: String) -> u32 {
    var in_fd: i32 = open_redir(in_path, 0);
    if in_fd < 0 { return 0u32; }
    var out_fd: i32 = open_redir(out_path, 1);
    if out_fd < 0 { close_redir(in_fd); return 0u32; }

    var fd: i32 = vfs_open(path, 0);
    if fd < 0 {
        debug_dump_path(path, "exec vfs_open failed");
        close_redir(in_fd); close_redir(out_fd); return 0u32;
    }
    var frame: u32 = load_fd(fd);
    vfs_close(fd);
    if frame == 0u32 {
        debug_dump_path(path, "exec load_fd failed");
        close_redir(in_fd); close_redir(out_fd); return 0u32;
    }

    var kargv: u32 = clone_argv(argv_addr);
    set_frame_argv(frame, kargv);
    set_last_argv(kargv);
    set_last_stdio(in_fd, out_fd);
    sched_replace_current(frame);
    task_set_name(sched_current_idx(), basename_copy(path));
    return frame;
}

// Handler for sys_spawn (a7 = 220). Loads the given path into a new
// scheduler slot and returns the slot index, or -1 on failure. Caller
// keeps running. argv_addr / in_addr / out_addr mirror the exec path.
export fn sys_spawn_handler(path: String, argv_addr: u32,
                            in_path: String, out_path: String) -> i32 {
    var in_fd: i32 = open_redir(in_path, 0);
    if in_fd < 0 {
        debug_dump_path(in_path, "spawn open_redir(in) failed");
        return -1;
    }
    var out_fd: i32 = open_redir(out_path, 1);
    if out_fd < 0 {
        debug_dump_path(out_path, "spawn open_redir(out) failed");
        close_redir(in_fd); return -1;
    }

    var fd: i32 = vfs_open(path, 0);
    if fd < 0 {
        debug_dump_path(path, "spawn vfs_open failed");
        close_redir(in_fd); close_redir(out_fd); return -1;
    }
    var frame: u32 = load_fd(fd);
    vfs_close(fd);
    if frame == 0u32 {
        debug_dump_path(path, "spawn load_fd failed");
        close_redir(in_fd); close_redir(out_fd); return -1;
    }

    var kargv: u32 = clone_argv(argv_addr);
    set_frame_argv(frame, kargv);
    set_last_argv(kargv);
    set_last_stdio(in_fd, out_fd);
    var slot: i32 = sched_spawn(frame);
    if slot >= 0 {
        task_set_name(slot, basename_copy(path));
    } else {
        // sched_spawn failed (no free slots). Clean up all resources
        // that were prepared for the child: redirect fds, argv, and
        // the frame/ram/stack/img allocated by load_fd + make_task.
        debug_dump_path(path, "spawn sched_spawn failed");
        close_redir(in_fd);
        close_redir(out_fd);
        free_last_alloc();
    }
    return slot;
}

// Handler for sys_spawn_fds (a7 = 219). Like sys_spawn_handler but
// takes already-open VFS fd numbers instead of file paths. Used by
// the shell for pipe redirection: sys_pipe returns fds, the shell
// passes them here so the child's stdin/stdout point at the pipe.
// The child owns the fds; slot_free_allocs closes them on exit.
export fn sys_spawn_fds_handler(path: String, argv_addr: u32,
                                in_fd: i32, out_fd: i32) -> i32 {
    var fd: i32 = vfs_open(path, 0);
    if fd < 0 {
        debug_dump_path(path, "spawn_fds vfs_open failed");
        return -1;
    }
    var frame: u32 = load_fd(fd);
    vfs_close(fd);
    if frame == 0u32 {
        debug_dump_path(path, "spawn_fds load_fd failed");
        return -1;
    }

    var kargv: u32 = clone_argv(argv_addr);
    set_frame_argv(frame, kargv);
    set_last_argv(kargv);
    set_last_stdio(in_fd, out_fd);
    var slot: i32 = sched_spawn(frame);
    if slot >= 0 {
        task_set_name(slot, basename_copy(path));
    } else {
        free_last_alloc();
    }
    return slot;
}

// Handler for sys_wait (a7 = 260). Blocks the current task until the
// named slot enters STATE_DONE. Returns the next task frame to switch
// to, or 0 if no switch is needed (target already done / invalid).
export fn sys_wait_handler(slot: i32) -> u32 {
    return sched_wait(slot);
}
