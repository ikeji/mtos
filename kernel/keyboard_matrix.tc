// kernel/keyboard_matrix.tc — GPIO matrix keyboard backend for
// /dev/kbd on the Pico 2 (RP2350). Phase 9 S5.
//
// The keyboard is logically 12 columns x 5 rows = 60 keys, wired with
// only 11 physical GPIO lines (5 rows + 6 columns) because the left
// and right halves have their diodes facing opposite directions (see
// docs/pico2_hardware.md). A key is therefore visible in exactly one
// of two scan phases:
//
//   phase A — drive a row low, read the 6 columns  -> logical cols 0-5
//   phase B — drive a column low, read the 5 rows  -> logical cols 6-11
//
// All lines idle high (internal pull-ups); a pressed key pulls the
// read line of its driven partner low. scancode = row * 12 + col.
//
// The 2026-05-21 board scrambles the row/col GPIO order across GP1-12
// (and the speaker takes GP11):
//
//   ROW0=GP2, ROW1=GP1, ROW2=GP4, ROW3=GP3, ROW4=GP6
//   COL0=GP5, COL1=GP8, COL2=GP7, COL3=GP10, COL4=GP9, COL5=GP12
//
// We keep per-row and per-col arrays of GPIO numbers (not contiguous
// ranges) and build the row/col masks from them at init time.

// DIAG: dump scancode → ASCII to UART so we can rebuild the keymap.
fn kdbg_kbd_sc(sc: i32, ch: u8) -> void;

// ===== RP2350 register addresses =====
var KBD_IO_BANK0: u32 = 0x40028000u32;
var KBD_PADS_SET: u32 = 0x4003A000u32;
var KBD_PADS_CLR: u32 = 0x4003B000u32;
var KBD_SIO:      u32 = 0xD0000000u32;

// SIO register offsets (low-GPIO group, GP0-31).
var SIO_IN:      u32 = 0x04u32;
var SIO_OUT_SET: u32 = 0x18u32;
var SIO_OUT_CLR: u32 = 0x20u32;
var SIO_OE_SET:  u32 = 0x38u32;
var SIO_OE_CLR:  u32 = 0x40u32;

// Physical row/col GPIO numbers (computed → masks at init).
var KBD_ROW_GP0: i32 = 2;
var KBD_ROW_GP1: i32 = 1;
var KBD_ROW_GP2: i32 = 4;
var KBD_ROW_GP3: i32 = 3;
var KBD_ROW_GP4: i32 = 6;
var KBD_COL_GP0: i32 = 5;
var KBD_COL_GP1: i32 = 8;
var KBD_COL_GP2: i32 = 7;
var KBD_COL_GP3: i32 = 10;
var KBD_COL_GP4: i32 = 9;
var KBD_COL_GP5: i32 = 12;

var g_kbd_rows_mask: u32 = 0u32;
var g_kbd_cols_mask: u32 = 0u32;
var g_kbd_inited: i32 = 0;

// 60-bit key state (scancode 0..59): current scan + previous scan.
var g_cur_lo:  u32 = 0u32;
var g_cur_hi:  u32 = 0u32;
var g_prev_lo: u32 = 0u32;
var g_prev_hi: u32 = 0u32;

// scancode -> ASCII. PLACEHOLDER LAYOUT — edit this for the physical
// key positions of your board. scancode = row*12 + col; the string is
// row-major. '.' marks an as-yet-unassigned key; the three control
// keys (backspace / enter) are patched in by kbd_init below.
var KBD_KEYMAP: StringLiteral =
    "1234567890-=" +
    "qwertyuiop[]" +
    "asdfghjkl;'`" +
    "zxcvbnm,./..." +
    "            ";
var g_keymap: U8Array = 0 as U8Array;

// Short busy-wait so a driven line settles before it is sampled.
fn kbd_settle() -> void {
    var i: i32 = 0;
    while i < 200 { i = i + 1; }
    return;
}

fn kbd_row_gp(r: i32) -> i32 {
    if r == 0 { return KBD_ROW_GP0; }
    if r == 1 { return KBD_ROW_GP1; }
    if r == 2 { return KBD_ROW_GP2; }
    if r == 3 { return KBD_ROW_GP3; }
    return KBD_ROW_GP4;
}

fn kbd_col_gp(c: i32) -> i32 {
    if c == 0 { return KBD_COL_GP0; }
    if c == 1 { return KBD_COL_GP1; }
    if c == 2 { return KBD_COL_GP2; }
    if c == 3 { return KBD_COL_GP3; }
    if c == 4 { return KBD_COL_GP4; }
    return KBD_COL_GP5;
}

fn kbd_setup_pin(gp: i32) -> void {
    // funcsel 5 = SIOB_PROC. Clear ISO + PDE (PDE resets to 1, so PUE
    // alone would conflict and the line would float mid-rail). Set
    // IE + PUE so undriven lines idle high — the matrix scan reads a
    // pressed key as the driven partner pulling its read line low.
    poke32(KBD_IO_BANK0 + ((8 * gp + 4) as u32), 5u32);
    poke32(KBD_PADS_CLR + ((4 + 4 * gp) as u32), 0x104u32);  // ISO | PDE
    poke32(KBD_PADS_SET + ((4 + 4 * gp) as u32), 0x48u32);   // IE | PUE
    return;
}

fn kbd_init() -> void {
    if g_kbd_inited != 0 { return; }
    var r: i32 = 0;
    while r < 5 {
        var gp: i32 = kbd_row_gp(r);
        kbd_setup_pin(gp);
        g_kbd_rows_mask = g_kbd_rows_mask | (1u32 << (gp as u32));
        r = r + 1;
    }
    var c: i32 = 0;
    while c < 6 {
        var gp2: i32 = kbd_col_gp(c);
        kbd_setup_pin(gp2);
        g_kbd_cols_mask = g_kbd_cols_mask | (1u32 << (gp2 as u32));
        c = c + 1;
    }
    // Build the runtime keymap from KBD_KEYMAP, then patch controls.
    g_keymap = U8Array(60u32);
    var i: i32 = 0;
    while i < 60 {
        set(g_keymap, i, get(KBD_KEYMAP, i));
        i = i + 1;
    }
    set(g_keymap, 46, 8u8);     // backspace  (edit to taste)
    set(g_keymap, 47, 10u8);    // enter      (edit to taste)
    g_kbd_inited = 1;
    return;
}

// Mark scancode `sc` pressed in the current-scan bitset.
fn kbd_mark(sc: i32) -> void {
    if sc < 32 {
        g_cur_lo = g_cur_lo | (1u32 << (sc as u32));
    } else {
        g_cur_hi = g_cur_hi | (1u32 << ((sc - 32) as u32));
    }
    return;
}

fn kbd_bit(lo: u32, hi: u32, sc: i32) -> i32 {
    if sc < 32 { return ((lo >> (sc as u32)) & 1u32) as i32; }
    return ((hi >> ((sc - 32) as u32)) & 1u32) as i32;
}

// Phase A: rows are outputs (idle high, pulse low one at a time),
// columns inputs. A low column reads a pressed key in logical cols 0-5.
fn kbd_scan_a() -> void {
    poke32(KBD_SIO + SIO_OE_SET, g_kbd_rows_mask);
    poke32(KBD_SIO + SIO_OE_CLR, g_kbd_cols_mask);
    poke32(KBD_SIO + SIO_OUT_SET, g_kbd_rows_mask);
    var r: i32 = 0;
    while r < 5 {
        var row_gp: i32 = kbd_row_gp(r);
        var rowbit: u32 = 1u32 << (row_gp as u32);
        poke32(KBD_SIO + SIO_OUT_CLR, rowbit);
        kbd_settle();
        var inv: u32 = peek32(KBD_SIO + SIO_IN);
        var c: i32 = 0;
        while c < 6 {
            var col_gp: i32 = kbd_col_gp(c);
            if (inv & (1u32 << (col_gp as u32))) == 0u32 {
                kbd_mark(r * 12 + c);
            }
            c = c + 1;
        }
        poke32(KBD_SIO + SIO_OUT_SET, rowbit);
        r = r + 1;
    }
    return;
}

// Phase B: columns are outputs, rows inputs. The diode-reversed right
// half (logical cols 6-11) is visible here.
fn kbd_scan_b() -> void {
    poke32(KBD_SIO + SIO_OE_SET, g_kbd_cols_mask);
    poke32(KBD_SIO + SIO_OE_CLR, g_kbd_rows_mask);
    poke32(KBD_SIO + SIO_OUT_SET, g_kbd_cols_mask);
    var c: i32 = 0;
    while c < 6 {
        var col_gp: i32 = kbd_col_gp(c);
        var colbit: u32 = 1u32 << (col_gp as u32);
        poke32(KBD_SIO + SIO_OUT_CLR, colbit);
        kbd_settle();
        var inv: u32 = peek32(KBD_SIO + SIO_IN);
        var r: i32 = 0;
        while r < 5 {
            var row_gp: i32 = kbd_row_gp(r);
            if (inv & (1u32 << (row_gp as u32))) == 0u32 {
                kbd_mark(r * 12 + (c + 6));
            }
            r = r + 1;
        }
        poke32(KBD_SIO + SIO_OUT_SET, colbit);
        c = c + 1;
    }
    return;
}

// /dev/kbd backend: scan the matrix and return the ASCII of every key
// pressed since the previous call. Returns the byte count (0 = none).
fn kbd_backend_read(buf_addr: u32, n: i32) -> i32 {
    if g_kbd_inited == 0 { kbd_init(); }
    g_cur_lo = 0u32;
    g_cur_hi = 0u32;
    kbd_scan_a();
    kbd_scan_b();
    var emitted: i32 = 0;
    var sc: i32 = 0;
    while sc < 60 && emitted < n {
        // Rising edge: pressed now, not pressed in the previous scan.
        if kbd_bit(g_cur_lo, g_cur_hi, sc) != 0
            && kbd_bit(g_prev_lo, g_prev_hi, sc) == 0 {
            var ch: u8 = get(g_keymap, sc);
            // DIAG: dump scancode → ASCII so callers can rebuild
            // KBD_KEYMAP for their physical board layout.
            kdbg_kbd_sc(sc, ch);
            if ch != 0u8 {
                poke8(buf_addr + (emitted as u32), ch);
                emitted = emitted + 1;
            }
        }
        sc = sc + 1;
    }
    g_prev_lo = g_cur_lo;
    g_prev_hi = g_cur_hi;
    return emitted;
}
