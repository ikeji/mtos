// kernel/block_sd.tc — SD card block backend for Pico 2 (2026-05-21 board).
//
// The 2026-05-21 board wired SD signals across GP34-37, but in the order
// MISO/CS/SCK/MOSI — which does NOT match RP2350's SPI0 hardware funcsel
// pin layout on those pins (SPI0 is SCK/MOSI/MISO/CS at GP34/35/36/37).
// So we drive the bus with software bit-bang via SIO instead of using
// the PL022 SPI peripheral. Expect roughly 1–2 MB/s vs the previous
// 6 MHz hardware SPI; sufficient for fatfs mount + small-file IO.
//
// Pins (all funcsel 5 = SIOB_PROC, high-GPIO group):
//   GP34 = MISO (input, IE+PUE)
//   GP35 = CS   (output, idle high)
//   GP36 = SCK  (output, idle low — SPI mode 0)
//   GP37 = MOSI (output)
//
// Protocol: same CMD0 → CMD8 → ACMD41 → CMD58 init as the SPI0 path.

// Drain the kernel UART RX ring from inside SD busy-waits. Without
// this, fat_block_write spends ~10 ms in a single ecall with
// hardware-cleared mstatus.MIE, the timer trap can't fire, and the
// PL011 32-byte RX FIFO overflows under sustained input (K11). The
// drain is a non-blocking PL011 status read + at most one byte copy
// into the kernel ring — ~10 cycles when idle.
fn uart_rx_drain() -> void;

// ----- MMIO -----
var SD_IO_BANK0:    u32 = 0x40028000u32;
var SD_PADS_CLR:    u32 = 0x4003B000u32;  // PADS_BANK0 atomic CLR alias
var SD_PADS_SET:    u32 = 0x4003A000u32;  // PADS_BANK0 atomic SET alias
var SD_SIO:         u32 = 0xD0000000u32;

// High-GPIO SIO offsets (GP32-47).
var SD_HI_IN:       u32 = 0x008u32;
var SD_HI_OUT_SET:  u32 = 0x01Cu32;
var SD_HI_OUT_CLR:  u32 = 0x024u32;
var SD_HI_OE_SET:   u32 = 0x03Cu32;

// Per-GPIO masks (n - 32).
var SD_MISO_MASK:   u32 = 0x04u32;  // GP34
var SD_CS_MASK:     u32 = 0x08u32;  // GP35
var SD_SCK_MASK:    u32 = 0x10u32;  // GP36
var SD_MOSI_MASK:   u32 = 0x20u32;  // GP37

// IO_BANK0 GPIO_CTRL offsets (= 4 + 8*n).
var SD_CTRL_MISO:   u32 = 0x114u32;  // GP34
var SD_CTRL_CS:     u32 = 0x11Cu32;  // GP35
var SD_CTRL_SCK:    u32 = 0x124u32;  // GP36
var SD_CTRL_MOSI:   u32 = 0x12Cu32;  // GP37

// PADS_BANK0 offsets (= 4 + 4*n).
var SD_PAD_MISO:    u32 = 0x08Cu32;  // GP34
var SD_PAD_CS:      u32 = 0x090u32;  // GP35
var SD_PAD_SCK:     u32 = 0x094u32;  // GP36
var SD_PAD_MOSI:    u32 = 0x098u32;  // GP37

// ----- module state -----
var g_sd_sdhc:        i32 = 0;     // 1 = SDHC, 0 = SDSC
var g_sd_inited:      i32 = 0;

// ----- low level bit-bang -----

fn sd_sck_high() -> void { poke32(SD_SIO + SD_HI_OUT_SET, SD_SCK_MASK); return; }
fn sd_sck_low()  -> void { poke32(SD_SIO + SD_HI_OUT_CLR, SD_SCK_MASK); return; }
fn sd_mosi_high() -> void { poke32(SD_SIO + SD_HI_OUT_SET, SD_MOSI_MASK); return; }
fn sd_mosi_low()  -> void { poke32(SD_SIO + SD_HI_OUT_CLR, SD_MOSI_MASK); return; }
fn sd_cs_low()  -> void { poke32(SD_SIO + SD_HI_OUT_CLR, SD_CS_MASK); return; }
fn sd_cs_high() -> void { poke32(SD_SIO + SD_HI_OUT_SET, SD_CS_MASK); return; }

fn sd_miso_read() -> u32 {
    return peek32(SD_SIO + SD_HI_IN) & SD_MISO_MASK;
}

// Exchange one byte MSB-first, SPI mode 0 (CPOL=0, CPHA=0).
fn sd_spi_xfer(b: u8) -> u8 {
    var out: u32 = b as u32;
    var rx: u32 = 0u32;
    var i: i32 = 0;
    while i < 8 {
        if (out & 0x80u32) == 0u32 { sd_mosi_low(); } else { sd_mosi_high(); }
        out = out << 1u32;
        sd_sck_high();
        rx = rx << 1u32;
        if sd_miso_read() != 0u32 { rx = rx | 1u32; }
        sd_sck_low();
        i = i + 1;
    }
    // Drain UART RX every SPI byte. Any SD path (block_read /
    // block_write / sd_busy_spin / fatfs FAT walk / cluster alloc)
    // funnels through here, so a single drain hook covers them all
    // — the K11 workaround applies to bit-bang too.
    uart_rx_drain();
    return (rx & 0xFFu32) as u8;
}

fn sd_cs_high_clk() -> void { sd_cs_high(); sd_spi_xfer(0xFFu8); return; }

// Send a 6-byte SD command frame, return R1.
fn sd_cmd(cmd: i32, arg: u32, crc: u8) -> u8 {
    sd_cs_low();
    sd_spi_xfer(0xFFu8);
    sd_spi_xfer((0x40 | cmd) as u8);
    sd_spi_xfer((arg >> 24u32) as u8);
    sd_spi_xfer((arg >> 16u32) as u8);
    sd_spi_xfer((arg >>  8u32) as u8);
    sd_spi_xfer( arg            as u8);
    sd_spi_xfer(crc);
    var r1: u8 = 0xFFu8;
    var i: i32 = 0;
    while i < 16 {
        r1 = sd_spi_xfer(0xFFu8);
        if (r1 as u32 & 0x80u32) == 0u32 { break; }
        i = i + 1;
    }
    return r1;
}

fn sd_busy_spin(n: i32) -> void {
    var i: i32 = 0;
    while i < n { i = i + 1; }
    return;
}

// ----- public API expected by fatfs.tc -----

export fn fat_block_init() -> i32 {
    if g_sd_inited == 1 { return 0; }

    // 1. Pre-drive CS, MOSI high (idle) and SCK low.
    poke32(SD_SIO + SD_HI_OUT_SET, SD_CS_MASK | SD_MOSI_MASK);
    poke32(SD_SIO + SD_HI_OUT_CLR, SD_SCK_MASK);

    // 2. Funcsel = 5 (SIOB_PROC) on all four pins.
    poke32(SD_IO_BANK0 + SD_CTRL_MISO, 5u32);
    poke32(SD_IO_BANK0 + SD_CTRL_CS,   5u32);
    poke32(SD_IO_BANK0 + SD_CTRL_SCK,  5u32);
    poke32(SD_IO_BANK0 + SD_CTRL_MOSI, 5u32);

    // 3. Pads: clear ISO + PDE on all four (PDE resets to 1, so just
    //    setting PUE on top of it would give both pulls — line floats
    //    around mid-rail). Then IE + PUE on MISO so it idles high.
    //    PADS_BANK0 GPn = base + 4 + 4*n. GP34 = 0x8C, …, GP37 = 0x98.
    poke32(SD_PADS_CLR + SD_PAD_MISO, 0x104u32);  // ISO | PDE
    poke32(SD_PADS_CLR + SD_PAD_CS,   0x104u32);
    poke32(SD_PADS_CLR + SD_PAD_SCK,  0x104u32);
    poke32(SD_PADS_CLR + SD_PAD_MOSI, 0x104u32);
    poke32(SD_PADS_SET + SD_PAD_MISO, 0x48u32);   // IE | PUE

    // 4. OE: CS, SCK, MOSI as outputs; MISO stays input.
    poke32(SD_SIO + SD_HI_OE_SET, SD_CS_MASK | SD_SCK_MASK | SD_MOSI_MASK);

    // 5. 80 init clocks with CS=H.
    sd_cs_high();
    var ic: i32 = 0;
    while ic < 10 { sd_spi_xfer(0xFFu8); ic = ic + 1; }

    // 6. CMD0 → idle state.
    var r1: u8 = 0xFFu8;
    var attempt: i32 = 0;
    while attempt < 5 {
        r1 = sd_cmd(0, 0u32, 0x95u8);
        sd_cs_high_clk();
        if r1 == 0x01u8 { break; }
        sd_busy_spin(2000);
        attempt = attempt + 1;
    }
    if r1 != 0x01u8 { return -1; }

    // 7. CMD8: SDHC voltage check.
    sd_cs_low();
    sd_spi_xfer(0xFFu8);
    sd_spi_xfer(0x48u8);
    sd_spi_xfer(0x00u8); sd_spi_xfer(0x00u8);
    sd_spi_xfer(0x01u8); sd_spi_xfer(0xAAu8);
    sd_spi_xfer(0x87u8);
    var cmd8_r1: u8 = 0xFFu8;
    var k: i32 = 0;
    while k < 16 {
        cmd8_r1 = sd_spi_xfer(0xFFu8);
        if (cmd8_r1 as u32 & 0x80u32) == 0u32 { break; }
        k = k + 1;
    }
    var e2: u8 = 0u8;
    var e3: u8 = 0u8;
    if cmd8_r1 != 0xFFu8 {
        sd_spi_xfer(0xFFu8);
        sd_spi_xfer(0xFFu8);
        e2 = sd_spi_xfer(0xFFu8);
        e3 = sd_spi_xfer(0xFFu8);
    }
    sd_cs_high_clk();
    var v2: i32 = 0;
    if cmd8_r1 == 0x01u8 {
        if e2 == 0x01u8 {
            if e3 == 0xAAu8 { v2 = 1; }
        }
    }

    // 8. ACMD41 init loop.
    var arg41: u32 = 0u32;
    if v2 == 1 { arg41 = 0x40000000u32; }
    var done: i32 = 0;
    var iter: i32 = 0;
    while iter < 1000 {
        sd_cmd(55, 0u32, 0x65u8);
        sd_cs_high_clk();
        var r41: u8 = sd_cmd(41, arg41, 0x77u8);
        sd_cs_high_clk();
        if r41 == 0x00u8 { done = 1; break; }
        sd_busy_spin(50000);
        iter = iter + 1;
    }
    if done == 0 { return -2; }

    // 8b. CMD59 disable CRC checking (some cards leave it on after CMD8).
    sd_cmd(59, 0u32, 0x91u8);
    sd_cs_high_clk();

    // 9. CMD58: read OCR, detect SDHC.
    g_sd_sdhc = 0;
    if v2 == 1 {
        sd_cs_low();
        sd_spi_xfer(0xFFu8);
        sd_spi_xfer(0x7Au8);
        sd_spi_xfer(0u8); sd_spi_xfer(0u8); sd_spi_xfer(0u8); sd_spi_xfer(0u8);
        sd_spi_xfer(0xFDu8);
        var r58: u8 = 0xFFu8;
        var m: i32 = 0;
        while m < 16 {
            r58 = sd_spi_xfer(0xFFu8);
            if (r58 as u32 & 0x80u32) == 0u32 { break; }
            m = m + 1;
        }
        var o0: u8 = sd_spi_xfer(0xFFu8);
        sd_spi_xfer(0xFFu8); sd_spi_xfer(0xFFu8); sd_spi_xfer(0xFFu8);
        sd_cs_high_clk();
        if (o0 as u32 & 0x40u32) != 0u32 { g_sd_sdhc = 1; }
    }

    g_sd_inited = 1;
    return 0;
}

// CMD17 (READ_SINGLE_BLOCK).
export fn fat_block_read(sector: u32, buf: U8Array) -> i32 {
    if g_sd_inited == 0 { return -1; }
    var arg: u32 = sector;
    if g_sd_sdhc == 0 { arg = sector * 512u32; }

    var r1: u8 = sd_cmd(17, arg, 0xFFu8);
    if r1 != 0x00u8 { sd_cs_high_clk(); return -1; }

    // Wait for data token 0xFE.
    var tok: u8 = 0xFFu8;
    var w: i32 = 0;
    while w < 100000 {
        tok = sd_spi_xfer(0xFFu8);
        if tok != 0xFFu8 { break; }
        w = w + 1;
    }
    if tok != 0xFEu8 { sd_cs_high_clk(); return -1; }

    var i: i32 = 0;
    while i < 512 {
        set(buf, i, sd_spi_xfer(0xFFu8));
        i = i + 1;
    }
    sd_spi_xfer(0xFFu8);  // CRC hi
    sd_spi_xfer(0xFFu8);  // CRC lo
    sd_cs_high_clk();
    return 512;
}

// CMD24 (WRITE_BLOCK).
export fn fat_block_write(sector: u32, buf: U8Array) -> i32 {
    if g_sd_inited == 0 { return -1; }
    var arg: u32 = sector;
    if g_sd_sdhc == 0 { arg = sector * 512u32; }

    var r1: u8 = sd_cmd(24, arg, 0xFFu8);
    if r1 != 0x00u8 { sd_cs_high_clk(); return -1; }

    // 1 byte gap, then start token 0xFE.
    sd_spi_xfer(0xFFu8);
    sd_spi_xfer(0xFEu8);
    var i: i32 = 0;
    while i < 512 {
        sd_spi_xfer(get(buf, i));
        i = i + 1;
    }
    sd_spi_xfer(0xFFu8);  // CRC dummy
    sd_spi_xfer(0xFFu8);

    // Data response. 0x05 accepted; anything else aborts (avoid silent
    // corruption — see comment in the SPI0-era driver).
    var resp: u8 = 0xFFu8;
    var rp: i32 = 0;
    while rp < 8 {
        resp = sd_spi_xfer(0xFFu8);
        if resp != 0xFFu8 { break; }
        rp = rp + 1;
    }
    if (resp as u32 & 0x1Fu32) != 0x05u32 {
        sd_cs_high_clk();
        return -1;
    }

    // Wait while card is busy (MISO held low).
    var w: i32 = 0;
    while w < 1000000 {
        var bb: u8 = sd_spi_xfer(0xFFu8);
        if bb == 0xFFu8 { break; }
        w = w + 1;
    }
    sd_cs_high_clk();
    return 512;
}
