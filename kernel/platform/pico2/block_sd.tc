// kernel/block_sd.tc — SD card block backend for Pico 2 (2026-05-21 board).
//
// The 2026-05-21 board wired SD signals across GP34-37, but in the order
// MISO/CS/SCK/MOSI — which does NOT match RP2350's SPI0 hardware funcsel
// pin layout on those pins (SPI0 is SCK/MOSI/MISO/CS at GP34/35/36/37).
// So we drive the bus with software bit-bang via SIO instead of using
// the PL022 SPI peripheral. Effective end-to-end throughput through
// fatfs is ~49 KB/s read / ~32 KB/s write (2026-07-05 measurement,
// docs/pico2_hardware.md) — the TC per-byte call overhead dominates,
// not the wire clock.
//
// Pins (all funcsel 5 = SIOB_PROC, high-GPIO group):
//   GP34 = MISO (input, IE+PUE)
//   GP35 = CS   (output, idle high)
//   GP36 = SCK  (output, idle low — SPI mode 0)
//   GP37 = MOSI (output)
//
// Protocol: same CMD0 → CMD8 → ACMD41 → CMD58 init as the SPI0 path.

// Drain the kernel UART RX ring from inside SD busy-waits. Without
// this, fat_block_write spends ~10 ms in a single ecall with
// hardware-cleared mstatus.MIE, the timer trap can't fire, and the
// PL011 32-byte RX FIFO overflows under sustained input (K11). The
// drain is a non-blocking PL011 status read + at most one byte copy
// into the kernel ring — ~10 cycles when idle.
fn uart_rx_drain() -> void;

// ----- MMIO -----
const SD_IO_BANK0:    u32 = 0x40028000u32;
const SD_PADS_CLR:    u32 = 0x4003B000u32;  // PADS_BANK0 atomic CLR alias
const SD_PADS_SET:    u32 = 0x4003A000u32;  // PADS_BANK0 atomic SET alias
const SD_SIO:         u32 = 0xD0000000u32;

// High-GPIO SIO offsets (GP32-47).
const SD_HI_IN:       u32 = 0x008u32;
const SD_HI_OUT_SET:  u32 = 0x01Cu32;
const SD_HI_OUT_CLR:  u32 = 0x024u32;
const SD_HI_OE_SET:   u32 = 0x03Cu32;

// Per-GPIO masks (n - 32).
const SD_MISO_MASK:   u32 = 0x04u32;  // GP34
const SD_CS_MASK:     u32 = 0x08u32;  // GP35
const SD_SCK_MASK:    u32 = 0x10u32;  // GP36
const SD_MOSI_MASK:   u32 = 0x20u32;  // GP37

// IO_BANK0 GPIO_CTRL offsets (= 4 + 8*n).
const SD_CTRL_MISO:   u32 = 0x114u32;  // GP34
const SD_CTRL_CS:     u32 = 0x11Cu32;  // GP35
const SD_CTRL_SCK:    u32 = 0x124u32;  // GP36
const SD_CTRL_MOSI:   u32 = 0x12Cu32;  // GP37

// PADS_BANK0 offsets (= 4 + 4*n).
const SD_PAD_MISO:    u32 = 0x08Cu32;  // GP34
const SD_PAD_CS:      u32 = 0x090u32;  // GP35
const SD_PAD_SCK:     u32 = 0x094u32;  // GP36
const SD_PAD_MOSI:    u32 = 0x098u32;  // GP37

// ----- module state -----
var g_sd_sdhc:        i32 = 0;     // 1 = SDHC, 0 = SDSC
var g_sd_inited:      i32 = 0;
var g_sd_burst_open:  i32 = 0;     // CMD25 multi-block write in flight
var g_sd_burst_next:  u32 = 0u32;  // next sector the open burst expects

// ----- low level bit-bang -----

fn sd_cs_low()  -> void { poke32(SD_SIO + SD_HI_OUT_CLR, SD_CS_MASK); return; }
fn sd_cs_high() -> void { poke32(SD_SIO + SD_HI_OUT_SET, SD_CS_MASK); return; }

// Exchange one byte MSB-first, SPI mode 0 (CPOL=0, CPHA=0).
//
// The bit loop uses peek32/poke32 directly with the SIO addresses
// hoisted into locals. The tidy sd_sck_high()-style wrappers cost a
// full TC call + prologue each (~25 insns), which at 4 wrapper calls
// per bit dominated the transfer time; peek32/poke32 themselves are
// inlined by bc2asm so the direct form is a handful of insns per
// pin op. Keep the wrappers for the cold paths (init, CS control).
fn sd_spi_xfer(b: u8) -> u8 {
    var out: u32 = b as u32;
    var rx: u32 = 0u32;
    var set_a: u32 = SD_SIO + SD_HI_OUT_SET;
    var clr_a: u32 = SD_SIO + SD_HI_OUT_CLR;
    var in_a:  u32 = SD_SIO + SD_HI_IN;
    var mosi:  u32 = SD_MOSI_MASK;
    var sck:   u32 = SD_SCK_MASK;
    var miso:  u32 = SD_MISO_MASK;
    var i: i32 = 0;
    while i < 8 {
        if (out & 0x80u32) == 0u32 { poke32(clr_a, mosi); } else { poke32(set_a, mosi); }
        out = out << 1u32;
        poke32(set_a, sck);
        rx = rx << 1u32;
        if (peek32(in_a) & miso) != 0u32 { rx = rx | 1u32; }
        poke32(clr_a, sck);
        i = i + 1;
    }
    // Drain UART RX every SPI byte. Any SD path (block_read /
    // block_write / sd_busy_spin / fatfs FAT walk / cluster alloc)
    // funnels through here, so a single drain hook covers them all
    // — the K11 workaround applies to bit-bang too.
    uart_rx_drain();
    return (rx & 0xFFu32) as u8;
}

fn sd_cs_high_clk() -> void { sd_cs_high(); sd_spi_xfer(0xFFu8); return; }

// Send a 6-byte SD command frame, return R1.
fn sd_cmd(cmd: i32, arg: u32, crc: u8) -> u8 {
    sd_cs_low();
    sd_spi_xfer(0xFFu8);
    sd_spi_xfer((0x40 | cmd) as u8);
    sd_spi_xfer((arg >> 24u32) as u8);
    sd_spi_xfer((arg >> 16u32) as u8);
    sd_spi_xfer((arg >>  8u32) as u8);
    sd_spi_xfer( arg            as u8);
    sd_spi_xfer(crc);
    var r1: u8 = 0xFFu8;
    var i: i32 = 0;
    while i < 16 {
        r1 = sd_spi_xfer(0xFFu8);
        if (r1 as u32 & 0x80u32) == 0u32 { break; }
        i = i + 1;
    }
    return r1;
}

fn sd_busy_spin(n: i32) -> void {
    var i: i32 = 0;
    while i < n { i = i + 1; }
    return;
}

// ----- public API expected by fatfs.tc -----

export fn fat_block_init() -> i32 {
    if g_sd_inited == 1 { return 0; }
    g_sd_burst_open = 0;

    // 1. Pre-drive CS, MOSI high (idle) and SCK low.
    poke32(SD_SIO + SD_HI_OUT_SET, SD_CS_MASK | SD_MOSI_MASK);
    poke32(SD_SIO + SD_HI_OUT_CLR, SD_SCK_MASK);

    // 2. Funcsel = 5 (SIOB_PROC) on all four pins.
    poke32(SD_IO_BANK0 + SD_CTRL_MISO, 5u32);
    poke32(SD_IO_BANK0 + SD_CTRL_CS,   5u32);
    poke32(SD_IO_BANK0 + SD_CTRL_SCK,  5u32);
    poke32(SD_IO_BANK0 + SD_CTRL_MOSI, 5u32);

    // 3. Pads: clear ISO + PDE on all four (PDE resets to 1, so just
    //    setting PUE on top of it would give both pulls — line floats
    //    around mid-rail). Then IE + PUE on MISO so it idles high.
    //    PADS_BANK0 GPn = base + 4 + 4*n. GP34 = 0x8C, …, GP37 = 0x98.
    poke32(SD_PADS_CLR + SD_PAD_MISO, 0x104u32);  // ISO | PDE
    poke32(SD_PADS_CLR + SD_PAD_CS,   0x104u32);
    poke32(SD_PADS_CLR + SD_PAD_SCK,  0x104u32);
    poke32(SD_PADS_CLR + SD_PAD_MOSI, 0x104u32);
    poke32(SD_PADS_SET + SD_PAD_MISO, 0x48u32);   // IE | PUE

    // 4. OE: CS, SCK, MOSI as outputs; MISO stays input.
    poke32(SD_SIO + SD_HI_OE_SET, SD_CS_MASK | SD_SCK_MASK | SD_MOSI_MASK);

    // 5. 80 init clocks with CS=H.
    sd_cs_high();
    var ic: i32 = 0;
    while ic < 10 { sd_spi_xfer(0xFFu8); ic = ic + 1; }

    // 6. CMD0 → idle state.
    var r1: u8 = 0xFFu8;
    var attempt: i32 = 0;
    while attempt < 5 {
        r1 = sd_cmd(0, 0u32, 0x95u8);
        sd_cs_high_clk();
        if r1 == 0x01u8 { break; }
        sd_busy_spin(2000);
        attempt = attempt + 1;
    }
    if r1 != 0x01u8 { return -1; }

    // 7. CMD8: SDHC voltage check.
    sd_cs_low();
    sd_spi_xfer(0xFFu8);
    sd_spi_xfer(0x48u8);
    sd_spi_xfer(0x00u8); sd_spi_xfer(0x00u8);
    sd_spi_xfer(0x01u8); sd_spi_xfer(0xAAu8);
    sd_spi_xfer(0x87u8);
    var cmd8_r1: u8 = 0xFFu8;
    var k: i32 = 0;
    while k < 16 {
        cmd8_r1 = sd_spi_xfer(0xFFu8);
        if (cmd8_r1 as u32 & 0x80u32) == 0u32 { break; }
        k = k + 1;
    }
    var e2: u8 = 0u8;
    var e3: u8 = 0u8;
    if cmd8_r1 != 0xFFu8 {
        sd_spi_xfer(0xFFu8);
        sd_spi_xfer(0xFFu8);
        e2 = sd_spi_xfer(0xFFu8);
        e3 = sd_spi_xfer(0xFFu8);
    }
    sd_cs_high_clk();
    var v2: i32 = 0;
    if cmd8_r1 == 0x01u8 {
        if e2 == 0x01u8 {
            if e3 == 0xAAu8 { v2 = 1; }
        }
    }

    // 8. ACMD41 init loop.
    var arg41: u32 = 0u32;
    if v2 == 1 { arg41 = 0x40000000u32; }
    var done: i32 = 0;
    var iter: i32 = 0;
    while iter < 1000 {
        sd_cmd(55, 0u32, 0x65u8);
        sd_cs_high_clk();
        var r41: u8 = sd_cmd(41, arg41, 0x77u8);
        sd_cs_high_clk();
        if r41 == 0x00u8 { done = 1; break; }
        sd_busy_spin(50000);
        iter = iter + 1;
    }
    if done == 0 { return -2; }

    // 8b. CMD59 disable CRC checking (some cards leave it on after CMD8).
    sd_cmd(59, 0u32, 0x91u8);
    sd_cs_high_clk();

    // 9. CMD58: read OCR, detect SDHC.
    g_sd_sdhc = 0;
    if v2 == 1 {
        sd_cs_low();
        sd_spi_xfer(0xFFu8);
        sd_spi_xfer(0x7Au8);
        sd_spi_xfer(0u8); sd_spi_xfer(0u8); sd_spi_xfer(0u8); sd_spi_xfer(0u8);
        sd_spi_xfer(0xFDu8);
        var r58: u8 = 0xFFu8;
        var m: i32 = 0;
        while m < 16 {
            r58 = sd_spi_xfer(0xFFu8);
            if (r58 as u32 & 0x80u32) == 0u32 { break; }
            m = m + 1;
        }
        var o0: u8 = sd_spi_xfer(0xFFu8);
        sd_spi_xfer(0xFFu8); sd_spi_xfer(0xFFu8); sd_spi_xfer(0xFFu8);
        sd_cs_high_clk();
        if (o0 as u32 & 0x40u32) != 0u32 { g_sd_sdhc = 1; }
    }

    g_sd_inited = 1;
    return 0;
}

// Send one 512-byte block inside an open CMD25 burst: 0xFC data
// token, payload, dummy CRC, data response, then wait out card busy.
fn sd_burst_block(buf: U8Array) -> i32 {
    sd_spi_xfer(0xFCu8);
    var i: i32 = 0;
    while i < 512 {
        sd_spi_xfer(get(buf, i));
        i = i + 1;
    }
    sd_spi_xfer(0xFFu8);  // CRC dummy
    sd_spi_xfer(0xFFu8);
    var resp: u8 = 0xFFu8;
    var rp: i32 = 0;
    while rp < 8 {
        resp = sd_spi_xfer(0xFFu8);
        if resp != 0xFFu8 { break; }
        rp = rp + 1;
    }
    if (resp as u32 & 0x1Fu32) != 0x05u32 { return -1; }
    var w: i32 = 0;
    while w < 1000000 {
        var bb: u8 = sd_spi_xfer(0xFFu8);
        if bb == 0xFFu8 { break; }
        w = w + 1;
    }
    return 0;
}

// Close an open CMD25 burst: 0xFD stop token, 1 byte gap, busy wait,
// release CS. No-op when no burst is open.
fn sd_burst_close() -> void {
    if g_sd_burst_open == 0 { return; }
    sd_spi_xfer(0xFDu8);
    sd_spi_xfer(0xFFu8);
    var w: i32 = 0;
    while w < 1000000 {
        var bb: u8 = sd_spi_xfer(0xFFu8);
        if bb == 0xFFu8 { break; }
        w = w + 1;
    }
    sd_cs_high_clk();
    g_sd_burst_open = 0;
    return;
}

// CMD17 (READ_SINGLE_BLOCK).
export fn fat_block_read(sector: u32, buf: U8Array) -> i32 {
    if g_sd_inited == 0 { return -1; }
    if g_sd_burst_open == 1 { sd_burst_close(); }
    var arg: u32 = sector;
    if g_sd_sdhc == 0 { arg = sector * 512u32; }

    var r1: u8 = sd_cmd(17, arg, 0xFFu8);
    if r1 != 0x00u8 { sd_cs_high_clk(); return -1; }

    // Wait for data token 0xFE.
    var tok: u8 = 0xFFu8;
    var w: i32 = 0;
    while w < 100000 {
        tok = sd_spi_xfer(0xFFu8);
        if tok != 0xFFu8 { break; }
        w = w + 1;
    }
    if tok != 0xFEu8 { sd_cs_high_clk(); return -1; }

    var i: i32 = 0;
    while i < 512 {
        set(buf, i, sd_spi_xfer(0xFFu8));
        i = i + 1;
    }
    sd_spi_xfer(0xFFu8);  // CRC hi
    sd_spi_xfer(0xFFu8);  // CRC lo
    sd_cs_high_clk();
    return 512;
}

// CMD25 (WRITE_MULTIPLE_BLOCK) with transparent bursting. CS stays
// low after a write; a sequential follow-up sector extends the same
// burst, so the card can pipeline its programming instead of paying
// the full per-sector program latency that single-block CMD24 did.
// fat_block_read and fat_block_sync close the burst; fatfs calls
// fat_block_sync at the end of every write-y operation so on-disk
// durability per syscall is unchanged.
export fn fat_block_write(sector: u32, buf: U8Array) -> i32 {
    if g_sd_inited == 0 { return -1; }

    // Sequential continuation of an open burst → just append.
    if g_sd_burst_open == 1 {
        if sector == g_sd_burst_next {
            if sd_burst_block(buf) != 0 { sd_burst_close(); return -1; }
            g_sd_burst_next = sector + 1u32;
            return 512;
        }
        sd_burst_close();
    }

    var arg: u32 = sector;
    if g_sd_sdhc == 0 { arg = sector * 512u32; }

    var r1: u8 = sd_cmd(25, arg, 0xFFu8);
    if r1 != 0x00u8 { sd_cs_high_clk(); return -1; }
    sd_spi_xfer(0xFFu8);  // 1 byte gap before the first data token

    g_sd_burst_open = 1;
    g_sd_burst_next = sector + 1u32;
    if sd_burst_block(buf) != 0 { sd_burst_close(); return -1; }
    return 512;
}

// Flush: close any open CMD25 burst so everything written so far is
// committed on the card. fatfs calls this at the end of each write-y
// entry point.
export fn fat_block_sync() -> i32 {
    if g_sd_inited == 0 { return 0; }
    sd_burst_close();
    return 0;
}
