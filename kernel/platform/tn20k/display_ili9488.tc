// kernel/platform/tn20k/display_ili9488.tc — ILI9488 backend for /dev/fb on
// the Tang Nano 20K (hw/ SoC). Copy of the pico2 driver: the SoC's GPIO
// block mirrors the RP2350 SIO register layout (hw/rtl/soc/gpio_sio.v) and
// GP38..44 carry the same roles, so only two things differ:
//   * the pico2 PIO2 fast path becomes the SoC's SPI master 2 at
//     0x1004_0000 (+0 DATA, +4 STATUS busy, +8 CTRL div): pio_lcd_init /
//     pio_spi_byte / pio_spi_wait_idle are reimplemented on it, and
//     g_lcd_use_pio stays 1. SCK/MOSI pins are driven by that block
//     (top_soc_sdram.v); DC/CS/RST/BL stay on the SIO-compatible GPIO.
//   * LCD_MTIME_PER_MS = 40500 — mtime runs at the 40.5 MHz CPU clock (hw/Makefile SYS_CLK_HZ)
// IO_BANK0 / PADS / RESETS / PIO2 addresses are unmapped on the SoC (writes
// ignored, reads 0); pull-ups are static pin attributes in the .cst.
// Keep this file in sync with the pico2 original when it changes.
// SIO timer (kernel_pico2.tc) — used for the power-on delays.
fn read_mtime() -> u32;
fn kputs_t(s: StringLiteral) -> void;

// ===== RP2350 register addresses =====
const LCD_IO_BANK0:    u32 = 0x40028000u32;
const LCD_PADS_SET:    u32 = 0x4003A000u32;
const LCD_PADS_CLR:    u32 = 0x4003B000u32;
const LCD_SIO:         u32 = 0xD0000000u32;

// High-GPIO SIO offsets (GP32-47).
const LCD_HI_OUT_SET:  u32 = 0x01Cu32;
const LCD_HI_OUT_CLR:  u32 = 0x024u32;
const LCD_HI_OE_SET:   u32 = 0x03Cu32;

// Per-GPIO masks (n - 32) for all seven pins.
const LCD_DC_MASK:   u32 = 0x040u32;   // GP38
const LCD_CS_MASK:   u32 = 0x080u32;   // GP39
const LCD_SCK_MASK:  u32 = 0x100u32;   // GP40
const LCD_MOSI_MASK: u32 = 0x200u32;   // GP41
const LCD_RST_MASK:  u32 = 0x800u32;   // GP43
const LCD_BL_MASK:   u32 = 0x1000u32;  // GP44

// IO_BANK0 GPIO_CTRL offsets (= 4 + 8*n) for GP38-44.
const LCD_CTRL_DC:   u32 = 0x134u32;
const LCD_CTRL_CS:   u32 = 0x13Cu32;
const LCD_CTRL_SCK:  u32 = 0x144u32;
const LCD_CTRL_MOSI: u32 = 0x14Cu32;
const LCD_CTRL_MISO: u32 = 0x154u32;
const LCD_CTRL_RST:  u32 = 0x15Cu32;
const LCD_CTRL_BL:   u32 = 0x164u32;

// PADS_BANK0 offsets (= 4 + 4*n) for GP38-44.
const LCD_PAD_DC:   u32 = 0x09Cu32;
const LCD_PAD_CS:   u32 = 0x0A0u32;
const LCD_PAD_SCK:  u32 = 0x0A4u32;
const LCD_PAD_MOSI: u32 = 0x0A8u32;
const LCD_PAD_MISO: u32 = 0x0ACu32;
const LCD_PAD_RST:  u32 = 0x0B0u32;
const LCD_PAD_BL:   u32 = 0x0B4u32;

// SIO MTIME tick rate on the Pico 2 (~131.5 MHz — see kernel_pico2.tc).
const LCD_MTIME_PER_MS: u32 = 40500u32;

// ===== SPI master 2 (SoC) for SCK (GP40) + MOSI (GP41) =====
//
// Replaces the pico2 PIO2 state machine. Write-only, SCK = clk/2
// (20.25 MHz at the 40.5 MHz system clock). pio_spi_byte waits for the
// PREVIOUS transfer to finish before posting the next byte, so the CPU
// overlaps with the shift; pio_spi_wait_idle drains before DC/CS moves.
const LCD_SPI_DATA:   u32 = 0x10040000u32;
const LCD_SPI_STATUS: u32 = 0x10040004u32;   // bit0 = cannot accept, bit1 = fully idle
const LCD_SPI_CTRL:   u32 = 0x10040008u32;
const LCD_SPI_PIX:    u32 = 0x1004000Cu32;   // write RGB565 → 3 bytes on the wire
const LCD_SPI_FILL:   u32 = 0x10040010u32;   // repeat the last PIX this many more times
const LCD_SPI_GAP:    u32 = 0x10040014u32;   // idle clocks between fill pixels

var g_pio_lcd_inited: i32 = 0;
// DC line state (-1 = unknown) and one-shot init flag — these lived in
// the pico2 PIO section and are used by lcd_cmd/lcd_dat/fb_backend_write.
var g_lcd_dc_is_data:  i32 = 0 - 1;
var g_lcd_inited: i32 = 0;
// Kill-switch kept from pico2: 1 → SPI master 2, 0 → SIO bit-bang on
// GP40/41 (dead on this board: those pins are wired to the SPI block).
var g_lcd_use_pio:    i32 = 1;

fn pio_lcd_init() -> void {
    if g_pio_lcd_inited != 0 { return; }
    poke32(LCD_SPI_CTRL, 0u32);   // div=0 → SCK = clk/2 (20 MHz)
    poke32(LCD_SPI_GAP, 64u32);   // inter-pixel gap for HW FILL (panel + long wires)
    g_pio_lcd_inited = 1;
    return;
}

fn pio_spi_byte(b: i32) -> void {
    while (peek32(LCD_SPI_STATUS) & 1u32) != 0u32 { }
    poke32(LCD_SPI_DATA, (b & 0xFF) as u32);
    return;
}

fn pio_spi_wait_idle() -> void {
    while (peek32(LCD_SPI_STATUS) & 2u32) != 0u32 { }
    return;
}

// Push one RGB565 pixel (hardware expands to the 3-byte 18-bit format).
fn pio_spi_pix(c: i32) -> void {
    while (peek32(LCD_SPI_STATUS) & 1u32) != 0u32 { }
    poke32(LCD_SPI_PIX, (c & 0xFFFF) as u32);
    return;
}

fn lcd_delay_ms(ms: i32) -> void {
    var start: u32 = read_mtime();
    var want:  u32 = (ms as u32) * LCD_MTIME_PER_MS;
    while (read_mtime() - start) < want { }
    return;
}

// Drive one high-GPIO line high (hi != 0) or low.
fn lcd_gpio(mask: u32, hi: i32) -> void {
    if hi != 0 {
        poke32(LCD_SIO + LCD_HI_OUT_SET, mask);
    } else {
        poke32(LCD_SIO + LCD_HI_OUT_CLR, mask);
    }
    return;
}

// Bit-bang fallback: 8 GPIO-toggle loop, SPI mode 0.
fn lcd_spi_bitbang(b: i32) -> void {
    var out: u32 = (b & 0xFF) as u32;
    var i: i32 = 0;
    while i < 8 {
        if (out & 0x80u32) == 0u32 {
            poke32(LCD_SIO + LCD_HI_OUT_CLR, LCD_MOSI_MASK);
        } else {
            poke32(LCD_SIO + LCD_HI_OUT_SET, LCD_MOSI_MASK);
        }
        out = out << 1u32;
        poke32(LCD_SIO + LCD_HI_OUT_SET, LCD_SCK_MASK);
        poke32(LCD_SIO + LCD_HI_OUT_CLR, LCD_SCK_MASK);
        i = i + 1;
    }
    return;
}

// Shift one byte out via either PIO2 SM0 or the bit-bang fallback.
// g_lcd_use_pio gates the switch so we can sanity-check the LCD with
// the known-good bit-bang path while debugging PIO.
fn lcd_spi(b: i32) -> void {
    if g_lcd_use_pio != 0 {
        pio_spi_byte(b);
    } else {
        lcd_spi_bitbang(b);
    }
    return;
}

// Send a command byte (DC = 0) / a data byte (DC = 1). When PIO is
// active we have to wait for the SM to drain before flipping DC so
// the trailing bytes of the previous command don't land under the
// new DC level. Bit-bang is synchronous so no wait is needed.
fn lcd_cmd(c: i32) -> void {
    if g_lcd_dc_is_data != 0 {
        if g_lcd_use_pio != 0 { pio_spi_wait_idle(); }
        lcd_gpio(LCD_DC_MASK, 0);
        g_lcd_dc_is_data = 0;
    }
    lcd_spi(c);
    return;
}
fn lcd_dat(d: i32) -> void {
    if g_lcd_dc_is_data != 1 {
        if g_lcd_use_pio != 0 { pio_spi_wait_idle(); }
        lcd_gpio(LCD_DC_MASK, 1);
        g_lcd_dc_is_data = 1;
    }
    lcd_spi(d);
    return;
}

// Read a little-endian u16 from a raw address.
fn fb_rd16(addr: u32) -> i32 {
    return (peek8(addr) as i32) | ((peek8(addr + 1u32) as i32) << 8);
}

// Bring up the bit-banged SPI + the ILI9488. Idempotent.
fn lcd_init() -> void {
    if g_lcd_inited != 0 { return; }

    // 1. Funcsel 5 (SIOB_PROC) on all seven LCD pins.
    poke32(LCD_IO_BANK0 + LCD_CTRL_DC,   5u32);
    poke32(LCD_IO_BANK0 + LCD_CTRL_CS,   5u32);
    poke32(LCD_IO_BANK0 + LCD_CTRL_SCK,  5u32);
    poke32(LCD_IO_BANK0 + LCD_CTRL_MOSI, 5u32);
    poke32(LCD_IO_BANK0 + LCD_CTRL_MISO, 5u32);
    poke32(LCD_IO_BANK0 + LCD_CTRL_RST,  5u32);
    poke32(LCD_IO_BANK0 + LCD_CTRL_BL,   5u32);

    // 2. Pads: clear ISO (bit 8) on all seven.
    poke32(LCD_PADS_CLR + LCD_PAD_DC,   0x100u32);
    poke32(LCD_PADS_CLR + LCD_PAD_CS,   0x100u32);
    poke32(LCD_PADS_CLR + LCD_PAD_SCK,  0x100u32);
    poke32(LCD_PADS_CLR + LCD_PAD_MOSI, 0x100u32);
    poke32(LCD_PADS_CLR + LCD_PAD_MISO, 0x100u32);
    poke32(LCD_PADS_CLR + LCD_PAD_RST,  0x100u32);
    poke32(LCD_PADS_CLR + LCD_PAD_BL,   0x100u32);

    // 3. Idle the control lines, then enable their outputs: CS + RST
    //    high (idle), DC + BL + SCK + MOSI low. MISO stays input.
    poke32(LCD_SIO + LCD_HI_OUT_SET, LCD_CS_MASK | LCD_RST_MASK);
    poke32(LCD_SIO + LCD_HI_OUT_CLR,
        LCD_DC_MASK | LCD_BL_MASK | LCD_SCK_MASK | LCD_MOSI_MASK);
    poke32(LCD_SIO + LCD_HI_OE_SET,
        LCD_DC_MASK | LCD_CS_MASK | LCD_SCK_MASK | LCD_MOSI_MASK |
        LCD_RST_MASK | LCD_BL_MASK);

    // 4. Backlight on; hardware reset pulse (RST low ~20 ms).
    lcd_gpio(LCD_BL_MASK, 1);
    lcd_gpio(LCD_RST_MASK, 1);  lcd_delay_ms(5);
    lcd_gpio(LCD_RST_MASK, 0);  lcd_delay_ms(20);
    lcd_gpio(LCD_RST_MASK, 1);  lcd_delay_ms(150);

    // 5. CS low — a single device owns the bus, so it is held asserted.
    lcd_gpio(LCD_CS_MASK, 0);

    // 5b. Optionally hand SCK + MOSI over to PIO2 SM0. Until this
    //     point they were SIO outputs driven low (step 3); pio_lcd_init
    //     re-funcsels them to PIO2 and configures the SPI state
    //     machine. When g_lcd_use_pio = 0, we leave them on SIO and
    //     fall back to the original bit-bang in lcd_spi.
    if g_lcd_use_pio != 0 { pio_lcd_init(); }

    // 6. ILI9488 init. Software reset, power/VCOM, MADCTL, 18-bit
    //    pixel format, gamma, then the vertical-scroll area and
    //    display-on. The 0xE0/0xE1 gamma tables are the values ILI
    //    publishes as the recommended starting point in the 9488
    //    application note (Adafruit / Waveshare ILI9488 demos use the
    //    same numbers). Skipping them leaves the reset default gamma,
    //    which biases the panel toward red and crushes greens.
    lcd_cmd(0x01);  lcd_delay_ms(120);                          // SWRESET
    lcd_cmd(0xC0);  lcd_dat(0x17); lcd_dat(0x15);               // Power Ctl 1
    lcd_cmd(0xC1);  lcd_dat(0x41);                              // Power Ctl 2
    lcd_cmd(0xC5);  lcd_dat(0x00); lcd_dat(0x12); lcd_dat(0x80);// VCOM
    lcd_cmd(0x36);  lcd_dat(0x48);             // MADCTL: portrait, BGR
    lcd_cmd(0x3A);  lcd_dat(0x66);             // pixel format: 18 bpp
    lcd_cmd(0xB0);  lcd_dat(0x00);             // interface mode control
    lcd_cmd(0xB1);  lcd_dat(0xA0);             // frame rate
    lcd_cmd(0xB4);  lcd_dat(0x02);             // display inversion control
    lcd_cmd(0xB6);  lcd_dat(0x02); lcd_dat(0x02); lcd_dat(0x3B);// disp func
    // Positive gamma (0xE0): 15 bytes per ILI9488 reference init.
    lcd_cmd(0xE0);
    lcd_dat(0x00); lcd_dat(0x03); lcd_dat(0x09); lcd_dat(0x08);
    lcd_dat(0x16); lcd_dat(0x0A); lcd_dat(0x3F); lcd_dat(0x78);
    lcd_dat(0x4C); lcd_dat(0x09); lcd_dat(0x0A); lcd_dat(0x08);
    lcd_dat(0x16); lcd_dat(0x1A); lcd_dat(0x0F);
    // Negative gamma (0xE1): 15 bytes, paired with the positive curve.
    lcd_cmd(0xE1);
    lcd_dat(0x00); lcd_dat(0x16); lcd_dat(0x19); lcd_dat(0x03);
    lcd_dat(0x0F); lcd_dat(0x05); lcd_dat(0x32); lcd_dat(0x45);
    lcd_dat(0x46); lcd_dat(0x04); lcd_dat(0x0E); lcd_dat(0x0D);
    lcd_dat(0x35); lcd_dat(0x37); lcd_dat(0x0F);
    // Vertical scroll: full 480-line area (TFA = 0, VSA = 480, BFA = 0).
    lcd_cmd(0x33);
    lcd_dat(0x00); lcd_dat(0x00);
    lcd_dat(0x01); lcd_dat(0xE0);
    lcd_dat(0x00); lcd_dat(0x00);
    lcd_cmd(0x11);  lcd_delay_ms(120);         // sleep out
    lcd_cmd(0x29);                             // display on

    g_lcd_inited = 1;
    return;
}

// Set the GRAM address window to (x0,y0)-(x1,y1) and issue RAMWR, so
// the bytes that follow are pixel data.
fn lcd_window(x0: i32, y0: i32, x1: i32, y1: i32) -> void {
    lcd_cmd(0x2A);                                  // CASET
    lcd_dat((x0 >> 8) & 0xFF); lcd_dat(x0 & 0xFF);
    lcd_dat((x1 >> 8) & 0xFF); lcd_dat(x1 & 0xFF);
    lcd_cmd(0x2B);                                  // PASET
    lcd_dat((y0 >> 8) & 0xFF); lcd_dat(y0 & 0xFF);
    lcd_dat((y1 >> 8) & 0xFF); lcd_dat(y1 & 0xFF);
    lcd_cmd(0x2C);                                  // RAMWR
    return;
}

// Push one RGB565 colour as a single 18-bit ILI9488 pixel (3 bytes:
// each colour component left-justified in its byte).
fn lcd_pixel(c: i32) -> void {
    if g_lcd_use_pio != 0 {
        if g_lcd_dc_is_data != 1 {
            pio_spi_wait_idle();
            lcd_gpio(LCD_DC_MASK, 1);
            g_lcd_dc_is_data = 1;
        }
        pio_spi_pix(c);
        return;
    }
    lcd_dat(((c >> 11) & 0x1F) << 3);   // R: 5 bits -> bits 7..3
    lcd_dat(((c >> 5)  & 0x3F) << 2);   // G: 6 bits -> bits 7..2
    lcd_dat(( c        & 0x1F) << 3);   // B: 5 bits -> bits 7..3
    return;
}

// mode 1: fill the rect (x,y,w,h) with one RGB565 colour.
fn lcd_fill(x: i32, y: i32, w: i32, h: i32, col: i32) -> void {
    if w <= 0 || h <= 0 { return; }
    lcd_window(x, y, x + w - 1, y + h - 1);
    var rb: i32 = ((col >> 11) & 0x1F) << 3;
    var gb: i32 = ((col >> 5)  & 0x3F) << 2;
    var bb: i32 = ( col        & 0x1F) << 3;
    var count: i32 = w * h;

    if g_lcd_use_pio == 0 {
        // Bit-bang fallback: keep the simple lcd_dat path.
        var i0: i32 = 0;
        while i0 < count {
            lcd_dat(rb); lcd_dat(gb); lcd_dat(bb);
            i0 = i0 + 1;
        }
        return;
    }

    // Fast path: prime DC once, then one PIX (latches the pattern) + a
    // hardware FILL for the rest. The FILL leaves LCD_SPI_GAP idle clocks
    // between pixels (set in pio_lcd_init) so this panel over the long
    // jumper wiring doesn't drop pixels — a zero-gap stream only painted
    // ~30 columns. The CASET/PASET window itself is correct (verified
    // against the slow per-byte path).
    lcd_dat(rb);  // primes DC = data; sends pixel 0's R byte
    var stat: u32 = LCD_SPI_STATUS;
    var data: u32 = LCD_SPI_DATA;
    while (peek32(stat) & 1u32) != 0u32 { }
    poke32(data, (gb & 0xFF) as u32);
    while (peek32(stat) & 1u32) != 0u32 { }
    poke32(data, (bb & 0xFF) as u32);
    if count > 1 {
        pio_spi_pix(col);
        if count > 2 {
            while (peek32(stat) & 1u32) != 0u32 { }
            poke32(LCD_SPI_FILL, (count - 2) as u32);
        }
    }
    pio_spi_wait_idle();
    return;
}

// mode 0: blit w*h RGB565 pixels from `pix` into the rect (x,y,w,h).
// Same fast path as lcd_fill: prime DC once, then poll + poke the SPI
// master directly per byte — going through lcd_pixel → lcd_dat ×3 costs
// several function calls per pixel and dominated glyph rendering.
fn lcd_blit(x: i32, y: i32, w: i32, h: i32, pix: u32) -> void {
    if w <= 0 || h <= 0 { return; }
    lcd_window(x, y, x + w - 1, y + h - 1);
    var count: i32 = w * h;
    if g_lcd_use_pio == 0 {
        var i0: i32 = 0;
        while i0 < count {
            var o0: u32 = pix + ((i0 * 2) as u32);
            lcd_pixel((peek8(o0) as i32) | ((peek8(o0 + 1u32) as i32) << 8));
            i0 = i0 + 1;
        }
        return;
    }
    // Prime DC via the first pixel's R byte, then one PIX write per pixel
    // (hardware does the RGB565 → 3-byte expansion).
    var c0: i32 = (peek8(pix) as i32) | ((peek8(pix + 1u32) as i32) << 8);
    lcd_dat(((c0 >> 11) & 0x1F) << 3);
    var stat: u32 = LCD_SPI_STATUS;
    while (peek32(stat) & 1u32) != 0u32 { }
    poke32(LCD_SPI_DATA, ((((c0 >> 5) & 0x3F) << 2) & 0xFF) as u32);
    while (peek32(stat) & 1u32) != 0u32 { }
    poke32(LCD_SPI_DATA, (((c0 & 0x1F) << 3) & 0xFF) as u32);
    var i: i32 = 1;
    var pixreg: u32 = LCD_SPI_PIX;
    while i < count {
        var o: u32 = pix + ((i * 2) as u32);
        var c: i32 = (peek8(o) as i32) | ((peek8(o + 1u32) as i32) << 8);
        while (peek32(stat) & 1u32) != 0u32 { }
        poke32(pixreg, (c & 0xFFFF) as u32);
        i = i + 1;
    }
    pio_spi_wait_idle();
    return;
}

// /dev/fb backend: render one framed blit.
export fn fb_backend_write(buf_addr: u32, n: i32) -> void {

    if g_lcd_inited == 0 {
        kputs_t("LCD: lcd_init begin\r\n");
        lcd_init();
        kputs_t("LCD: lcd_init done\r\n");
    }
    if n < 10 { return; }
    var x:    i32 = fb_rd16(buf_addr);
    var y:    i32 = fb_rd16(buf_addr + 2u32);
    var w:    i32 = fb_rd16(buf_addr + 4u32);
    var h:    i32 = fb_rd16(buf_addr + 6u32);
    var mode: i32 = fb_rd16(buf_addr + 8u32);
    if mode == 0 {
        lcd_blit(x, y, w, h, buf_addr + 10u32);
    } else if mode == 1 {
        if n >= 12 { lcd_fill(x, y, w, h, fb_rd16(buf_addr + 10u32)); }
    } else if mode == 2 {
        // hardware vertical scroll — VSCRSADD
        if n >= 12 {
            lcd_cmd(0x37);
            var line: i32 = fb_rd16(buf_addr + 10u32);
            lcd_dat((line >> 8) & 0xFF);
            lcd_dat(line & 0xFF);
        }
    } else if mode == 3 {
        // Set MADCTL (memory access control: rotation / mirroring).
        // The low 8 bits of buf+10 select the ILI9488 MADCTL value.
        // Portrait (default) = 0x48, landscape = 0x28 / 0xE8 etc.
        if n >= 12 {
            lcd_cmd(0x36);
            lcd_dat(fb_rd16(buf_addr + 10u32) & 0xFF);
        }
    }
    return;
}
