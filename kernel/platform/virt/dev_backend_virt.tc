// kernel/dev_backend_virt.tc — qemu virt backends for the devfs
// hardware nodes.
//
// On virt there is no SPI display or key matrix:
//   /dev/fb  — each framed blit is dumped to the UART as an
//              "FB: mode=N ..." line tests/fb_render.py can replay.
//   /dev/kbd — reads pull from the UART RX ring, so the serial
//              console doubles as the keyboard.
// The pico2 build links display_ili9488.tc + keyboard_matrix.tc
// (real hardware) instead. devfs.tc forward-declares fb_backend_write
// and kbd_backend_read and routes /dev/fb and /dev/kbd to them.

fn do_uart_write(buf: u32, len: i32) -> i32;
fn uart_rx_pop(buf: u32, len: i32) -> i32;

// /dev/kbd backend: pull keystrokes from the kernel UART RX ring.
export fn kbd_backend_read(buf_addr: u32, n: i32) -> i32 {
    return uart_rx_pop(buf_addr, n);
}

// Read a little-endian u16 from a raw address.
fn fb_u16(addr: u32) -> i32 {
    return (peek8(addr) as i32) | ((peek8(addr + 1u32) as i32) << 8);
}

fn fb_put_str(b: U8Array, pos: i32, s: StringLiteral) -> i32 {
    var sl: i32 = len(s);
    var i: i32 = 0;
    while i < sl {
        set(b, pos, get(s, i));
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}

fn fb_put_dec(b: U8Array, pos: i32, v: i32) -> i32 {
    var d: U8Array = U8Array(12u32);
    var nn: i32 = 0;
    var x: i32 = v;
    if x < 0 { x = 0; }
    if x == 0 {
        set(d, 0, '0' as u8);
        nn = 1;
    }
    while x > 0 {
        set(d, nn, (('0' as i32) + x % 10) as u8);
        nn = nn + 1;
        x = x / 10;
    }
    while nn > 0 {
        nn = nn - 1;
        set(b, pos, get(d, nn));
        pos = pos + 1;
    }
    delete(d);
    return pos;
}

fn fb_hex_digit(d: i32) -> u8 {
    if d < 10 { return (('0' as i32) + d) as u8; }
    return (('a' as i32) + d - 10) as u8;
}

// Append the two lowercase hex digits of byte `v` (0..255).
fn fb_put_hex2(b: U8Array, pos: i32, v: i32) -> i32 {
    set(b, pos,     fb_hex_digit((v >> 4) & 0xF));
    set(b, pos + 1, fb_hex_digit(v & 0xF));
    return pos + 2;
}

// /dev/fb backend: dump one framed-blit request to the UART. A mode-0
// blit also dumps its RGB565 pixel payload as hex (`data=...`) so
// tests/fb_render.py can reconstruct the exact image.
export fn fb_backend_write(buf_addr: u32, n: i32) -> void {
    var b: U8Array = U8Array((160 + n * 2) as u32);
    var p: i32 = 0;
    p = fb_put_str(b, p, "FB: ");
    if n < 10 {
        p = fb_put_str(b, p, "runt n=");
        p = fb_put_dec(b, p, n);
    } else {
        var x:    i32 = fb_u16(buf_addr);
        var y:    i32 = fb_u16(buf_addr + 2u32);
        var w:    i32 = fb_u16(buf_addr + 4u32);
        var h:    i32 = fb_u16(buf_addr + 6u32);
        var mode: i32 = fb_u16(buf_addr + 8u32);
        p = fb_put_str(b, p, "mode="); p = fb_put_dec(b, p, mode);
        p = fb_put_str(b, p, " x=");   p = fb_put_dec(b, p, x);
        p = fb_put_str(b, p, " y=");   p = fb_put_dec(b, p, y);
        p = fb_put_str(b, p, " w=");   p = fb_put_dec(b, p, w);
        p = fb_put_str(b, p, " h=");   p = fb_put_dec(b, p, h);
        p = fb_put_str(b, p, " n=");   p = fb_put_dec(b, p, n);
        if mode == 0 {
            p = fb_put_str(b, p, " px=");
            p = fb_put_dec(b, p, w * h);
            p = fb_put_str(b, p, " data=");
            var pi: i32 = 10;
            while pi < n {
                p = fb_put_hex2(b, p, peek8(buf_addr + (pi as u32)) as i32);
                pi = pi + 1;
            }
        } else if mode == 1 {
            if n >= 12 {
                p = fb_put_str(b, p, " color=");
                p = fb_put_dec(b, p, fb_u16(buf_addr + 10u32));
            }
        } else if mode == 2 {
            if n >= 12 {
                p = fb_put_str(b, p, " scroll=");
                p = fb_put_dec(b, p, fb_u16(buf_addr + 10u32));
            }
        }
    }
    set(b, p, 10u8);
    p = p + 1;
    do_uart_write((b as u32) + 4u32, p);
    delete(b);
    return;
}

// /dev/touch stub: qemu virt has no touch panel, so always return 0
// (devfs maps that to -2 = would-block at the syscall layer, which
// makes any task that reads /dev/touch park indefinitely).
export fn touch_backend_read(buf_addr: u32, n: i32) -> i32 {
    return 0;
}
